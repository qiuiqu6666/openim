@@ -0,0 +1,41 @@
+package stickermedia
+
+import (
+	"context"
+	"github.com/openimsdk/chat/pkg/common/config"
+	"net/url"
+	"testing"
+	"time"
+)
+
+func TestCOSPresignUsesPublicAcceleration(t *testing.T) {
+	cfg := config.StickerMinio{Engine: "cos", Bucket: "test-123", Region: "ap-guangzhou", InternalAddress: "https://cos.ap-guangzhou.myqcloud.com", ExternalAddress: "https://cos.accelerate.myqcloud.com", CDN: "https://test-123.cos.accelerate.myqcloud.com", AccessKeyID: "test", SecretAccessKey: "test"}
+	s, e := NewMinioStore(nil, cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	raw, e := s.PresignPut(context.Background(), "favorite/test", time.Minute)
+	if e != nil {
+		t.Fatal(e)
+	}
+	u, e := url.Parse(raw)
+	if e != nil || u.Host != "test-123.cos.accelerate.myqcloud.com" {
+		t.Fatal("wrong upload host", u, e)
+	}
+	if s.client.EndpointURL().Host != "cos.ap-guangzhou.myqcloud.com" {
+		t.Fatal("source reader changed")
+	}
+	cfg.ExternalAddress = ""
+	s, e = NewMinioStore(nil, cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	raw, e = s.PresignPut(context.Background(), "favorite/test", time.Minute)
+	if e != nil {
+		t.Fatal(e)
+	}
+	u, _ = url.Parse(raw)
+	if u.Host != "test-123.cos.ap-guangzhou.myqcloud.com" {
+		t.Fatal("legacy fallback changed")
+	}
+}
