+package stickermedia
+import("bytes";"context";"crypto/rand";"encoding/hex";"io";"net/http";"net/url";"os";"testing";"time";"github.com/minio/minio-go/v7";"github.com/openimsdk/chat/pkg/common/config";"gopkg.in/yaml.v3")
+func TestCOSAccelerationLive(t *testing.T){
+ if os.Getenv("COS_ACCELERATION_LIVE")!="1"{t.Skip("explicit live test required")}
+ raw,e:=os.ReadFile("/srv/99chat-production/rpc-release-20261019/config-owner/chat-rpc-chat.yml");if e!=nil{t.Fatal(e)}
+ var v map[string]interface{};if e=yaml.Unmarshal(raw,&v);e!=nil{t.Fatal(e)}
+ a:=v["sticker"].(map[string]interface{})["minio"].(map[string]interface{})
+ str:=func(k string)string{s,_:=a[k].(string);return s}
+ cfg:=config.StickerMinio{Engine:"cos",Bucket:str("bucket"),Region:str("region"),InternalAddress:str("internalAddress"),ExternalAddress:"https://cos.accelerate.myqcloud.com",CDN:str("cdn"),AccessKeyID:str("accessKeyID"),SecretAccessKey:str("secretAccessKey")}
+ s,e:=NewMinioStore(nil,cfg);if e!=nil{t.Fatal(e)}
+ random:=make([]byte,16);rand.Read(random);key:="diagnostics/direct-acceleration-"+hex.EncodeToString(random);data:=[]byte("99chat direct acceleration upload")
+ ctx,cancel:=context.WithTimeout(context.Background(),30*time.Second);defer cancel()
+ u,e:=s.PresignPut(ctx,key,time.Minute);if e!=nil{t.Fatal(e)}
+ parsed,_:=url.Parse(u);if parsed.Host!=cfg.Bucket+".cos.accelerate.myqcloud.com"{t.Fatal("wrong signing host")}
+ req,_:=http.NewRequestWithContext(ctx,"PUT",u,bytes.NewReader(data));res,e:=http.DefaultClient.Do(req);if e!=nil{t.Fatal("upload transport failed")};io.Copy(io.Discard,res.Body);res.Body.Close();if res.StatusCode!=200{t.Fatalf("upload status %d",res.StatusCode)}
+ defer func(){if e:=s.client.RemoveObject(context.Background(),cfg.Bucket,key,minio.RemoveObjectOptions{});e!=nil{t.Error("cleanup failed")}}()
+ res,e=http.Get(CDNObjectURL(cfg.CDN,key));if e!=nil{t.Fatal("read transport failed")};got,e:=io.ReadAll(res.Body);res.Body.Close();if e!=nil||res.StatusCode!=200||!bytes.Equal(got,data){t.Fatal("read mismatch")}
+ t.Log("accelerated presigned upload and public download verified")
+}
