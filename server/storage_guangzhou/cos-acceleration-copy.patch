+++ b/pkg/common/storage/objectstorage/cos_acceleration_test.go
@@ -0,0 +1,45 @@
+package objectstorage
+
+import (
+	"context"
+	"github.com/openimsdk/tools/s3/cos"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+)
+
+type accelerationTransport func(*http.Request) (*http.Response, error)
+
+func (f accelerationTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func TestCOSAccelerationCopyUsesRegionalBucket(t *testing.T) {
+	conf := cos.Config{BucketURL: "https://bucket-123.cos.accelerate.myqcloud.com", SecretID: "test", SecretKey: "test", PublicRead: true}
+	c, e := NewCOSWithRuntime(context.Background(), conf, "", Config{COSCopyOrigin: "https://bucket-123.cos.ap-guangzhou.myqcloud.com"}, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	old := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = old })
+	http.DefaultTransport = accelerationTransport(func(r *http.Request) (*http.Response, error) {
+		if r.URL.Host != "bucket-123.cos.ap-guangzhou.myqcloud.com" {
+			t.Error("wrong copy target")
+		}
+		if !strings.HasPrefix(r.Header.Get("x-cos-copy-source"), "bucket-123.cos.ap-guangzhou.myqcloud.com/") {
+			t.Error("accelerated copy source")
+		}
+		return &http.Response{StatusCode: 200, Header: http.Header{}, Body: io.NopCloser(strings.NewReader("<CopyObjectResult><ETag>abc</ETag></CopyObjectResult>")), Request: r}, nil
+	})
+	if _, e = c.CopyObject(context.Background(), "source", "target"); e != nil {
+		t.Fatal(e)
+	}
+	read, e := c.AccessURL(context.Background(), "key", time.Minute, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	u, _ := url.Parse(read)
+	if u.Host != "bucket-123.cos.accelerate.myqcloud.com" {
+		t.Error("access domain changed")
+	}
+}
