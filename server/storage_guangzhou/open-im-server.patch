@@ -0,0 +1,17 @@
+package objectstorage
+
+import (
+	"github.com/openimsdk/tools/s3/cos"
+	"testing"
+)
+
+func TestNamedBucketKeepsLegacyEngine(t *testing.T) {
+	old, err := NewCOS(cos.Config{BucketURL: "https://old-123.cos.ap-hongkong.myqcloud.com", SecretID: "x", SecretKey: "y", PublicRead: true}, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	current := &NamedEngine{Interface: old, Name: "tencent-cos-guangzhou"}
+	if current.Engine() == old.Engine() || old.Engine() != "tencent-cos" {
+		t.Fatal("bucket metadata collision")
+	}
+}
