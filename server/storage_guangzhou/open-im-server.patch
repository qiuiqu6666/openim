@@ -0,0 +1,11 @@
+package objectstorage
+
+import "github.com/openimsdk/tools/s3"
+
+// NamedEngine keeps object metadata for separate COS buckets isolated.
+type NamedEngine struct {
+	s3.Interface
+	Name string
+}
+
+func (s *NamedEngine) Engine() string { return s.Name }
