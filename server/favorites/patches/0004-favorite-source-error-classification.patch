+
+type favoriteFailingResolver struct {
+	imapi.CallerInterface
+	err error
+}
+
+func (r favoriteFailingResolver) ResolveObjectURL(context.Context, string) (string, error) {
+	return "", r.err
+}
+
+func TestFavoriteSourceDiagnosticsRetryPreservesMissingVersusUnavailable(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		status   int
+		body     string
+		expected error
+	}{
+		{"object_missing", 404, `<Error><Code>NoSuchKey</Code><Message>private-lease</Message></Error>`, eerrs.ErrAssetMissing},
+		{"bucket_missing", 404, `<Error><Code>NoSuchBucket</Code></Error>`, eerrs.ErrFavoriteTemporary},
+		{"proxy_404", 404, `not found private-lease`, eerrs.ErrFavoriteTemporary},
+		{"gone_unknown", 410, ``, eerrs.ErrFavoriteTemporary},
+		{"auth", 401, ``, eerrs.ErrFavoriteTemporary},
+		{"signature", 403, `<Error><Code>SignatureDoesNotMatch</Code></Error>`, eerrs.ErrFavoriteTemporary},
+		{"server", 503, ``, eerrs.ErrFavoriteTemporary},
+		{"redirect", 302, ``, eerrs.ErrFavoriteTemporary},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			storage := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				w.WriteHeader(test.status)
+				_, _ = w.Write([]byte(test.body))
+			}))
+			defer storage.Close()
+			resolver := &favoriteSourceTestResolver{url: storage.URL + "/favorites/key?X-Amz-Signature=private-lease"}
+			store := &favoriteSourceTestStore{item: &chatdb.FavoriteItem{ID: "favorite", OwnerIMID: "owner", Status: chatdb.FavoriteArchiveFailed}, job: &chatdb.FavoriteArchiveJob{JobID: "job", SnapshotJSON: `{"objectName":"logical-message.png","sizeBytes":100}`}}
+			server := &chatSvr{Favorite: favoriteSourceTestSettings(t, storage.URL, ""), IM: resolver, Database: &favoriteSourceTestDatabase{store: store}}
+			ctx := mctx.WithOpUserID(context.Background(), "owner", chatconstant.NormalUser)
+			_, err := server.RetryChatFavoriteArchive(ctx, &chatpb.RetryChatFavoriteArchiveReq{Id: "favorite", ClientRequestID: "12345678-1234-4234-8234-123456789abc"})
+			if err != test.expected || store.reserved != 0 || store.requeued || store.reopened {
+				t.Fatal("retry must preserve source classification without changing archive/quota state")
+			}
+			if strings.Contains(err.Error(), "private-lease") || strings.Contains(err.Error(), storage.URL) {
+				t.Fatal("source detail must remain private")
+			}
+		})
+	}
+}
+
+func TestFavoriteSourceDiagnosticsNetworkPolicyAndResolverErrorsAreTemporary(t *testing.T) {
+	storage := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	f := favoriteSourceTestSettings(t, storage.URL, "")
+	storage.Close()
+	for _, raw := range []string{storage.URL + "/favorites/key?X-Amz-Signature=private-lease", storage.URL + "/other/key", "http://untrusted.test/favorites/key"} {
+		server := &chatSvr{Favorite: f, IM: &favoriteSourceTestResolver{url: raw}}
+		if err := server.probeFavoriteSource(context.Background(), "logical-message.png"); err != eerrs.ErrFavoriteTemporary {
+			t.Fatal("network and trust-policy errors must not become AssetMissing")
+		}
+	}
+	for _, cause := range []error{eerrs.ErrAssetMissing, eerrs.ErrFavoriteTemporary, errors.New("network http://storage/key?X-Amz-Signature=private-lease")} {
+		server := &chatSvr{Favorite: f, IM: favoriteFailingResolver{err: cause}}
+		err := server.probeFavoriteSource(context.Background(), "logical-message.png")
+		if cause == eerrs.ErrAssetMissing {
+			if err != eerrs.ErrAssetMissing {
+				t.Fatal("confirmed metadata absence must be preserved")
+			}
+		} else if err != eerrs.ErrFavoriteTemporary {
+			t.Fatal("unconfirmed resolver failures must remain temporary")
+		}
+		if strings.Contains(err.Error(), "private-lease") {
+			t.Fatal("resolver causes must not leak a signed query")
+		}
+	}
+}
