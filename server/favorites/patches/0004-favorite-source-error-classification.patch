@@ -0,0 +1,46 @@
+package imapi
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/openimsdk/chat/pkg/eerrs"
+)
+
+func TestFavoriteObjectDiagnosticsPreserveMetadataNotFoundAndSanitizeOtherCodes(t *testing.T) {
+	for _, code := range []int{1004, 1002, 1501, 1502, 1503} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = fmt.Fprintf(w, `{"errCode":%d,"errMsg":"private-lease","errDlt":"http://storage/key?X-Amz-Signature=private-lease"}`, code)
+		}))
+		_, err := favoriteObjectTestCaller(server).ResolveObjectURL(context.Background(), "logical-message.png")
+		server.Close()
+		if code == 1004 {
+			if err != eerrs.ErrAssetMissing {
+				t.Fatal("metadata record-not-found must retain its classification")
+			}
+		} else if err != eerrs.ErrFavoriteTemporary {
+			t.Fatal("auth and internal errors must remain service unavailable")
+		}
+		if strings.Contains(err.Error(), "private-lease") || strings.Contains(err.Error(), "storage/key") {
+			t.Fatal("numeric classification must not preserve upstream detail")
+		}
+	}
+}
+
+func TestFavoriteObjectDiagnosticsHTTPErrorCannotMasqueradeAsSuccessfulLease(t *testing.T) {
+	for _, status := range []int{401, 403, 503} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			w.WriteHeader(status)
+			_, _ = w.Write([]byte(`{"errCode":0,"data":{"url":"http://storage/key?X-Amz-Signature=private-lease","expireTime":9999999999999}}`))
+		}))
+		_, err := favoriteObjectTestCaller(server).ResolveObjectURL(context.Background(), "logical-message.png")
+		server.Close()
+		if err != eerrs.ErrFavoriteTemporary {
+			t.Fatal("HTTP failure must not produce a usable signed lease")
+		}
+	}
+}
