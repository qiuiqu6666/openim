+// Log only fixed categories and numeric status, never object names, URL, headers,
+// upstream detail, error bodies or transport errors containing a signed query.
+func favoriteSourceUnavailable(ctx context.Context, stage, category string, status int, missing bool) error {
+	err := eerrs.ErrFavoriteTemporary
+	if missing {
+		err = eerrs.ErrAssetMissing
+	}
+	log.ZWarn(ctx, "favorite source unavailable", err, "stage", stage, "category", category, "httpStatus", status)
+	return err
+}
+
+func favoriteResolutionFailure(ctx context.Context, err error) error {
