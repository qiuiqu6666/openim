+++ b/pkg/common/imapi/object_url_http_error.go
@@ -0,0 +1,6 @@
+package imapi
+
+// Only the numeric HTTP status survives the metadata boundary; no URL or body.
+type objectURLHTTPError struct{ status int }
+
+func (*objectURLHTTPError) Error() string { return "ObjectURLHTTPUnavailable" }
