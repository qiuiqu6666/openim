+func (r *favoriteSourceTestResolver) ResolveObjectURL(_ context.Context, name string) (string, error) {
+	r.name = name
+	r.calls++
+	return r.url, nil
+}
+func (r *favoriteSourceTestResolver) ImAdminTokenWithDefaultAdmin(context.Context) (string, error) {
+	return "", errors.New("notifications are outside this test")
+}
+
+func favoriteSourceTestSettings(t *testing.T, internal, public string) favoriteSettings {
+	t.Helper()
+	f, err := newFavoriteSettings(config.FavoriteConfig{
+		PublicStorageURL: public,
+		Minio:            config.StickerMinio{Bucket: "favorites", InternalAddress: internal, AccessKeyID: "test-access", SecretAccessKey: "test-secret"},
+	}, config.StickerConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+
+func TestFavoriteSourceResolvesLogicalNameAndReadsOnlyConfiguredBucket(t *testing.T) {
+	calls := 0
+	storage := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		calls++
+		if req.Method != http.MethodGet || req.URL.Path != "/favorites/2026/user/random-key.png" {
+			t.Error("archive must use OpenIM's resolved physical object path")
+		}
+		if req.Header.Get("token") != "" || req.Header.Get("Authorization") != "" || req.Header.Get("operationID") != "" {
+			t.Error("storage fetch must not inherit caller authorization headers")
+		}
+		_, _ = w.Write([]byte("original"))
+	}))
+	defer storage.Close()
+	resolver := &favoriteSourceTestResolver{url: storage.URL + "/favorites/2026/user/random-key.png?X-Amz-Signature=test"}
+	server := &chatSvr{Favorite: favoriteSourceTestSettings(t, storage.URL, ""), IM: resolver}
+	body, err := server.readFavoriteSource(context.Background(), "logical-message.png", 20)
+	if err != nil || string(body) != "original" || calls != 1 || resolver.name != "logical-message.png" {
+		t.Fatal("verified logical name must resolve through the API before a bounded storage fetch")
+	}
+	publicSettings := favoriteSourceTestSettings(t, "http://localhost:10005", storage.URL)
+	if _, err := publicSettings.readResolvedSource(context.Background(), resolver.url, 20); err != nil {
+		t.Fatal("configured public storage origin is also a trusted source")
+	}
+}
+
+func TestFavoriteSourceRejectsForeignOriginBucketTraversalAndRedirect(t *testing.T) {
+	fetched := 0
+	foreign := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { fetched++ }))
+	defer foreign.Close()
+	storage := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		http.Redirect(w, req, foreign.URL+"/favorites/secret", http.StatusFound)
+	}))
+	defer storage.Close()
+	f := favoriteSourceTestSettings(t, storage.URL, "")
+	for _, raw := range []string{
+		foreign.URL + "/favorites/key", storage.URL + "/other/key", storage.URL + "/favorites/",
+		storage.URL + "/favorites/%2e%2e/key", storage.URL + "/favorites/./key", storage.URL + "/favorites/a%5cb",
+		strings.Replace(storage.URL, "http://", "http://user:pass@", 1) + "/favorites/key",
+		storage.URL + "/favorites/key#part", strings.Replace(storage.URL, "http://", "https://", 1) + "/favorites/key",
+	} {
+		if _, err := f.readResolvedSource(context.Background(), raw, 20); err == nil {
+			t.Fatal("untrusted source accepted")
+		}
+	}
+	if _, err := f.readResolvedSource(context.Background(), storage.URL+"/favorites/redirect", 20); err == nil {
+		t.Fatal("storage redirects must be rejected")
+	}
+	if fetched != 0 {
+		t.Fatal("no request may reach a foreign origin")
+	}
+}
+
+func TestFavoriteSourceBoundsKnownAndChunkedBodiesAndSanitizesFailures(t *testing.T) {
+	storage := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if strings.HasSuffix(req.URL.Path, "/known") {
+			w.Header().Set("Content-Length", "30")
+		} else {
+			w.(http.Flusher).Flush()
+		}
+		_, _ = w.Write(bytes.Repeat([]byte("a"), 30))
+	}))
+	f := favoriteSourceTestSettings(t, storage.URL, "")
+	for _, key := range []string{"known", "chunked"} {
+		if _, err := f.readResolvedSource(context.Background(), storage.URL+"/favorites/"+key, 10); err != eerrs.ErrMediaTooLarge {
+			t.Fatal("declared and streamed bodies must obey the same maximum size")
+		}
+	}
+	storage.Close()
+	_, err := f.readResolvedSource(context.Background(), storage.URL+"/favorites/key?X-Amz-Signature=private-lease", 10)
+	if err == nil || strings.Contains(err.Error(), "private-lease") || strings.Contains(err.Error(), storage.URL) {
+		t.Fatal("network errors must not expose the source signed URL")
+	}
+}
+
+func TestFavoriteSourceTrustUsesEffectivePortWithoutChangingSignedURL(t *testing.T) {
+	for _, test := range []struct {
+		endpoint, raw string
+		allowed       bool
+	}{
+		{"https://storage.test:443", "https://STORAGE.test/favorites/key?X-Amz-Signature=test", true},
+		{"http://storage.test:80", "http://storage.test/favorites/key?X-Amz-Signature=test", true},
+		{"https://storage.test", "https://storage.test:443/favorites/key?X-Amz-Signature=test", true},
+		{"http://storage.test:10005", "http://storage.test/favorites/key", false},
+		{"http://storage.test:10005", "http://storage.test:10006/favorites/key", false},
+		{"https://storage.test:443", "http://storage.test:443/favorites/key", false},
+	} {
+		f := favoriteSourceTestSettings(t, test.endpoint, "")
+		parsed, err := f.trustedSourceURL(test.raw)
+		if (err == nil) != test.allowed {
+			t.Fatal("only equivalent default ports may be normalized for origin checks")
+		}
+		if err == nil && parsed.String() != test.raw {
+			t.Fatal("trusted origin comparison must preserve the original signed URL")
+		}
+	}
+}
