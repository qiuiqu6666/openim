+func TestFavoriteSourceRetryArchiveUsesLegacySnapshotResolverAndKeepsMissingAssetError(t *testing.T) {
+	missing := false
+	storage := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if req.Method != http.MethodGet || req.URL.Path != "/favorites/2026/user/actual.png" || req.Header.Get("Range") != "bytes=0-0" {
+			t.Error("retry must probe the resolved object with a GET signature")
+		}
+		if missing {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		w.WriteHeader(http.StatusPartialContent)
+		_, _ = w.Write([]byte("a"))
+	}))
+	defer storage.Close()
+	resolver := &favoriteSourceTestResolver{url: storage.URL + "/favorites/2026/user/actual.png?X-Amz-Signature=test"}
+	// This is the original snapshot wire shape, without a new physical-key field.
+	snapshot := `{"objectName":"logical-message.png","contentType":102,"sizeBytes":100}`
+	store := &favoriteSourceTestStore{
+		item: &chatdb.FavoriteItem{ID: "favorite", OwnerIMID: "owner", Status: chatdb.FavoriteArchiveFailed, Version: 2},
+		job:  &chatdb.FavoriteArchiveJob{JobID: "legacy-job", OwnerIMID: "owner", FavoriteID: "favorite", SnapshotJSON: snapshot},
+	}
+	server := &chatSvr{Favorite: favoriteSourceTestSettings(t, storage.URL, ""), IM: resolver, Database: &favoriteSourceTestDatabase{store: store}}
+	ctx := mctx.WithOpUserID(context.Background(), "owner", chatconstant.NormalUser)
+	req := &chatpb.RetryChatFavoriteArchiveReq{Id: "favorite", ClientRequestID: "12345678-1234-4234-8234-123456789abc"}
+	resp, err := server.RetryChatFavoriteArchive(ctx, req)
+	if err != nil || resp.Status != chatdb.FavoritePendingArchive || resp.JobID != "legacy-job" || !store.requeued || !store.reopened || resolver.name != "logical-message.png" {
+		t.Fatal("legacy archive retry must resolve metadata and reopen the original job")
+	}
+	missing = true
+	store.requeued, store.reopened = false, false
+	store.reserved = 0
+	if _, err := server.RetryChatFavoriteArchive(ctx, req); err != eerrs.ErrAssetMissing || store.reserved != 0 || store.requeued || store.reopened {
+		t.Fatal("missing resolved object must remain ASSET_MISSING without reserving or requeueing")
+	}
+}
+
+func TestFavoriteSourceArchiveJobInspectsAndWritesPrivateCopyWithoutLogicalKeyStat(t *testing.T) {
+	var original bytes.Buffer
+	if err := png.Encode(&original, image.NewRGBA(image.Rect(0, 0, 2, 2))); err != nil {
+		t.Fatal(err)
+	}
+	var copied []byte
+	storage := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		switch {
+		case req.Method == http.MethodGet && req.URL.Query().Has("location"):
+			_, _ = w.Write([]byte(`<LocationConstraint xmlns="http://s3.amazonaws.com/doc/2006-03-01/">us-east-1</LocationConstraint>`))
+		case req.Method == http.MethodGet && req.URL.Path == "/favorites/2026/user/random.png":
+			_, _ = w.Write(original.Bytes())
+		case req.Method == http.MethodPut && strings.HasPrefix(req.URL.Path, "/favorites/favorite/owner/ast_"):
+			copied, _ = io.ReadAll(req.Body)
+			w.Header().Set("ETag", `"test-etag"`)
+		default:
+			t.Errorf("unexpected storage operation: %s", req.Method)
+			w.WriteHeader(http.StatusBadRequest)
+		}
+	}))
+	defer storage.Close()
+	resolver := &favoriteSourceTestResolver{url: storage.URL + "/favorites/2026/user/random.png?X-Amz-Signature=test"}
+	server := &chatSvr{Favorite: favoriteSourceTestSettings(t, storage.URL, ""), IM: resolver}
+	store := &favoriteSourceTestStore{item: &chatdb.FavoriteItem{ID: "favorite", OwnerIMID: "owner", Status: chatdb.FavoritePendingArchive, Version: 1}}
+	snap, _ := json.Marshal(archiveSnapshot{ObjectName: "logical-message.png", FileName: "photo.png", ContentType: constant.Picture, SizeBytes: int64(original.Len())})
+	server.runFavoriteJob(context.Background(), store, &chatdb.FavoriteArchiveJob{OwnerIMID: "owner", FavoriteID: "favorite", JobID: "job", SnapshotJSON: string(snap)})
+	if !store.ready || store.jobState != chatdb.FavoriteJobDone || store.asset == nil || store.asset.MimeType != "image/png" || !strings.HasPrefix(store.asset.ObjectKey, "favorite/owner/") {
+		t.Fatal("resolved original must become an inspected private favorite asset")
+	}
+	// minio-go may use aws-chunked transfer for PUT. The full original must be present.
+	if !bytes.Contains(copied, original.Bytes()) {
+		t.Fatal("private copy must retain the original bytes")
+	}
+	if resolver.name != "logical-message.png" || resolver.calls != 1 {
+		t.Fatal("logical metadata resolution must occur exactly once")
+	}
+}
