+package imapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/protocol/third"
+)
+
+func favoriteObjectTestCaller(server *httptest.Server) *Caller {
+	return &Caller{imApi: server.URL, defaultIMUserID: "test-admin", tokenCache: map[string]*authToken{
+		"test-admin": {token: "test-admin-token", timeout: time.Now().Add(time.Minute)},
+	}}
+}
+
+func TestFavoriteObjectURLCallerUsesLogicalMetadataAPIAndAdminContext(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		var body third.AccessURLReq
+		if req.Method != http.MethodPost || req.URL.Path != "/object/access_url" || req.Header.Get("token") != "test-admin-token" || json.NewDecoder(req.Body).Decode(&body) != nil || body.Name != "logical-message.png" || len(body.Query) != 0 {
+			t.Error("logical original must be resolved through the authenticated metadata API")
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"errCode": 0, "data": map[string]any{"url": "http://storage.test/bucket/random?X-Amz-Signature=test", "expireTime": time.Now().Add(time.Minute).UnixMilli()}})
+	}))
+	defer server.Close()
+	raw, err := favoriteObjectTestCaller(server).ResolveObjectURL(context.Background(), "logical-message.png")
+	if err != nil || !strings.Contains(raw, "/bucket/random?") {
+		t.Fatal("metadata response was not returned")
+	}
+}
+
+func TestFavoriteObjectURLCallerRejectsExpiredAndSanitizesUpstreamErrors(t *testing.T) {
+	for _, body := range []string{
+		`{"errCode":0,"data":{"url":"http://storage.test/key?X-Amz-Signature=private-lease","expireTime":1}}`,
+		`{"errCode":1001,"errMsg":"http://storage.test/key?X-Amz-Signature=private-lease","errDlt":"private-lease"}`,
+		`malformed response http://storage.test/key?X-Amz-Signature=private-lease`,
+	} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(body)) }))
+		_, err := favoriteObjectTestCaller(server).ResolveObjectURL(context.Background(), "logical-message.png")
+		server.Close()
+		if err == nil || strings.Contains(err.Error(), "private-lease") || strings.Contains(err.Error(), "storage.test") {
+			t.Fatal("expired or failed resolution must not expose a private signed URL")
+		}
+	}
+}
