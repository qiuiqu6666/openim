+// Resolve only OpenIM's verified logical object name through its metadata API.
+// The response contains a private signed URL and must not enter ordinary logs.
+func (c *Caller) ResolveObjectURL(ctx context.Context, name string) (string, error) {
+	if name == "" {
+		return "", eerrs.ErrSourceNotAccessible
+	}
+	apiCtx, err := c.adminCtx(ctx)
+	if err != nil {
+		return "", eerrs.ErrSourceNotAccessible
+	}
+	resp, err := resolveObjectURL.Call(apiCtx, c.imApi, &third.AccessURLReq{Name: name})
+	if err != nil || resp == nil || resp.Url == "" || resp.ExpireTime <= time.Now().UnixMilli() {
+		return "", eerrs.ErrSourceNotAccessible
+	}
+	return resp.Url, nil
+}
