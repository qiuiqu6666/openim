diff --git a/internal/rpc/chat/favorite_source.go b/internal/rpc/chat/favorite_source.go
new file mode 100644
--- /dev/null
+++ b/internal/rpc/chat/favorite_source.go
@@ -0,0 +1,136 @@
+package chat
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/minio/minio-go/v7"
+	"github.com/openimsdk/chat/pkg/eerrs"
+)
+
+// Called only with a snapshot captured after PullMsgsBySeq and message eligibility
+// checks. Resolve the logical name using OpenIM's metadata, without guessing a key.
+func (o *chatSvr) readFavoriteSource(ctx context.Context, name string, limit int64) ([]byte, error) {
+	if o.IM == nil || name == "" || limit <= 0 {
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	raw, err := o.IM.ResolveObjectURL(ctx, name)
+	if err != nil {
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	return o.Favorite.readResolvedSource(ctx, raw, limit)
+}
+
+// Retry preflight uses the same old snapshot name and fresh metadata lease. A
+// one-byte GET range avoids signing a HEAD method with a GET-only signature.
+func (o *chatSvr) probeFavoriteSource(ctx context.Context, name string) error {
+	if o.IM == nil || name == "" {
+		return eerrs.ErrAssetMissing
+	}
+	raw, err := o.IM.ResolveObjectURL(ctx, name)
+	if err != nil {
+		return eerrs.ErrAssetMissing
+	}
+	resp, err := o.Favorite.openResolvedSource(ctx, raw, "bytes=0-0")
+	if err != nil {
+		return eerrs.ErrAssetMissing
+	}
+	resp.Body.Close()
+	return nil
+}
+
+func (f favoriteSettings) trustedSourceURL(raw string) (*url.URL, error) {
+	parsed, err := url.Parse(raw)
+	if err != nil || parsed == nil || parsed.Host == "" || parsed.User != nil || parsed.Fragment != "" ||
+		(parsed.Scheme != "http" && parsed.Scheme != "https") || f.Bucket == "" {
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	allowed := false
+	for _, client := range []*minio.Client{f.Client, f.PublicSigner} {
+		if client != nil && sameFavoriteStorageOrigin(parsed, client.EndpointURL()) {
+			allowed = true
+			break
+		}
+	}
+	prefix := "/" + f.Bucket + "/"
+	if !allowed || !strings.HasPrefix(parsed.Path, prefix) || len(parsed.Path) == len(prefix) {
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	for _, segment := range strings.Split(parsed.Path, "/") {
+		if segment == "." || segment == ".." || strings.ContainsRune(segment, '\\') {
+			return nil, eerrs.ErrSourceNotAccessible
+		}
+	}
+	return parsed, nil
+}
+
+func sameFavoriteStorageOrigin(a, b *url.URL) bool {
+	if a.Scheme != b.Scheme || !strings.EqualFold(a.Hostname(), b.Hostname()) {
+		return false
+	}
+	port := func(u *url.URL) string {
+		if u.Port() != "" {
+			return u.Port()
+		}
+		if u.Scheme == "https" {
+			return "443"
+		}
+		return "80"
+	}
+	return port(a) == port(b)
+}
+
+func (f favoriteSettings) openResolvedSource(ctx context.Context, raw, byteRange string) (*http.Response, error) {
+	parsed, err := f.trustedSourceURL(raw)
+	if err != nil {
+		return nil, err
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, parsed.String(), nil)
+	if err != nil {
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	if byteRange != "" {
+		request.Header.Set("Range", byteRange)
+	}
+	client := &http.Client{
+		Timeout:       30 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+	// This storage request carries no OpenIM/business token or caller headers.
+	resp, err := client.Do(request)
+	if err != nil {
+		// net/http errors include the request URL; never expose the private lease.
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	if resp.StatusCode != http.StatusOK && !(byteRange != "" && resp.StatusCode == http.StatusPartialContent) {
+		resp.Body.Close()
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	return resp, nil
+}
+
+func (f favoriteSettings) readResolvedSource(ctx context.Context, raw string, limit int64) ([]byte, error) {
+	if limit <= 0 {
+		return nil, eerrs.ErrMediaTooLarge
+	}
+	resp, err := f.openResolvedSource(ctx, raw, "")
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.ContentLength > limit {
+		return nil, eerrs.ErrMediaTooLarge
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, limit+1))
+	if err != nil {
+		return nil, eerrs.ErrSourceNotAccessible
+	}
+	if int64(len(body)) > limit {
+		return nil, eerrs.ErrMediaTooLarge
+	}
+	return body, nil
+}
