-	o.finishFavoriteRequest(ctx, store, owner, "batch-delete", req.ClientRequestID, hash, "", 0)
+	if err := o.saveFavoriteBatchResponse(ctx, store, owner, req.ClientRequestID, hash, resp); err != nil {
