+// A presigned URL includes its host in the signature. Build it with the public
+// endpoint from the start; server-side object operations keep the internal one.
+func newFavoritePublicSigner(raw string, storage config.StickerMinio) (*minio.Client, error) {
+	if strings.TrimSpace(raw) == "" {
+		return nil, nil
+	}
+	endpoint, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || endpoint == nil ||
+		(endpoint.Scheme != "http" && endpoint.Scheme != "https") ||
+		endpoint.Host == "" || endpoint.Hostname() == "" || endpoint.User != nil ||
+		(endpoint.Path != "" && endpoint.Path != "/") || endpoint.RawQuery != "" ||
+		endpoint.ForceQuery || endpoint.Fragment != "" {
+		return nil, fmt.Errorf("favorite publicStorageURL must be an HTTP(S) storage endpoint without credentials, path, query or fragment")
+	}
+	signer, err := minio.New(endpoint.Host, &minio.Options{
+		Creds:  credentials.NewStaticV4(storage.AccessKeyID, storage.SecretAccessKey, storage.SessionToken),
+		Secure: endpoint.Scheme == "https",
+	})
+	if err != nil {
+		return nil, fmt.Errorf("favorite publicStorageURL is not a valid storage endpoint")
+	}
+	return signer, nil
 }
 
