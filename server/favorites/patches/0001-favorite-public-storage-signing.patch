@@ -0,0 +1,101 @@
+package chat
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/chat/pkg/common/config"
+)
+
+func favoriteSigningTestStorage(endpoint string) config.StickerMinio {
+	return config.StickerMinio{Bucket: "favorites", InternalAddress: endpoint,
+		AccessKeyID: "test-access", SecretAccessKey: "test-secret"}
+}
+
+func favoriteSigningTestEndpoint(t *testing.T) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet || !r.URL.Query().Has("location") {
+			t.Errorf("only a read-only bucket-region lookup is expected: %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("Content-Type", "application/xml")
+		_, _ = w.Write([]byte(`<LocationConstraint xmlns="http://s3.amazonaws.com/doc/2006-03-01/">us-east-1</LocationConstraint>`))
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+func TestFavoritePublicSignerPresignsPublicHostAndKeepsInternalClient(t *testing.T) {
+	public := favoriteSigningTestEndpoint(t)
+	internalURL := "http://localhost:10005"
+	settings, err := newFavoriteSettings(config.FavoriteConfig{
+		PublicStorageURL: public.URL, Minio: favoriteSigningTestStorage(internalURL),
+	}, config.StickerConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if settings.Client.EndpointURL().String() != internalURL {
+		t.Fatal("public signing must not change the internal object client")
+	}
+	if settings.PublicSigner == nil || settings.PublicSigner == settings.Client {
+		t.Fatal("a separate public signer is required")
+	}
+	for _, put := range []bool{true, false} {
+		var signed string
+		if put {
+			signed, err = settings.presignPut(context.Background(), "favorite/owner/asset", 10*time.Minute)
+		} else {
+			signed, err = settings.presignGet(context.Background(), "favorite/owner/asset", 10*time.Minute)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		parsed, err := url.Parse(signed)
+		if err != nil {
+			t.Fatal("signed URL did not parse")
+		}
+		endpoint, _ := url.Parse(public.URL)
+		if parsed.Host != endpoint.Host || parsed.Scheme != endpoint.Scheme || parsed.Path != "/favorites/favorite/owner/asset" {
+			t.Fatal("signature must be created for the selected public endpoint and object")
+		}
+		if parsed.Query().Get("X-Amz-Signature") == "" || parsed.Query().Get("X-Amz-Expires") != "600" {
+			t.Fatal("public URL must retain a valid signed lease")
+		}
+	}
+}
+
+func TestFavoritePublicSignerEmptyConfigPreservesInternalFallback(t *testing.T) {
+	internal := favoriteSigningTestEndpoint(t)
+	settings, err := newFavoriteSettings(config.FavoriteConfig{Minio: favoriteSigningTestStorage(internal.URL)}, config.StickerConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if settings.PublicSigner != nil {
+		t.Fatal("empty configuration must keep the legacy signer")
+	}
+	signed, err := settings.presignGet(context.Background(), "favorite/owner/asset", time.Minute)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, _ := url.Parse(signed)
+	endpoint, _ := url.Parse(internal.URL)
+	if parsed.Host != endpoint.Host {
+		t.Fatal("internal fallback endpoint changed")
+	}
+}
+
+func TestFavoritePublicSignerRejectsInvalidURL(t *testing.T) {
+	for _, raw := range []string{"media.example.com:10005", "ftp://media.example.com", "http:///", "http://user:pass@media.example.com", "https://media.example.com/storage", "https://media.example.com?token=private", "https://media.example.com?", "https://media.example.com#part", "https://media.example.com:bad"} {
+		if _, err := newFavoriteSettings(config.FavoriteConfig{
+			PublicStorageURL: raw, Minio: favoriteSigningTestStorage("localhost:10005"),
+		}, config.StickerConfig{}); err == nil {
+			t.Fatal("invalid public endpoint was accepted")
+		}
+	}
+}
