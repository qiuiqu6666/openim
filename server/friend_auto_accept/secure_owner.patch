@@ -0,0 +1,48 @@
+package imapi
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestAutoAcceptFriendOperationAndResponse(t *testing.T) {
+	for _, tc := range []struct {
+		name, op string
+		result   int
+		want     int
+		fail     bool
+	}{
+		{"pending", "new", 0, 1, false}, {"accepted", "new", 1, 0, false}, {"rejected", "new", -1, 0, false}, {"old request", "old", 0, 0, true}, {"missing operation", "", 0, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch r.URL.Path {
+				case "/friend/get_designated_friend_apply":
+					body := map[string]any{"errCode": 0, "data": map[string]any{"friendRequests": []map[string]any{{"fromUserID": "A", "toUserID": "B", "ex": fmt.Sprintf(`{"op":%q}`, tc.op), "handleResult": tc.result}}}}
+					json.NewEncoder(w).Encode(body)
+				case "/friend/add_friend_response":
+					calls++
+					var body map[string]any
+					json.NewDecoder(r.Body).Decode(&body)
+					if body["fromUserID"] != "A" || body["toUserID"] != "B" || body["handleResult"] != float64(1) {
+						t.Errorf("wrong response %v", body)
+					}
+					fmt.Fprint(w, `{"errCode":0,"data":{}}`)
+				default:
+					t.Errorf("unexpected path %s", r.URL.Path)
+				}
+			}))
+			defer s.Close()
+			e := New(s.URL, "", "").AutoAcceptFriendApplyForOperation(context.Background(), "A", "B", "new")
+			if (e != nil) != tc.fail || calls != tc.want {
+				t.Fatalf("calls=%d err=%v", calls, e)
+			}
+		})
+	}
+}
