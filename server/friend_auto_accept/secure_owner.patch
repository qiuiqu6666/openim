@@ -0,0 +1,135 @@
+package chat
+
+import (
+	"context"
+	"errors"
+	chatdb "github.com/openimsdk/chat/pkg/common/db/table/chat"
+	chatpb "github.com/openimsdk/chat/pkg/protocol/chat"
+	"github.com/openimsdk/protocol/wrapperspb"
+	"testing"
+	"time"
+)
+
+type autoDB struct {
+	blacklistFlowDB
+	attribute *chatdb.Attribute
+	claimed   *chatdb.FriendGrant
+}
+
+func (d *autoDB) TakeAttributeByUserID(context.Context, string) (*chatdb.Attribute, error) {
+	return d.attribute, nil
+}
+func (d *autoDB) ClaimFriendGrant(ctx context.Context, g, a, op string, now time.Time, auto bool) (*chatdb.FriendGrant, error) {
+	row, e := d.blacklistFlowDB.ClaimFriendGrant(ctx, g, a, op, now, auto)
+	d.claimed = row
+	return row, e
+}
+
+type autoIM struct {
+	blacklistFlowIM
+	accepted int
+	fail     error
+}
+
+func (i *autoIM) AutoAcceptFriendApplyForOperation(_ context.Context, from, to, op string) error {
+	if from != "A" || to != "B" || op != i.operation {
+		panic("wrong request")
+	}
+	i.accepted++
+	return i.fail
+}
+func autoFlow(enabled bool) (*chatSvr, *autoDB, *autoIM, *chatdb.FriendGrant) {
+	s, _, _, row := newBlacklistFlow()
+	a := openAttribute()
+	a.AutoAcceptFriend = enabled
+	db := &autoDB{attribute: a}
+	im := &autoIM{}
+	s.Database = db
+	s.IM = im
+	return s, db, im, row
+}
+func TestAutoAcceptFriendSubmission(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		s, db, im, row := autoFlow(enabled)
+		r, e := s.continueFriendApply(context.Background(), row, "hi")
+		if e != nil || r.ApplyState != chatdb.FriendGrantSuccess {
+			t.Fatalf("%v %v", r, e)
+		}
+		want := 0
+		if enabled {
+			want = 1
+		}
+		if im.accepted != want || db.claimed.AutoAccept != enabled {
+			t.Fatal("approval policy not captured")
+		}
+	}
+}
+func TestAutoAcceptFriendRetryAndHistoricalSafety(t *testing.T) {
+	s, db, im, row := autoFlow(true)
+	im.fail = errors.New("timeout")
+	if _, e := s.continueFriendApply(context.Background(), row, "hi"); e == nil {
+		t.Fatal("must not finalize before approval")
+	}
+	for _, state := range db.states {
+		if state == chatdb.FriendGrantSuccess {
+			t.Fatal("premature success")
+		}
+	}
+	im.fail = nil
+	if _, e := s.settleFriendApply(context.Background(), db.claimed); e != nil || im.accepted != 2 || im.sent != 1 {
+		t.Fatal("retry failed", e)
+	}
+	s, db, im, row = autoFlow(false)
+	if _, e := s.continueFriendApply(context.Background(), row, "hi"); e != nil {
+		t.Fatal(e)
+	}
+	db.attribute.AutoAcceptFriend = true
+	if _, e := s.settleFriendApply(context.Background(), db.claimed); e != nil || im.accepted != 0 {
+		t.Fatal("historical request auto-approved", e)
+	}
+}
+func TestAutoAcceptFriendRespectsRestrictions(t *testing.T) {
+	for _, restriction := range []string{"blacklist", "source", "global", "disabled"} {
+		t.Run(restriction, func(t *testing.T) {
+			s, db, im, row := autoFlow(true)
+			row.AutoAccept = true
+			row.OpID = "op"
+			im.operation = "op"
+			switch restriction {
+			case "blacklist":
+				im.blockedOwner = "B"
+			case "source":
+				db.attribute.AllowAddByAccount = 2
+			case "global":
+				db.attribute.AllowAddFriend = 0
+			case "disabled":
+				db.attribute.AutoAcceptFriend = false
+			}
+			e := s.autoAcceptFriendApply(context.Background(), row)
+			if im.accepted != 0 {
+				t.Fatal("restriction bypassed")
+			}
+			if restriction != "disabled" && e == nil {
+				t.Fatal("expected denial")
+			}
+		})
+	}
+}
+func TestAutoAcceptFriendSettingPatchAndDefault(t *testing.T) {
+	if v := DbToPbUserFullInfo(&chatdb.Attribute{}).AutoAcceptFriend; v == nil || *v {
+		t.Fatal("default must explicitly be false")
+	}
+	for _, enabled := range []bool{false, true} {
+		m, e := ToDBAttributeUpdate(&chatpb.UpdateUserInfoReq{AutoAcceptFriend: &wrapperspb.BoolValue{Value: enabled}})
+		if e != nil || m["auto_accept_friend"] != enabled || len(m) != 1 {
+			t.Fatalf("bad patch %v %v", m, e)
+		}
+	}
+	m, e := ToDBAttributeUpdate(&chatpb.UpdateUserInfoReq{})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, ok := m["auto_accept_friend"]; ok {
+		t.Fatal("omitted setting overwritten")
+	}
+}
