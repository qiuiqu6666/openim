+package chat
+
+import (
+	"context"
+	chatdb "github.com/openimsdk/chat/pkg/common/db/table/chat"
+)
+
+// Only the policy captured at submission authorizes auto approval. Failures
+// remain pending and are retried through the existing grant settlement path.
+func (o *chatSvr) autoAcceptFriendApply(ctx context.Context, row *chatdb.FriendGrant) error {
+	if !row.AutoAccept {
+		return nil
+	}
+	if err := o.allowFriendBlacklist(ctx, row.ApplicantIMID, row.TargetIMID); err != nil {
+		return err
+	}
+	if err := o.allowFriendSubject(ctx, row); err != nil {
+		return err
+	}
+	attribute, err := o.Database.TakeAttributeByUserID(ctx, row.TargetIMID)
+	if err != nil {
+		return err
+	}
+	// Disabling cancels automatic approval for still-pending retries.
+	if attribute == nil || !attribute.AutoAcceptFriend {
+		return nil
+	}
+	imCtx, err := o.withIMAdmin(ctx)
+	if err != nil {
+		return grantDenied("apply uncertain")
+	}
+	if err := o.IM.AutoAcceptFriendApplyForOperation(imCtx, row.ApplicantIMID, row.TargetIMID, row.OpID); err != nil {
+		return grantDenied("apply uncertain")
+	}
+	return nil
+}
