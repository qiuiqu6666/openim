@@ -0,0 +1,33 @@
+package imapi
+
+import (
+	"context"
+	"github.com/openimsdk/protocol/constant"
+	"github.com/openimsdk/protocol/relation"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+)
+
+var respondFriendApply = NewApiCaller[relation.RespondFriendApplyReq, relation.RespondFriendApplyResp]("/friend/add_friend_response")
+
+func (c *Caller) AutoAcceptFriendApplyForOperation(ctx context.Context, from, to, opID string) error {
+	resp, err := designatedFriendApply.Call(ctx, c.imApi, &relation.GetDesignatedFriendsApplyReq{FromUserID: from, ToUserID: to})
+	if err != nil {
+		return err
+	}
+	if resp == nil {
+		return errs.ErrArgs.WrapMsg("friend request unavailable")
+	}
+	for _, request := range resp.FriendRequests {
+		if !friendApplyMatchesOperation([]*sdkws.FriendRequest{request}, from, to, opID) {
+			continue
+		}
+		// Never override a manual rejection or repeat an already accepted response.
+		if request.HandleResult != 0 {
+			return nil
+		}
+		_, err := respondFriendApply.Call(ctx, c.imApi, &relation.RespondFriendApplyReq{FromUserID: from, ToUserID: to, HandleResult: constant.FriendResponseAgree})
+		return err
+	}
+	return errs.ErrArgs.WrapMsg("friend request operation changed")
+}
