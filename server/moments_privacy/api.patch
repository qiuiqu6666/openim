+			return readErr
+		}
+		blocked, readErr = d.store.ListBlockedViewers(ctx, userID)
+		if readErr != nil {
+			return readErr
+		}
+		hidden, readErr = d.store.ListHiddenAuthors(ctx, userID)
+		return readErr
+	})
