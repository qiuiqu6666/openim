+++ b/pkg/common/storage/database/mgo/history_find_seqs_test.go
@@ -0,0 +1,26 @@
+package mgo
+
+import (
+	"context"
+	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/model"
+	"go.mongodb.org/mongo-driver/bson"
+	"go.mongodb.org/mongo-driver/mongo/integration/mtest"
+	"testing"
+)
+
+func TestFindSeqsRetriesUncommittedSlot(t *testing.T) {
+	mt := mtest.New(t, mtest.NewOptions().ClientType(mtest.Mock))
+	mt.Run("empty then durable", func(mt *mtest.T) {
+		db := &MsgMgo{coll: mt.Coll}
+		ns := mt.DB.Name() + "." + mt.Coll.Name()
+		mt.AddMockResponses(mtest.CreateCursorResponse(0, ns, mtest.FirstBatch, bson.D{{Key: "msgs", Value: bson.A{bson.M{"msg": nil, "revoke": nil, "del_list": bson.A{}, "is_read": false}}}}))
+		if rows, err := db.FindSeqs(context.Background(), "chat", []int64{5000}); err == nil || len(rows) != 0 {
+			mt.Fatal("uncommitted slot became deletion proof")
+		}
+		mt.AddMockResponses(mtest.CreateCursorResponse(0, ns, mtest.FirstBatch, bson.D{{Key: "msgs", Value: bson.A{&model.MsgInfoModel{Msg: &model.MsgDataModel{Seq: 5000, SendTime: 10, Content: "arrived"}}}}}))
+		rows, err := db.FindSeqs(context.Background(), "chat", []int64{5000})
+		if err != nil || len(rows) != 1 || rows[0].Msg.Content != "arrived" {
+			mt.Fatalf("retry did not recover: %+v %v", rows, err)
+		}
+	})
+}
diff --git a/pkg/common/storage/database/mgo/history_slot.go b/pkg/common/storage/database/mgo/history_slot.go
new file mode 100644
--- /dev/null
+++ b/pkg/common/storage/database/mgo/history_slot.go
@@ -0,0 +1,31 @@
+package mgo
+
+import (
+	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/model"
+	"github.com/openimsdk/protocol/constant"
+	"go.mongodb.org/mongo-driver/bson"
+	"go.mongodb.org/mongo-driver/bson/bsontype"
+)
+
+// A preallocated slot has msg/revoke/del_list/is_read fields, even when empty.
+// Legacy physical deletion replaced the entire slot with exactly {msg:null}.
+// Preserve this distinction before decoding; unknown absence is never a tombstone.
+func decodeHistorySlot(raw bson.Raw) (*model.MsgInfoModel, error) {
+	if len(raw) == 0 {
+		return nil, nil
+	}
+	var row model.MsgInfoModel
+	if err := bson.Unmarshal(raw, &row); err != nil {
+		return nil, err
+	}
+	fields, err := raw.Elements()
+	if err != nil {
+		return nil, err
+	}
+	marker, ok := raw.Lookup("history_deleted").BooleanOK()
+	legacy := len(fields) == 1 && fields[0].Key() == "msg" && fields[0].Value().Type == bsontype.Null
+	if row.Msg == nil && ((ok && marker) || legacy) {
+		row.Msg = &model.MsgDataModel{Status: constant.MsgStatusHasDeleted}
+	}
+	return &row, nil
+}
diff --git a/pkg/common/storage/database/mgo/history_slot_test.go b/pkg/common/storage/database/mgo/history_slot_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/common/storage/database/mgo/history_slot_test.go
@@ -0,0 +1,42 @@
+package mgo
+
+import (
+	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/model"
+	"github.com/openimsdk/protocol/constant"
+	"go.mongodb.org/mongo-driver/bson"
+	"testing"
+)
+
+func TestHistorySlotRequiresDeletionEvidence(t *testing.T) {
+	cases := []struct {
+		name    string
+		value   any
+		deleted bool
+	}{
+		{"preallocated", &model.MsgInfoModel{DelList: []string{}}, false},
+		{"unknown empty", bson.M{}, false},
+		{"revoke before body", &model.MsgInfoModel{Revoke: &model.RevokeModel{Time: 10}}, false},
+		{"legacy physical delete", bson.M{"msg": nil}, true},
+		{"explicit physical delete", bson.M{"msg": nil, "history_deleted": true}, true},
+		{"visible body", &model.MsgInfoModel{Msg: &model.MsgDataModel{Seq: 5000, SendTime: 10, Status: 2}}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			raw, err := bson.Marshal(tc.value)
+			if err != nil {
+				t.Fatal(err)
+			}
+			row, err := decodeHistorySlot(raw)
+			if err != nil {
+				t.Fatal(err)
+			}
+			deleted := row != nil && row.Msg != nil && row.Msg.Status >= constant.MsgStatusHasDeleted
+			if deleted != tc.deleted {
+				t.Fatalf("false coverage for %s: %+v", tc.name, row)
+			}
+		})
+	}
+	if row, err := decodeHistorySlot(nil); row != nil || err != nil {
+		t.Fatal("missing slot was fabricated")
+	}
+}
