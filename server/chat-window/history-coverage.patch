+package controller
+
+import (
+	"context"
+	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/cache"
+	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/model"
+	"github.com/openimsdk/protocol/constant"
+	"testing"
+)
+
+type incompleteHistoryCache struct {
+	cache.MsgCache
+	rows []*model.MsgInfoModel
+}
+
+func (c *incompleteHistoryCache) GetMessageBySeqs(context.Context, string, []int64) ([]*model.MsgInfoModel, error) {
+	return c.rows, nil
+}
+func TestMissingHistoryCannotProveDeletion(t *testing.T) {
+	c := &incompleteHistoryCache{}
+	db := &commonMsgDatabase{msgCache: c}
+	if _, err := db.GetMessageBySeqs(context.Background(), "chat", "self", []int64{5000}); err == nil {
+		t.Fatal("missing durable row was called deleted")
+	}
+	c.rows = []*model.MsgInfoModel{{Msg: &model.MsgDataModel{Seq: 5000, Status: constant.MsgStatusHasDeleted}}}
+	rows, err := db.GetMessageBySeqs(context.Background(), "chat", "self", []int64{5000})
+	if err != nil || len(rows) != 1 || rows[0].Status != constant.MsgStatusHasDeleted {
+		t.Fatalf("explicit tombstone rejected: %v %v", rows, err)
+	}
+}
