+package imapi
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/openimsdk/protocol/relation"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func (c *Caller) FriendApplyExistsForOperation(ctx context.Context, from, to, opID string) (bool, error) {
+	if opID == "" {
+		return false, nil
+	}
+	resp, err := designatedFriendApply.Call(ctx, c.imApi, &relation.GetDesignatedFriendsApplyReq{
+		FromUserID: from, ToUserID: to,
+	})
+	if err != nil || resp == nil {
+		return false, err
+	}
+	return friendApplyMatchesOperation(resp.FriendRequests, from, to, opID), nil
+}
+
+func friendApplyMatchesOperation(requests []*sdkws.FriendRequest, from, to, opID string) bool {
+	if opID == "" {
+		return false
+	}
+	for _, request := range requests {
+		if request == nil || request.FromUserID != from || request.ToUserID != to {
+			continue
+		}
+		var ex struct {
+			Op string `json:"op"`
+		}
+		if json.Unmarshal([]byte(request.Ex), &ex) == nil && ex.Op == opID {
+			return true
+		}
+	}
+	return false
+}
