+package imapi
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestBlacklistErrorSurvivesHTTPTransport(t *testing.T) {
+	for _, status := range []int{http.StatusOK, http.StatusForbidden} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.URL.Path != "/friend/add_friend" {
+				t.Errorf("unexpected path %s", r.URL.Path)
+			}
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(status)
+			fmt.Fprint(w, `{"errCode":1302,"errMsg":"BlockedByPeer","errDlt":"blocked"}`)
+		}))
+		err := New(server.URL, "", "").AddFriendApply(context.Background(), "A", "B", "hello", `{"op":"new"}`)
+		server.Close()
+		var coded errs.CodeError
+		if !errors.As(err, &coded) || coded.Code() != 1302 {
+			t.Fatalf("HTTP %d lost blacklist code: %v", status, err)
+		}
+	}
+}
+
+func TestFriendApplyOperationIdentity(t *testing.T) {
+	for _, tc := range []struct {
+		from, to, ex, op string
+		want             bool
+	}{
+		{"A", "B", `{"op":"new"}`, "new", true},
+		{"A", "B", `{"op":"old"}`, "new", false},
+		{"A", "B", `{}`, "new", false},
+		{"A", "B", `invalid`, "new", false},
+		{"B", "A", `{"op":"new"}`, "new", false},
+		{"A", "B", `{"op":""}`, "", false},
+	} {
+		requests := []*sdkws.FriendRequest{nil, {FromUserID: tc.from, ToUserID: tc.to, Ex: tc.ex}}
+		if got := friendApplyMatchesOperation(requests, "A", "B", tc.op); got != tc.want {
+			t.Fatalf("%+v got %v", tc, got)
+		}
+	}
+}
