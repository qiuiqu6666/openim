+package chat
+
+import (
+	"context"
+	"errors"
+
+	chatdb "github.com/openimsdk/chat/pkg/common/db/table/chat"
+	"github.com/openimsdk/tools/errs"
+)
+
+const friendBlockedCode = 1302
+
+func friendBlocked() error {
+	return errs.NewCodeError(friendBlockedCode, "BlockedByPeer").Wrap()
+}
+
+func isFriendBlocked(err error) bool {
+	var coded errs.CodeError
+	return errors.As(err, &coded) && coded.Code() == friendBlockedCode
+}
+
+// Check both directions, including retries of a previously successful grant.
+// Failure to read a blacklist must never become an application success.
+func (o *chatSvr) requireFriendPairUnblocked(ctx context.Context, row *chatdb.FriendGrant) error {
+	imCtx, err := o.withIMAdmin(ctx)
+	if err != nil {
+		return err
+	}
+	for _, pair := range [][2]string{
+		{row.ApplicantIMID, row.TargetIMID},
+		{row.TargetIMID, row.ApplicantIMID},
+	} {
+		blacks, err := o.IM.SpecifiedBlacks(imCtx, pair[0], []string{pair[1]})
+		if err != nil {
+			return err
+		}
+		if _, blocked := blacks[pair[1]]; blocked {
+			return friendBlocked()
+		}
+	}
+	return nil
+}
