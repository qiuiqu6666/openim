+package chat
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/chat/pkg/common/config"
+	"github.com/openimsdk/chat/pkg/common/db/database"
+	chatdb "github.com/openimsdk/chat/pkg/common/db/table/chat"
+	"github.com/openimsdk/chat/pkg/common/imapi"
+)
+
+type blacklistFlowDB struct {
+	database.ChatDatabaseInterface
+	states []string
+}
+
+func (d *blacklistFlowDB) TakeAttributeByUserID(context.Context, string) (*chatdb.Attribute, error) {
+	return openAttribute(), nil
+}
+func (d *blacklistFlowDB) ClaimFriendGrant(_ context.Context, grant, applicant, op string, now time.Time) (*chatdb.FriendGrant, error) {
+	return &chatdb.FriendGrant{Grant: grant, ApplicantIMID: applicant, TargetIMID: "B", Source: "account", OpID: op, ApplyState: chatdb.FriendGrantPending}, nil
+}
+func (d *blacklistFlowDB) SetFriendGrantState(_ context.Context, _ string, _ []string, state string) (bool, error) {
+	d.states = append(d.states, state)
+	return true, nil
+}
+
+type blacklistFlowIM struct {
+	imapi.CallerInterface
+	blockedOwner      string
+	queryErr, sendErr error
+	sent, lookups     int
+	operation         string
+	blockDuringSend   bool
+}
+
+func (i *blacklistFlowIM) ImAdminTokenWithDefaultAdmin(context.Context) (string, error) {
+	return "test", nil
+}
+func (i *blacklistFlowIM) SpecifiedBlacks(_ context.Context, owner string, peers []string) (map[string]struct{}, error) {
+	result := map[string]struct{}{}
+	if owner == i.blockedOwner {
+		result[peers[0]] = struct{}{}
+	}
+	return result, i.queryErr
+}
+func (i *blacklistFlowIM) AddFriendApply(_ context.Context, _, _, _, ex string) error {
+	i.sent++
+	var body struct {
+		Op string `json:"op"`
+	}
+	_ = json.Unmarshal([]byte(ex), &body)
+	if i.sendErr == nil {
+		i.operation = body.Op
+	}
+	if i.blockDuringSend {
+		i.blockedOwner = "B"
+	}
+	return i.sendErr
+}
+func (i *blacklistFlowIM) FriendApplyExistsForOperation(_ context.Context, _, _, op string) (bool, error) {
+	i.lookups++
+	return op != "" && op == i.operation, nil
+}
+func (i *blacklistFlowIM) FriendApplyExists(context.Context, string, string) (bool, error) {
+	panic("historical pair lookup must not authorize a new operation")
+}
+func newBlacklistFlow() (*chatSvr, *blacklistFlowIM, *blacklistFlowDB, *chatdb.FriendGrant) {
+	im, db := &blacklistFlowIM{}, &blacklistFlowDB{}
+	server := &chatSvr{IM: im, Database: db,
+		FriendGrant: config.FriendGrantConfig{ActiveKeyID: 1, Keys: []config.FriendGrantKey{{ID: 1, Secret: "test-only"}}}}
+	row := &chatdb.FriendGrant{Grant: "grant", ApplicantIMID: "A", TargetIMID: "B",
+		Source: "account", ApplyState: chatdb.FriendGrantUnused, ExpireAt: time.Now().Add(time.Minute)}
+	return server, im, db, row
+}
+func TestFriendBlacklistFullApplicationFlow(t *testing.T) {
+	s, im, _, row := newBlacklistFlow()
+	im.blockedOwner = "B"
+	if resp, err := s.continueFriendApply(context.Background(), row, "hello"); resp != nil || !isFriendBlocked(err) || im.sent != 0 {
+		t.Fatalf("blocked submission: %+v %v sent=%d", resp, err, im.sent)
+	}
+	im.blockedOwner = ""
+	if resp, err := s.continueFriendApply(context.Background(), row, "hello"); err != nil || resp.ApplyState != chatdb.FriendGrantSuccess || im.sent != 1 {
+		t.Fatalf("unblocked submission: %+v %v", resp, err)
+	}
+	row.ApplyState = chatdb.FriendGrantSuccess
+	im.blockedOwner = "B"
+	if resp, err := s.continueFriendApply(context.Background(), row, "retry"); resp != nil || !isFriendBlocked(err) {
+		t.Fatalf("cached success bypassed blacklist: %+v %v", resp, err)
+	}
+}
+func TestBlockedErrorWinsOverHistoricalApplication(t *testing.T) {
+	s, im, db, row := newBlacklistFlow()
+	im.operation = "old-operation"
+	im.sendErr = fmt.Errorf("upstream: %w", friendBlocked())
+	resp, err := s.continueFriendApply(context.Background(), row, "hello")
+	if resp != nil || !isFriendBlocked(err) || im.lookups != 0 {
+		t.Fatalf("lost blacklist error: %+v %v lookups=%d", resp, err, im.lookups)
+	}
+	if len(db.states) != 1 || db.states[0] != chatdb.FriendGrantFailed {
+		t.Fatal(db.states)
+	}
+}
+func TestBlacklistAllRetryStatesAndQueryFailure(t *testing.T) {
+	for _, state := range []string{chatdb.FriendGrantUnused, chatdb.FriendGrantPending, chatdb.FriendGrantUnknown, chatdb.FriendGrantSuccess, chatdb.FriendGrantFailed} {
+		for _, owner := range []string{"A", "B"} {
+			s, im, _, row := newBlacklistFlow()
+			row.ApplyState, im.blockedOwner = state, owner
+			if resp, err := s.continueFriendApply(context.Background(), row, "retry"); resp != nil || !isFriendBlocked(err) {
+				t.Fatalf("%s/%s: %+v %v", state, owner, resp, err)
+			}
+		}
+	}
+	s, im, _, row := newBlacklistFlow()
+	im.queryErr = errors.New("lookup failed")
+	if resp, err := s.continueFriendApply(context.Background(), row, "hello"); resp != nil || err == nil || im.sent != 0 {
+		t.Fatal(resp, err)
+	}
+}
+func TestConcurrentBlockAndOldRequestCannotReportSuccess(t *testing.T) {
+	s, im, _, row := newBlacklistFlow()
+	im.blockDuringSend = true
+	if resp, err := s.continueFriendApply(context.Background(), row, "hello"); resp != nil || !isFriendBlocked(err) {
+		t.Fatal(resp, err)
+	}
+	s, im, _, row = newBlacklistFlow()
+	im.operation, im.sendErr = "old-operation", errors.New("connection lost")
+	if resp, err := s.continueFriendApply(context.Background(), row, "hello"); resp != nil || err == nil {
+		t.Fatal(resp, err)
+	}
+	row.ApplyState, row.OpID = chatdb.FriendGrantUnknown, "new-operation"
+	if resp, err := s.continueFriendApply(context.Background(), row, "retry"); resp != nil || err == nil {
+		t.Fatal(resp, err)
+	}
+	im.operation = "new-operation"
+	if resp, err := s.continueFriendApply(context.Background(), row, "retry"); err != nil || resp.ApplyState != chatdb.FriendGrantSuccess {
+		t.Fatal(resp, err)
+	}
+}
