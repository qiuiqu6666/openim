@@ -0,0 +1,36 @@
+package relationshippolicy
+
+import (
+	"context"
+
+	"github.com/openimsdk/open-im-server/v3/pkg/common/servererrs"
+)
+
+type PairLookup func(context.Context, string, string) (bool, bool, error)
+type FriendLookup func(context.Context, string, string) (bool, error)
+
+// Friend requests and approvals never change or bypass a blacklist.
+func RequireUnblocked(ctx context.Context, lookup PairLookup, a, b string) error {
+	left, right, err := lookup(ctx, a, b)
+	if err != nil {
+		return err
+	}
+	if left || right {
+		return servererrs.ErrBlockedByPeer.Wrap()
+	}
+	return nil
+}
+
+// Both directed friend edges must exist, including after a unilateral delete.
+func RequireMutual(ctx context.Context, lookup FriendLookup, a, b string) error {
+	for _, pair := range [][2]string{{a, b}, {b, a}} {
+		ok, err := lookup(ctx, pair[0], pair[1])
+		if err != nil {
+			return err
+		}
+		if !ok {
+			return servererrs.ErrNotPeersFriend.Wrap()
+		}
+	}
+	return nil
+}
