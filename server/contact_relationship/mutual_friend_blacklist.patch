@@ -0,0 +1,60 @@
+package relationshippolicy
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestMutualFriendMatrix(t *testing.T) {
+	for _, ab := range []bool{false, true} {
+		for _, ba := range []bool{false, true} {
+			for _, reverse := range []bool{false, true} {
+				a, b := "A", "B"
+				if reverse {
+					a, b = b, a
+				}
+				err := RequireMutual(context.Background(), func(_ context.Context, from, to string) (bool, error) {
+					if from == "A" && to == "B" {
+						return ab, nil
+					}
+					if from == "B" && to == "A" {
+						return ba, nil
+					}
+					t.Fatalf("unexpected pair %s %s", from, to)
+					return false, nil
+				}, a, b)
+				if (err == nil) != (ab && ba) {
+					t.Fatalf("edges %v/%v reverse %v: %v", ab, ba, reverse, err)
+				}
+			}
+		}
+	}
+}
+
+func TestBlacklistMatrix(t *testing.T) {
+	for _, left := range []bool{false, true} {
+		for _, right := range []bool{false, true} {
+			err := RequireUnblocked(context.Background(), func(context.Context, string, string) (bool, bool, error) {
+				return left, right, nil
+			}, "A", "B")
+			if (err == nil) != (!left && !right) {
+				t.Fatalf("blacklist %v/%v: %v", left, right, err)
+			}
+		}
+	}
+}
+
+func TestLookupFailureNeverGrantsPermission(t *testing.T) {
+	want := errors.New("relation unavailable")
+	if err := RequireMutual(context.Background(), func(context.Context, string, string) (bool, error) {
+		return true, want
+	}, "A", "B"); err != want {
+		t.Fatal(err)
+	}
+	if err := RequireUnblocked(context.Background(), func(context.Context, string, string) (bool, bool, error) {
+		return false, false, want
+	}, "A", "B"); err != want {
+		t.Fatal(err)
+	}
+}
