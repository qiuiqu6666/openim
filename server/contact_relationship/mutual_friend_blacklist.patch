+package relation
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/controller"
+	"github.com/openimsdk/protocol/constant"
+	"github.com/openimsdk/protocol/relation"
+	"github.com/openimsdk/tools/mcontext"
+)
+
+type blockedPair struct {
+	controller.BlackDatabase
+	left, right bool
+	err         error
+}
+
+func (b blockedPair) CheckIn(context.Context, string, string) (bool, bool, error) {
+	return b.left, b.right, b.err
+}
+
+func TestBlacklistedRequestsNeverWriteRelationships(t *testing.T) {
+	for _, pair := range []blockedPair{
+		{left: true}, {right: true}, {left: true, right: true},
+		{err: errors.New("blacklist unavailable")},
+	} {
+		// Nil friend DB, user client and notification sender deliberately catch
+		// any attempt to continue or mutate relations after a rejected check.
+		s := &friendServer{config: &Config{}, blackDatabase: pair}
+		if _, err := s.ApplyToAddFriend(
+			mcontext.WithOpUserIDContext(context.Background(), "A"),
+			&relation.ApplyToAddFriendReq{FromUserID: "A", ToUserID: "B"},
+		); err == nil {
+			t.Fatal("blocked request accepted")
+		}
+		if _, err := s.RespondFriendApply(
+			mcontext.WithOpUserIDContext(context.Background(), "B"),
+			&relation.RespondFriendApplyReq{
+				FromUserID: "A", ToUserID: "B", HandleResult: constant.FriendResponseAgree,
+			},
+		); err == nil {
+			t.Fatal("blocked approval accepted")
+		}
+	}
+}
