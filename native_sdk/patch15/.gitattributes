ios-core-source/** text=auto eol=lf
*.patch -text -whitespace
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
ios-core-source/*.sqlite -text
# The manifest hashes every source byte. Git must not rewrite this snapshot's
# existing line endings on add/checkout across Windows and macOS.
core-source/** -text
# This locked descriptor is hashed byte-for-byte; preserve its exact newline.
core-source/version/version -text -whitespace
