+//go:build !js
+
+package interaction
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestReconnectBackoffDoesNotWrapAndResetIsExplicit(t *testing.T) {
+	r := NewExponentialRetry()
+	for i := 0; i < 100; i++ {
+		d := r.GetSleepInterval()
+		if i >= 5 && (d < 15*time.Second || d > 30*time.Second) {
+			t.Fatalf("sustained failure returned to fast retry: attempt=%d delay=%v", i, d)
+		}
+	}
+	r.Reset()
+	if d := r.GetSleepInterval(); d < 500*time.Millisecond || d > time.Second {
+		t.Fatal(d)
+	}
+}
+
+func TestRecoveryWaitCancelledAndWakeCoalesced(t *testing.T) {
+	c := &LongConnMgr{}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if c.waitReconnect(ctx, time.Hour) {
+		t.Fatal("cancelled session retried")
+	}
+	for i := 0; i < 1000; i++ {
+		c.wakeReconnect()
+	}
+	if len(c.recoverySignal()) != 1 {
+		t.Fatal("wake events not coalesced")
+	}
+	if !c.waitReconnect(context.Background(), time.Hour) {
+		t.Fatal("wake ignored")
+	}
+	if len(c.recoverySignal()) != 0 {
+		t.Fatal("wake not consumed")
+	}
+}
+
+func TestForegroundInterruptsBackgroundBackoff(t *testing.T) {
+	c := &LongConnMgr{}
+	c.SetBackground(true)
+	done := make(chan bool, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	go func() { done <- c.waitReconnect(ctx, time.Minute) }()
+	c.SetBackground(false)
+	if !<-done {
+		t.Fatal("foreground did not wake reconnect")
+	}
+}
+
+func TestNativeDialHonorsSessionCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	d := NewWebSocket(0)
+	_, err := dialSession(ctx, d, "ws://127.0.0.1:1")
+	if err == nil || !d.IsNil() {
+		t.Fatal("cancelled dial opened a socket")
+	}
+}
diff --git a/internal/interaction/connection_request_lifetime.go b/internal/interaction/connection_request_lifetime.go
new file mode 100644
index 00000000..cfe09eb2
--- /dev/null
+++ b/internal/interaction/connection_request_lifetime.go
@@ -0,0 +1,28 @@
+package interaction
+
+// requestConnectionDone binds a response wait to the socket used for its write.
+// The caller holds connWrite, so a redial cannot replace the socket in between.
+func (c *LongConnMgr) requestConnectionDone() <-chan struct{} {
+	c.w.Lock()
+	defer c.w.Unlock()
+	if c.connectionDone == nil {
+		c.connectionDone = make(chan struct{})
+		if c.connStatus != Connected {
+			close(c.connectionDone)
+		}
+	}
+	return c.connectionDone
+}
+
+// endConnectionRequestsLocked does not retry sent messages: the caller still
+// receives the normal network error and owns any idempotent recovery policy.
+func (c *LongConnMgr) endConnectionRequestsLocked() {
+	if c.connectionDone == nil {
+		return
+	}
+	select {
+	case <-c.connectionDone:
+	default:
+		close(c.connectionDone)
+	}
+}
diff --git a/internal/interaction/connection_request_lifetime_test.go b/internal/interaction/connection_request_lifetime_test.go
new file mode 100644
index 00000000..853d6fb5
--- /dev/null
+++ b/internal/interaction/connection_request_lifetime_test.go
@@ -0,0 +1,164 @@
+package interaction
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+// Only the transport boundary is faked; requests use the real response router.
+type lifetimeTransport struct {
+	LongConn
+	written chan struct{}
+	onWrite func()
+}
+
+func (c *lifetimeTransport) WriteMessage(int, []byte) error {
+	c.written <- struct{}{}
+	if c.onWrite != nil {
+		c.onWrite()
+	}
+	return nil
+}
+func (c *lifetimeTransport) SetWriteDeadline(time.Duration) error { return nil }
+func (c *lifetimeTransport) Close() error                         { return nil }
+
+func lifetimeManager(t *testing.T) (*LongConnMgr, *lifetimeTransport) {
+	t.Helper()
+	transport := &lifetimeTransport{written: make(chan struct{}, 8)}
+	c := &LongConnMgr{ctx: recoveryContext(t), conn: transport, connWrite: new(sync.Mutex),
+		Syncer: NewWsRespAsyn(), encoder: NewGobEncoder()}
+	c.SetConnectionStatus(Connected)
+	return c, transport
+}
+
+func TestAcknowledgedRequestSurvivesImmediateDisconnect(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	request := &GeneralWsReq{ReqIdentifier: constant.SendMsg}
+	transport.onWrite = func() {
+		if err := c.Syncer.NotifyResp(c.ctx, GeneralWsResp{MsgIncr: request.MsgIncr, Data: []byte("ack")}); err != nil {
+			t.Fatal(err)
+		}
+		_ = c.close()
+	}
+	response, err := c.sendAndWaitResp(c.ctx, request)
+	if err != nil || response == nil || string(response.Data) != "ack" {
+		t.Fatalf("lost acknowledged send on closure: response=%v error=%v", response, err)
+	}
+}
+
+func TestForegroundConfirmationRunsAfterDisconnectedQueuedRequest(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	ctx, cancel := context.WithCancel(c.ctx)
+	defer cancel()
+	old := Message{Ctx: ctx, Message: GeneralWsReq{ReqIdentifier: constant.PullMsgByRange}, Resp: make(chan *GeneralWsResp, 1)}
+	foreground := Message{Ctx: ctx, Message: GeneralWsReq{ReqIdentifier: constant.SetBackgroundStatus}, Resp: make(chan *GeneralWsResp, 1)}
+	resume := make(chan struct{})
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		c.dispatchMessage(old)
+		<-resume
+		c.dispatchMessage(foreground)
+	}()
+	<-transport.written
+	_ = c.close()
+	c.SetConnectionStatus(Connected)
+	close(resume)
+	select {
+	case <-transport.written:
+	case <-time.After(300 * time.Millisecond):
+		cancel()
+		<-finished
+		t.Fatal("foreground confirmation stayed behind a disconnected history request")
+	}
+	c.Syncer.wsMutex.RLock()
+	var id string
+	for key := range c.Syncer.wsNotification {
+		id = key
+	}
+	c.Syncer.wsMutex.RUnlock()
+	if id == "" {
+		t.Fatal("foreground request missing")
+	}
+	if err := c.Syncer.NotifyResp(ctx, GeneralWsResp{MsgIncr: id}); err != nil {
+		t.Fatal(err)
+	}
+	<-finished
+	if response := <-old.Resp; response.ErrCode == 0 {
+		t.Fatal("disconnected request reported success")
+	}
+	if response := <-foreground.Resp; response.ErrCode != 0 {
+		t.Fatalf("foreground confirmation failed: %v", response)
+	}
+}
+
+func TestDisconnectedRequestReleasesForegroundQueue(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	ctx, cancel := context.WithCancel(c.ctx)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := c.sendAndWaitResp(ctx, &GeneralWsReq{ReqIdentifier: constant.SetBackgroundStatus})
+		done <- err
+	}()
+	<-transport.written
+	if err := c.close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("disconnected request reported success")
+		}
+	case <-time.After(300 * time.Millisecond):
+		cancel()
+		<-done
+		t.Fatal("old socket request still blocks foreground recovery after disconnect")
+	}
+	if len(c.Syncer.wsNotification) != 0 {
+		t.Fatal("response registration leaked")
+	}
+}
+
+func TestRecoveredConnectionDoesNotInheritOldRequestWait(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	ctx, cancel := context.WithCancel(c.ctx)
+	defer cancel()
+	oldDone := make(chan error, 1)
+	go func() {
+		_, err := c.sendAndWaitResp(ctx, &GeneralWsReq{ReqIdentifier: constant.SetBackgroundStatus})
+		oldDone <- err
+	}()
+	<-transport.written
+	_ = c.close()
+	c.SetConnectionStatus(Connected)
+	select {
+	case err := <-oldDone:
+		if err == nil {
+			t.Fatal("old request succeeded on replacement connection")
+		}
+	case <-time.After(300 * time.Millisecond):
+		cancel()
+		<-oldDone
+		t.Fatal("replacement connection hid the old socket closure")
+	}
+	request := &GeneralWsReq{ReqIdentifier: constant.GetNewestSeq}
+	newDone := make(chan error, 1)
+	go func() { _, err := c.sendAndWaitResp(ctx, request); newDone <- err }()
+	<-transport.written
+	select {
+	case err := <-newDone:
+		t.Fatalf("new request inherited old cancellation: %v", err)
+	default:
+	}
+	if err := c.Syncer.NotifyResp(ctx, GeneralWsResp{MsgIncr: request.MsgIncr}); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-newDone; err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/interaction/connection_telemetry.go b/internal/interaction/connection_telemetry.go
new file mode 100644
index 00000000..8ad857a1
--- /dev/null
+++ b/internal/interaction/connection_telemetry.go
@@ -0,0 +1,58 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"github.com/openimsdk/tools/log"
+	"net"
+	"sync/atomic"
+	"time"
+)
+
+type connectionTelemetry struct {
+	attempts       atomic.Int64
+	connectedAt    atomic.Int64
+	lastPing       atomic.Int64
+	lastPong       atomic.Int64
+	lastMessage    atomic.Int64
+	lastDisconnect atomic.Int64
+}
+
+func observedConnectionError(err error) string {
+	var dns *net.DNSError
+	if errors.As(err, &dns) {
+		return "dns_error"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "session_cancelled"
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return "transport_timeout"
+	}
+	return "transport_error"
+}
+
+func (m *connectionTelemetry) connected(ctx context.Context, background bool) {
+	now := time.Now().UnixMilli()
+	m.connectedAt.Store(now)
+	m.lastPing.Store(0)
+	m.lastPong.Store(0)
+	m.lastMessage.Store(0)
+	var recoveryMS int64
+	if disconnected := m.lastDisconnect.Load(); disconnected > 0 {
+		recoveryMS = now - disconnected
+	}
+	log.ZInfo(ctx, "connection_recovered", "connectedAtMs", now, "attempts", m.attempts.Swap(0), "recoveryMs", recoveryMS, "background", background)
+}
+
+func (m *connectionTelemetry) disconnected(ctx context.Context, err error, background bool) {
+	now := time.Now().UnixMilli()
+	m.lastDisconnect.Store(now)
+	code, received := transportCloseCode(err)
+	log.ZWarn(ctx, "connection_disconnected", err,
+		"disconnectedAtMs", now, "connectedAtMs", m.connectedAt.Load(),
+		"observedError", observedConnectionError(err), "confirmedReason", "unknown",
+		"closeCode", code, "closeFrameReceived", received, "background", background,
+		"lastPingAtMs", m.lastPing.Load(), "lastPongAtMs", m.lastPong.Load(), "lastMessageAtMs", m.lastMessage.Load())
+}
