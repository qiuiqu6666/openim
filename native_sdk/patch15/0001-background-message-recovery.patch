@@ -0,0 +1,272 @@
+package interaction
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestAllConversationPreviewsPrecedeRecentHistory(t *testing.T) {
+	for _, initial := range []bool{false, true} {
+		t.Run(fmt.Sprint("initial=", initial), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, db: &recoveryVersionDB{installed: !initial}, reinstalled: initial,
+				longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+			targets := map[string]int64{"si_peer": 1000, "si_other": 1000}
+			for n := 0; n < 205; n++ {
+				targets[fmt.Sprintf("sg_%03d", n)] = 1000
+			}
+			var mu sync.Mutex
+			visible := make(map[string]bool)
+			stored := make(map[string]map[int64]bool)
+			previewRequests, historyRequests := 0, 0
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				var packets map[string]*sdkws.PullMsgs
+				if initial {
+					packets = cmd.Value.(sdk_struct.CmdMsgSyncInReinstall).Msgs
+				} else {
+					packets = cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs
+				}
+				mu.Lock()
+				defer mu.Unlock()
+				for id, packet := range packets {
+					if stored[id] == nil {
+						stored[id] = make(map[int64]bool)
+					}
+					for _, row := range packet.Msgs {
+						if stored[id][row.Seq] {
+							t.Errorf("duplicate recovery of %s/%d", id, row.Seq)
+						}
+						stored[id][row.Seq] = true
+						if row.Seq == 1000 {
+							visible[id] = true
+						}
+					}
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				pull := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+					panic(err)
+				}
+				resp := &sdkws.PullMessageBySeqsResp{Msgs: make(map[string]*sdkws.PullMsgs)}
+				preview := true
+				for _, r := range pull.SeqRanges {
+					preview = preview && r.Begin == 1000 && r.End == 1000 && r.Num == 1
+				}
+				mu.Lock()
+				if preview {
+					previewRequests++
+					if len(pull.SeqRanges) > 100 {
+						t.Error("unbounded preview batch")
+					}
+					if previewRequests == 1 {
+						foundSingle, foundGroup := false, false
+						for _, r := range pull.SeqRanges {
+							foundSingle = foundSingle || r.ConversationID == "si_peer" || r.ConversationID == "si_other"
+							foundGroup = foundGroup || r.ConversationID == "sg_000"
+						}
+						if !foundSingle || !foundGroup {
+							t.Error("first preview batch delayed one conversation type")
+						}
+					}
+				} else {
+					historyRequests++
+					if len(pull.SeqRanges) > 8 {
+						t.Error("unbounded history transport batch")
+					}
+					if len(visible) != len(targets) {
+						t.Errorf("history started with only %d/%d visible conversations", len(visible), len(targets))
+					}
+				}
+				mu.Unlock()
+				for _, r := range pull.SeqRanges {
+					if r.Begin < 901 || r.End > 1000 || r.Num != r.End-r.Begin+1 {
+						t.Errorf("unbounded recent range: %v", r)
+					}
+					var seqs []int64
+					for seq := r.Begin; seq <= r.End; seq++ {
+						seqs = append(seqs, seq)
+					}
+					resp.Msgs[r.ConversationID] = recoveryMsgs(r.ConversationID, seqs...)[r.ConversationID]
+				}
+				return wireResponse(resp)
+			})
+			if err := m.compareSeqsAndBatchSync(ctx, targets, 1); err != nil {
+				t.Fatal(err)
+			}
+			wantHistory := (len(targets) + 7) / 8
+			if previewRequests != 3 || historyRequests != wantHistory {
+				t.Fatalf("preview/history requests: %d/%d", previewRequests, historyRequests)
+			}
+			for id := range targets {
+				if len(stored[id]) != 100 || m.syncedMaxSeqs[id] != 0 || !m.messageAlreadyCovered(id, 1000) {
+					t.Fatalf("wrong recovered coverage for %s: %+v", id, m.checkpoints[id])
+				}
+			}
+		})
+	}
+}
+
+// A server fixture returns exactly the requested sequences for every chat.
+func requestedRecoveryResponse(t *testing.T, req Message) *GeneralWsResp {
+	t.Helper()
+	pull := &sdkws.PullMessageBySeqsReq{}
+	if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+		panic(err)
+	}
+	resp := &sdkws.PullMessageBySeqsResp{Msgs: make(map[string]*sdkws.PullMsgs), NotificationMsgs: make(map[string]*sdkws.PullMsgs)}
+	for _, r := range pull.SeqRanges {
+		var seqs []int64
+		for seq := r.Begin; seq <= r.End; seq++ {
+			seqs = append(seqs, seq)
+		}
+		packet := recoveryMsgs(r.ConversationID, seqs...)[r.ConversationID]
+		if IsNotification(r.ConversationID) {
+			resp.NotificationMsgs[r.ConversationID] = packet
+		} else {
+			resp.Msgs[r.ConversationID] = packet
+		}
+	}
+	return wireResponse(resp)
+}
+
+func TestLatestPreviewHistoryFailureRetainsGapsForRestart(t *testing.T) {
+	ctx := recoveryContext(t)
+	d := &recoveryVersionDB{installed: true}
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, db: d, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"si_peer": 100}}
+	stopHistory := fmt.Errorf("history unavailable")
+	receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		pull := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+			panic(err)
+		}
+		r := pull.SeqRanges[0]
+		if r.Begin == 1000 && r.End == 1000 {
+			return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("si_peer", 1000)})
+		}
+		return &GeneralWsResp{ErrCode: 10001, ErrMsg: stopHistory.Error()}
+	})
+	if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"si_peer": 1000}, 1); err == nil {
+		t.Fatal("failed history reported complete")
+	}
+	restarted := &MsgSyncer{db: d, syncedMaxSeqs: map[string]int64{"si_peer": 1000}}
+	if err := restarted.loadMessageCheckpoints(ctx, []string{"si_peer"}); err != nil {
+		t.Fatal(err)
+	}
+	if restarted.syncedMaxSeqs["si_peer"] != 100 || !restarted.messageAlreadyCovered("si_peer", 1000) {
+		t.Fatal("latest preview falsely completed old gaps")
+	}
+	missing := restarted.recentMissingRanges("si_peer", [2]int64{101, 1000})
+	if len(missing) != 1 || missing[0] != [2]int64{901, 999} {
+		t.Fatalf("restart lost recent history: %v", missing)
+	}
+}
+
+func TestDeletedTailRestoresLastValidPreviewBeforeHistory(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, db: &recoveryVersionDB{installed: true}, longConnMgr: conn,
+		conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"si_peer": 950}}
+	var visible bool
+	validReads := 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		for _, packet := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+			for _, row := range packet.Msgs {
+				if row.Seq == 100 && row.Status != constant.MsgStatusHasDeleted {
+					visible = true
+				}
+			}
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.PullConvLastMessage {
+			validReads++
+			return wireResponse(&msg.GetLastMessageResp{Msgs: map[string]*sdkws.MsgData{"si_peer": {Seq: 100, Status: constant.MsgStatusSendSuccess}}})
+		}
+		pull := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+			panic(err)
+		}
+		resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+		for _, r := range pull.SeqRanges {
+			if r.Begin < r.End && !visible {
+				t.Error("history preceded last valid preview")
+			}
+			packet := &sdkws.PullMsgs{}
+			for seq := r.Begin; seq <= r.End; seq++ {
+				packet.Msgs = append(packet.Msgs, &sdkws.MsgData{Seq: seq, Status: constant.MsgStatusHasDeleted})
+			}
+			resp.Msgs[r.ConversationID] = packet
+		}
+		return wireResponse(resp)
+	})
+	if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"si_peer": 1000}, 1); err != nil {
+		t.Fatal(err)
+	}
+	if !visible || validReads != 1 || m.syncedMaxSeqs["si_peer"] != 1000 {
+		t.Fatal("deleted tail hid the remaining valid conversation")
+	}
+}
+
+func TestFailedLatestPreviewDoesNotHideOtherConversations(t *testing.T) {
+	for _, failure := range []string{"transport", "missing", "storage"} {
+		t.Run(failure, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+			goodRows := 0
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				packets := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs
+				if packets["si_bad"] != nil && failure == "storage" {
+					return fmt.Errorf("bad message cannot be saved")
+				}
+				if packets["sg_good"] != nil {
+					goodRows += len(packets["sg_good"].Msgs)
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				pull := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+					panic(err)
+				}
+				resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+				for _, r := range pull.SeqRanges {
+					if r.ConversationID == "si_bad" {
+						if failure == "transport" {
+							return &GeneralWsResp{ErrCode: 10001, ErrMsg: "bad conversation unavailable"}
+						}
+						if failure == "missing" {
+							continue
+						}
+					}
+					var seqs []int64
+					for seq := r.Begin; seq <= r.End; seq++ {
+						seqs = append(seqs, seq)
+					}
+					resp.Msgs[r.ConversationID] = recoveryMsgs(r.ConversationID, seqs...)[r.ConversationID]
+				}
+				return wireResponse(resp)
+			})
+			if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"si_bad": 1000, "sg_good": 1000}, 1); err == nil {
+				t.Fatal("failed preview reported complete")
+			}
+			if goodRows != 100 || !m.messageAlreadyCovered("sg_good", 1000) || m.messageAlreadyCovered("si_bad", 1000) || m.checkpoints["si_bad"].Target != 1000 {
+				t.Fatalf("failure lost isolation/targets: rows=%d states=%+v", goodRows, m.checkpoints)
+			}
+		})
+	}
+}
diff --git a/internal/interaction/msg_sync_metadata.go b/internal/interaction/msg_sync_metadata.go
new file mode 100644
index 00000000..4c44d976
--- /dev/null
+++ b/internal/interaction/msg_sync_metadata.go
@@ -0,0 +1,85 @@
+package interaction
+
+import (
+	"context"
+	"github.com/openimsdk/tools/log"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+)
+
+const cmdSyncAuxiliaryMetadata = "syncAuxiliaryMetadata"
+
+func (m *MsgSyncer) finishMessageRecovery(ctx context.Context) {
+	if ctx.Err() != nil {
+		return
+	}
+	if m.recvCh == nil {
+		// Standalone callers without the recovery scheduler keep joined work.
+		if err := m.syncMetadataAfterMessages(ctx); err != nil {
+			m.reportMessageSyncFailure(ctx, err)
+			return
+		}
+	}
+	common.TriggerCmdSyncFlag(m.ctx, constant.MsgSyncEnd, m.conversationCh)
+	m.requestAuxiliaryMetadata()
+}
+
+func (m *MsgSyncer) requestAuxiliaryMetadata() {
+	if m.recvCh == nil {
+		return
+	}
+	if !m.auxMetadataPending {
+		m.auxMetadataProgress = &common.MetadataProgress{}
+	}
+	m.auxProfilesOnly = false
+	m.auxMetadataPending = true
+	m.queuePendingAuxiliaryMetadata()
+}
+
+func (m *MsgSyncer) queuePendingAuxiliaryMetadata() {
+	if !m.auxMetadataPending || m.recvCh == nil || m.ctx.Err() != nil {
+		return
+	}
+	select {
+	case m.recvCh <- common.Cmd2Value{Ctx: common.WithPreparedRecoveryMetadata(m.ctx), Cmd: cmdSyncAuxiliaryMetadata}:
+	default:
+	}
+}
+
+func (m *MsgSyncer) doAuxiliaryMetadataSync(ctx context.Context) {
+	if !m.auxMetadataPending {
+		return
+	}
+	ctx = common.WithMetadataProgress(ctx, m.auxMetadataProgress)
+	before := m.auxMetadataProgress.Checkpoints()
+	var err error
+	if m.auxProfilesOnly {
+		err = common.SendSyncCmdWithReceipt(ctx, common.Cmd2Value{Cmd: common.CmdSyncMissingProfiles}, m.conversationCh)
+	} else {
+		err = m.syncMetadataAfterMessages(ctx)
+	}
+	if owner, ok := ctx.Value(messagePageContextKey{}).(*messagePageCoordinator); ok {
+		owner.committed.Add(m.auxMetadataProgress.Checkpoints() - before)
+	}
+	if err != nil {
+		// Retry on the same serialized scheduler. Auxiliary profile failures
+		// never turn already committed messages into a failed network recovery.
+		recordMessageSyncFailure(ctx, err)
+		log.ZWarn(ctx, "auxiliary metadata synchronization deferred", err)
+		return
+	}
+	m.auxMetadataPending = false
+	m.auxMetadataProgress = nil
+}
+
+// Keep metadata failures visible and retryable, but only after offline messages
+// have been persisted and published. The existing interruptible conversation
+// worker owns this work; no untracked goroutine can outlive the login session.
+func (m *MsgSyncer) syncMetadataAfterMessages(ctx context.Context) error {
+	return common.SendSyncCmdWithReceipt(ctx, common.Cmd2Value{
+		Cmd:   constant.CmdSyncData,
+		Value: sdk_struct.CmdNewMsgComeToConversation{},
+	}, m.conversationCh)
+}
diff --git a/internal/interaction/msg_sync_metadata_fairness_test.go b/internal/interaction/msg_sync_metadata_fairness_test.go
new file mode 100644
index 00000000..d1991f6a
--- /dev/null
+++ b/internal/interaction/msg_sync_metadata_fairness_test.go
@@ -0,0 +1,202 @@
+package interaction
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+type metadataFairWorker struct {
+	queue     chan common.Cmd2Value
+	started   chan struct{}
+	completed chan struct{}
+	updates   atomic.Int32
+}
+
+func (w *metadataFairWorker) GetCh() chan common.Cmd2Value { return w.queue }
+func (w *metadataFairWorker) InterruptibleCommand(c common.Cmd2Value) bool {
+	return c.Cmd == constant.CmdSyncData
+}
+func (w *metadataFairWorker) Work(c common.Cmd2Value) {
+	if c.Cmd != constant.CmdSyncData {
+		w.updates.Add(1)
+		return
+	}
+	finish := common.BeginMetadataBatch(c.Ctx)
+	defer finish()
+	w.started <- struct{}{}
+	select {
+	case <-time.After(250 * time.Millisecond):
+		w.completed <- struct{}{}
+		c.Receipt <- nil
+	case <-c.Ctx.Done():
+		c.Receipt <- c.Ctx.Err()
+	}
+}
+
+func TestMetadataSweepMakesProgressAcrossBusyRetries(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	input := make(chan common.Cmd2Value, 128)
+	m := &MsgSyncer{ctx: ctx, recvCh: input, conversationCh: make(chan common.Cmd2Value)}
+	var committed atomic.Int32
+	var attempts atomic.Int32
+	var live atomic.Int32
+	finished := make(chan struct{}, 1)
+	ids := []string{"0", "1", "2", "3", "4", "5", "6", "7"}
+	receiptWorker(t, m.conversationCh, func(c common.Cmd2Value) error {
+		for _, id := range common.PendingMetadataItems(c.Ctx, "test-groups", ids) {
+			finish := common.BeginMetadataBatch(c.Ctx)
+			select {
+			case <-c.Ctx.Done():
+				finish()
+				return c.Ctx.Err()
+			case <-time.After(180 * time.Millisecond):
+				common.CompleteMetadataItem(c.Ctx, "test-groups", id)
+				committed.Add(1)
+				finish()
+			}
+		}
+		finished <- struct{}{}
+		return nil
+	})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(c common.Cmd2Value) {
+			if c.Cmd == cmdSyncAuxiliaryMetadata {
+				attempts.Add(1)
+				m.doAuxiliaryMetadataSync(c.Ctx)
+			} else {
+				live.Add(1)
+			}
+		})
+	}()
+	producerDone := make(chan struct{})
+	go func() {
+		defer close(producerDone)
+		ticker := time.NewTicker(5 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				select {
+				case input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}:
+				case <-ctx.Done():
+					return
+				}
+			}
+		}
+	}()
+	defer func() { cancel(); <-producerDone; <-done }()
+	m.requestAuxiliaryMetadata()
+	select {
+	case <-finished:
+	case <-time.After(6 * time.Second):
+		t.Fatalf("sweep starved: committed=%d attempts=%d", committed.Load(), attempts.Load())
+	}
+	if committed.Load() != 8 || attempts.Load() < 2 || live.Load() == 0 {
+		t.Fatalf("committed=%d attempts=%d live=%d", committed.Load(), attempts.Load(), live.Load())
+	}
+}
+
+func TestBoundedMetadataCompletesUnderBothBusySchedulers(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	input := make(chan common.Cmd2Value, 100)
+	w := &metadataFairWorker{queue: make(chan common.Cmd2Value, 100), started: make(chan struct{}, 10), completed: make(chan struct{}, 10)}
+	listenerDone, schedulerDone := make(chan struct{}), make(chan struct{})
+	go func() { defer close(listenerDone); common.DoListener(ctx, w) }()
+	var live atomic.Int32
+	go func() {
+		defer close(schedulerDone)
+		runMessageSyncLoop(ctx, input, func(c common.Cmd2Value) {
+			if c.Cmd == cmdSyncAuxiliaryMetadata {
+				_ = common.SendSyncCmdWithReceipt(c.Ctx, common.Cmd2Value{Cmd: constant.CmdSyncData}, w.queue)
+			} else {
+				live.Add(1)
+			}
+		})
+	}()
+	defer func() { cancel(); <-schedulerDone; <-listenerDone }()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: cmdSyncAuxiliaryMetadata}
+	select {
+	case <-w.started:
+	case <-time.After(time.Second):
+		t.Fatal("metadata not started")
+	}
+	// Keep both queues busy beyond the old 100ms cancellation threshold.
+	for i := 0; i < 30; i++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+		w.queue <- common.Cmd2Value{Ctx: ctx, Cmd: "external-update"}
+	}
+	select {
+	case <-w.completed:
+	case <-time.After(900 * time.Millisecond):
+		t.Fatal("busy ingress starved bounded metadata")
+	}
+	deadline := time.Now().Add(time.Second)
+	for live.Load() != 30 || w.updates.Load() != 30 {
+		if time.Now().After(deadline) {
+			t.Fatalf("updates lost: live=%d conversation=%d", live.Load(), w.updates.Load())
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestBoundedMetadataCannotRenewAllowanceOrBlockLogout(t *testing.T) {
+	for _, logout := range []bool{false, true} {
+		t.Run(map[bool]string{false: "live-deadline", true: "logout"}[logout], func(t *testing.T) {
+			ctx, cancel := context.WithCancel(recoveryContext(t))
+			input := make(chan common.Cmd2Value, 10)
+			started, live, done := make(chan struct{}, 10), make(chan struct{}, 10), make(chan struct{})
+			go func() {
+				defer close(done)
+				runMessageSyncLoop(ctx, input, func(c common.Cmd2Value) {
+					if c.Cmd != cmdSyncAuxiliaryMetadata {
+						live <- struct{}{}
+						return
+					}
+					finish := common.BeginMetadataBatch(c.Ctx)
+					defer finish()
+					started <- struct{}{}
+					for {
+						select {
+						case <-c.Ctx.Done():
+							return
+						case <-time.After(20 * time.Millisecond):
+							f := common.BeginMetadataBatch(c.Ctx)
+							f()
+						}
+					}
+				})
+			}()
+			defer func() { cancel(); <-done }()
+			input <- common.Cmd2Value{Ctx: ctx, Cmd: cmdSyncAuxiliaryMetadata}
+			select {
+			case <-started:
+			case <-time.After(time.Second):
+				t.Fatal("not started")
+			}
+			if logout {
+				cancel()
+				select {
+				case <-done:
+				case <-time.After(300 * time.Millisecond):
+					t.Fatal("logout waited for batch")
+				}
+				return
+			}
+			input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+			select {
+			case <-live:
+			case <-time.After(1500 * time.Millisecond):
+				t.Fatal("batch renewal starved live message")
+			}
+		})
+	}
+}
diff --git a/internal/interaction/msg_sync_metadata_retry_test.go b/internal/interaction/msg_sync_metadata_retry_test.go
