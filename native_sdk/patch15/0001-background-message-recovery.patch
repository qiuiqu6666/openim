@@ -0,0 +1,113 @@
+//go:build cgo && !js
+
+package interaction
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestContiguousSQLiteLegacyGapAndInterruptedCheckpoint(t *testing.T) {
+	ctx := recoveryContext(t)
+	dir := t.TempDir()
+	d, err := db.NewDataBase(ctx, "self", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = d.Close(ctx) })
+	if err = d.SetAppSDKVersion(ctx, &model_struct.LocalAppSDKVersion{Installed: true}); err != nil {
+		t.Fatal(err)
+	}
+	if err = d.BatchInsertConversationList(ctx, []*model_struct.LocalConversation{{ConversationID: "chat", LatestMsgSendTime: 3, ConversationType: constant.SingleChatType}}); err != nil {
+		t.Fatal(err)
+	}
+	// Legacy recovery.12 left a tail at 13 but never received 4..12.
+	for _, seq := range []int64{1, 2, 3, 13} {
+		if err = d.BatchInsertMessageList(ctx, "chat", []*model_struct.LocalChatLog{{ClientMsgID: fmt.Sprint(seq), Seq: seq}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	m, err := NewMsgSyncer(ctx, make(chan common.Cmd2Value), nil, "self", nil, d, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.syncedMaxSeqs["chat"] != 0 {
+		t.Fatalf("MAX(seq) trusted as coverage: %v", m.syncedMaxSeqs)
+	}
+	if err = m.rememberMessageTarget(ctx, "chat", 13); err != nil {
+		t.Fatal(err)
+	}
+	// Simulate the process disappearing after storage, before the checkpoint.
+	rows := make([]*model_struct.LocalChatLog, 0, 13)
+	for seq := int64(1); seq <= 13; seq++ {
+		rows = append(rows, &model_struct.LocalChatLog{ClientMsgID: fmt.Sprint(seq), Seq: seq})
+	}
+	if err = d.CommitMessageSyncBatch(ctx, nil, map[string][]*model_struct.LocalChatLog{"chat": rows}, []*model_struct.LocalConversation{{ConversationID: "chat", LatestMsgSendTime: 13, UnreadCount: 10}}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if err = d.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+	d, err = db.NewDataBase(ctx, "self", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m, err = NewMsgSyncer(ctx, make(chan common.Cmd2Value), nil, "self", conn, d, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.syncedMaxSeqs["chat"] != 0 {
+		t.Fatal("restart skipped interrupted receipt")
+	}
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		p := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation)
+		var rows []*model_struct.LocalChatLog
+		for _, row := range p.Msgs["chat"].Msgs {
+			rows = append(rows, &model_struct.LocalChatLog{ClientMsgID: fmt.Sprint(row.Seq), Seq: row.Seq})
+		}
+		return d.CommitMessageSyncBatch(ctx, nil, map[string][]*model_struct.LocalChatLog{"chat": rows}, nil, nil)
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		p := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+			panic(err)
+		}
+		var seqs []int64
+		for s := p.SeqRanges[0].Begin; s <= p.SeqRanges[0].End; s++ {
+			seqs = append(seqs, s)
+		}
+		return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seqs...)})
+	})
+	// Even an old maximum observation cannot erase the durable target.
+	if err = m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": 3}, 1); err != nil {
+		t.Fatal(err)
+	}
+	if m.syncedMaxSeqs["chat"] != 13 {
+		t.Fatal("did not complete durable target")
+	}
+	for seq := int64(1); seq <= 13; seq++ {
+		if _, err = d.GetMessageBySeq(ctx, "chat", seq); err != nil {
+			t.Fatalf("missing %d: %v", seq, err)
+		}
+	}
+	c, err := d.GetConversation(ctx, "chat")
+	if err != nil || c.UnreadCount != 10 {
+		t.Fatalf("replay changed unread: %+v %v", c, err)
+	}
+	restarted, err := NewMsgSyncer(ctx, make(chan common.Cmd2Value), nil, "self", nil, d, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if restarted.syncedMaxSeqs["chat"] != 13 {
+		t.Fatal("committed checkpoint did not survive reload")
+	}
+}
diff --git a/internal/interaction/msg_checkpoint_test.go b/internal/interaction/msg_checkpoint_test.go
new file mode 100644
index 00000000..f1fbeb34
--- /dev/null
+++ b/internal/interaction/msg_checkpoint_test.go
@@ -0,0 +1,176 @@
+package interaction
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+type checkpointFaultDB struct {
+	*recoveryVersionDB
+	failCompleted int64
+	boundary      model_struct.LocalConversation
+}
+
+func (d *checkpointFaultDB) SetVersionSync(ctx context.Context, row *model_struct.LocalVersionSync) error {
+	var state messageCheckpoint
+	if row.VersionID != "" {
+		if err := json.Unmarshal([]byte(row.VersionID), &state); err != nil {
+			return err
+		}
+	}
+	if d.failCompleted > 0 && state.Completed == d.failCompleted {
+		return errors.New("checkpoint disk failure")
+	}
+	return d.recoveryVersionDB.SetVersionSync(ctx, row)
+}
+func (d *checkpointFaultDB) GetConversation(context.Context, string) (*model_struct.LocalConversation, error) {
+	c := d.boundary
+	return &c, nil
+}
+
+func TestContiguousCheckpointFailureRestoresPendingAfterRestart(t *testing.T) {
+	ctx := recoveryContext(t)
+	d := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, failCompleted: 6}
+	m := &MsgSyncer{db: d, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5}}
+	receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+	resp := &sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 6)}
+	if err := m.commitPulledMessages(ctx, resp, map[string][2]int64{"chat": {6, 6}}, 0); err == nil {
+		t.Fatal("checkpoint failure swallowed")
+	}
+	if m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("uncommitted checkpoint advanced")
+	}
+	restarted, err := NewMsgSyncer(ctx, m.conversationCh, nil, "self", nil, d, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if restarted.syncedMaxSeqs["chat"] != 5 || restarted.checkpoints["chat"].Target != 6 {
+		t.Fatal("restart lost pending page")
+	}
+	d.failCompleted = 0
+	if err := restarted.commitPulledMessages(ctx, resp, map[string][2]int64{"chat": {6, 6}}, 0); err != nil {
+		t.Fatal(err)
+	}
+	if restarted.syncedMaxSeqs["chat"] != 6 {
+		t.Fatal("retry failed")
+	}
+}
+
+func TestContiguousVisibleBoundariesAndFailedConversationIsolation(t *testing.T) {
+	ctx := recoveryContext(t)
+	d := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, boundary: model_struct.LocalConversation{MinSeq: 6, MaxSeq: 15}}
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{db: d, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"a": 3, "b": 3}}
+	stored := 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		for _, p := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+			stored += len(p.Msgs)
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.PullMsgBySeqList {
+			p := &msg.GetSeqMessageReq{}
+			if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+				panic(err)
+			}
+			packets := make(map[string]*sdkws.PullMsgs)
+			for _, row := range p.Conversations {
+				packets[row.ConversationID] = &sdkws.PullMsgs{IsEnd: p.Order == sdkws.PullOrder_PullOrderAsc, EndSeq: 15}
+			}
+			return wireResponse(&msg.GetSeqMessageResp{Msgs: packets})
+		}
+		p := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+			panic(err)
+		}
+		for _, r := range p.SeqRanges {
+			if r.Begin < 6 || r.End > 15 || r.Num != r.End-r.Begin+1 {
+				t.Errorf("ignored visibility boundaries: %v", r)
+			}
+			if r.ConversationID == "a" {
+				return &GeneralWsResp{ErrCode: 10001, ErrMsg: "temporary unavailable"}
+			}
+		}
+		return requestedRecoveryResponse(t, req)
+	})
+	if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"a": 20, "b": 20}, 1); err == nil {
+		t.Fatal("failed conversation reported complete")
+	}
+	if m.syncedMaxSeqs["a"] != 5 || m.syncedMaxSeqs["b"] != 15 || stored != 10 {
+		t.Fatalf("wrong progress: %v stored=%d", m.syncedMaxSeqs, stored)
+	}
+}
+
+func TestSparsePushDeliversBeforeRecentGapRecovery(t *testing.T) {
+	ctx := recoveryContext(t)
+	d := &recoveryVersionDB{installed: true}
+	m := &MsgSyncer{ctx: ctx, db: d, recvCh: make(chan common.Cmd2Value, 1), syncedMaxSeqs: map[string]int64{"chat": 3}}
+	// No transport: the latest message must not wait for any gap request.
+	delivered := false
+	m.pushTriggerAndSync(ctx, recoveryMsgs("chat", 1003), func(context.Context, map[string]*sdkws.PullMsgs) error {
+		delivered = true
+		return nil
+	})
+	if !delivered || !m.messageAlreadyCovered("chat", 1003) {
+		t.Fatal("latest push was not delivered and recorded")
+	}
+	if m.syncedMaxSeqs["chat"] != 3 || m.checkpoints["chat"].Target != 1003 {
+		t.Fatal("push consumed gap")
+	}
+	select {
+	case cmd := <-m.recvCh:
+		if cmd.Cmd != constant.CmdIMMessageSync {
+			t.Fatal("wrong scheduler command")
+		}
+	default:
+		t.Fatal("gap was not scheduled")
+	}
+}
+
+func TestContiguousMetadataFailureStillRecoversOnSilentPeriodicTick(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	conn.SetConnectionStatus(Connected)
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 3}}
+	stored, probes, reconciliations := 0, 0, 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		p := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation)
+		if cmd.Cmd == constant.CmdSyncFlag {
+			return errors.New("optional profile unavailable")
+		}
+		stored += len(p.Msgs["chat"].Msgs)
+		if p.ReconcileReadSeq {
+			reconciliations++
+		}
+		if !p.Recovery {
+			t.Error("recovery lost read-sequence guard")
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.GetNewestSeq {
+			probes++
+			return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"chat": 13}})
+		}
+		return requestedRecoveryResponse(t, req)
+	})
+	m.doConnected(ctx)
+	if probes != 0 {
+		t.Fatal("fixture did not model metadata block")
+	}
+	m.doMessageSeqReconciliation(ctx)
+	if stored != 10 || reconciliations != 1 || m.syncedMaxSeqs["chat"] != 13 {
+		t.Fatal("silent retry still waited for next push")
+	}
+}
diff --git a/internal/interaction/msg_contiguous_recovery_test.go b/internal/interaction/msg_contiguous_recovery_test.go
new file mode 100644
index 00000000..a19869c2
--- /dev/null
+++ b/internal/interaction/msg_contiguous_recovery_test.go
@@ -0,0 +1,79 @@
+package interaction
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+// The peer has stopped sending. A range server honors exactly the wire request;
+// it does not help the client by returning messages outside its requested tail.
+func TestReconnectRecoversLatestWindowWithoutNextPush(t *testing.T) {
+	for _, count := range []int64{10, 100, 1000, 100000000} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 3}}
+			stored := make(map[int64]bool)
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				if cmd.Cmd == constant.CmdNewMsgCome {
+					for _, row := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs["chat"].Msgs {
+						stored[row.Seq] = true
+					}
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier == constant.GetNewestSeq {
+					return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"chat": 3 + count}})
+				}
+				p := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+					panic(err)
+				}
+				resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+				for _, r := range p.SeqRanges {
+					if r.End-r.Begin+1 > SplitPullMsgNum {
+						t.Errorf("unbounded batch: %v", r)
+					}
+					var seqs []int64
+					for seq := r.Begin; seq <= r.End && int64(len(seqs)) < r.Num; seq++ {
+						seqs = append(seqs, seq)
+					}
+					resp.Msgs[r.ConversationID] = recoveryMsgs(r.ConversationID, seqs...)[r.ConversationID]
+				}
+				return wireResponse(resp)
+			})
+			m.doConnected(ctx)
+			if len(stored) != int(min(count, recentMessageWindow)) {
+				t.Fatalf("offline rows persisted = %d/%d, cursor = %d", len(stored), count, m.syncedMaxSeqs["chat"])
+			}
+			if count > recentMessageWindow && m.syncedMaxSeqs["chat"] != 3 {
+				t.Fatal("sparse tail advanced continuous checkpoint")
+			}
+			for seq := max(int64(4), 4+count-recentMessageWindow); seq <= 3+count; seq++ {
+				if !stored[seq] {
+					t.Fatalf("missing seq %d", seq)
+				}
+			}
+		})
+	}
+}
+
+func TestContiguousPartialAndEmptyResponsesCannotConsumeGap(t *testing.T) {
+	for _, seqs := range [][]int64{nil, {13}, {4, 5, 7, 8, 9, 10, 11, 12, 13}, {4, 4, 5, 6, 7, 8, 9, 10, 11, 12}} {
+		t.Run(fmt.Sprint(seqs), func(t *testing.T) {
+			m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 3}}
+			receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+			err := m.commitPulledMessages(recoveryContext(t), &sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seqs...)}, map[string][2]int64{"chat": {4, 13}}, 0)
+			if err == nil || m.syncedMaxSeqs["chat"] != 3 {
+				t.Fatalf("incomplete response accepted: error=%v cursor=%d", err, m.syncedMaxSeqs["chat"])
+			}
+		})
+	}
+}
diff --git a/internal/interaction/msg_loss_matrix_test.go b/internal/interaction/msg_loss_matrix_test.go
new file mode 100644
index 00000000..fea3a446
--- /dev/null
+++ b/internal/interaction/msg_loss_matrix_test.go
@@ -0,0 +1,452 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/rand"
+	"reflect"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+// Exercise the real push/gap/receipt chain instead of replacing the sequence
+// owner with a callback. The fake server owns every requested sequence; a
+// missing received message therefore cannot be explained by retention policy.
+func TestLossMatrixPushOrderAndDuplicates(t *testing.T) {
+	packets := [][][]int64{
+		{{999}, {1000}},
+		{{1000}, {999}},
+		{{999, 1000}, {999, 1000}},
+		{{1000, 999}, {1000}},
+		{{999, 999, 1000}},
+		{{998, 999}, {998, 999, 1000}},
+		{{998}, {997}, {1000}, {999}},
+	}
+	for _, id := range []string{"chat", "n_chat"} {
+		for _, packet := range packets {
+			t.Run(fmt.Sprintf("%s/%v", id, packet), func(t *testing.T) {
+				ctx := recoveryContext(t)
+				conn := &LongConnMgr{send: make(chan Message, 1)}
+				m := &MsgSyncer{ctx: ctx, longConnMgr: conn,
+					conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{id: 998}}
+				var delivered []int64
+				var mu sync.Mutex
+				receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+					p := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation)
+					if p.ReconcileReadSeq && len(p.Msgs) == 0 {
+						return nil
+					}
+					if cmd.Cmd != constant.CmdNewMsgCome && cmd.Cmd != constant.CmdNotification {
+						return fmt.Errorf("unexpected failure notification: %s", cmd.Cmd)
+					}
+					mu.Lock()
+					defer mu.Unlock()
+					for _, msg := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs[id].Msgs {
+						delivered = append(delivered, msg.Seq)
+					}
+					return nil
+				})
+				requestWorker(t, conn, func(req Message) *GeneralWsResp {
+					pull := &sdkws.PullMessageBySeqsReq{}
+					if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+						panic(err)
+					}
+					resp := &sdkws.PullMessageBySeqsResp{}
+					for _, seqRange := range pull.SeqRanges {
+						var seqs []int64
+						for seq := seqRange.Begin; seq <= seqRange.End; seq++ {
+							seqs = append(seqs, seq)
+						}
+						if IsNotification(id) {
+							resp.NotificationMsgs = recoveryMsgs(id, seqs...)
+						} else {
+							resp.Msgs = recoveryMsgs(id, seqs...)
+						}
+					}
+					return wireResponse(resp)
+				})
+				for _, seqs := range packet {
+					push := &sdkws.PushMessages{}
+					if IsNotification(id) {
+						push.NotificationMsgs = recoveryMsgs(id, seqs...)
+					} else {
+						push.Msgs = recoveryMsgs(id, seqs...)
+					}
+					m.doPushMsg(ctx, push)
+				}
+				mu.Lock()
+				defer mu.Unlock()
+				if !IsNotification(id) {
+					sort.Slice(delivered, func(i, j int) bool { return delivered[i] < delivered[j] })
+				}
+				if !reflect.DeepEqual(delivered, []int64{999, 1000}) {
+					t.Fatalf("lost or replayed stored messages: %v", delivered)
+				}
+				if m.syncedMaxSeqs[id] != 1000 {
+					t.Fatalf("unexpected committed position: %d", m.syncedMaxSeqs[id])
+				}
+			})
+		}
+	}
+}
