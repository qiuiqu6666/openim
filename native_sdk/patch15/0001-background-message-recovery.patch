+		return nil, err
+	}
+	s.SoundElem = &sdk_struct.SoundElem{
+		SoundPath: soundPath,
+		Duration:  duration,
+		DataSize:  fi.Size(),
+		SoundType: strings.Replace(filepath.Ext(fi.Name()), ".", "", 1),
+	}
+	return &s, nil
+}
