diff --git a/pkg/common/cmd_cancel_drain_test.go b/pkg/common/cmd_cancel_drain_test.go
new file mode 100644
index 00000000..f1f97e7d
--- /dev/null
+++ b/pkg/common/cmd_cancel_drain_test.go
@@ -0,0 +1,100 @@
+package common
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+)
+
+// A foreground group query owns the metadata lock and publishes more profile
+// notifications than fit in the queue. The cancelled sync must acquire that
+// lock before it can return, exactly as SyncAllJoinedGroupsAndMembersWithLock.
+type lockWaitingWorker struct {
+	queue     chan Cmd2Value
+	lock      sync.Mutex
+	started   chan struct{}
+	cancelled chan struct{}
+	applied   chan string
+}
+
+func (w *lockWaitingWorker) GetCh() chan Cmd2Value                   { return w.queue }
+func (w *lockWaitingWorker) InterruptibleCommand(cmd Cmd2Value) bool { return cmd.Cmd == "sync" }
+func (w *lockWaitingWorker) Work(cmd Cmd2Value) {
+	if cmd.Cmd != "sync" {
+		w.applied <- cmd.Cmd
+		return
+	}
+	close(w.started)
+	<-cmd.Ctx.Done()
+	close(w.cancelled)
+	w.lock.Lock()
+	w.lock.Unlock()
+	cmd.Receipt <- cmd.Ctx.Err()
+}
+
+func TestCancelledSyncDrainsNotificationsWhileJoiningLockWaiter(t *testing.T) {
+	t.Run("small queue", func(t *testing.T) { testCancelledSyncDrains(t, 2) })
+	t.Run("production queue", func(t *testing.T) { testCancelledSyncDrains(t, 1000) })
+}
+
+func testCancelledSyncDrains(t *testing.T, capacity int) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	count := capacity + 5
+	w := &lockWaitingWorker{queue: make(chan Cmd2Value, capacity), started: make(chan struct{}), cancelled: make(chan struct{}), applied: make(chan string, count+1)}
+	w.lock.Lock()
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	receipt := make(chan error, 1)
+	w.queue <- Cmd2Value{Ctx: ctx, Cmd: "sync", Receipt: receipt}
+	<-w.started
+	w.queue <- Cmd2Value{Ctx: ctx, Cmd: "live"}
+	<-w.cancelled
+	// Allow cleanup even against the broken listener, without leaving goroutines.
+	producerCtx, stopProducer := context.WithTimeout(ctx, time.Second)
+	defer stopProducer()
+	produced := make(chan bool, 1)
+	go func() {
+		defer w.lock.Unlock()
+		for i := 0; i < count; i++ {
+			select {
+			case w.queue <- Cmd2Value{Ctx: ctx, Cmd: "profile"}:
+			case <-producerCtx.Done():
+				produced <- false
+				return
+			}
+		}
+		produced <- true
+	}()
+	ok := <-produced
+	if !ok {
+		cancel()
+		<-done
+		t.Fatal("cancel join stopped draining: group lock/queue cycle")
+	}
+	select {
+	case err := <-receipt:
+		if err != context.Canceled {
+			t.Errorf("cancelled sync receipt = %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Error("sync failed to exit")
+	}
+	for i := 0; i < count+1; i++ {
+		select {
+		case got := <-w.applied:
+			want := "profile"
+			if i == 0 {
+				want = "live"
+			}
+			if got != want {
+				t.Errorf("update %d = %s, want %s", i, got, want)
+			}
+		case <-time.After(time.Second):
+			t.Error("notification lost")
+		}
+	}
+	cancel()
+	<-done
+}
diff --git a/pkg/common/cmd_interruptible.go b/pkg/common/cmd_interruptible.go
new file mode 100644
index 00000000..0d8b311e
--- /dev/null
+++ b/pkg/common/cmd_interruptible.go
@@ -0,0 +1,131 @@
+package common
+
+import (
+	"context"
+	"time"
+)
+
+type syncNotificationOwnerKey struct{}
+type syncNotificationOwner struct{ marker bool }
+
+// Only explicitly opted-in network sync commands can yield. Their original
+// receipt reports cancellation, so the caller must retry rather than publish
+// a false sync success. Normal message writes never overlap or get preempted.
+func runInterruptibleListener(ctx context.Context, worker goroutine, interruptible func(Cmd2Value) bool) {
+	var done chan struct{}
+	var cancel context.CancelFunc
+	var activeCtx context.Context
+	owner := &syncNotificationOwner{}
+	var pending []Cmd2Value
+	protected := false
+	var grace *time.Timer
+	var graceDone <-chan time.Time
+	stop := func() {
+		if grace != nil {
+			grace.Stop()
+			grace = nil
+			graceDone = nil
+		}
+		if cancel != nil {
+			cancel()
+			// A cancelled metadata job may still be waiting for a lock held by
+			// an API call that publishes to this queue. Keep draining until the
+			// job exits, but never apply updates concurrently with that job.
+			queue := worker.GetCh()
+		joining:
+			for {
+				select {
+				case <-done:
+					break joining
+				case cmd, ok := <-queue:
+					if !ok {
+						queue = nil
+						continue
+					}
+					if cmd.Ctx != nil && cmd.Ctx.Value(syncNotificationOwnerKey{}) == owner {
+						cmd.Ctx = ctx
+					}
+					pending = append(pending, cmd)
+				}
+			}
+			cancel, done = nil, nil
+		}
+	}
+	defer stop()
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		var cmd Cmd2Value
+		if done == nil && len(pending) > 0 {
+			cmd = pending[0]
+			pending[0] = Cmd2Value{}
+			pending = pending[1:]
+		} else {
+			select {
+			case <-ctx.Done():
+				return
+			case <-graceDone:
+				if delay := MetadataPreemptionDelay(activeCtx); delay > 0 {
+					grace.Reset(delay)
+					continue
+				}
+				stop()
+				continue
+			case <-done:
+				stop()
+				continue
+			case value, ok := <-worker.GetCh():
+				if !ok {
+					return
+				}
+				cmd = value
+			}
+		}
+		// Metadata synchronization emits its own profile/conversation updates.
+		// Those are consequences of this job, not live traffic that should
+		// cancel it. Apply them serially after it exits, on the login context.
+		if cmd.Ctx != nil && cmd.Ctx.Value(syncNotificationOwnerKey{}) == owner {
+			cmd.Ctx = ctx
+			if done != nil {
+				pending = append(pending, cmd)
+			} else {
+				runCommandSafely(worker, cmd)
+			}
+			continue
+		}
+		if done != nil {
+			pending = append(pending, cmd)
+			if !protected && grace == nil {
+				grace = time.NewTimer(100 * time.Millisecond)
+				graceDone = grace.C
+			}
+			continue
+		}
+		if !interruptible(cmd) {
+			runCommandSafely(worker, cmd)
+			continue
+		}
+		if cmd.Ctx == nil {
+			cmd.Ctx = ctx
+		}
+		protected = false
+		if policy, ok := worker.(interface{ ProtectSyncCommand(Cmd2Value) bool }); ok {
+			protected = policy.ProtectSyncCommand(cmd)
+		}
+		attemptCtx, attemptCancel := context.WithCancel(context.WithValue(cmd.Ctx, syncNotificationOwnerKey{}, owner))
+		cmd.Ctx, cancel = attemptCtx, attemptCancel
+		activeCtx = attemptCtx
+		done = make(chan struct{})
+		go func(command Cmd2Value, finished chan struct{}) {
+			defer close(finished)
+			defer attemptCancel()
+			runCommandSafely(worker, command)
+		}(cmd, done)
+		// Live work can already be buffered behind a protected bootstrap.
+		// Do not make it wait for a newly started metadata retry to finish.
+		if !protected && len(pending) > 0 {
+			stop()
+		}
+	}
+}
diff --git a/pkg/common/cmd_interruptible_test.go b/pkg/common/cmd_interruptible_test.go
new file mode 100644
index 00000000..db5bd524
--- /dev/null
+++ b/pkg/common/cmd_interruptible_test.go
@@ -0,0 +1,175 @@
+package common
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type yieldingTestWorker struct {
+	queue   chan Cmd2Value
+	started chan struct{}
+	updated chan struct{}
+}
+
+func (w *yieldingTestWorker) GetCh() chan Cmd2Value                   { return w.queue }
+func (w *yieldingTestWorker) InterruptibleCommand(cmd Cmd2Value) bool { return cmd.Cmd == "sync" }
+func (w *yieldingTestWorker) Work(cmd Cmd2Value) {
+	if cmd.Cmd == "sync" {
+		close(w.started)
+		<-cmd.Ctx.Done()
+		cmd.Receipt <- cmd.Ctx.Err()
+	} else {
+		close(w.updated)
+	}
+}
+func TestSentConversationUpdateInterruptsMetadataWait(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	w := &yieldingTestWorker{make(chan Cmd2Value, 2), make(chan struct{}), make(chan struct{})}
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	receipt := make(chan error, 1)
+	w.queue <- Cmd2Value{Ctx: ctx, Cmd: "sync", Receipt: receipt}
+	<-w.started
+	w.queue <- Cmd2Value{Ctx: ctx, Cmd: "sent-message-update"}
+	select {
+	case <-w.updated:
+	case <-time.After(time.Second):
+		t.Fatal("sent message update blocked by sync")
+	}
+	if err := <-receipt; !errors.Is(err, context.Canceled) {
+		t.Fatalf("sync falsely succeeded: %v", err)
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("listener leaked on logout")
+	}
+}
+
+type selfNotifyingWorker struct {
+	queue     chan Cmd2Value
+	generated chan struct{}
+	finish    chan struct{}
+	updated   chan error
+}
+
+type bootstrapWorker struct{ *selfNotifyingWorker }
+
+func (w *bootstrapWorker) ProtectSyncCommand(cmd Cmd2Value) bool { return cmd.Cmd == "sync" }
+
+func TestBootstrapDrainsButDoesNotYieldToExternalUpdates(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	w := &bootstrapWorker{&selfNotifyingWorker{make(chan Cmd2Value, 4), make(chan struct{}), make(chan struct{}), make(chan error, 2)}}
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	receipt := make(chan error, 1)
+	w.queue <- Cmd2Value{Cmd: "sync", Ctx: ctx, Receipt: receipt}
+	<-w.generated
+	w.queue <- Cmd2Value{Cmd: "external-live-update", Ctx: ctx}
+	select {
+	case err := <-receipt:
+		t.Fatalf("bootstrap interrupted by live traffic: %v", err)
+	case <-w.updated:
+		t.Fatal("message handled without bootstrap data")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(w.finish)
+	if err := <-receipt; err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		select {
+		case err := <-w.updated:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("queued update lost")
+		}
+	}
+	cancel()
+	<-done
+}
+
+func (w *selfNotifyingWorker) GetCh() chan Cmd2Value                   { return w.queue }
+func (w *selfNotifyingWorker) InterruptibleCommand(cmd Cmd2Value) bool { return cmd.Cmd == "sync" }
+func (w *selfNotifyingWorker) Work(cmd Cmd2Value) {
+	if cmd.Cmd != "sync" {
+		w.updated <- cmd.Ctx.Err()
+		return
+	}
+	w.queue <- Cmd2Value{Cmd: "profile-update", Ctx: cmd.Ctx}
+	close(w.generated)
+	select {
+	case <-cmd.Ctx.Done():
+		cmd.Receipt <- cmd.Ctx.Err()
+	case <-w.finish:
+		cmd.Receipt <- nil
+	}
+}
+
+func TestMetadataNotificationsDoNotRestartTheirOwnSync(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	w := &selfNotifyingWorker{make(chan Cmd2Value, 4), make(chan struct{}), make(chan struct{}), make(chan error, 1)}
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	receipt := make(chan error, 1)
+	w.queue <- Cmd2Value{Cmd: "sync", Ctx: ctx, Receipt: receipt}
+	<-w.generated
+	select {
+	case err := <-receipt:
+		t.Fatalf("sync cancelled by its own metadata notification: %v", err)
+	case <-w.updated:
+		t.Fatal("metadata applied concurrently with active sync")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(w.finish)
+	select {
+	case err := <-receipt:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("sync did not complete")
+	}
+	select {
+	case err := <-w.updated:
+		if err != nil {
+			t.Fatalf("metadata notification lost after cleanup: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("metadata notification not delivered")
+	}
+	cancel()
+	<-done
+}
+
+func TestShortMetadataCompletesBeforePreemptionGrace(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	w := &selfNotifyingWorker{make(chan Cmd2Value, 4), make(chan struct{}), make(chan struct{}), make(chan error, 2)}
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	receipt := make(chan error, 1)
+	w.queue <- Cmd2Value{Ctx: ctx, Cmd: "sync", Receipt: receipt}
+	<-w.generated
+	w.queue <- Cmd2Value{Ctx: ctx, Cmd: "external-live-update"}
+	time.Sleep(10 * time.Millisecond)
+	close(w.finish)
+	select {
+	case err := <-receipt:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("sync blocked")
+	}
+	cancel()
+	<-done
+}
