+		ServerMsgID:      info.ServerMsgID,
+		SendID:           info.SendID,
+		RecvID:           info.RecvID,
+		SenderPlatformID: info.SenderPlatformID,
+		SenderNickname:   info.SenderNickname,
+		SenderFaceURL:    info.SenderFaceURL,
+		SessionType:      info.SessionType,
+		MsgFrom:          info.MsgFrom,
