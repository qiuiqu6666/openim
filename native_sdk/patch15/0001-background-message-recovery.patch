+package interaction
+
+import (
+	"errors"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"testing"
+)
+
+func TestProfileWakeDoesNotRefreshWholeDirectory(t *testing.T) {
+	ctx := recoveryContext(t)
+	m := &MsgSyncer{ctx: ctx, recvCh: make(chan common.Cmd2Value, 2), conversationCh: make(chan common.Cmd2Value)}
+	profileCalls, fullCalls := 0, 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		switch cmd.Cmd {
+		case common.CmdSyncMissingProfiles:
+			profileCalls++
+		case constant.CmdSyncData:
+			fullCalls++
+		}
+		return nil
+	})
+	m.handlePushMsgAndEvent(common.Cmd2Value{Ctx: ctx, Cmd: cmdSyncAuxiliaryMetadata, Value: common.ProfileQueueWake{}})
+	if profileCalls != 1 || fullCalls != 0 || m.auxMetadataPending {
+		t.Fatalf("profile=%d full=%d pending=%v", profileCalls, fullCalls, m.auxMetadataPending)
+	}
+	m.requestAuxiliaryMetadata()
+	m.handlePushMsgAndEvent(common.Cmd2Value{Ctx: ctx, Cmd: cmdSyncAuxiliaryMetadata, Value: common.ProfileQueueWake{}})
+	if fullCalls != 1 {
+		t.Fatal("profile wake replaced existing full metadata obligation")
+	}
+}
+
+func TestProfileLookupFailureRetainsOnlyItsOwnRetry(t *testing.T) {
+	ctx := recoveryContext(t)
+	m := &MsgSyncer{ctx: ctx, recvCh: make(chan common.Cmd2Value, 2), conversationCh: make(chan common.Cmd2Value)}
+	calls := 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if cmd.Cmd != common.CmdSyncMissingProfiles {
+			t.Error("optional retry launched a full metadata sweep")
+		}
+		calls++
+		if calls == 1 {
+			return errors.New("profile unavailable")
+		}
+		return nil
+	})
+	m.handlePushMsgAndEvent(common.Cmd2Value{Ctx: ctx, Cmd: cmdSyncAuxiliaryMetadata, Value: common.ProfileQueueWake{}})
+	if !m.auxMetadataPending || !m.auxProfilesOnly {
+		t.Fatal("failed optional work was discarded")
+	}
+	m.queuePendingAuxiliaryMetadata()
+	m.handlePushMsgAndEvent(<-m.recvCh)
+	if calls != 2 || m.auxMetadataPending {
+		t.Fatal("optional work did not recover")
+	}
+}
diff --git a/internal/interaction/msg_sync_recent.go b/internal/interaction/msg_sync_recent.go
new file mode 100644
index 00000000..82b9b63c
--- /dev/null
+++ b/internal/interaction/msg_sync_recent.go
@@ -0,0 +1,77 @@
+package interaction
+
+import (
+	"context"
+	"sort"
+)
+
+// Automatic recovery is bounded independently of a group's lifetime history.
+const recentMessageWindow = 100
+
+func (m *MsgSyncer) messageAlreadyCovered(id string, seq int64) bool {
+	for _, r := range m.checkpoints[id].Covered {
+		if seq >= r[0] && seq <= r[1] {
+			return true
+		}
+	}
+	return false
+}
+
+// commitMessageCoverage never mistakes the newest observed message for a
+// complete prefix. Old ranges may be forgotten conservatively: their content
+// remains queryable on demand and is never scheduled for background download.
+func (m *MsgSyncer) commitMessageCoverage(ctx context.Context, id string, ranges [][2]int64) error {
+	state := m.checkpoints[id]
+	state.Completed = max(state.Completed, m.syncedMaxSeqs[id])
+	all := append(append([][2]int64(nil), state.Covered...), ranges...)
+	sort.Slice(all, func(i, j int) bool { return all[i][0] < all[j][0] })
+	merged := make([][2]int64, 0, len(all))
+	for _, r := range all {
+		state.Target = max(state.Target, r[1])
+		if r[1] <= state.Completed {
+			continue
+		}
+		if r[0] <= state.Completed+1 {
+			state.Completed = r[1]
+			continue
+		}
+		if len(merged) > 0 && r[0] <= merged[len(merged)-1][1]+1 {
+			merged[len(merged)-1][1] = max(merged[len(merged)-1][1], r[1])
+		} else {
+			merged = append(merged, r)
+		}
+	}
+	// A bounded journal, rather than one item per missing sequence.
+	if len(merged) > recentMessageWindow {
+		merged = merged[len(merged)-recentMessageWindow:]
+	}
+	state.Covered = merged
+	if err := m.saveMessageCheckpoint(ctx, id, state); err != nil {
+		return err
+	}
+	m.syncedMaxSeqs[id] = state.Completed
+	return nil
+}
+
+func (m *MsgSyncer) recentMissingRanges(id string, r [2]int64) [][2]int64 {
+	r[0] = max(max(1, r[0]), r[1]-recentMessageWindow+1)
+	state := m.checkpoints[id]
+	r[0] = max(r[0], m.syncedMaxSeqs[id]+1)
+	var missing [][2]int64
+	for _, covered := range state.Covered {
+		if covered[1] < r[0] {
+			continue
+		}
+		if covered[0] > r[1] {
+			break
+		}
+		if covered[0] > r[0] {
+			missing = append(missing, [2]int64{r[0], covered[0] - 1})
+		}
+		r[0] = max(r[0], covered[1]+1)
+	}
+	if r[0] <= r[1] {
+		missing = append(missing, r)
+	}
+	return missing
+}
diff --git a/internal/interaction/msg_sync_recent_batch.go b/internal/interaction/msg_sync_recent_batch.go
new file mode 100644
index 00000000..02c70f5f
--- /dev/null
+++ b/internal/interaction/msg_sync_recent_batch.go
@@ -0,0 +1,215 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/sdkerrs"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+// Each conversation retains its 100-message page. Up to eight such pages
+// share one transport round trip; notification state is always replayed alone.
+func (m *MsgSyncer) nextRecoveryBatch(ids []string, pending map[string][][2]int64) map[string][2]int64 {
+	batch := make(map[string][2]int64)
+	remaining := int64(SplitPullMsgNum * 8)
+	for _, id := range ids {
+		pages := pending[id]
+		if len(pages) == 0 {
+			continue
+		}
+		r := pages[len(pages)-1]
+		r[0] = max(r[0], m.syncedMaxSeqs[id]+1)
+		if r[0] > r[1] {
+			pending[id] = pages[:len(pages)-1]
+			if len(pending[id]) == 0 {
+				delete(pending, id)
+			}
+			continue
+		}
+		if IsNotification(id) && len(batch) > 0 {
+			continue
+		}
+		r[1] = min(r[1], r[0]+min(remaining, int64(SplitPullMsgNum))-1)
+		batch[id] = r
+		remaining -= r[1] - r[0] + 1
+		if IsNotification(id) || remaining == 0 || len(batch) == 8 {
+			break
+		}
+	}
+	return batch
+}
+
+func (m *MsgSyncer) pullMissingRecoveryBatch(ctx context.Context, batch map[string][2]int64, total int) map[string]error {
+	failed := make(map[string]error)
+	resp, err := m.pullMsgBySeqRange(ctx, batch, SplitPullMsgNum)
+	if err != nil {
+		// A connection timeout applies to the whole transport. Never multiply a
+		// 30-second outage into one timeout per conversation in this batch.
+		if len(batch) > 1 && ctx.Err() == nil && !errors.Is(err, sdkerrs.ErrCtxDeadline) {
+			for id, r := range batch {
+				for key, failure := range m.pullMissingRecoveryBatch(ctx, map[string][2]int64{id: r}, total) {
+					failed[key] = failure
+				}
+			}
+		} else {
+			for id := range batch {
+				failed[id] = err
+			}
+		}
+		return failed
+	}
+	for id, r := range batch {
+		if err := ctx.Err(); err != nil {
+			failed[id] = err
+			continue
+		}
+		var one *sdkws.PullMessageBySeqsResp
+		if resp != nil {
+			one = &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}, NotificationMsgs: map[string]*sdkws.PullMsgs{}}
+			if packet := resp.Msgs[id]; packet != nil {
+				one.Msgs[id] = packet
+			}
+			if packet := resp.NotificationMsgs[id]; packet != nil {
+				one.NotificationMsgs[id] = packet
+			}
+		}
+		if err := m.commitPulledMessages(ctx, one, map[string][2]int64{id: r}, total); err != nil {
+			failed[id] = err
+		} else {
+			messageSyncPageCommitted(ctx)
+		}
+	}
+	return failed
+}
+
+func (m *MsgSyncer) recoverRecentMessagePages(ctx context.Context, ids []string, pending map[string][][2]int64, reinstall bool, totalPages int) []error {
+	refreshed := make(map[string]bool)
+	var failures []error
+	priorities := m.conversationPriorities(ctx)
+	ctx = context.WithValue(ctx, recoveryPriorityKey{}, priorities)
+	for len(pending) > 0 {
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			return append(failures, err)
+		}
+		m.prioritizeConversations(ids, priorities)
+		batch := m.nextRecoveryBatch(ids, pending)
+		if len(batch) == 0 {
+			continue
+		}
+		total := 0
+		if reinstall {
+			total = totalPages
+		}
+		failed := m.pullRecoveryBatch(ctx, batch, total)
+		if err := ctx.Err(); err != nil {
+			return append(failures, err)
+		}
+		// Resolve incomplete conversations together using the same authenticated
+		// directional proof. Empty packets alone still cannot advance coverage.
+		boundaryRanges := make(map[string][2]int64)
+		boundaryFailures := make(map[string]error)
+		for id, r := range batch {
+			var incomplete *incompleteMessageRange
+			if errors.As(failed[id], &incomplete) && !IsNotification(id) && !refreshed[id] {
+				pages := pending[id]
+				boundaryRanges[id] = [2]int64{r[0], pages[len(pages)-1][1]}
+			}
+		}
+		if len(boundaryRanges) > 0 {
+			m.resolveVisibilityBatch(ctx, boundaryRanges, boundaryFailures)
+		}
+		if err := ctx.Err(); err != nil {
+			return append(failures, err)
+		}
+		for id, r := range batch {
+			if err := failed[id]; err != nil {
+				var incomplete *incompleteMessageRange
+				if errors.As(err, &incomplete) && !IsNotification(id) && !refreshed[id] {
+					refreshed[id] = true
+					pages := pending[id]
+					remaining := [2]int64{r[0], pages[len(pages)-1][1]}
+					visible, boundaryErr := boundaryRanges[id], boundaryFailures[id]
+					if boundaryErr == nil && visible != remaining {
+						if visible[0] > r[0] {
+							if commitErr := m.commitMessageCheckpoint(ctx, id, min(r[1], visible[0]-1)); commitErr != nil {
+								return append(failures, commitErr)
+							}
+						}
+						pending[id] = m.recentMissingRanges(id, visible)
+						if len(pending[id]) == 0 {
+							delete(pending, id)
+						}
+						continue
+					}
+					if boundaryErr != nil {
+						err = errors.Join(err, boundaryErr)
+					}
+				}
+				failures = append(failures, fmt.Errorf("message range %s [%d,%d]: %w", id, r[0], r[1], err))
+				delete(pending, id)
+				continue
+			}
+			pages := pending[id]
+			page := pages[len(pages)-1]
+			if r[1] == page[1] {
+				pending[id] = pages[:len(pages)-1]
+			} else {
+				pages[len(pages)-1] = [2]int64{r[1] + 1, page[1]}
+			}
+			if len(pending[id]) == 0 {
+				delete(pending, id)
+			}
+		}
+	}
+	return failures
+}
+
+// Share foreground history lanes and adopt only rows revalidated in SQLite.
+// Locks are ordered by ID, and there is no concurrent coverage mutation.
+func (m *MsgSyncer) pullRecoveryBatch(ctx context.Context, batch map[string][2]int64, total int) map[string]error {
+	failed := make(map[string]error)
+	release, err := m.lockPreviewHistory(ctx, batch)
+	if err != nil {
+		for id := range batch {
+			failed[id] = err
+		}
+		return failed
+	}
+	defer release()
+	missing := make(map[string][][2]int64)
+	for id, r := range batch {
+		if err := m.acceptStoredHistory(ctx, id, r, total); err != nil {
+			failed[id] = err
+			continue
+		}
+		if IsNotification(id) {
+			missing[id] = [][2]int64{r}
+		} else {
+			missing[id] = m.recentMissingRanges(id, r)
+		}
+		if len(missing[id]) == 0 {
+			delete(missing, id)
+		}
+	}
+	for len(missing) > 0 {
+		request := make(map[string][2]int64)
+		for id, spans := range missing {
+			request[id] = spans[0]
+		}
+		results := m.pullMissingRecoveryBatch(ctx, request, total)
+		for id := range request {
+			if err := results[id]; err != nil {
+				failed[id] = err
+				delete(missing, id)
+			} else {
+				missing[id] = missing[id][1:]
+				if len(missing[id]) == 0 {
+					delete(missing, id)
+				}
+			}
+		}
+	}
+	return failed
+}
diff --git a/internal/interaction/msg_sync_recovery_test.go b/internal/interaction/msg_sync_recovery_test.go
new file mode 100644
index 00000000..7b9f0993
--- /dev/null
+++ b/internal/interaction/msg_sync_recovery_test.go
@@ -0,0 +1,344 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+	"google.golang.org/protobuf/proto"
+)
+
+func recoveryContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "self"}), 5*time.Second)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+func recoveryMsgs(id string, seqs ...int64) map[string]*sdkws.PullMsgs {
+	p := &sdkws.PullMsgs{}
+	for _, seq := range seqs {
+		p.Msgs = append(p.Msgs, &sdkws.MsgData{Seq: seq})
+	}
+	return map[string]*sdkws.PullMsgs{id: p}
+}
+
+func receiptWorker(t *testing.T, ch <-chan common.Cmd2Value, handle func(common.Cmd2Value) error) {
+	t.Helper()
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case cmd := <-ch:
+				err := handle(cmd)
+				if cmd.Receipt != nil {
+					cmd.Receipt <- err
+				}
+			case <-stop:
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { close(stop); <-done })
+}
+
+func requestWorker(t *testing.T, c *LongConnMgr, handle func(Message) *GeneralWsResp) {
+	t.Helper()
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case req := <-c.send:
+				req.Resp <- handle(req)
+			case <-stop:
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { close(stop); <-done })
+}
+
+func wireResponse(p proto.Message) *GeneralWsResp {
+	data, err := proto.Marshal(p)
+	if err != nil {
+		panic(err)
+	}
+	return &GeneralWsResp{Data: data}
+}
+
+func TestPullCommitWaitsForStorageAndRetriesFailure(t *testing.T) {
+	ctx := recoveryContext(t)
+	m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5}}
+	resp := &sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 6)}
+	ranges := map[string][2]int64{"chat": {6, 6}}
+	done := make(chan error, 1)
+	go func() { done <- m.commitPulledMessages(ctx, resp, ranges, 0) }()
+	cmd := <-m.conversationCh
+	if m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("advanced before storage acknowledgement")
+	}
+	want := errors.New("disk full")
+	cmd.Receipt <- want
+	if err := <-done; !errors.Is(err, want) {
+		t.Fatalf("lost storage error: %v", err)
+	}
+	if m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("advanced after failed storage")
+	}
+	go func() { done <- m.commitPulledMessages(ctx, resp, ranges, 0) }()
+	cmd = <-m.conversationCh
+	cmd.Receipt <- nil
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if m.syncedMaxSeqs["chat"] != 6 {
+		t.Fatal("retry did not commit")
+	}
+}
