+package common
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type commandBodyProbe struct{ encoded atomic.Int32 }
+
+func (v *commandBodyProbe) MarshalJSON() ([]byte, error) {
+	v.encoded.Add(1)
+	return []byte(`{"content":"message body"}`), nil
+}
+
+func TestCommandInfoLogDoesNotSerializePayload(t *testing.T) {
+	probe := &commandBodyProbe{}
+	ch := make(chan Cmd2Value, 1)
+	if err := sendCmd(ch, Cmd2Value{Ctx: context.Background(), Cmd: "notification", Value: probe}, time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if (<-ch).Value != probe {
+		t.Fatal("logging changed command payload")
+	}
+	if probe.encoded.Load() != 0 {
+		t.Fatal("INFO log serialized the message page")
+	}
+}
diff --git a/pkg/common/cmd_pending_extremes_test.go b/pkg/common/cmd_pending_extremes_test.go
new file mode 100644
index 00000000..1bb48b05
--- /dev/null
+++ b/pkg/common/cmd_pending_extremes_test.go
@@ -0,0 +1,84 @@
+package common
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+type pendingRetryWorker struct {
+	queue   chan Cmd2Value
+	started chan struct{}
+	finish  chan struct{}
+	applied chan struct{}
+}
+
+func (w *pendingRetryWorker) GetCh() chan Cmd2Value                   { return w.queue }
+func (w *pendingRetryWorker) InterruptibleCommand(cmd Cmd2Value) bool { return cmd.Cmd != "live" }
+func (w *pendingRetryWorker) ProtectSyncCommand(cmd Cmd2Value) bool   { return cmd.Cmd == "bootstrap" }
+func (w *pendingRetryWorker) Work(cmd Cmd2Value) {
+	switch cmd.Cmd {
+	case "bootstrap":
+		close(w.started)
+		select {
+		case <-w.finish:
+		case <-cmd.Ctx.Done():
+		}
+	case "retry":
+		<-cmd.Ctx.Done()
+	case "live":
+		close(w.applied)
+	}
+}
+
+func TestPendingLiveTrafficPreemptsPendingMetadataRetry(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	w := &pendingRetryWorker{make(chan Cmd2Value), make(chan struct{}), make(chan struct{}), make(chan struct{})}
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	w.queue <- Cmd2Value{Cmd: "bootstrap", Ctx: ctx}
+	<-w.started
+	// Unbuffered sends guarantee both items have reached pending before release.
+	w.queue <- Cmd2Value{Cmd: "retry", Ctx: ctx}
+	w.queue <- Cmd2Value{Cmd: "live", Ctx: ctx}
+	close(w.finish)
+	select {
+	case <-w.applied:
+	case <-time.After(time.Second):
+		t.Error("pending live update trapped behind metadata retry")
+	}
+	cancel()
+	<-done
+}
+
+func TestLogoutDrainsLockOwnerButDoesNotApplyOldAccountUpdates(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	w := &lockWaitingWorker{queue: make(chan Cmd2Value, 2), started: make(chan struct{}), cancelled: make(chan struct{}), applied: make(chan string, 10)}
+	w.lock.Lock()
+	done := make(chan struct{})
+	go func() { defer close(done); DoListener(ctx, w) }()
+	w.queue <- Cmd2Value{Cmd: "sync", Ctx: ctx, Receipt: make(chan error, 1)}
+	<-w.started
+	cancel()
+	<-w.cancelled
+	deadline := time.After(time.Second)
+	for i := 0; i < 5; i++ {
+		select {
+		case w.queue <- Cmd2Value{Cmd: "old-account-update", Ctx: ctx}:
+		case <-deadline:
+			w.lock.Unlock()
+			<-done
+			t.Fatal("logout blocked group lock owner")
+		}
+	}
+	w.lock.Unlock()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("logout listener leaked")
+	}
+	if len(w.applied) != 0 {
+		t.Fatal("old account updates applied after logout")
+	}
+}
diff --git a/pkg/common/cmd_recovery_test.go b/pkg/common/cmd_recovery_test.go
new file mode 100644
index 00000000..5c7e91b8
--- /dev/null
+++ b/pkg/common/cmd_recovery_test.go
@@ -0,0 +1,96 @@
+package common
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestCancelledCommandNeverEnqueues(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	queue := make(chan Cmd2Value, 100)
+	for i := 0; i < 100; i++ {
+		if err := SendCmdWithReceipt(ctx, Cmd2Value{Cmd: "expired"}, queue); !errors.Is(err, context.Canceled) {
+			t.Fatalf("got %v", err)
+		}
+	}
+	if len(queue) != 0 {
+		t.Fatalf("queued %d expired commands", len(queue))
+	}
+}
+
+func TestReceiptWaitsForStorageAndReturnsFailure(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	queue := make(chan Cmd2Value, 1)
+	done := make(chan error, 1)
+	go func() { done <- SendCmdWithReceipt(ctx, Cmd2Value{Cmd: "store"}, queue) }()
+	cmd := <-queue
+	if cmd.ExpiresAt.IsZero() || time.Until(cmd.ExpiresAt) > time.Second {
+		t.Fatal("queued command has no expiry")
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("returned before storage: %v", err)
+	default:
+	}
+	want := errors.New("disk full")
+	cmd.Receipt <- want
+	if err := <-done; !errors.Is(err, want) {
+		t.Fatalf("got %v", err)
+	}
+	if cmd.Ctx.Err() != nil {
+		t.Fatal("receipt cancelled follow-up work")
+	}
+}
+
+func TestReceiptCancellationWithFullQueue(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	queue := make(chan Cmd2Value, 1)
+	queue <- Cmd2Value{Cmd: "existing"}
+	done := make(chan error, 1)
+	go func() { done <- SendCmdWithReceipt(ctx, Cmd2Value{}, queue) }()
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("full queue ignored cancellation")
+	}
+}
+
+type panicTestWorker struct {
+	ch        chan Cmd2Value
+	processed chan struct{}
+}
+
+func (w *panicTestWorker) GetCh() chan Cmd2Value { return w.ch }
+func (w *panicTestWorker) Work(c Cmd2Value) {
+	if c.Cmd == "panic" {
+		panic("bad item")
+	}
+	w.processed <- struct{}{}
+}
+
+func TestListenerContinuesAfterPanicAndExitsOnClose(t *testing.T) {
+	w := &panicTestWorker{make(chan Cmd2Value, 2), make(chan struct{}, 1)}
+	w.ch <- Cmd2Value{Cmd: "panic", Ctx: context.Background()}
+	w.ch <- Cmd2Value{Cmd: "next", Ctx: context.Background()}
+	close(w.ch)
+	done := make(chan struct{})
+	go func() { DoListener(context.Background(), w); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("listener did not exit")
+	}
+	select {
+	case <-w.processed:
+	default:
+		t.Fatal("panic stopped the receive worker")
+	}
+}
