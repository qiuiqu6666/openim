+func (s *ZkClient) IsSelfNode(cc grpc.ClientConnInterface) bool {
+	cli, ok := cc.(*grpc.ClientConn)
+	if !ok {
+		return false
+	}
+	return s.GetSelfConnTarget() == cli.Target()
+}
