+package interaction
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+func TestNoProgressRetryBackoffCapsAndResetsOnProgress(t *testing.T) {
+	var r messageSyncRetry
+	now := time.Unix(100, 0)
+	for _, seconds := range []int{1, 2, 4, 8, 16, 30, 30, 30} {
+		r.failed(now, false)
+		if got := r.remaining(now); got != time.Duration(seconds)*time.Second {
+			t.Fatalf("delay=%v want=%ds", got, seconds)
+		}
+		now = r.next
+	}
+	r.failed(now, true)
+	if r.remaining(now) != time.Second {
+		t.Fatal("committed progress did not reset backoff")
+	}
+}
+
+func TestNoProgressRetryCoalescesSignalsAndDeliversLivePush(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 100)
+	attempts := make(chan struct{}, 10)
+	live := make(chan struct{}, 100)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				live <- struct{}{}
+				return
+			}
+			recordMessageSyncFailure(cmd.Ctx, errors.New("unchanged missing range"))
+			attempts <- struct{}{}
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	select {
+	case <-attempts:
+	case <-time.After(time.Second):
+		t.Fatal("initial sync not started")
+	}
+	for n := 0; n < 30; n++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	}
+	for n := 0; n < 30; n++ {
+		select {
+		case <-live:
+		case <-time.After(250 * time.Millisecond):
+			t.Fatal("retry backoff blocked live delivery")
+		}
+	}
+	select {
+	case <-attempts:
+		t.Fatal("incoming signals bypassed backoff")
+	case <-time.After(150 * time.Millisecond):
+	}
+	select {
+	case <-attempts:
+	case <-time.After(2 * time.Second):
+		t.Fatal("retry was lost without another message")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(250 * time.Millisecond):
+		t.Fatal("logout waited for retry timer")
+	}
+}
+
+func TestCancelledAttemptDoesNotBecomeFailedRecovery(t *testing.T) {
+	owner := &messagePageCoordinator{}
+	ctx, cancel := context.WithCancel(context.WithValue(context.Background(), messagePageContextKey{}, owner))
+	cancel()
+	recordMessageSyncFailure(ctx, context.Canceled)
+	if owner.failed.Load() {
+		t.Fatal("preemption increased backoff")
+	}
+}
+
+func TestLivePreemptionCannotBypassRecordedFailure(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 4)
+	started, live, done := make(chan struct{}, 4), make(chan struct{}, 1), make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				live <- struct{}{}
+				return
+			}
+			recordMessageSyncFailure(cmd.Ctx, errors.New("range already failed"))
+			started <- struct{}{}
+			<-cmd.Ctx.Done()
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-started
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	select {
+	case <-live:
+	case <-time.After(time.Second):
+		t.Fatal("live push blocked")
+	}
+	select {
+	case <-started:
+		t.Fatal("preemption bypassed no-progress cooldown")
+	case <-time.After(150 * time.Millisecond):
+	}
+	cancel()
+	<-done
+}
+
+func TestRetryCooldownDrainsMoreThanOneBurstOfQueuedLiveMessages(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	input := make(chan common.Cmd2Value, 100)
+	started, live, done := make(chan struct{}), make(chan struct{}, 70), make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				live <- struct{}{}
+				return
+			}
+			owner := cmd.Ctx.Value(messagePageContextKey{}).(*messagePageCoordinator)
+			owner.bounded.Store(true)
+			recordMessageSyncFailure(cmd.Ctx, errors.New("failed bounded page"))
+			close(started)
+			<-cmd.Ctx.Done()
+		})
+	}()
+	defer func() { cancel(); <-done }()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-started
+	for n := 0; n < 70; n++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	}
+	deadline := time.After(500 * time.Millisecond)
+	for n := 0; n < 70; n++ {
+		select {
+		case <-live:
+		case <-deadline:
+			t.Fatalf("only %d queued live messages delivered during cooldown", n)
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_scheduler.go b/internal/interaction/msg_sync_scheduler.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_scheduler.go
@@ -0,0 +1,242 @@
+package interaction
+
+import (
+	"context"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+func isBackgroundSyncCommand(cmd common.Cmd2Value) bool {
+	return cmd.Cmd == constant.CmdConnSuccesss ||
+		cmd.Cmd == constant.CmdWakeUpDataSync || cmd.Cmd == constant.CmdIMMessageSync ||
+		cmd.Cmd == cmdReconcileMessageSeq || cmd.Cmd == cmdSyncAuxiliaryMetadata
+}
+
+func coalesceMessageSync(pending *common.Cmd2Value, incoming common.Cmd2Value) *common.Cmd2Value {
+	// Reconnect/foreground jobs also initialize metadata and publish the
+	// normal sync lifecycle. Lightweight checks must not replace that work.
+	if pending != nil && messageSyncPriority(incoming.Cmd) < messageSyncPriority(pending.Cmd) {
+		return pending
+	}
+	return &incoming
+}
+
+func messageSyncPriority(cmd string) int {
+	switch cmd {
+	case constant.CmdConnSuccesss:
+		return 4
+	case constant.CmdWakeUpDataSync:
+		return 3
+	case constant.CmdIMMessageSync:
+		return 2
+	case cmdSyncAuxiliaryMetadata:
+		return 0
+	default:
+		return 1
+	}
+}
+
+// Yield slow sync I/O to live pushes, without concurrent sequence mutation or
+// storage commits. A cancelled sync never advances uncommitted ranges; one
+// coalesced sync command resumes after queued live messages have been handled.
+func runMessageSyncLoop(ctx context.Context, input <-chan common.Cmd2Value, handle func(common.Cmd2Value), protectInitialSync ...func() bool) {
+	var pending *common.Cmd2Value
+	var active *common.Cmd2Value
+	var done chan struct{}
+	var cancel context.CancelFunc
+	var queued []common.Cmd2Value
+	protected := false
+	const liveBurst = 32
+	liveHandled := 0
+	var pageOwner *messagePageCoordinator
+	var pageTurns <-chan chan struct{}
+	var preemption *time.Timer
+	var preempt <-chan time.Time
+	reserveProgress := false
+	var retry messageSyncRetry
+	var retryTimer *time.Timer
+	var retryWake <-chan time.Time
+	clearRetryTimer := func() {
+		if retryTimer != nil {
+			retryTimer.Stop()
+		}
+		retryTimer, retryWake = nil, nil
+	}
+	defer clearRetryTimer()
+	clearPreemption := func() {
+		if preemption != nil {
+			preemption.Stop()
+		}
+		preemption, preempt = nil, nil
+	}
+	stop := func() {
+		clearPreemption()
+		if cancel != nil {
+			cancel()
+			<-done // The sole state owner must exit before another command runs.
+			// A live push can win the select just as a failed worker exits.
+			// Preserve its failure here too, so traffic cannot bypass the cooldown.
+			if pageOwner.failed.Load() {
+				retry.failed(time.Now(), pageOwner.committed.Load() > 0)
+				pending = coalesceMessageSync(pending, *active)
+			}
+			cancel, done, active = nil, nil, nil
+			pageOwner, pageTurns = nil, nil
+		}
+	}
+	defer stop()
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		if active == nil && len(queued) > 0 && (pending == nil || liveHandled < liveBurst || retry.remaining(time.Now()) > 0) {
+			cmd := queued[0]
+			queued[0] = common.Cmd2Value{}
+			queued = queued[1:]
+			handle(cmd)
+			liveHandled++
+			continue
+		}
+		// Drain already queued work before restarting an interrupted sync.
+		if active == nil && pending != nil && retry.remaining(time.Now()) == 0 {
+			clearRetryTimer()
+			protected = len(protectInitialSync) > 0 && protectInitialSync[0]()
+			if !protected && liveHandled < liveBurst {
+				select {
+				case cmd, ok := <-input:
+					if !ok {
+						return
+					}
+					if isBackgroundSyncCommand(cmd) {
+						pending = coalesceMessageSync(pending, cmd)
+					} else {
+						handle(cmd)
+						liveHandled++
+					}
+					continue
+				default:
+				}
+			}
+			original := *pending
+			pending = nil
+			if original.Ctx == nil {
+				original.Ctx = ctx
+			}
+			if original.Ctx.Err() != nil {
+				continue
+			}
+			active = &original
+			// Read bootstrap state only while no job owns it. Once started,
+			// first-login initialization cannot be starved by incoming traffic.
+			attempt := original
+			attemptCtx, attemptCancel := context.WithCancel(original.Ctx)
+			pageOwner = &messagePageCoordinator{turns: make(chan chan struct{})}
+			pageTurns = pageOwner.turns
+			attempt.Ctx, cancel = context.WithValue(attemptCtx, messagePageContextKey{}, pageOwner), attemptCancel
+			liveHandled = 0
+			done = make(chan struct{})
+			go func(finished chan struct{}) {
+				defer close(finished)
+				defer attemptCancel()
+				handle(attempt)
+			}(done)
+		}
+		if active == nil && pending != nil && retryTimer == nil {
+			retryTimer = time.NewTimer(retry.remaining(time.Now()))
+			retryWake = retryTimer.C
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-retryWake:
+			clearRetryTimer()
+		case <-done:
+			if !pageOwner.failed.Load() {
+				retry = messageSyncRetry{}
+			}
+			reserveProgress = false
+			stop()
+		case <-preempt:
+			// A stalled first attempt may yield once. Its retry owns a bounded
+			// page until completion, so busy chats cannot cancel it forever.
+			if active != nil {
+				resume := *active
+				pending = coalesceMessageSync(pending, resume)
+				reserveProgress = true
+				stop()
+			}
+		case resume := <-pageTurns:
+			clearPreemption()
+			if pageOwner.committed.Load() > 0 {
+				reserveProgress = false
+			}
+			// The worker is paused and no message transaction is in flight.
+			// Bound the ingress turn so continuous traffic cannot starve pages.
+			for n := 0; n < liveBurst; n++ {
+				var cmd common.Cmd2Value
+				if len(queued) > 0 {
+					cmd, queued = queued[0], queued[1:]
+				} else {
+					select {
+					case incoming, ok := <-input:
+						if !ok {
+							close(resume)
+							return
+						}
+						cmd = incoming
+					default:
+						n = liveBurst
+						continue
+					}
+				}
+				if isBackgroundSyncCommand(cmd) {
+					pending = coalesceMessageSync(pending, cmd)
+				} else {
+					handle(cmd)
+				}
+			}
+			close(resume)
+		case cmd, ok := <-input:
+			if !ok {
+				return
+			}
+			if isBackgroundSyncCommand(cmd) {
+				if cmd.Cmd == constant.CmdConnSuccesss {
+					// A fresh transport may recover a network failure immediately.
+					retry = messageSyncRetry{}
+					clearRetryTimer()
+				}
+				// Repeated foreground/reconnect signals describe the same desired
+				// catch-up. Do not accumulate full sync jobs behind live traffic.
+				if active == nil || cmd.Cmd == constant.CmdConnSuccesss || cmd.Cmd == cmdSyncAuxiliaryMetadata ||
+					(active.Cmd == cmdReconcileMessageSeq && messageSyncPriority(cmd.Cmd) > 1) {
+					pending = coalesceMessageSync(pending, cmd)
+				}
+				if active != nil && active.Cmd == cmdReconcileMessageSeq && messageSyncPriority(cmd.Cmd) > 1 {
+					stop()
+				}
+				continue
+			}
+			if active != nil {
+				if protected || reserveProgress || (pageOwner != nil && pageOwner.bounded.Load()) {
+					queued = append(queued, cmd)
+					if !protected && !reserveProgress && preemption == nil {
+						preemption = time.NewTimer(100 * time.Millisecond)
+						preempt = preemption.C
+					}
+					continue
+				}
+				resume := *active
+				if pending == nil {
+					pending = &resume
+				}
+				// Metadata/max-sequence I/O must also get an uninterrupted retry.
+				reserveProgress = true
+				stop()
+			}
+			handle(cmd)
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_scheduler_test.go b/internal/interaction/msg_sync_scheduler_test.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_scheduler_test.go
@@ -0,0 +1,149 @@
+package interaction
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func TestLivePushPreemptsSyncWithoutConcurrentStateOwners(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 8)
+	started, live, resumed, done := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var owners, attempts atomic.Int32
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if owners.Add(1) != 1 {
+				t.Error("concurrent sequence owners")
+			}
+			defer owners.Add(-1)
+			if cmd.Cmd == constant.CmdPushMsg {
+				close(live)
+				return
+			}
+			if attempts.Add(1) == 1 {
+				close(started)
+			} else {
+				close(resumed)
+			}
+			<-cmd.Ctx.Done()
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	<-started
+	for i := 0; i < 5; i++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	}
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	select {
+	case <-live:
+	case <-time.After(time.Second):
+		t.Fatal("sync blocked live push")
+	}
+	select {
+	case <-resumed:
+	case <-time.After(time.Second):
+		t.Fatal("interrupted sync was lost")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("logout did not stop sync")
+	}
+	if attempts.Load() != 2 {
+		t.Fatalf("duplicate sync signals queued %d jobs", attempts.Load())
+	}
+}
+
+func TestLivePushArrivesWhileNativeSyncNetworkIsStalled(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	c := &LongConnMgr{send: make(chan Message, 4)}
+	m := &MsgSyncer{ctx: ctx, loginUserID: "self", longConnMgr: c,
+		recvCh: make(chan common.Cmd2Value, 4), conversationCh: make(chan common.Cmd2Value, 4),
+		syncedMaxSeqs: map[string]int64{"chat": 5}}
+	delivered := make(chan int64, 4)
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if cmd.Cmd == constant.CmdNewMsgCome {
+			for _, msg := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs["chat"].Msgs {
+				delivered <- msg.Seq
+			}
+		}
+		return nil
+	})
+	done := make(chan struct{})
+	go func() { defer close(done); m.DoListener(ctx) }()
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	// Leave the sequence request unanswered. A live push must not wait for its
+	// network timeout, and the catch-up request must resume after delivery.
+	select {
+	case <-c.send:
+	case <-ctx.Done():
+		t.Fatal("sync never started")
+	}
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg,
+		Value: &sdkws.PushMessages{Msgs: recoveryMsgs("chat", 6)}}
+	select {
+	case seq := <-delivered:
+		if seq != 6 {
+			t.Fatalf("unexpected sequence %d", seq)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("live message waited behind sync network request")
+	}
+	select {
+	case <-c.send:
+	case <-time.After(time.Second):
+		t.Fatal("sync was not resumed")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("listener failed to exit")
+	}
+	if m.syncedMaxSeqs["chat"] != 6 {
+		t.Fatal("live storage acknowledgement not committed")
+	}
+}
+
+func TestReconnectDuringSyncIsRetained(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value)
+	started, release, reconnected, done := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdWakeUpDataSync {
+				close(started)
+				select {
+				case <-release:
+				case <-cmd.Ctx.Done():
+				}
+			} else {
+				close(reconnected)
+			}
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	<-started
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdConnSuccesss}
+	close(release)
+	select {
+	case <-reconnected:
+	case <-time.After(time.Second):
+		t.Fatal("new connection event was discarded")
+	}
+	cancel()
+	<-done
+}
