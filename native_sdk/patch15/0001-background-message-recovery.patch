@@ -0,0 +1,79 @@
+package interaction
+
+import (
+	"context"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func TestPullMissingConversationDoesNotAdvanceAndCanRetry(t *testing.T) {
+	for _, kind := range []string{"normal", "notification"} {
+		t.Run(kind, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value),
+				syncedMaxSeqs: map[string]int64{"chat": 998, "n_chat": 998}}
+			receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+			ranges := map[string][2]int64{"chat": {999, 1000}, "n_chat": {999, 1000}}
+			resp := &sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 999, 1000),
+				NotificationMsgs: recoveryMsgs("n_chat", 999, 1000)}
+			missingID := "chat"
+			if kind == "normal" {
+				resp.Msgs = nil
+			} else {
+				missingID = "n_chat"
+				resp.NotificationMsgs = nil
+			}
+			if err := m.commitPulledMessages(ctx, resp, ranges, 0); err == nil {
+				t.Fatal("omitted requested conversation accepted as complete")
+			}
+			if m.syncedMaxSeqs[missingID] != 998 {
+				t.Fatal("missing response advanced the cursor")
+			}
+			if kind == "notification" && m.syncedMaxSeqs["chat"] != 1000 {
+				t.Fatal("successfully persisted normal range was not committed")
+			}
+			resp.Msgs = recoveryMsgs("chat", 999, 1000)
+			resp.NotificationMsgs = recoveryMsgs("n_chat", 999, 1000)
+			if err := m.commitPulledMessages(ctx, resp, ranges, 0); err != nil {
+				t.Fatal(err)
+			}
+			if m.syncedMaxSeqs["chat"] != 1000 || m.syncedMaxSeqs["n_chat"] != 1000 {
+				t.Fatal("complete retry did not commit")
+			}
+		})
+	}
+}
+
+func TestPullExplicitDeletedSequencePlaceholdersCanCommit(t *testing.T) {
+	m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 998, "n_chat": 998}}
+	receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+	resp := &sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 999, 1000),
+		NotificationMsgs: recoveryMsgs("n_chat", 999, 1000)}
+	for _, p := range []*sdkws.PullMsgs{resp.Msgs["chat"], resp.NotificationMsgs["n_chat"]} {
+		for _, m := range p.Msgs {
+			m.Status = constant.MsgStatusHasDeleted
+		}
+	}
+	if err := m.commitPulledMessages(recoveryContext(t), resp,
+		map[string][2]int64{"chat": {999, 1000}, "n_chat": {999, 1000}}, 0); err != nil {
+		t.Fatal(err)
+	}
+	if m.syncedMaxSeqs["chat"] != 1000 || m.syncedMaxSeqs["n_chat"] != 1000 {
+		t.Fatal("explicit empty range could not complete")
+	}
+}
+
+func TestPullAbsentOrNilConversationCannotCommit(t *testing.T) {
+	for _, resp := range []*sdkws.PullMessageBySeqsResp{nil, {}, {Msgs: map[string]*sdkws.PullMsgs{"chat": nil}}} {
+		m := &MsgSyncer{syncedMaxSeqs: map[string]int64{"chat": 998}}
+		if err := m.commitPulledMessages(context.Background(), resp, map[string][2]int64{"chat": {999, 1000}}, 0); err == nil {
+			t.Fatal("absent response accepted")
+		}
+		if m.syncedMaxSeqs["chat"] != 998 {
+			t.Fatal("absent response changed cursor")
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_diagnostics.go b/internal/interaction/msg_sync_diagnostics.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_diagnostics.go
@@ -0,0 +1,110 @@
+package interaction
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/log"
+)
+
+// Diagnostics deliberately contain no message bodies, tokens or member profiles.
+// One command owns this state; live pushes get a different context.
+type syncDiagnosticKey struct{}
+type syncDiagnostic struct {
+	id                         uint64
+	started                    time.Time
+	pulls, mismatches, samples int
+}
+
+var syncDiagnosticSequence atomic.Uint64
+
+func beginSyncDiagnostic(ctx context.Context, command string, initial bool) (context.Context, func()) {
+	d := &syncDiagnostic{id: syncDiagnosticSequence.Add(1), started: time.Now()}
+	ctx = context.WithValue(ctx, syncDiagnosticKey{}, d)
+	log.ZInfo(ctx, "sync_diag attempt_start", "attempt", d.id, "command", command, "initial", initial)
+	return ctx, func() {
+		log.ZInfo(ctx, "sync_diag attempt_end", "attempt", d.id, "elapsed", time.Since(d.started).String(),
+			"pulls", d.pulls, "coverageMismatches", d.mismatches, "samples", d.samples, "cancelled", ctx.Err() != nil)
+	}
+}
+
+type syncPacketDiagnostic struct {
+	Present bool  `json:"present"`
+	Count   int   `json:"count"`
+	IsEnd   bool  `json:"isEnd"`
+	EndSeq  int64 `json:"endSeq"`
+	MinSeq  int64 `json:"minSeq"`
+	MaxSeq  int64 `json:"maxSeq"`
+	Deleted int   `json:"deleted"`
+	NilRows int   `json:"nilRows"`
+}
+
+func describeSyncPacket(packet *sdkws.PullMsgs) syncPacketDiagnostic {
+	if packet == nil {
+		return syncPacketDiagnostic{}
+	}
+	s := syncPacketDiagnostic{Present: true, Count: len(packet.Msgs), IsEnd: packet.IsEnd, EndSeq: packet.EndSeq}
+	for _, row := range packet.Msgs {
+		if row == nil {
+			s.NilRows++
+			continue
+		}
+		if s.MinSeq == 0 || row.Seq < s.MinSeq {
+			s.MinSeq = row.Seq
+		}
+		if row.Seq > s.MaxSeq {
+			s.MaxSeq = row.Seq
+		}
+		if row.Status >= 4 {
+			s.Deleted++
+		}
+	}
+	return s
+}
+
+func (m *MsgSyncer) diagnoseSyncPull(ctx context.Context, ranges map[string][2]int64, resp *sdkws.PullMessageBySeqsResp, elapsed time.Duration, pullErr error) {
+	d, _ := ctx.Value(syncDiagnosticKey{}).(*syncDiagnostic)
+	if d == nil {
+		return
+	}
+	d.pulls++
+	missing, incomplete := 0, 0
+	for id, requested := range ranges {
+		var packet *sdkws.PullMsgs
+		if resp != nil {
+			if IsNotification(id) {
+				packet = resp.NotificationMsgs[id]
+			} else {
+				packet = resp.Msgs[id]
+			}
+		}
+		if packet == nil {
+			missing++
+		}
+		if pullErr == nil && validatePulledConversationCoverage(map[string]*sdkws.PullMsgs{id: packet}, map[string][2]int64{id: requested}, IsNotification(id)) == nil {
+			continue
+		}
+		incomplete++
+		d.mismatches++
+		if d.samples >= 12 {
+			continue
+		}
+		d.samples++
+		fields := []any{"attempt", d.id, "pull", d.pulls, "conversationID", id, "requested", requested,
+			"packet", describeSyncPacket(packet), "syncedSeq", m.syncedMaxSeqs[id], "checkpoint", m.checkpoints[id], "elapsed", elapsed.String()}
+		if m.db != nil {
+			conversation, err := m.db.GetConversation(ctx, id)
+			fields = append(fields, "localReadFailed", err != nil)
+			if conversation != nil {
+				fields = append(fields, "localMinSeq", conversation.MinSeq, "localMaxSeq", conversation.MaxSeq)
+			}
+		}
+		log.ZWarn(ctx, "sync_diag coverage_sample", pullErr, fields...)
+	}
+	if d.pulls <= 3 || d.pulls%100 == 0 || (incomplete > 0 && d.samples < 12) || elapsed > 2*time.Second {
+		log.ZInfo(ctx, "sync_diag pull_summary", "attempt", d.id, "pull", d.pulls, "requestedConversations", len(ranges),
+			"missingPackets", missing, "incompletePackets", incomplete, "elapsed", elapsed.String(), "transportFailed", pullErr != nil)
+	}
+}
