+		return nil, errors.New("missing")
+	}
+	r := *d.row
+	return &r, nil
+}
+func (d *auditResumeDB) InsertUpload(_ context.Context, r *model_struct.LocalUpload) error {
+	v := *r
+	d.row = &v
