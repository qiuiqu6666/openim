+func (c *msgUploadFileCallback) UploadID(uploadID string) {
+	c.msg.AttachedInfoElem.Progress.UploadID = uploadID
+	data, err := json.Marshal(c.msg.AttachedInfoElem)
+	if err != nil {
+		panic(err)
