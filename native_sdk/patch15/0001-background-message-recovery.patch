+	defer qpsMutex.Unlock()
+
+	now := time.Now()
+	// If more than 1 second has passed since the last update, reset the counter.
+	if now.Sub(qpsUpdateTime) >= time.Second {
+		QPSChan <- qpsCounter
+		qpsCounter = 0
+		qpsUpdateTime = now
+		//log.ZError(context.Background(), "QPS", nil, "qps", "timer")
+
+	}
+	qpsCounter++
+}
+
+func GetQPS() int64 {
+	qpsMutex.Lock()
+	defer qpsMutex.Unlock()
+
+	return qpsCounter
+}
