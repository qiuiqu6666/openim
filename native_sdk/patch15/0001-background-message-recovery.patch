new file mode 100644
--- /dev/null
+++ b/internal/interaction/connection_telemetry.go
@@ -0,0 +1,58 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"github.com/openimsdk/tools/log"
+	"net"
+	"sync/atomic"
+	"time"
+)
+
+type connectionTelemetry struct {
+	attempts       atomic.Int64
+	connectedAt    atomic.Int64
+	lastPing       atomic.Int64
+	lastPong       atomic.Int64
+	lastMessage    atomic.Int64
+	lastDisconnect atomic.Int64
+}
+
+func observedConnectionError(err error) string {
+	var dns *net.DNSError
+	if errors.As(err, &dns) {
+		return "dns_error"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "session_cancelled"
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return "transport_timeout"
+	}
+	return "transport_error"
+}
+
+func (m *connectionTelemetry) connected(ctx context.Context, background bool) {
+	now := time.Now().UnixMilli()
+	m.connectedAt.Store(now)
+	m.lastPing.Store(0)
+	m.lastPong.Store(0)
+	m.lastMessage.Store(0)
+	var recoveryMS int64
+	if disconnected := m.lastDisconnect.Load(); disconnected > 0 {
+		recoveryMS = now - disconnected
+	}
+	log.ZInfo(ctx, "connection_recovered", "connectedAtMs", now, "attempts", m.attempts.Swap(0), "recoveryMs", recoveryMS, "background", background)
+}
+
+func (m *connectionTelemetry) disconnected(ctx context.Context, err error, background bool) {
+	now := time.Now().UnixMilli()
+	m.lastDisconnect.Store(now)
+	code, received := transportCloseCode(err)
+	log.ZWarn(ctx, "connection_disconnected", err,
+		"disconnectedAtMs", now, "connectedAtMs", m.connectedAt.Load(),
+		"observedError", observedConnectionError(err), "confirmedReason", "unknown",
+		"closeCode", code, "closeFrameReceived", received, "background", background,
+		"lastPingAtMs", m.lastPing.Load(), "lastPongAtMs", m.lastPong.Load(), "lastMessageAtMs", m.lastMessage.Load())
+}
diff --git a/internal/interaction/history_priority.go b/internal/interaction/history_priority.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/history_priority.go
@@ -0,0 +1,297 @@
+package interaction
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/converter"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"sort"
+	"sync"
+)
+
+// Session-owned coordination: history reads and recovery share one lane per
+// conversation. Only durably stored foreground rows are advertised as covered.
+// No process-global account state or second message store is introduced.
+type historyPriority struct {
+	mu      sync.Mutex
+	lanes   map[string]*historyLane
+	covered map[string][]int64
+	order   []string
+}
+type historyLane struct {
+	token            chan struct{}
+	refs, foreground int
+}
+
+func (l *LongConnMgr) LockMessageHistory(ctx context.Context, id string, foreground bool) (func(), error) {
+	if l == nil {
+		return func() {}, ctx.Err()
+	}
+	p := &l.historyPriority
+	p.mu.Lock()
+	if p.lanes == nil {
+		p.lanes = make(map[string]*historyLane)
+	}
+	lane := p.lanes[id]
+	if lane == nil {
+		lane = &historyLane{token: make(chan struct{}, 1)}
+		lane.token <- struct{}{}
+		p.lanes[id] = lane
+	}
+	lane.refs++
+	if foreground {
+		lane.foreground++
+	}
+	p.mu.Unlock()
+	drop := func() {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		lane.refs--
+		if foreground {
+			lane.foreground--
+		}
+		if lane.refs == 0 {
+			delete(p.lanes, id)
+		}
+	}
+	select {
+	case <-ctx.Done():
+		drop()
+		return nil, ctx.Err()
+	case <-lane.token:
+	}
+	if err := ctx.Err(); err != nil {
+		lane.token <- struct{}{}
+		drop()
+		return nil, err
+	}
+	var once sync.Once
+	return func() { once.Do(func() { lane.token <- struct{}{}; drop() }) }, nil
+}
+
+func (l *LongConnMgr) RememberHistoryRows(id string, seqs []int64) {
+	if l == nil || len(seqs) == 0 {
+		return
+	}
+	p := &l.historyPriority
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.covered == nil {
+		p.covered = make(map[string][]int64)
+	}
+	if _, ok := p.covered[id]; !ok {
+		if len(p.order) >= 128 {
+			delete(p.covered, p.order[0])
+			p.order = p.order[1:]
+		}
+		p.order = append(p.order, id)
+	}
+	seen := make(map[int64]bool)
+	for _, s := range append(append([]int64(nil), p.covered[id]...), seqs...) {
+		if s > 0 {
+			seen[s] = true
+		}
+	}
+	rows := make([]int64, 0, len(seen))
+	for s := range seen {
+		rows = append(rows, s)
+	}
+	sort.Slice(rows, func(i, j int) bool { return rows[i] < rows[j] })
+	if len(rows) > recentMessageWindow {
+		rows = rows[len(rows)-recentMessageWindow:]
+	}
+	p.covered[id] = rows
+}
+
+func (l *LongConnMgr) storedHistoryRanges(id string, r [2]int64) [][2]int64 {
+	if l == nil {
+		return nil
+	}
+	p := &l.historyPriority
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	var ranges [][2]int64
+	for _, s := range p.covered[id] {
+		if s < r[0] || s > r[1] {
+			continue
+		}
+		if len(ranges) > 0 && ranges[len(ranges)-1][1]+1 == s {
+			ranges[len(ranges)-1][1] = s
+		} else {
+			ranges = append(ranges, [2]int64{s, s})
+		}
+	}
+	return ranges
+}
+
+type syncConversationPriority struct {
+	pinned   bool
+	activity int64
+}
+
+type recoveryPriorityKey struct{}
+
+func recoveryPriorities(ctx context.Context) map[string]syncConversationPriority {
+	priorities, _ := ctx.Value(recoveryPriorityKey{}).(map[string]syncConversationPriority)
+	return priorities
+}
+
+func (m *MsgSyncer) conversationPriorities(ctx context.Context) map[string]syncConversationPriority {
+	result := make(map[string]syncConversationPriority)
+	if m.db == nil {
+		return result
+	}
+	var rows []*model_struct.LocalConversation
+	var err error
+	if reader, ok := m.db.(db_interface.MessageRecoveryBoundsReader); ok {
+		rows, err = reader.GetMessageRecoveryBounds(ctx)
+	} else {
+		rows, err = m.db.GetAllConversationListDB(ctx)
+	}
+	if err != nil {
+		return result
+	} // Ordering is optional; synchronization still runs.
+	for _, row := range rows {
+		if row != nil {
+			result[row.ConversationID] = syncConversationPriority{row.IsPinned, row.LatestMsgSendTime}
+		}
+	}
+	return result
+}
+
+func (m *MsgSyncer) prioritizeConversations(ids []string, priorities map[string]syncConversationPriority) {
+	active := make(map[string]bool)
+	if m.longConnMgr != nil {
+		p := &m.longConnMgr.historyPriority
+		p.mu.Lock()
+		for id, lane := range p.lanes {
+			active[id] = lane.foreground > 0
+		}
+		p.mu.Unlock()
+	}
+	sort.SliceStable(ids, func(i, j int) bool {
+		a, b := ids[i], ids[j]
+		if active[a] != active[b] {
+			return active[a]
+		}
+		x, y := priorities[a], priorities[b]
+		if x.pinned != y.pinned {
+			return x.pinned
+		}
+		return x.activity > y.activity
+	})
+}
+
+// Called while holding the same lane as foreground storage. A sparse newest
+// window remains sparse coverage; it must never advance across an older gap.
+func (m *MsgSyncer) acceptStoredHistory(ctx context.Context, id string, r [2]int64, total int) error {
+	if IsNotification(id) {
+		return nil
+	}
+	ranges := m.longConnMgr.storedHistoryRanges(id, r)
+	if len(ranges) == 0 {
+		return nil
+	}
+	if m.db == nil {
+		return nil
+	}
+	var seqs []int64
+	for _, span := range ranges {
+		for s := span[0]; s <= span[1]; s++ {
+			if !m.messageAlreadyCovered(id, s) {
+				seqs = append(seqs, s)
+			}
+		}
+	}
+	if len(seqs) == 0 {
+		return nil
+	}
+	rows, err := m.db.GetMessagesBySeqs(ctx, id, seqs)
+	if err != nil {
+		return err
+	}
+	// Replay through the normal receipt path so adopting history preserves
+	// conversation previews, unread reconciliation and durable acknowledgements.
+	// Revalidate SQLite: clear-history may have removed a remembered row.
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i] == nil {
+			return false
+		}
+		if rows[j] == nil {
+			return true
+		}
+		return rows[i].Seq < rows[j].Seq
+	})
+	var groups [][]*sdkws.MsgData
+	for _, row := range rows {
+		if row == nil || row.Seq < r[0] || row.Seq > r[1] {
+			continue
+		}
+		data := converter.MsgStructToMsgData(converter.LocalChatLogToMsgStruct(row), nil)
+		if len(groups) > 0 && groups[len(groups)-1][len(groups[len(groups)-1])-1].Seq+1 == row.Seq {
+			groups[len(groups)-1] = append(groups[len(groups)-1], data)
+		} else {
+			groups = append(groups, []*sdkws.MsgData{data})
+		}
+	}
+	for _, group := range groups {
+		resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{id: {Msgs: group}}}
+		if err = m.commitPulledMessages(ctx, resp, map[string][2]int64{id: {group[0].Seq, group[len(group)-1].Seq}}, total, true); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (m *MsgSyncer) syncPrioritizedPage(ctx context.Context, id string, r [2]int64, total int) error {
+	release, err := m.longConnMgr.LockMessageHistory(ctx, id, false)
+	if err != nil {
+		return err
+	}
+	defer release()
+	if err = m.acceptStoredHistory(ctx, id, r, total); err != nil {
+		return err
+	}
+	pages := [][2]int64{r}
+	if !IsNotification(id) {
+		pages = m.recentMissingRanges(id, r)
+	}
+	for _, page := range pages {
+		batch := map[string][2]int64{id: page}
+		resp, err := m.pullMsgBySeqRange(ctx, batch, page[1]-page[0]+1)
+		if err != nil {
+			return err
+		}
+		if err = m.commitPulledMessages(ctx, resp, batch, total); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (m *MsgSyncer) lockPreviewHistory(ctx context.Context, batch map[string][2]int64) (func(), error) {
+	ids := make([]string, 0, len(batch))
+	for id := range batch {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	var releases []func()
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			for i := len(releases) - 1; i >= 0; i-- {
+				releases[i]()
+			}
+		})
+	}
+	for _, id := range ids {
+		unlock, err := m.longConnMgr.LockMessageHistory(ctx, id, false)
+		if err != nil {
+			release()
+			return nil, err
+		}
+		releases = append(releases, unlock)
+	}
+	return release, nil
+}
diff --git a/internal/interaction/history_priority_test.go b/internal/interaction/history_priority_test.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/history_priority_test.go
@@ -0,0 +1,231 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+type priorityDB struct {
+	*recoveryVersionDB
+	conversations []*model_struct.LocalConversation
+	rows          map[int64]*model_struct.LocalChatLog
+	readErr       error
+}
+
+func (d *priorityDB) GetAllConversationListDB(context.Context) ([]*model_struct.LocalConversation, error) {
+	return d.conversations, d.readErr
+}
+func (d *priorityDB) GetMessagesBySeqs(_ context.Context, _ string, seqs []int64) ([]*model_struct.LocalChatLog, error) {
+	var rows []*model_struct.LocalChatLog
+	for _, s := range seqs {
+		if row := d.rows[s]; row != nil {
+			rows = append(rows, row)
+		}
+	}
+	return rows, d.readErr
+}
+
+func TestHistoryPriorityActivePinnedRecentAndCancellation(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{}
+	m := &MsgSyncer{longConnMgr: conn, db: &priorityDB{conversations: []*model_struct.LocalConversation{
+		{ConversationID: "pinned", IsPinned: true, LatestMsgSendTime: 1},
+		{ConversationID: "recent", LatestMsgSendTime: 50},
+		{ConversationID: "old", LatestMsgSendTime: 2},
+	}}}
+	priorities := m.conversationPriorities(ctx)
+	release, err := conn.LockMessageHistory(ctx, "opened", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids := []string{"old", "recent", "pinned", "opened"}
+	m.prioritizeConversations(ids, priorities)
+	if !reflect.DeepEqual(ids, []string{"opened", "pinned", "recent", "old"}) {
+		t.Fatal(ids)
+	}
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, err = conn.LockMessageHistory(cancelled, "opened", true); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	release()
+	release()
+	if len(conn.historyPriority.lanes) != 0 {
+		t.Fatal("lane/foreground interest leaked")
+	}
+	m.prioritizeConversations(ids, priorities)
+	if ids[0] != "pinned" {
+		t.Fatal(ids)
+	}
+}
+
+func TestRecentRecoveryWaitsForForegroundAndDownloadsOnlyMissingRows(t *testing.T) {
+	for _, cleared := range []bool{false, true} {
+		t.Run(fmt.Sprint("cleared=", cleared), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			d := &priorityDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, rows: make(map[int64]*model_struct.LocalChatLog)}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, db: d, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+			receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+			var downloaded []int64
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				p := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+					panic(err)
+				}
+				resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+				for _, r := range p.SeqRanges {
+					var seqs []int64
+					for s := r.Begin; s <= r.End; s++ {
+						seqs = append(seqs, s)
+						downloaded = append(downloaded, s)
+					}
+					resp.Msgs[r.ConversationID] = recoveryMsgs(r.ConversationID, seqs...)[r.ConversationID]
+				}
+				return wireResponse(resp)
+			})
+			release, err := conn.LockMessageHistory(ctx, "chat", true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			done := make(chan error, 1)
+			go func() { done <- m.syncPrioritizedPage(ctx, "chat", [2]int64{201, 300}, 0) }()
+			select {
+			case err := <-done:
+				t.Fatalf("recovery bypassed foreground storage: %v", err)
+			case <-time.After(10 * time.Millisecond):
+			}
+			var stored []int64
+			for s := int64(261); s <= 300; s++ {
+				stored = append(stored, s)
+				if !cleared {
+					d.rows[s] = &model_struct.LocalChatLog{ClientMsgID: fmt.Sprint(s), Seq: s, SendTime: s, ContentType: constant.Text, Content: `{"content":"local"}`, Status: constant.MsgStatusSendSuccess}
+				}
+			}
+			conn.RememberHistoryRows("chat", stored)
+			release()
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			want := 60
+			if cleared {
+				want = 100
+			}
+			if len(downloaded) != want {
+				t.Fatalf("downloaded %d want %d: %v", len(downloaded), want, downloaded)
+			}
+			if m.syncedMaxSeqs["chat"] != 0 {
+				t.Fatal("recent cache falsely consumed old gap")
+			}
+			if !m.messageAlreadyCovered("chat", 300) {
+				t.Fatal("tail missing")
+			}
+		})
+	}
+}
+
+func TestRecoveryPriorityOrdersRealHistoryRequests(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	d := &priorityDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, conversations: []*model_struct.LocalConversation{
+		{ConversationID: "z_pin", IsPinned: true, LatestMsgSendTime: 1},
+		{ConversationID: "y_recent", LatestMsgSendTime: 99},
+		{ConversationID: "a_old", LatestMsgSendTime: 2},
+	}}
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, db: d, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+	receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+	var history []string
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		p := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+			panic(err)
+		}
+		resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+		for _, r := range p.SeqRanges {
+			if r.Begin != r.End {
+				history = append(history, r.ConversationID)
+			}
+			var seqs []int64
+			for s := r.Begin; s <= r.End; s++ {
+				seqs = append(seqs, s)
+			}
+			resp.Msgs[r.ConversationID] = recoveryMsgs(r.ConversationID, seqs...)[r.ConversationID]
+		}
+		return wireResponse(resp)
+	})
+	if err := m.syncCompleteMessageRanges(ctx, map[string][2]int64{"a_old": {1, 10}, "y_recent": {1, 10}, "z_pin": {1, 10}}, false); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(history, []string{"z_pin", "y_recent", "a_old"}) {
+		t.Fatal(history)
+	}
+}
+
+func TestHistoryCoordinationIsBoundedAndSessionIsolated(t *testing.T) {
+	first, second := &LongConnMgr{}, &LongConnMgr{}
+	for n := 0; n < 150; n++ {
+		var seqs []int64
+		for s := int64(1); s <= 200; s++ {
+			seqs = append(seqs, s)
+		}
+		first.RememberHistoryRows(fmt.Sprint(n), seqs)
+	}
+	if len(first.historyPriority.covered) != 128 || len(first.historyPriority.covered["149"]) != 100 {
+		t.Fatal("unbounded coverage")
+	}
+	if len(second.storedHistoryRanges("149", [2]int64{1, 200})) != 0 {
+		t.Fatal("cross-session coverage")
+	}
+}
+
+func TestForegroundPreviewAdoptionRequiresReceiptAndRetriesWithoutDownload(t *testing.T) {
+	ctx, cancel := context.WithTimeout(recoveryContext(t), time.Second)
+	defer cancel()
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	d := &priorityDB{recoveryVersionDB: &recoveryVersionDB{}, rows: map[int64]*model_struct.LocalChatLog{
+		100: {ClientMsgID: "m100", Seq: 100, ContentType: constant.Text, Content: `{"content":"kept"}`, Status: constant.MsgStatusSendSuccess},
+	}}
+	conn.RememberHistoryRows("chat", []int64{100})
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, db: d, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+	var fail atomic.Bool
+	fail.Store(true)
+	receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error {
+		if fail.Load() {
+			return errors.New("storage failed")
+		}
+		return nil
+	})
+	run := func() error {
+		return m.syncLatestMessageBatch(ctx, map[string][2]int64{"chat": {100, 100}}, map[string][2]int64{"chat": {1, 100}}, 1, map[string]error{})
+	}
+	if err := run(); err == nil {
+		t.Fatal("failed receipt accepted")
+	}
+	if m.messageAlreadyCovered("chat", 100) {
+		t.Fatal("failed receipt consumed coverage")
+	}
+	fail.Store(false)
+	if err := run(); err != nil {
+		t.Fatal(err)
+	}
+	if len(conn.send) != 0 {
+		t.Fatal("already stored latest preview downloaded twice")
+	}
+	if !m.messageAlreadyCovered("chat", 100) {
+		t.Fatal("retry lost preview")
+	}
+	if len(conn.historyPriority.lanes) != 0 {
+		t.Fatal("failed/retried preview leaked lane")
+	}
+}
