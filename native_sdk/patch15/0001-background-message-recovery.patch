@@ -0,0 +1,73 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+)
+
+type startupSnapshotDB struct {
+	*recoveryVersionDB
+	ids           []string
+	reads, legacy int
+	failure       error
+}
+
+func (d *startupSnapshotDB) GetAllConversationIDList(context.Context) ([]string, error) {
+	return d.ids, nil
+}
+func (d *startupSnapshotDB) GetMessageRecoveryVersions(context.Context, string) ([]*model_struct.LocalVersionSync, error) {
+	d.reads++
+	if d.failure != nil {
+		return nil, d.failure
+	}
+	var rows []*model_struct.LocalVersionSync
+	for _, row := range d.journal {
+		rows = append(rows, row)
+	}
+	return rows, nil
+}
+func (d *startupSnapshotDB) CheckConversationNormalMsgSeq(_ context.Context, id string) (int64, error) {
+	if id != "legacy" {
+		panic("persisted coverage queried MAX(seq)")
+	}
+	d.legacy++
+	return 99, nil
+}
+func (d *startupSnapshotDB) GetVersionSync(context.Context, string, string) (*model_struct.LocalVersionSync, error) {
+	panic("snapshot performed per-record checkpoint reads")
+}
+
+func TestStartupUsesOneCheckpointSnapshotAndPreservesLegacyGaps(t *testing.T) {
+	ctx := recoveryContext(t)
+	d := &startupSnapshotDB{recoveryVersionDB: &recoveryVersionDB{installed: true, journal: make(map[string]*model_struct.LocalVersionSync)}}
+	for n := 0; n < 1000; n++ {
+		id := fmt.Sprintf("sg_%04d", n)
+		d.ids = append(d.ids, id)
+		d.journal[id] = &model_struct.LocalVersionSync{EntityID: "conversation:" + id, VersionID: `{"completed":5,"target":1000,"covered":[[901,1000]]}`}
+	}
+	d.ids = append(d.ids, "legacy")
+	m, err := NewMsgSyncer(ctx, nil, nil, "self", nil, d, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d.reads != 1 || d.legacy != 1 {
+		t.Fatalf("startup reads=%d legacy=%d", d.reads, d.legacy)
+	}
+	if m.syncedMaxSeqs["sg_0000"] != 5 || m.checkpoints["sg_0000"].Target != 1000 || !m.messageAlreadyCovered("sg_0000", 999) {
+		t.Fatal("durable sparse coverage changed")
+	}
+	if m.syncedMaxSeqs["legacy"] != 0 || m.checkpoints["legacy"].Target != 99 {
+		t.Fatal("legacy MAX(seq) was mistaken for coverage")
+	}
+}
+
+func TestStartupSnapshotFailureDoesNotPretendCoverageWasLoaded(t *testing.T) {
+	d := &startupSnapshotDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, failure: errors.New("disk read failed")}
+	if _, err := NewMsgSyncer(recoveryContext(t), nil, nil, "self", nil, d, 0); err == nil {
+		t.Fatal("snapshot failure was swallowed")
+	}
+}
diff --git a/internal/interaction/msg_sync_visibility_batch.go b/internal/interaction/msg_sync_visibility_batch.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_visibility_batch.go
@@ -0,0 +1,162 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"sort"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+)
+
+// Only explicit authenticated directional boundaries can shrink a range. Batch
+// the same protocol across chats; a missing packet is an error for that chat.
+func (m *MsgSyncer) visibleMessageRanges(ctx context.Context, ranges map[string][2]int64) (map[string][2]int64, map[string]error, []string) {
+	visible, conflicts := make(map[string][2]int64), make(map[string][2]int64)
+	failed := make(map[string]error)
+	ids := make([]string, 0, len(ranges))
+	for id := range ranges {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	var cached map[string]*model_struct.LocalConversation
+	if reader, ok := m.db.(db_interface.MessageRecoveryBoundsReader); ok {
+		rows, err := reader.GetMessageRecoveryBounds(ctx)
+		if err != nil {
+			for _, id := range ids {
+				failed[id] = err
+			}
+			return visible, failed, ids
+		}
+		cached = make(map[string]*model_struct.LocalConversation, len(rows))
+		for _, row := range rows {
+			if row != nil {
+				cached[row.ConversationID] = row
+			}
+		}
+		// Recent/pinned chats reach the first batch before dormant history.
+		sort.SliceStable(ids, func(i, j int) bool {
+			a, b := cached[ids[i]], cached[ids[j]]
+			if a == nil {
+				return false
+			}
+			if b == nil {
+				return true
+			}
+			if a.IsPinned != b.IsPinned {
+				return a.IsPinned
+			}
+			return a.LatestMsgSendTime > b.LatestMsgSendTime
+		})
+	}
+	for _, id := range ids {
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			failed[id] = err
+			continue
+		}
+		r := ranges[id]
+		r[0] = max(1, r[0])
+		if m.db != nil && !IsNotification(id) {
+			var row *model_struct.LocalConversation
+			var err error
+			if cached != nil {
+				row = cached[id]
+			} else {
+				row, err = m.db.GetConversation(ctx, id)
+			}
+			if err != nil && !errors.Is(err, errs.ErrRecordNotFound) {
+				failed[id] = err
+				continue
+			}
+			if row != nil {
+				r[0] = max(r[0], row.MinSeq)
+				if row.MaxSeq > 0 && r[1] > row.MaxSeq {
+					conflicts[id] = r
+				}
+			}
+		}
+		visible[id] = r
+	}
+	m.prioritizeConversations(ids, nil)
+	if len(conflicts) == 0 {
+		return visible, failed, ids
+	}
+	var conflictingIDs []string
+	for _, id := range ids {
+		if _, ok := conflicts[id]; ok {
+			conflictingIDs = append(conflictingIDs, id)
+		}
+	}
+	for begin := 0; begin < len(conflictingIDs); begin += latestMessageBatchSize {
+		batch := make(map[string][2]int64)
+		for _, id := range conflictingIDs[begin:min(begin+latestMessageBatchSize, len(conflictingIDs))] {
+			batch[id] = conflicts[id]
+		}
+		m.resolveVisibilityBatch(ctx, batch, failed)
+		for id, r := range batch {
+			if failed[id] == nil {
+				visible[id] = r
+			}
+		}
+	}
+	return visible, failed, ids
+}
+
+func (m *MsgSyncer) resolveVisibilityBatch(ctx context.Context, ranges map[string][2]int64, failed map[string]error) {
+	for _, ascending := range []bool{false, true} {
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			for id := range ranges {
+				failed[id] = err
+			}
+			return
+		}
+		order := sdkws.PullOrder_PullOrderDesc
+		if ascending {
+			order = sdkws.PullOrder_PullOrderAsc
+		}
+		req := &msg.GetSeqMessageReq{UserID: m.loginUserID, Order: order}
+		for id, r := range ranges {
+			if failed[id] != nil || r[0] > r[1] {
+				continue
+			}
+			seq := r[0]
+			if ascending {
+				seq = r[1]
+			}
+			req.Conversations = append(req.Conversations, &msg.ConversationSeqs{ConversationID: id, Seqs: []int64{seq}})
+		}
+		if len(req.Conversations) == 0 {
+			return
+		}
+		var resp msg.GetSeqMessageResp
+		if err := m.longConnMgr.SendReqWaitResp(ctx, req, constant.PullMsgBySeqList, &resp); err != nil {
+			for _, row := range req.Conversations {
+				failed[row.ConversationID] = err
+			}
+			return
+		}
+		for _, row := range req.Conversations {
+			id := row.ConversationID
+			packet := resp.Msgs[id]
+			if packet == nil || packet.EndSeq < 0 {
+				failed[id] = fmt.Errorf("invalid visibility response for %q", id)
+				continue
+			}
+			if !packet.IsEnd {
+				continue
+			}
+			r := ranges[id]
+			if ascending {
+				r[1] = min(r[1], packet.EndSeq)
+			} else {
+				r[0] = max(r[0], packet.EndSeq)
+			}
+			ranges[id] = r
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_visible_empty.go b/internal/interaction/msg_sync_visible_empty.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_visible_empty.go
@@ -0,0 +1,101 @@
+package interaction
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/log"
+)
+
+// An empty preview alone is not coverage. Revalidate its full pending window
+// through the authenticated directional history API. This preserves cleared or
+// membership-restricted history without waiving genuine holes or transport errors.
+func (m *MsgSyncer) resolveEmptySyncPreviews(ctx context.Context, batch, visible map[string][2]int64, resp *sdkws.PullMessageBySeqsResp) error {
+	if resp == nil {
+		return nil
+	}
+	pending := make(map[string][2]int64)
+	for id := range batch {
+		if packet := resp.Msgs[id]; packet != nil && len(packet.Msgs) == 0 {
+			pending[id] = visible[id]
+		}
+	}
+	if len(pending) == 0 {
+		return nil
+	}
+	closed := 0
+	for _, ascending := range []bool{false, true} {
+		req := &msg.GetSeqMessageReq{UserID: m.loginUserID, Order: sdkws.PullOrder_PullOrderDesc}
+		if ascending {
+			req.Order = sdkws.PullOrder_PullOrderAsc
+		}
+		for id, r := range pending {
+			if r[0] > r[1] {
+				continue
+			}
+			seq := r[0]
+			if ascending {
+				seq = r[1]
+			}
+			req.Conversations = append(req.Conversations, &msg.ConversationSeqs{ConversationID: id, Seqs: []int64{seq}})
+		}
+		if len(req.Conversations) == 0 {
+			break
+		}
+		var boundary msg.GetSeqMessageResp
+		if err := m.longConnMgr.SendReqWaitResp(ctx, req, constant.PullMsgBySeqList, &boundary); err != nil {
+			return err
+		}
+		for _, conv := range req.Conversations {
+			packet := boundary.Msgs[conv.ConversationID]
+			if packet == nil || packet.EndSeq < 0 {
+				return fmt.Errorf("invalid empty-preview visibility response for %q", conv.ConversationID)
+			}
+			if !packet.IsEnd {
+				continue
+			}
+			r := pending[conv.ConversationID]
+			if ascending {
+				r[1] = min(r[1], packet.EndSeq)
+			} else {
+				r[0] = max(r[0], packet.EndSeq)
+			}
+			pending[conv.ConversationID] = r
+		}
+	}
+	for id, r := range pending {
+		original := visible[id]
+		tail := batch[id][1]
+		if r[0] <= tail && tail <= r[1] {
+			continue // The missing preview is still readable, so proof is incomplete.
+		}
+		var invisible [][2]int64
+		if r[0] > original[0] {
+			invisible = append(invisible, [2]int64{original[0], min(original[1], r[0]-1)})
+		}
+		if r[1] < original[1] {
+			invisible = append(invisible, [2]int64{max(original[0], r[1]+1), original[1]})
+		}
+		if len(invisible) > 0 {
+			// Directional history proves these sequences are outside visibility.
+			// Record only those ranges: a suffix must never acknowledge older holes.
+			if err := m.commitMessageCoverage(ctx, id, invisible); err != nil {
+				return err
+			}
+			messageSyncPageCommitted(ctx)
+		}
+		// Tightening the upper bound must not expand the automatic recent window
+		// backwards into history which was deliberately left for on-demand reads.
+		r[0] = max(r[0], original[1]-recentMessageWindow+1)
+		visible[id] = r
+		if m.syncedMaxSeqs[id] >= tail || m.messageAlreadyCovered(id, tail) {
+			delete(batch, id)
+			closed++
+		}
+	}
+	log.ZInfo(ctx, "sync_diag empty_previews_revalidated", "candidates", len(pending), "confirmedInvisible", closed, "stillIncomplete", len(pending)-closed)
+	return nil
+}
