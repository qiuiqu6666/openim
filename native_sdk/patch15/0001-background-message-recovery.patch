+
+func TestSelfDeliveryJournalSurvivesLostMemory(t *testing.T) {
+	c, d, callbacks, cmd := selfMessageLossFixture(t)
+	d.conversationErr = errors.New("failed after message write")
+	if err := c.doMsgNew(cmd); err == nil {
