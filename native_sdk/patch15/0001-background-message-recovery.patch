+	}
+	return d.stored, nil
+}
+func (d *recoveryDB) BatchUpdateConversationList(_ context.Context, cs []*model_struct.LocalConversation) error {
+	if d.conversationErr != nil {
+		return d.conversationErr
+	}
+	for _, c := range cs {
+		d.conversation = *c
+	}
+	return nil
