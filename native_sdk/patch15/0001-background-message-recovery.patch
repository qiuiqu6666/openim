@@ -0,0 +1,133 @@
+package interaction
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestEmptyPreviewFailureDoesNotAdvanceCheckpoint(t *testing.T) {
+	for _, disk := range []bool{false, true} {
+		t.Run(fmt.Sprint("disk=", disk), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			db := &recoveryVersionDB{}
+			if disk {
+				db.writeErr = errors.New("disk unavailable")
+			}
+			// checkpointFaultDB fails only the durable completion write.
+			store := &checkpointFaultDB{recoveryVersionDB: db}
+			if disk {
+				store.failCompleted = 4
+			}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, syncedMaxSeqs: map[string]int64{}, db: store}
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if !disk {
+					return &GeneralWsResp{ErrCode: 10001, ErrMsg: "boundary unavailable"}
+				}
+				return wireResponse(&msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{"sg_test": {IsEnd: true, EndSeq: 5}}})
+			})
+			batch := map[string][2]int64{"sg_test": {4, 4}}
+			err := m.resolveEmptySyncPreviews(ctx, batch, map[string][2]int64{"sg_test": {1, 4}}, &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{"sg_test": {}}})
+			if err == nil || m.syncedMaxSeqs["sg_test"] != 0 || len(batch) != 1 {
+				t.Fatal("failed proof/write discarded pending work", err)
+			}
+		})
+	}
+}
+
+func TestEmptyPreviewRequiresAuthoritativeInvisiblePrefix(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		lower             int64
+		terminal, missing bool
+		wantClosed        bool
+	}{
+		{"cleared_history", 5, true, false, true},
+		{"inclusive_boundary_still_readable", 4, true, false, false},
+		{"empty_without_boundary", 5, false, false, false},
+		{"missing_boundary_packet", 5, true, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, syncedMaxSeqs: map[string]int64{}, db: &recoveryVersionDB{}}
+			batch := map[string][2]int64{"sg_test": {4, 4}}
+			visible := map[string][2]int64{"sg_test": {1, 4}}
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier != constant.PullMsgBySeqList {
+					t.Error("unexpected request")
+				}
+				q := &msg.GetSeqMessageReq{}
+				_ = proto.Unmarshal(req.Message.Data, q)
+				p := &sdkws.PullMsgs{IsEnd: tc.terminal, EndSeq: tc.lower}
+				if q.Order == sdkws.PullOrder_PullOrderAsc {
+					p.EndSeq = 4
+				}
+				r := &msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{}}
+				if !tc.missing {
+					r.Msgs["sg_test"] = p
+				}
+				return wireResponse(r)
+			})
+			err := m.resolveEmptySyncPreviews(ctx, batch, visible, &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{"sg_test": {IsEnd: true, EndSeq: 4}}})
+			if tc.missing && err == nil {
+				t.Fatal("missing proof accepted")
+			}
+			if !tc.missing && err != nil {
+				t.Fatal(err)
+			}
+			if tc.wantClosed {
+				if len(batch) != 0 || m.syncedMaxSeqs["sg_test"] != 4 || visible["sg_test"][0] != 5 {
+					t.Fatal("closed prefix not committed")
+				}
+			} else if len(batch) != 1 || m.syncedMaxSeqs["sg_test"] != 0 {
+				t.Fatal("unproven gap acknowledged")
+			}
+		})
+	}
+}
+
+func TestEmptyPreviewsRevalidateInOneBatchAndDoNotRepeat(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, syncedMaxSeqs: map[string]int64{}, db: &recoveryVersionDB{}}
+	targets := map[string]int64{}
+	requests := 0
+	for n := 0; n < 100; n++ {
+		targets[fmt.Sprintf("sg_%03d", n)] = 4
+	}
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		requests++
+		if req.Message.ReqIdentifier == constant.PullMsgByRange {
+			r := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+			for id := range targets {
+				r.Msgs[id] = &sdkws.PullMsgs{IsEnd: true, EndSeq: 4}
+			}
+			return wireResponse(r)
+		}
+		q := &msg.GetSeqMessageReq{}
+		_ = proto.Unmarshal(req.Message.Data, q)
+		if len(q.Conversations) != 100 || q.Order != sdkws.PullOrder_PullOrderDesc {
+			t.Error("not batched")
+		}
+		r := &msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{}}
+		for id := range targets {
+			r.Msgs[id] = &sdkws.PullMsgs{IsEnd: true, EndSeq: 5}
+		}
+		return wireResponse(r)
+	})
+	for n := 0; n < 2; n++ {
+		if err := m.compareSeqsAndBatchSync(ctx, targets, 1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if requests != 2 {
+		t.Fatalf("expected one preview and one boundary batch, got %d", requests)
+	}
+}
diff --git a/internal/interaction/msg_visible_range.go b/internal/interaction/msg_visible_range.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_visible_range.go
@@ -0,0 +1,51 @@
+package interaction
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+// Resolve only from an explicit directional boundary on the existing history
+// protocol. An empty range pull alone never proves deletion or visibility.
+func (m *MsgSyncer) refreshVisibleMessageRange(ctx context.Context, id string, r [2]int64) ([2]int64, error) {
+	return m.longConnMgr.ResolveVisibleMessageRange(ctx, m.loginUserID, id, r)
+}
+
+// ResolveVisibleMessageRange revalidates a conflicting cached bound using the
+// existing directional history protocol. It does not change local checkpoints.
+func (c *LongConnMgr) ResolveVisibleMessageRange(ctx context.Context, userID, id string, r [2]int64) ([2]int64, error) {
+	for _, ascending := range []bool{false, true} {
+		seq, order := r[0], sdkws.PullOrder_PullOrderDesc
+		if ascending {
+			seq, order = r[1], sdkws.PullOrder_PullOrderAsc
+		}
+		var resp msg.GetSeqMessageResp
+		req := &msg.GetSeqMessageReq{UserID: userID, Order: order, Conversations: []*msg.ConversationSeqs{{ConversationID: id, Seqs: []int64{seq}}}}
+		if err := c.SendReqWaitResp(ctx, req, constant.PullMsgBySeqList, &resp); err != nil {
+			return r, err
+		}
+		rows := resp.Msgs[id]
+		if rows == nil {
+			return r, fmt.Errorf("visibility response missing %q", id)
+		}
+		if rows.IsEnd {
+			if rows.EndSeq < 0 {
+				return r, fmt.Errorf("invalid visibility boundary for %q", id)
+			}
+			if ascending && rows.EndSeq < r[1] {
+				r[1] = rows.EndSeq
+			}
+			if !ascending && rows.EndSeq > r[0] {
+				r[0] = rows.EndSeq
+			}
+		}
+		if r[0] > r[1] {
+			break
+		}
+	}
+	return r, nil
+}
diff --git a/internal/interaction/msg_visible_range_test.go b/internal/interaction/msg_visible_range_test.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_visible_range_test.go
@@ -0,0 +1,108 @@
+package interaction
+
+import (
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+func TestVisibilityRecoveryUsesFreshBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name                                                       string
+		completed, cachedMax, target, visibleMin, visibleMax, want int64
+		ambiguous                                                  bool
+	}{
+		{name: "stale upper bound", completed: 10, cachedMax: 10, target: 20, visibleMin: 1, visibleMax: 20, want: 20},
+		{name: "expired prefix within latest window", target: 650, visibleMin: 601, visibleMax: 650, want: 650},
+		{name: "permission upper bound", completed: 10, cachedMax: 10, target: 20, visibleMin: 1, visibleMax: 15, want: 15},
+		{name: "ambiguous empty prefix", target: 650, visibleMin: 601, visibleMax: 650, want: 0, ambiguous: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			d := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, boundary: model_struct.LocalConversation{MaxSeq: tc.cachedMax}}
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, db: d, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": tc.completed}}
+			delivered, pulls, probes := 0, 0, 0
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				for _, batch := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+					for _, row := range batch.Msgs {
+						if row.Seq < tc.visibleMin || row.Seq > tc.visibleMax {
+							t.Errorf("delivered invisible seq %d", row.Seq)
+						}
+						delivered++
+					}
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier == constant.PullMsgBySeqList {
+					probes++
+					p := &msg.GetSeqMessageReq{}
+					if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+						panic(err)
+					}
+					bound := &sdkws.PullMsgs{}
+					seq := p.Conversations[0].Seqs[0]
+					if !tc.ambiguous {
+						if p.Order == sdkws.PullOrder_PullOrderDesc && seq < tc.visibleMin {
+							bound.IsEnd = true
+							bound.EndSeq = tc.visibleMin
+						}
+						if p.Order == sdkws.PullOrder_PullOrderAsc && seq > tc.visibleMax {
+							bound.IsEnd = true
+							bound.EndSeq = tc.visibleMax
+						}
+					}
+					return wireResponse(&msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{"chat": bound}})
+				}
+				pulls++
+				p := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+					panic(err)
+				}
+				r := p.SeqRanges[0]
+				var seqs []int64
+				for s := r.Begin; s <= r.End; s++ {
+					if s >= tc.visibleMin && s <= tc.visibleMax {
+						seqs = append(seqs, s)
+					}
+				}
+				return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seqs...)})
+			})
+			err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": tc.target}, 1)
+			if (err != nil) != tc.ambiguous {
+				t.Fatalf("unexpected sync result: %v", err)
+			}
+			if m.syncedMaxSeqs["chat"] != tc.want || m.checkpoints["chat"].Target != tc.target {
+				t.Fatalf("lost coverage/target: %+v", m.checkpoints["chat"])
+			}
+			wantRows := int(tc.want - max(tc.completed, tc.visibleMin-1))
+			if wantRows < 0 {
+				wantRows = 0
+			}
+			if tc.ambiguous {
+				wantRows = 1
+			} // The valid tail is visible; the unknown older gap remains pending.
+			if delivered != wantRows {
+				t.Fatalf("delivered=%d want=%d", delivered, wantRows)
+			}
+			if probes != 2 {
+				t.Fatalf("boundary resolution must be bounded: %d", probes)
+			}
+			if !tc.ambiguous && tc.want == tc.target {
+				previous := pulls
+				if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": tc.target}, 1); err != nil {
+					t.Fatal(err)
+				}
+				if pulls != previous {
+					t.Fatal("complete interval was fetched again")
+				}
+			}
+		})
+	}
+}
