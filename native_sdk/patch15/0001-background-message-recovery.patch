diff --git a/open_im_sdk/diagnostic_logging.go b/open_im_sdk/diagnostic_logging.go
new file mode 100644
index 00000000..507b637b
--- /dev/null
+++ b/open_im_sdk/diagnostic_logging.go
@@ -0,0 +1,20 @@
+package open_im_sdk
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/logpolicy"
+	"github.com/openimsdk/tools/log"
+	"runtime"
+)
+
+// SetDiagnosticLogging enables metadata-only routine diagnostics for up to 900
+// seconds. Pass zero to stop. Returns the accepted duration. The logger must
+// be configured at Info or more verbose. This does not enable raw Debug/SQL logs.
+func SetDiagnosticLogging(seconds int) int {
+	accepted := logpolicy.Configure(seconds)
+	log.ZInfo(context.Background(), "diagnostic logging configured", "durationSeconds", accepted, "goroutines", runtime.NumGoroutine())
+	return accepted
+}
+
+// GetDiagnosticLoggingSeconds returns the remaining window, or zero when off.
+func GetDiagnosticLoggingSeconds() int { return logpolicy.RemainingSeconds() }
diff --git a/open_im_sdk/diagnostic_logging_test.go b/open_im_sdk/diagnostic_logging_test.go
new file mode 100644
index 00000000..a37c71bd
--- /dev/null
+++ b/open_im_sdk/diagnostic_logging_test.go
@@ -0,0 +1,16 @@
+package open_im_sdk
+
+import "testing"
+
+func TestDiagnosticLoggingPublicControl(t *testing.T) {
+	defer SetDiagnosticLogging(0)
+	if SetDiagnosticLogging(1000000) != 900 {
+		t.Fatal("missing cap")
+	}
+	if n := GetDiagnosticLoggingSeconds(); n < 899 || n > 900 {
+		t.Fatalf("remaining=%d", n)
+	}
+	if SetDiagnosticLogging(0) != 0 || GetDiagnosticLoggingSeconds() != 0 {
+		t.Fatal("disable failed")
+	}
+}
