+	defer d.mRWMutex.RUnlock()
+	var groupList []*model_struct.LocalGroup
+	err := d.conn.WithContext(ctx).Where("group_id in (?)", groupIDs).Find(&groupList).Error
+	return groupList, errs.WrapMsg(err, "GetGroups failed ")
