+func NewKafkaProducerV2(config *Config, addr []string, topic string) (mq.Producer, error) {
+	conf, err := BuildProducerConfig(*config)
+	if err != nil {
+		return nil, err
+	}
+	producer, err := NewProducer(conf, addr)
