+	}
+	f.unlockHash("image")
+}
+
+func TestUploadHashSerializesConcurrentRetries(t *testing.T) {
+	f := NewFile(nil, "test")
+	var active, overlaps atomic.Int32
+	var workers sync.WaitGroup
+	for i := 0; i < 60; i++ {
+		workers.Add(1)
