@@ -0,0 +1,111 @@
+//go:build cgo && !js
+
+package conversation_msg
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/open_im_sdk_callback"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+)
+
+type stressConversationListener struct {
+	open_im_sdk_callback.OnConversationListener
+	count, largest, bytes int
+}
+
+func (l *stressConversationListener) OnConversationChanged(raw string) {
+	var rows []*model_struct.LocalConversation
+	if err := json.Unmarshal([]byte(raw), &rows); err != nil {
+		panic(err)
+	}
+	l.count += len(rows)
+	if len(rows) > l.largest {
+		l.largest = len(rows)
+	}
+	l.bytes += len(raw)
+}
+
+func BenchmarkConversationProfileCatchup(b *testing.B) {
+	for _, size := range []int{1000, 5000} {
+		for _, changed := range []bool{false, true} {
+			b.Run(fmt.Sprintf("groups%d-conversations%d-changed%v", size, size*4, changed), func(b *testing.B) {
+				ctx := ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "stress"})
+				database, err := db.NewDataBase(ctx, "stress", b.TempDir(), 0)
+				if err != nil {
+					b.Fatal(err)
+				}
+				defer database.Close(ctx)
+				groups := make([]*model_struct.LocalGroup, size)
+				rows := make([]*model_struct.LocalConversation, size*4)
+				for i := range groups {
+					groups[i] = &model_struct.LocalGroup{GroupID: fmt.Sprintf("g%06d", i), GroupName: "After", FaceURL: "new", GroupType: 2}
+				}
+				payload := strings.Repeat("x", 2048)
+				for i := range rows {
+					rows[i] = &model_struct.LocalConversation{ConversationID: fmt.Sprintf("c%06d", i), ConversationType: constant.SingleChatType, LatestMsgSendTime: int64(i + 1), LatestMsg: payload, ShowName: "Peer", DraftText: "draft", UnreadCount: 7}
+					if i < size {
+						rows[i].GroupID = groups[i].GroupID
+						rows[i].ConversationType = constant.ReadGroupChatType
+						rows[i].ShowName = "After"
+						rows[i].FaceURL = "new"
+						if changed {
+							rows[i].ShowName = "Before"
+							rows[i].FaceURL = "old"
+						}
+					}
+				}
+				for start := 0; start < len(groups); start += 100 {
+					end := start + 100
+					if end > len(groups) {
+						end = len(groups)
+					}
+					if err := database.BatchInsertGroup(ctx, groups[start:end]); err != nil {
+						b.Fatal(err)
+					}
+				}
+				if err := database.BatchInsertConversationList(ctx, rows); err != nil {
+					b.Fatal(err)
+				}
+				listener := &stressConversationListener{}
+				c := &Conversation{db: database, ConversationListener: func() open_im_sdk_callback.OnConversationListener { return listener }}
+				runtime.GC()
+				var before, after runtime.MemStats
+				runtime.ReadMemStats(&before)
+				b.ResetTimer()
+				for turn := 0; turn < b.N; turn++ {
+					if err := c.reconcileGroupConversationProfiles(ctx); err != nil {
+						b.Fatal(err)
+					}
+				}
+				b.StopTimer()
+				runtime.ReadMemStats(&after)
+				b.ReportMetric(float64(after.TotalAlloc-before.TotalAlloc)/1024/1024/float64(b.N), "alloc-MiB/op")
+				b.ReportMetric(float64(after.HeapAlloc)/1024/1024, "end-heap-MiB")
+				b.ReportMetric(float64(listener.bytes)/1024/1024, "callback-MiB")
+				b.ReportMetric(float64(listener.largest), "largest-callback-rows")
+				expected := 0
+				if changed {
+					expected = size
+				}
+				if listener.count != expected {
+					b.Fatalf("lost refresh: %d/%d", listener.count, expected)
+				}
+				for i := 0; i < size; i++ {
+					row, err := database.GetConversation(ctx, rows[i].ConversationID)
+					if err != nil || row.ShowName != "After" || row.FaceURL != "new" || row.UnreadCount != 7 || row.DraftText != "draft" {
+						b.Fatalf("incorrect group %d: %+v %v", i, row, err)
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/internal/conversation_msg/group_profile_sync.go b/internal/conversation_msg/group_profile_sync.go
new file mode 100644
index 00000000..e323e9a9
--- /dev/null
+++ b/internal/conversation_msg/group_profile_sync.go
@@ -0,0 +1,74 @@
+package conversation_msg
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+)
+
+// Reconcile after both group and conversation sync have completed. Group rows
+// may already be current while a previous version left the conversation stale.
+// Only profile columns are written; drafts, unread counts and history survive.
+func (c *Conversation) reconcileGroupConversationProfiles(ctx context.Context) error {
+	if paged, ok := c.db.(db_interface.GroupConversationProfileSync); ok {
+		var after string
+		for {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			rows, err := paged.ReconcileGroupConversationProfilePage(ctx, after, 128)
+			if err != nil {
+				return err
+			}
+			if len(rows) == 0 {
+				return nil
+			}
+			c.ConversationListener().OnConversationChanged(utils.StructToJsonString(rows))
+			after = rows[len(rows)-1].ConversationID
+		}
+	}
+	groups, err := c.db.GetJoinedGroupListDB(ctx)
+	if err != nil {
+		return err
+	}
+	byID := make(map[string]*model_struct.LocalGroup, len(groups))
+	for _, group := range groups {
+		byID[group.GroupID] = group
+	}
+	rows, err := c.db.GetAllConversationListDB(ctx)
+	if err != nil {
+		return err
+	}
+	changed := make([]*model_struct.LocalConversation, 0)
+	defer func() {
+		// Publish successful rows even if a later row fails. The next attempt
+		// sees those rows as current and would otherwise miss their callback.
+		if len(changed) > 0 && ctx.Err() == nil {
+			c.ConversationListener().OnConversationChanged(utils.StructToJsonString(changed))
+		}
+	}()
+	for _, row := range rows {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if row.ConversationType != constant.ReadGroupChatType && row.ConversationType != constant.WriteGroupChatType {
+			continue
+		}
+		group := byID[row.GroupID]
+		if group == nil || (row.ShowName == group.GroupName && row.FaceURL == group.FaceURL) {
+			continue
+		}
+		if err := c.db.UpdateColumnsConversation(ctx, row.ConversationID, map[string]interface{}{
+			"show_name": group.GroupName, "face_url": group.FaceURL,
+		}); err != nil {
+			return err
+		}
+		updated := *row
+		updated.ShowName, updated.FaceURL = group.GroupName, group.FaceURL
+		changed = append(changed, &updated)
+	}
+	return nil
+}
diff --git a/internal/conversation_msg/group_profile_sync_test.go b/internal/conversation_msg/group_profile_sync_test.go
new file mode 100644
index 00000000..aa8bf872
--- /dev/null
+++ b/internal/conversation_msg/group_profile_sync_test.go
@@ -0,0 +1,99 @@
+package conversation_msg
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/open_im_sdk_callback"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+)
+
+type profileSyncDB struct {
+	db_interface.DataBase
+	rows   []*model_struct.LocalConversation
+	groups []*model_struct.LocalGroup
+	writes int
+	fail   bool
+}
+
+func (d *profileSyncDB) GetJoinedGroupListDB(context.Context) ([]*model_struct.LocalGroup, error) {
+	return d.groups, nil
+}
+func (d *profileSyncDB) GetAllConversationListDB(context.Context) ([]*model_struct.LocalConversation, error) {
+	return d.rows, nil
+}
+func (d *profileSyncDB) UpdateColumnsConversation(_ context.Context, id string, values map[string]interface{}) error {
+	if d.fail {
+		return errors.New("disk unavailable")
+	}
+	d.writes++
+	for _, row := range d.rows {
+		if row.ConversationID == id {
+			row.ShowName = values["show_name"].(string)
+			row.FaceURL = values["face_url"].(string)
+		}
+	}
+	return nil
+}
+
+type profileSyncListener struct {
+	open_im_sdk_callback.OnConversationListener
+	batches [][]*model_struct.LocalConversation
+}
+
+func (l *profileSyncListener) OnConversationChanged(raw string) {
+	var rows []*model_struct.LocalConversation
+	if err := json.Unmarshal([]byte(raw), &rows); err != nil {
+		panic(err)
+	}
+	l.batches = append(l.batches, rows)
+}
+
+func TestOfflineGroupProfileRepairsConversationAndPublishes(t *testing.T) {
+	for _, face := range []string{"new-avatar", ""} {
+		d := &profileSyncDB{groups: []*model_struct.LocalGroup{{GroupID: "group", GroupName: "Renamed offline", FaceURL: face}}, rows: []*model_struct.LocalConversation{
+			{ConversationID: "sg_group", GroupID: "group", ConversationType: constant.ReadGroupChatType, ShowName: "Old", FaceURL: "old-avatar", DraftText: "draft", UnreadCount: 7},
+			{ConversationID: "si_peer", ConversationType: constant.SingleChatType, ShowName: "Peer"},
+		}}
+		l := &profileSyncListener{}
+		c := &Conversation{db: d, ConversationListener: func() open_im_sdk_callback.OnConversationListener { return l }}
+		if err := c.reconcileGroupConversationProfiles(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		row := d.rows[0]
+		if row.ShowName != "Renamed offline" || row.FaceURL != face || row.UnreadCount != 7 || row.DraftText != "draft" || d.rows[1].ShowName != "Peer" {
+			t.Fatalf("incorrect reconciliation: %+v", row)
+		}
+		if d.writes != 1 || len(l.batches) != 1 || l.batches[0][0].ShowName != row.ShowName {
+			t.Fatal("missing list refresh")
+		}
+		if err := c.reconcileGroupConversationProfiles(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		if d.writes != 1 || len(l.batches) != 1 {
+			t.Fatal("unchanged sync must be a no-op")
+		}
+	}
+}
+
+func TestGroupProfileWriteFailureAndCancellationRemainRetryable(t *testing.T) {
+	d := &profileSyncDB{fail: true, groups: []*model_struct.LocalGroup{{GroupID: "group", GroupName: "New"}}, rows: []*model_struct.LocalConversation{{ConversationID: "sg_group", GroupID: "group", ConversationType: constant.ReadGroupChatType, ShowName: "Old"}}}
+	l := &profileSyncListener{}
+	c := &Conversation{db: d, ConversationListener: func() open_im_sdk_callback.OnConversationListener { return l }}
+	if err := c.reconcileGroupConversationProfiles(context.Background()); err == nil || len(l.batches) != 0 {
+		t.Fatal("failed write acknowledged")
+	}
+	d.fail = false
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := c.reconcileGroupConversationProfiles(ctx); !errors.Is(err, context.Canceled) || d.writes != 0 {
+		t.Fatal("cancelled session wrote profiles")
+	}
+	if err := c.reconcileGroupConversationProfiles(context.Background()); err != nil || d.writes != 1 {
+		t.Fatalf("retry failed: %v", err)
+	}
+}
diff --git a/internal/conversation_msg/heat_recovery_sqlite_test.go b/internal/conversation_msg/heat_recovery_sqlite_test.go
