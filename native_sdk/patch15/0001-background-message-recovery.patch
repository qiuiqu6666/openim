diff --git a/pkg/logpolicy/policy.go b/pkg/logpolicy/policy.go
new file mode 100644
index 00000000..8627a767
--- /dev/null
+++ b/pkg/logpolicy/policy.go
@@ -0,0 +1,45 @@
+// Package logpolicy controls bounded, metadata-only SDK diagnostics.
+package logpolicy
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+const MaxDiagnosticSeconds = 15 * 60
+const SlowCallThreshold = time.Second
+
+type window struct{ until atomic.Pointer[time.Time] }
+
+var detailed window
+
+func (w *window) configure(seconds int, now time.Time) int {
+	if seconds <= 0 {
+		w.until.Store(nil)
+		return 0
+	}
+	if seconds > MaxDiagnosticSeconds {
+		seconds = MaxDiagnosticSeconds
+	}
+	end := now.Add(time.Duration(seconds) * time.Second)
+	w.until.Store(&end)
+	return seconds
+}
+func (w *window) remaining(now time.Time) int {
+	end := w.until.Load()
+	if end == nil {
+		return 0
+	}
+	left := end.Sub(now)
+	if left <= 0 {
+		return 0
+	}
+	return int((left + time.Second - 1) / time.Second)
+}
+
+// Configure enables diagnostics for a bounded window; nonpositive disables it.
+// Nothing is persisted and no background timer or goroutine is created.
+func Configure(seconds int) int             { return detailed.configure(seconds, time.Now()) }
+func RemainingSeconds() int                 { return detailed.remaining(time.Now()) }
+func Enabled() bool                         { return RemainingSeconds() > 0 }
+func LogSuccess(elapsed time.Duration) bool { return elapsed >= SlowCallThreshold || Enabled() }
diff --git a/pkg/logpolicy/policy_test.go b/pkg/logpolicy/policy_test.go
new file mode 100644
index 00000000..583cb5e5
--- /dev/null
+++ b/pkg/logpolicy/policy_test.go
@@ -0,0 +1,70 @@
+package logpolicy
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestDiagnosticWindowExpiryDisableAndRenewal(t *testing.T) {
+	var w window
+	now := time.Now()
+	if w.remaining(now) != 0 {
+		t.Fatal("diagnostics enabled by default")
+	}
+	if w.configure(60, now) != 60 || w.remaining(now) != 60 {
+		t.Fatal("enable failed")
+	}
+	if w.remaining(now.Add(59999*time.Millisecond)) != 1 || w.remaining(now.Add(time.Minute)) != 0 {
+		t.Fatal("expiry boundary failed")
+	}
+	// Renewing cannot be cancelled by an older window's expiry.
+	w.configure(120, now.Add(30*time.Second))
+	if w.remaining(now.Add(time.Minute)) != 90 {
+		t.Fatal("renewal lost")
+	}
+	w.configure(0, now)
+	if w.remaining(now) != 0 {
+		t.Fatal("disable failed")
+	}
+	w.configure(-1, now)
+	if w.remaining(now) != 0 {
+		t.Fatal("negative duration enabled diagnostics")
+	}
+	if w.configure(int(^uint(0)>>1), now) != MaxDiagnosticSeconds || w.remaining(now) != MaxDiagnosticSeconds {
+		t.Fatal("duration cap failed")
+	}
+}
+func TestSuccessPolicyRetainsSlowCalls(t *testing.T) {
+	Configure(0)
+	t.Cleanup(func() { Configure(0) })
+	if LogSuccess(time.Millisecond) || !LogSuccess(SlowCallThreshold) {
+		t.Fatal("compact policy failed")
+	}
+	Configure(30)
+	if !LogSuccess(time.Millisecond) {
+		t.Fatal("detailed policy failed")
+	}
+	Configure(0)
+	if LogSuccess(time.Millisecond) {
+		t.Fatal("disable failed")
+	}
+}
+func TestConcurrentDiagnosticWindow(t *testing.T) {
+	var w window
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 1000; j++ {
+				w.configure(j%901, time.Now())
+				n := w.remaining(time.Now())
+				if n < 0 || n > MaxDiagnosticSeconds {
+					t.Errorf("remaining=%d", n)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
