@@ -0,0 +1,74 @@
+package common
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/logpolicy"
+	"github.com/openimsdk/tools/log"
+)
+
+func TestCommandLoggingWindowPreservesDeliveryAndErrors(t *testing.T) {
+	logpolicy.Configure(0)
+	t.Cleanup(func() { logpolicy.Configure(0) })
+	// The logger owns an open rotating file with no public Close method.
+	// Isolate it so Windows can remove the directory after the child exits.
+	dir := os.Getenv("OPENIM_LOG_POLICY_TEST_DIR")
+	if dir == "" {
+		exe, err := os.Executable()
+		if err != nil {
+			t.Fatal(err)
+		}
+		cmd := exec.Command(exe, "-test.run=^TestCommandLoggingWindowPreservesDeliveryAndErrors$")
+		cmd.Env = append(os.Environ(), "OPENIM_LOG_POLICY_TEST_DIR="+t.TempDir())
+		if output, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("log policy child: %v\n%s", err, output)
+		}
+		return
+	}
+	if err := log.InitLoggerFromConfig("policy-test", "", "", "", log.LevelInfo, true, false, dir, 1, 24, "test", true); err != nil {
+		t.Fatal(err)
+	}
+	ch := make(chan Cmd2Value, 3)
+	send := func(name string) {
+		t.Helper()
+		if err := sendCmd(ch, Cmd2Value{Ctx: context.Background(), Cmd: name, Caller: "test"}, time.Second); err != nil {
+			t.Fatal(err)
+		}
+	}
+	send("compact-event")
+	logpolicy.Configure(60)
+	send("detailed-event")
+	logpolicy.Configure(0)
+	send("disabled-event")
+	if len(ch) != 3 {
+		t.Fatal("logging policy changed delivery")
+	}
+	if err := sendCmd(nil, Cmd2Value{Ctx: context.Background(), Cmd: "failure-event", Caller: "test"}, time.Second); err != ErrChanNil {
+		t.Fatal("error lost")
+	}
+	files, err := filepath.Glob(filepath.Join(dir, "policy-test.*"))
+	if err != nil || len(files) == 0 {
+		t.Fatalf("missing logs: %v", err)
+	}
+	var output strings.Builder
+	for _, f := range files {
+		b, e := os.ReadFile(f)
+		if e != nil {
+			t.Fatal(e)
+		}
+		output.Write(b)
+	}
+	got := output.String()
+	if strings.Contains(got, "compact-event") || strings.Contains(got, "disabled-event") {
+		t.Fatal("routine logs escaped compact mode")
+	}
+	if !strings.Contains(got, "detailed-event") || !strings.Contains(got, "failure-event") {
+		t.Fatal("diagnostic or error evidence missing")
+	}
+}
diff --git a/pkg/common/metadata_progress.go b/pkg/common/metadata_progress.go
new file mode 100644
index 00000000..f08540fe
--- /dev/null
+++ b/pkg/common/metadata_progress.go
@@ -0,0 +1,119 @@
+package common
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type metadataProgressKey struct{}
+
+// MetadataProgress belongs to one pending auxiliary recovery obligation. It
+// survives attempts, never a new recovery or login. The owner joins all stages
+// before retrying; the mutex protects independent parallel stage completions.
+type MetadataProgress struct {
+	mu          sync.Mutex
+	completed   map[string]time.Time
+	items       map[string]map[string]bool
+	checkpoints atomic.Int64
+}
+
+// PendingMetadataItems retains per-entity progress until a whole sweep succeeds.
+// Unlike stage freshness, a long sweep must not expire its completed prefix.
+func PendingMetadataItems(ctx context.Context, scope string, ids []string) []string {
+	p, _ := ctx.Value(metadataProgressKey{}).(*MetadataProgress)
+	if p == nil {
+		return ids
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	pending := make([]string, 0, len(ids))
+	for _, id := range ids {
+		if !p.items[scope][id] {
+			pending = append(pending, id)
+		}
+	}
+	return pending
+}
+
+// CompleteMetadataItem is called only after all entity writes succeed, or a
+// successful endpoint response confirms the entity is unchanged.
+func CompleteMetadataItem(ctx context.Context, scope, id string) {
+	if ctx.Err() != nil {
+		return
+	}
+	p, _ := ctx.Value(metadataProgressKey{}).(*MetadataProgress)
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.items == nil {
+		p.items = make(map[string]map[string]bool)
+	}
+	if p.items[scope] == nil {
+		p.items[scope] = make(map[string]bool)
+	}
+	if !p.items[scope][id] {
+		p.items[scope][id] = true
+		p.checkpoints.Add(1)
+	}
+}
+
+func FinishMetadataItems(ctx context.Context, scope string) {
+	if p, _ := ctx.Value(metadataProgressKey{}).(*MetadataProgress); p != nil {
+		p.mu.Lock()
+		delete(p.items, scope)
+		p.mu.Unlock()
+	}
+}
+
+func WithMetadataProgress(ctx context.Context, progress *MetadataProgress) context.Context {
+	return context.WithValue(ctx, metadataProgressKey{}, progress)
+}
+
+func RunMetadataStage(ctx context.Context, name string, run func(context.Context) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	progress, _ := ctx.Value(metadataProgressKey{}).(*MetadataProgress)
+	if progress == nil {
+		return run(ctx)
+	}
+	progress.mu.Lock()
+	completedAt := progress.completed[name]
+	progress.mu.Unlock()
+	// A long-lived failing stage must not freeze the other profiles forever.
+	if !completedAt.IsZero() && time.Since(completedAt) < time.Minute {
+		return nil
+	}
+	if err := run(ctx); err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	progress.mu.Lock()
+	if progress.completed == nil {
+		progress.completed = make(map[string]time.Time)
+	}
+	progress.completed[name] = time.Now()
+	progress.checkpoints.Add(1)
+	progress.mu.Unlock()
+	return nil
+}
+
+// RecordMetadataCheckpoint counts committed batches, not requests or bytes.
+func RecordMetadataCheckpoint(ctx context.Context) {
+	if progress, _ := ctx.Value(metadataProgressKey{}).(*MetadataProgress); progress != nil {
+		progress.checkpoints.Add(1)
+	}
+}
+
+func (p *MetadataProgress) Checkpoints() int64 {
+	if p == nil {
+		return 0
+	}
+	return p.checkpoints.Load()
+}
diff --git a/pkg/common/metadata_progress_test.go b/pkg/common/metadata_progress_test.go
new file mode 100644
index 00000000..11f9aaf8
--- /dev/null
+++ b/pkg/common/metadata_progress_test.go
@@ -0,0 +1,89 @@
+package common
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestMetadataProgressRetainsOnlySuccessfulStagesAcrossAttempts(t *testing.T) {
+	progress := &MetadataProgress{}
+	base := WithMetadataProgress(context.Background(), progress)
+	first, cancel := context.WithCancel(base)
+	completed, failed := 0, 0
+	good := func(context.Context) error { completed++; return nil }
+	bad := func(context.Context) error { failed++; return errors.New("network failure") }
+	if err := RunMetadataStage(first, "user", good); err != nil {
+		t.Fatal(err)
+	}
+	if err := RunMetadataStage(first, "friends", bad); err == nil {
+		t.Fatal("lost failure")
+	}
+	cancel()
+	if err := RunMetadataStage(first, "user", good); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if err := RunMetadataStage(base, "user", good); err != nil {
+		t.Fatal(err)
+	}
+	_ = RunMetadataStage(base, "friends", bad)
+	if completed != 1 || failed != 2 {
+		t.Fatalf("completed=%d failed=%d", completed, failed)
+	}
+	// New obligation/session never inherits a previous completion.
+	fresh := WithMetadataProgress(context.Background(), &MetadataProgress{})
+	_ = RunMetadataStage(fresh, "user", good)
+	if completed != 2 {
+		t.Fatal("completion leaked to new recovery")
+	}
+}
+
+func TestMetadataStageCancelledBeforeReturnIsNotCheckpointed(t *testing.T) {
+	progress := &MetadataProgress{}
+	base := WithMetadataProgress(context.Background(), progress)
+	ctx, cancel := context.WithCancel(base)
+	if err := RunMetadataStage(ctx, "friends", func(context.Context) error { cancel(); return nil }); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	called := false
+	_ = RunMetadataStage(base, "friends", func(context.Context) error { called = true; return nil })
+	if !called {
+		t.Fatal("cancelled stage acknowledged")
+	}
+}
+
+func TestLongMetadataOutageDoesNotFreezeSuccessfulProfiles(t *testing.T) {
+	progress := &MetadataProgress{completed: map[string]time.Time{"user": time.Now().Add(-2 * time.Minute)}}
+	ctx := WithMetadataProgress(context.Background(), progress)
+	called := 0
+	for i := 0; i < 2; i++ {
+		if err := RunMetadataStage(ctx, "user", func(context.Context) error { called++; return nil }); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if called != 1 {
+		t.Fatalf("stale stage not refreshed once: %d", called)
+	}
+}
+
+func TestMetadataItemsKeepProgressAcrossCancelledAttempts(t *testing.T) {
+	p := &MetadataProgress{}
+	base := WithMetadataProgress(context.Background(), p)
+	CompleteMetadataItem(base, "groups", "committed")
+	CompleteMetadataItem(base, "groups", "committed")
+	ctx, cancel := context.WithCancel(base)
+	cancel()
+	CompleteMetadataItem(ctx, "groups", "cancelled")
+	pending := PendingMetadataItems(base, "groups", []string{"committed", "cancelled", "new"})
+	if len(pending) != 2 || pending[0] != "cancelled" || p.Checkpoints() != 1 {
+		t.Fatalf("pending=%v checkpoints=%d", pending, p.Checkpoints())
+	}
+	if len(PendingMetadataItems(WithMetadataProgress(context.Background(), &MetadataProgress{}), "groups", []string{"committed"})) != 1 {
+		t.Fatal("progress leaked to new obligation")
+	}
+	FinishMetadataItems(base, "groups")
+	if len(PendingMetadataItems(base, "groups", []string{"committed"})) != 1 {
+		t.Fatal("refresh skipped old entity")
+	}
+}
diff --git a/pkg/common/metadata_turn.go b/pkg/common/metadata_turn.go
new file mode 100644
index 00000000..99f930c0
--- /dev/null
+++ b/pkg/common/metadata_turn.go
@@ -0,0 +1,53 @@
+package common
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+)
+
+type metadataTurnKey struct{}
+type metadataTurn struct {
+	deadline atomic.Int64
+	active   atomic.Int64
+}
+
+// One shared allowance per attempt, across both message and conversation
+// schedulers. Further batches cannot renew it and starve live messages.
+const metadataTurnBudget = time.Second
+
+func WithMetadataTurn(ctx context.Context) context.Context {
+	return context.WithValue(ctx, metadataTurnKey{}, &metadataTurn{})
+}
+
+// Only bounded group batches opt in; unrelated or hung metadata still uses the
+// normal 100ms grace. Parent cancellation/logout always bypasses this allowance.
+func BeginMetadataBatch(ctx context.Context) func() {
+	t, _ := ctx.Value(metadataTurnKey{}).(*metadataTurn)
+	if t == nil {
+		return func() {}
+	}
+	t.deadline.CompareAndSwap(0, time.Now().Add(metadataTurnBudget).UnixNano())
+	t.active.Add(1)
+	return func() { t.active.Add(-1) }
+}
+
+func MetadataPreemptionDelay(ctx context.Context) time.Duration {
+	if ctx == nil || ctx.Err() != nil {
+		return 0
+	}
+	t, _ := ctx.Value(metadataTurnKey{}).(*metadataTurn)
+	if t == nil || t.active.Load() == 0 {
+		return 0
+	}
+	remaining := time.Until(time.Unix(0, t.deadline.Load()))
+	// Recheck at short intervals so completed work yields promptly. The absolute
+	// deadline cannot be extended by a new batch or by the other scheduler.
+	if remaining > 10*time.Millisecond {
+		return 10 * time.Millisecond
+	}
+	if remaining < 0 {
+		return 0
+	}
+	return remaining
+}
