+			resp, err := g.getFullJoinGroupIDs(ctx, &group.GetFullJoinGroupIDsReq{
+				UserID: g.loginUserID,
+			})
+			if err != nil {
+				return nil, err
+			}
+			return resp.GroupIDs, nil
+
+		},
+		IDOrderChanged: func(resp *group.GetIncrementalJoinGroupResp) bool {
+			if resp.SortVersion > 0 {
+				return true
+			}
+			return false
+		},
+	}
+	if err := joinedGroupSyncer.IncrementalSync(); err != nil {
+		return nil, err
+	}
+	lvs, err := g.db.GetVersionSync(ctx, g.groupTableName(), g.loginUserID)
+	if err != nil && !errs.ErrRecordNotFound.Is(err) {
+		return nil, err
+	}
+	return lvs.UIDList, nil
+}
diff --git a/internal/group/member_full_sync.go b/internal/group/member_full_sync.go
new file mode 100644
index 00000000..6a52e392
--- /dev/null
+++ b/internal/group/member_full_sync.go
@@ -0,0 +1,44 @@
+package group
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/api"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/group"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+)
+
+// A full response is still a change to a live directory. Fetch every page
+// before applying differences, preserving callbacks and retryable local rows
+// if the request fails. A truncated first 1000 members is not a full snapshot.
+func (g *Group) syncFullGroupMembers(ctx context.Context, groupID string) error {
+	req := &group.GetGroupMemberListReq{GroupID: groupID, Pagination: &sdkws.RequestPagination{ShowNumber: 100}}
+	members, err := api.Page(ctx, req, api.GetGroupMemberList.Invoke, (*group.GetGroupMemberListResp).GetMembers)
+	if err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	server := make([]*model_struct.LocalGroupMember, 0, len(members))
+	seen := make(map[string]bool, len(members))
+	for _, member := range members {
+		if member == nil || member.GroupID != groupID || member.UserID == "" || seen[member.UserID] {
+			return errs.New("invalid full group member snapshot", "groupID", groupID)
+		}
+		seen[member.UserID] = true
+		server = append(server, ServerGroupMemberToLocalGroupMember(member))
+	}
+	local, err := g.db.GetGroupMemberListByGroupID(ctx, groupID)
+	if err != nil {
+		return err
+	}
+	// Clear stale cached rows even when the database already contains the same
+	// profile (e.g. a previous build performed silent full replacement).
+	g.groupMemberCache.DeleteCon(func(_ string, member *model_struct.LocalGroupMember) bool {
+		return member != nil && member.GroupID == groupID
+	})
+	return g.groupMemberSyncer.Sync(ctx, server, local, nil)
+}
diff --git a/internal/group/member_full_sync_test.go b/internal/group/member_full_sync_test.go
new file mode 100644
index 00000000..af32be20
--- /dev/null
+++ b/internal/group/member_full_sync_test.go
@@ -0,0 +1,210 @@
+package group
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/open_im_sdk_callback"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/group"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+type memberRecoveryDB struct {
+	groupProfileDB
+	members  map[string]*model_struct.LocalGroupMember
+	failUser string
+}
+
+func (d *memberRecoveryDB) GetGroupMemberListByGroupID(context.Context, string) ([]*model_struct.LocalGroupMember, error) {
+	rows := make([]*model_struct.LocalGroupMember, 0, len(d.members))
+	for _, row := range d.members {
+		rows = append(rows, row)
+	}
+	return rows, nil
+}
+func (d *memberRecoveryDB) InsertGroupMember(_ context.Context, row *model_struct.LocalGroupMember) error {
+	if row.UserID == d.failUser {
+		return errors.New("injected member write failure")
+	}
+	d.members[row.UserID] = row
+	return nil
+}
+func (d *memberRecoveryDB) UpdateGroupMember(ctx context.Context, row *model_struct.LocalGroupMember) error {
+	return d.InsertGroupMember(ctx, row)
+}
+func (d *memberRecoveryDB) DeleteGroupMember(_ context.Context, _, user string) error {
+	delete(d.members, user)
+	return nil
+}
+
+type memberRecoveryListener struct {
+	groupProfileListener
+	added, changed, deleted int
+}
+
+func (l *memberRecoveryListener) OnGroupMemberAdded(string)       { l.added++ }
+func (l *memberRecoveryListener) OnGroupMemberInfoChanged(string) { l.changed++ }
+func (l *memberRecoveryListener) OnGroupMemberDeleted(string)     { l.deleted++ }
+func recoveryMember(user, name string) *sdkws.GroupMemberFullInfo {
+	return &sdkws.GroupMemberFullInfo{GroupID: "g", UserID: user, Nickname: name}
+}
+func newMemberRecoveryGroup(t *testing.T) (*Group, *memberRecoveryDB, *memberRecoveryListener) {
+	t.Helper()
+	d := &memberRecoveryDB{groupProfileDB: groupProfileDB{row: &model_struct.LocalGroup{GroupID: "g", GroupName: "Old group", MemberCount: 3}}, members: map[string]*model_struct.LocalGroupMember{
+		"rename": {GroupID: "g", UserID: "rename", Nickname: "Old nickname"},
+		"remove": {GroupID: "g", UserID: "remove", Nickname: "Removed"},
+		"same":   {GroupID: "g", UserID: "same", Nickname: "Unchanged"},
+	}}
+	g := NewGroup("self", d, make(chan common.Cmd2Value, 4096))
+	l := &memberRecoveryListener{}
+	g.SetGroupListener(func() open_im_sdk_callback.OnGroupListener { return l })
+	for _, row := range d.members {
+		g.groupMemberCache.Store(g.buildGroupMemberKey("g", row.UserID), row)
+	}
+	return g, d, l
+}
+func memberRecoveryServer(t *testing.T, members []*sdkws.GroupMemberFullInfo, failPage *bool) context.Context {
+	return groupProfileServer(t, func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/group/get_group_member_list":
+			var req group.GetGroupMemberListReq
+			if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+				t.Error(err)
+				w.WriteHeader(500)
+				return
+			}
+			if failPage != nil && *failPage && req.Pagination.PageNumber == 2 {
+				w.WriteHeader(500)
+				return
+			}
+			start := int((req.Pagination.PageNumber - 1) * req.Pagination.ShowNumber)
+			end := min(start+int(req.Pagination.ShowNumber), len(members))
+			start = min(start, len(members))
+			profileResponse(w, map[string]any{"members": members[start:end], "total": len(members)})
+		case "/group/get_full_group_member_user_ids":
+			ids := make([]string, 0, len(members))
+			for _, m := range members {
+				ids = append(ids, m.UserID)
+			}
+			profileResponse(w, map[string]any{"userIDs": ids})
+		default:
+			t.Errorf("unexpected endpoint %s", r.URL.Path)
+			w.WriteHeader(500)
+		}
+	})
+}
+func TestMemberRecoveryFullAndIncrementalNotifyProfileCountAndMembers(t *testing.T) {
+	for _, full := range []bool{false, true} {
+		t.Run(fmt.Sprint(full), func(t *testing.T) {
+			members := []*sdkws.GroupMemberFullInfo{recoveryMember("rename", "New nickname"), recoveryMember("same", "Unchanged"), recoveryMember("add", "Added"), recoveryMember("add2", "Added2")}
+			ctx := memberRecoveryServer(t, members, nil)
+			g, d, l := newMemberRecoveryGroup(t)
+			response := &group.GetIncrementalGroupMemberResp{Full: full, VersionID: "v", Version: 2, Group: &sdkws.GroupInfo{GroupID: "g", GroupName: "New group", MemberCount: 4}}
+			if !full {
+				response.Update = members[:1]
+				response.Insert = members[2:]
+				response.Delete = []string{"remove"}
+			}
+			if err := g.syncGroupAndMember(ctx, "g", response); err != nil {
+				t.Fatal(err)
+			}
+			if len(d.members) != 4 || d.members["rename"].Nickname != "New nickname" || d.members["remove"] != nil {
+				t.Fatalf("bad members: %+v", d.members)
+			}
+			if d.row.GroupName != "New group" || d.row.MemberCount != 4 || l.groupProfileListener.changed != 1 || l.changed != 1 || l.added != 2 || l.deleted != 1 || d.saved != 1 {
+				t.Fatalf("row=%+v listener=%+v versions=%d", d.row, l, d.saved)
+			}
+			for _, id := range []string{"rename", "remove"} {
+				if _, ok := g.groupMemberCache.Load(g.buildGroupMemberKey("g", id)); ok {
+					t.Fatalf("stale cache %s", id)
+				}
+			}
+			if err := g.syncGroupAndMember(ctx, "g", response); err != nil {
+				t.Fatal(err)
+			}
+			if l.changed != 1 || l.added != 2 || l.deleted != 1 {
+				t.Fatal("replayed unchanged members generated duplicate events")
+			}
+		})
+	}
+}
+func TestMemberRecoveryFullFetchFailurePreservesDirectory(t *testing.T) {
+	members := make([]*sdkws.GroupMemberFullInfo, 101)
+	for i := range members {
+		members[i] = recoveryMember(fmt.Sprint(i), "Name")
+	}
+	fail := true
+	ctx := memberRecoveryServer(t, members, &fail)
+	g, d, l := newMemberRecoveryGroup(t)
+	if err := g.syncFullGroupMembers(ctx, "g"); err == nil {
+		t.Fatal("expected page failure")
+	}
+	if len(d.members) != 3 || l.added+l.changed+l.deleted != 0 {
+		t.Fatal("partial page changed live directory")
+	}
+	fail = false
+	if err := g.syncFullGroupMembers(ctx, "g"); err != nil {
+		t.Fatal(err)
+	}
+	if len(d.members) != 101 || l.added != 101 || l.deleted != 3 {
+		t.Fatalf("retry lost changes: members=%d listener=%+v", len(d.members), l)
+	}
+}
+func TestMemberRecoveryFullIsNotTruncatedAndRejectsInvalidRows(t *testing.T) {
+	t.Run("more-than-1000", func(t *testing.T) {
+		members := make([]*sdkws.GroupMemberFullInfo, 1005)
+		for i := range members {
+			members[i] = recoveryMember(fmt.Sprint(i), "Name")
+		}
+		ctx := memberRecoveryServer(t, members, nil)
+		g, d, l := newMemberRecoveryGroup(t)
+		if err := g.syncFullGroupMembers(ctx, "g"); err != nil {
+			t.Fatal(err)
+		}
+		if len(d.members) != 1005 || l.added != 1005 || l.deleted != 3 {
+			t.Fatalf("truncated directory: %d", len(d.members))
+		}
+	})
+	for _, invalid := range []string{"foreign", "duplicate"} {
+		t.Run(invalid, func(t *testing.T) {
+			members := []*sdkws.GroupMemberFullInfo{recoveryMember("u", "Name"), recoveryMember("u", "Name")}
+			if invalid == "foreign" {
+				members[1].GroupID = "other"
+			}
+			ctx := memberRecoveryServer(t, members, nil)
+			g, d, l := newMemberRecoveryGroup(t)
+			if err := g.syncFullGroupMembers(ctx, "g"); err == nil {
+				t.Fatal("accepted invalid snapshot")
+			}
+			if len(d.members) != 3 || l.added+l.changed+l.deleted != 0 {
+				t.Fatal("invalid snapshot changed directory")
+			}
+		})
+	}
+}
+func TestMemberRecoveryWriteFailureKeepsVersionRetryable(t *testing.T) {
+	members := []*sdkws.GroupMemberFullInfo{recoveryMember("rename", "New nickname"), recoveryMember("add", "Added")}
+	ctx := memberRecoveryServer(t, members, nil)
+	g, d, l := newMemberRecoveryGroup(t)
+	d.failUser = "add"
+	response := &group.GetIncrementalGroupMemberResp{Full: true, VersionID: "v", Version: 2, Group: &sdkws.GroupInfo{GroupID: "g", GroupName: "New group", MemberCount: 2}}
+	if err := g.syncGroupAndMember(ctx, "g", response); err == nil {
+		t.Fatal("expected storage failure")
+	}
+	if d.saved != 0 || d.row.GroupName != "Old group" {
+		t.Fatal("committed version/profile before member write succeeded")
+	}
+	d.failUser = ""
+	if err := g.syncGroupAndMember(ctx, "g", response); err != nil {
+		t.Fatal(err)
+	}
+	if len(d.members) != 2 || d.saved != 1 || l.changed != 1 || l.added != 1 || l.deleted != 2 || d.row.MemberCount != 2 {
+		t.Fatalf("retry incomplete: %+v members=%d", l, len(d.members))
+	}
+}
diff --git a/internal/group/member_resume_test.go b/internal/group/member_resume_test.go
new file mode 100644
index 00000000..563dc7e8
--- /dev/null
+++ b/internal/group/member_resume_test.go
@@ -0,0 +1,145 @@
+package group
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sync"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/open_im_sdk_callback"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	protocol "github.com/openimsdk/protocol/group"
+)
+
+func TestMemberBatchesResumeAfterCancelledRequest(t *testing.T) {
+	var mu sync.Mutex
+	requests := 0
+	seen := make(map[string]int)
+	var cancel context.CancelFunc
+	ctx := groupProfileServer(t, func(w http.ResponseWriter, r *http.Request) {
+		var req protocol.BatchGetIncrementalGroupMemberReq
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			t.Error(err)
+			return
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		requests++
+		if len(req.ReqList) > 20 {
+			t.Errorf("oversized batch: %d", len(req.ReqList))
+		}
+		if requests == 2 {
+			cancel()
+			return
+		}
+		for _, item := range req.ReqList {
+			seen[item.GroupID]++
+		}
+		// An entirely empty success confirms every requested group was skipped.
+		profileResponse(w, map[string]any{"respList": map[string]any{}})
+	})
+	base := common.WithMetadataProgress(ctx, &common.MetadataProgress{})
+	first, stop := context.WithCancel(base)
+	cancel = stop
+	defer stop()
+	ids := make([]string, 65)
+	for i := range ids {
+		ids[i] = fmt.Sprintf("g%03d", i)
+	}
+	g := NewGroup("self", &groupProfileDB{}, make(chan common.Cmd2Value, 1))
+	if err := g.IncrSyncGroupAndMember(first, ids...); err == nil {
+		t.Fatal("cancelled request reported success")
+	}
+	if err := g.IncrSyncGroupAndMember(base, ids...); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if requests != 5 || len(seen) != len(ids) {
+		t.Fatalf("requests=%d completed=%d", requests, len(seen))
+	}
+	for id, count := range seen {
+		if count != 1 {
+			t.Errorf("completed group %s fetched %d times", id, count)
+		}
+	}
+}
+
+func TestMemberStorageFailureIsRetriedWithoutRefetchingCompletedGroup(t *testing.T) {
+	var mu sync.Mutex
+	var requests [][]string
+	ctx := groupProfileServer(t, func(w http.ResponseWriter, r *http.Request) {
+		var req protocol.BatchGetIncrementalGroupMemberReq
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			t.Error(err)
+			return
+		}
+		ids := make([]string, 0, len(req.ReqList))
+		for _, item := range req.ReqList {
+			ids = append(ids, item.GroupID)
+		}
+		mu.Lock()
+		requests = append(requests, ids)
+		mu.Unlock()
+		profileResponse(w, map[string]any{"respList": map[string]any{"unchanged": map[string]any{}, "g": map[string]any{"versionID": "members", "version": 1, "group": map[string]any{"groupID": "g", "groupName": "New"}}}})
+	})
+	base := common.WithMetadataProgress(ctx, &common.MetadataProgress{})
+	d := &groupProfileDB{row: &model_struct.LocalGroup{GroupID: "g"}, failMember: true}
+	g := NewGroup("self", d, make(chan common.Cmd2Value, 4))
+	g.SetGroupListener(func() open_im_sdk_callback.OnGroupListener { return &groupProfileListener{} })
+	if err := g.IncrSyncGroupAndMember(base, "g", "unchanged"); err == nil || d.saved != 0 {
+		t.Fatal("failed storage checkpointed")
+	}
+	d.failMember = false
+	if err := g.IncrSyncGroupAndMember(base, "g", "unchanged"); err != nil || d.saved != 1 {
+		t.Fatalf("retry failed: %v versions=%d", err, d.saved)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(requests) != 2 || len(requests[1]) != 1 || requests[1][0] != "g" {
+		t.Fatalf("wrong retry: %v", requests)
+	}
+}
+
+func TestMemberBatchFailureRetainsSuccessfulSiblings(t *testing.T) {
+	var requests [][]string
+	ctx := groupProfileServer(t, func(w http.ResponseWriter, r *http.Request) {
+		var req protocol.BatchGetIncrementalGroupMemberReq
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			t.Error(err)
+			return
+		}
+		ids := make([]string, 0, len(req.ReqList))
+		for _, item := range req.ReqList {
+			ids = append(ids, item.GroupID)
+		}
+		requests = append(requests, ids)
+		if len(requests) == 1 {
+			profileResponse(w, map[string]any{"respList": map[string]any{"bad": nil, "unchanged": map[string]any{}}})
+		} else {
+			profileResponse(w, map[string]any{"respList": map[string]any{}})
+		}
+	})
+	base := common.WithMetadataProgress(ctx, &common.MetadataProgress{})
+	g := NewGroup("self", &groupProfileDB{}, make(chan common.Cmd2Value, 1))
+	ids := []string{"unchanged", "bad", "unchanged"}
+	if err := g.IncrSyncGroupAndMember(base, ids...); err == nil {
+		t.Fatal("nil response acknowledged")
+	}
+	if err := g.IncrSyncGroupAndMember(base, ids...); err != nil {
+		t.Fatal(err)
+	}
+	if len(requests) != 2 || len(requests[0]) != 2 || len(requests[1]) != 1 || requests[1][0] != "bad" {
+		t.Fatalf("retry did not retain sibling: %v", requests)
+	}
+	// A completed sweep must allow a later refresh to observe new changes.
+	if err := g.IncrSyncGroupAndMember(base, ids...); err != nil {
+		t.Fatal(err)
+	}
+	if len(requests[2]) != 2 {
+		t.Fatal("completed sweep suppressed new refresh")
+	}
+}
