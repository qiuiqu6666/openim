--- /dev/null
+++ b/internal/interaction/msg_sync_batch_latency_test.go
@@ -0,0 +1,100 @@
+package interaction
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestRecoveryBatchesVisibilityAndSmallGapsWithoutDuplicateRows(t *testing.T) {
+	for _, missingBoundary := range []bool{false, true} {
+		t.Run(fmt.Sprint("missingBoundary=", missingBoundary), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			d := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, boundary: model_struct.LocalConversation{MaxSeq: 1}}
+			m := &MsgSyncer{ctx: ctx, db: d, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+			targets := make(map[string]int64)
+			for n := 0; n < 30; n++ {
+				id := fmt.Sprintf("sg_%03d", n)
+				targets[id] = 6
+				m.syncedMaxSeqs[id] = 3
+			}
+			boundaries, pulls := 0, 0
+			stored := make(map[string]map[int64]bool)
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				for id, packet := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+					if stored[id] == nil {
+						stored[id] = make(map[int64]bool)
+					}
+					for _, row := range packet.Msgs {
+						if row.Seq < 4 || row.Seq > 6 || stored[id][row.Seq] {
+							t.Errorf("invisible or duplicate row %s/%d", id, row.Seq)
+						}
+						stored[id][row.Seq] = true
+					}
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier == constant.PullMsgBySeqList {
+					boundaries++
+					p := &msg.GetSeqMessageReq{}
+					if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+						panic(err)
+					}
+					resp := &msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{}}
+					for _, row := range p.Conversations {
+						if missingBoundary && row.ConversationID == "sg_000" {
+							continue
+						}
+						end := int64(4)
+						if p.Order == sdkws.PullOrder_PullOrderAsc {
+							end = 6
+						}
+						resp.Msgs[row.ConversationID] = &sdkws.PullMsgs{IsEnd: true, EndSeq: end}
+					}
+					return wireResponse(resp)
+				}
+				pulls++
+				p := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+					panic(err)
+				}
+				rows := int64(0)
+				for _, r := range p.SeqRanges {
+					rows += r.Num
+					if r.Num != r.End-r.Begin+1 {
+						t.Error("range was silently cropped")
+					}
+				}
+				if rows > 100 {
+					t.Fatalf("response budget expanded: %d", rows)
+				}
+				return requestedRecoveryResponse(t, req)
+			})
+			err := m.compareSeqsAndBatchSync(ctx, targets, 1)
+			if (err != nil) != missingBoundary {
+				t.Fatalf("wrong boundary failure: %v", err)
+			}
+			if boundaries != 2 || pulls != 5 {
+				t.Fatalf("boundary/pull requests=%d/%d", boundaries, pulls)
+			}
+			for id := range targets {
+				want := 3
+				if missingBoundary && id == "sg_000" {
+					want = 0
+				}
+				if len(stored[id]) != want {
+					t.Fatalf("lost messages for %s: %v", id, stored[id])
+				}
+			}
+		})
+	}
+}
diff --git a/internal/interaction/msg_sync_batches.go b/internal/interaction/msg_sync_batches.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_batches.go
@@ -0,0 +1,110 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"sort"
+)
+
+// Round-robin bounded pages keep a large or failing conversation from hiding
+// another conversation's gap. There is one owner, inherited from the existing
+// sync scheduler. A failed page is left pending for the next foreground tick.
+func (m *MsgSyncer) syncCompleteMessageRanges(ctx context.Context, ranges map[string][2]int64, reinstall bool) error {
+	leavePages := protectMessagePages(ctx)
+	defer leavePages()
+	m.recoveryReadSeqReady = common.RecoveryMetadataPrepared(ctx)
+	pending := make(map[string][][2]int64, len(ranges))
+	var ids []string
+	var failures []error
+	totalPages := 0
+	visibleRanges := make(map[string][2]int64, len(ranges))
+	validatedRanges, boundaryFailures, recoveryOrder := m.visibleMessageRanges(ctx, ranges)
+	for id, r := range ranges {
+		// Boundary revalidation can perform network I/O for many conversations.
+		// Lend ownership between these checks as well as between message pages.
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			return err
+		}
+		if err := m.rememberMessageTarget(ctx, id, r[1]); err != nil {
+			return err
+		}
+		visible, err := validatedRanges[id], boundaryFailures[id]
+		if err != nil {
+			failures = append(failures, err)
+			continue
+		}
+		if visible[0] > r[0] && visible[0]-1 > m.syncedMaxSeqs[id] {
+			if err := m.commitMessageCheckpoint(ctx, id, min(r[1], visible[0]-1)); err != nil {
+				return err
+			}
+		}
+		if visible[0] > visible[1] {
+			continue
+		}
+		if IsNotification(id) {
+			pending[id] = [][2]int64{visible}
+		} else {
+			pending[id] = m.recentMissingRanges(id, visible)
+			if len(pending[id]) == 0 {
+				delete(pending, id)
+				continue
+			}
+		}
+		ids = append(ids, id)
+		visibleRanges[id] = visible
+		for _, page := range pending[id] {
+			totalPages += int((page[1]-page[0])/SplitPullMsgNum + 1)
+		}
+		if !IsNotification(id) && !m.messageAlreadyCovered(id, visible[1]) {
+			last := pending[id][len(pending[id])-1]
+			if last[0] < last[1] {
+				totalPages++ // The preview and remaining tail have separate receipts.
+			}
+		}
+	}
+	priority := make(map[string]int, len(recoveryOrder))
+	for n, id := range recoveryOrder {
+		priority[id] = n
+	}
+	sort.SliceStable(ids, func(i, j int) bool { return priority[ids[i]] < priority[ids[j]] })
+	previewTotal := 0
+	if reinstall {
+		previewTotal = totalPages
+	}
+	failedPreviews, err := m.syncLatestMessagePreviews(ctx, ids, visibleRanges, previewTotal)
+	if err != nil {
+		return err
+	}
+	for id, failure := range failedPreviews {
+		failures = append(failures, failure)
+		delete(pending, id) // Keep its durable target for the next attempt.
+	}
+	// Preview receipts cover only their own sequences. Recompute the recent
+	// gaps so backfill neither downloads that row again nor skips older gaps.
+	for id := range pending {
+		if !IsNotification(id) {
+			pending[id] = m.recentMissingRanges(id, visibleRanges[id])
+			if len(pending[id]) == 0 {
+				delete(pending, id)
+			}
+		}
+	}
+	failures = append(failures, m.recoverRecentMessagePages(ctx, ids, pending, reinstall, totalPages)...)
+	if len(failures) > 0 {
+		return errors.Join(failures...)
+	}
+	// Out-of-order live rows may close the whole latest window before the
+	// recovery job runs. Reconcile unread even when no message page is missing.
+	if m.pendingReadReconcile && !reinstall {
+		if !m.recoveryReadSeqReady {
+			if err := common.SendCmdWithReceipt(ctx, common.Cmd2Value{Cmd: constant.CmdNewMsgCome, Value: sdk_struct.CmdNewMsgComeToConversation{ReconcileReadSeq: true, Recovery: true}}, m.conversationCh); err != nil {
+				return err
+			}
+		}
+		m.pendingReadReconcile = false
+	}
+	return nil
+}
