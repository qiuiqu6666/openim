diff --git a/pkg/db/message_revoke_record.go b/pkg/db/message_revoke_record.go
new file mode 100644
--- /dev/null
+++ b/pkg/db/message_revoke_record.go
@@ -0,0 +1,85 @@
+//go:build !js
+
+package db
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Recall state survives eviction of the message body. It is not a cached body.
+type messageRevokeRecord struct {
+	ConversationID string `gorm:"primaryKey"`
+	Seq            int64  `gorm:"primaryKey"`
+	Tips           string
+}
+
+func (messageRevokeRecord) TableName() string { return "sdk_message_revocations_v1" }
+
+func (d *DataBase) SaveMessageRevocation(ctx context.Context, tips *sdkws.RevokeMsgTips) error {
+	data, err := json.Marshal(tips)
+	if err != nil {
+		return err
+	}
+	d.mRWMutex.Lock()
+	defer d.mRWMutex.Unlock()
+	return d.conn.WithContext(ctx).Clauses(clause.OnConflict{DoNothing: true}).Create(&messageRevokeRecord{ConversationID: tips.ConversationID, Seq: tips.Seq, Tips: string(data)}).Error
+}
+
+func (d *DataBase) ApplyMessageRevocations(ctx context.Context, id string, rows []*model_struct.LocalChatLog) error {
+	d.mRWMutex.RLock()
+	defer d.mRWMutex.RUnlock()
+	return applyMessageRevocations(d.conn.WithContext(ctx), id, rows)
+}
+
+func applyMessageRevocations(tx *gorm.DB, id string, rows []*model_struct.LocalChatLog) error {
+	seqs := make([]int64, 0, len(rows))
+	for _, row := range rows {
+		if row.Seq > 0 {
+			seqs = append(seqs, row.Seq)
+		}
+	}
+	if len(seqs) == 0 {
+		return nil
+	}
+	var records []messageRevokeRecord
+	if err := tx.Where("conversation_id = ? AND seq IN ?", id, seqs).Find(&records).Error; err != nil {
+		return err
+	}
+	bySeq := make(map[int64]*sdkws.RevokeMsgTips, len(records))
+	for _, record := range records {
+		var tips sdkws.RevokeMsgTips
+		if err := json.Unmarshal([]byte(record.Tips), &tips); err != nil {
+			return err
+		}
+		bySeq[record.Seq] = &tips
+	}
+	for _, row := range rows {
+		tips := bySeq[row.Seq]
+		if tips == nil || row.ContentType == constant.RevokeNotification || row.Status >= constant.MsgStatusHasDeleted {
+			continue
+		}
+		nickname := ""
+		if tips.RevokerUserID == row.SendID {
+			nickname = row.SenderNickname
+		}
+		payload, err := json.Marshal(sdk_struct.MessageRevoked{RevokerID: tips.RevokerUserID, ClientMsgID: row.ClientMsgID, RevokerNickname: nickname, RevokeTime: tips.RevokeTime, SourceMessageSendTime: row.SendTime, SourceMessageSendID: row.SendID, SourceMessageSenderNickname: row.SenderNickname, SessionType: tips.SesstionType, Seq: tips.Seq, Ex: row.Ex, IsAdminRevoke: tips.IsAdminRevoke})
+		if err != nil {
+			return err
+		}
+		content, err := json.Marshal(sdk_struct.NotificationElem{Detail: string(payload)})
+		if err != nil {
+			return err
+		}
+		row.ContentType = constant.RevokeNotification
+		row.Content = string(content)
+	}
+	return nil
+}
diff --git a/pkg/db/message_sync_batch.go b/pkg/db/message_sync_batch.go
new file mode 100644
--- /dev/null
+++ b/pkg/db/message_sync_batch.go
@@ -0,0 +1,77 @@
+//go:build !js
+
+package db
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"gorm.io/gorm"
+)
+
+// Messages and their derived conversation/unread state must survive or roll
+// back together. The syncer journal is committed afterwards, so a crash between
+// this transaction and its receipt safely replays the same page.
+func (d *DataBase) CommitMessageSyncBatch(ctx context.Context, updates, inserts map[string][]*model_struct.LocalChatLog, changed, added []*model_struct.LocalConversation) error {
+	for id := range inserts {
+		if err := d.initChatLog(ctx, id); err != nil {
+			return err
+		}
+	}
+	for id := range updates {
+		if err := d.initChatLog(ctx, id); err != nil {
+			return err
+		}
+	}
+	d.mRWMutex.Lock()
+	defer d.mRWMutex.Unlock()
+	return d.conn.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// A transaction-scoped adapter has its own mutex. It never changes the
+		// shared connection, and all existing insert/conflict rules are reused.
+		batch := &DataBase{conn: tx, loginUserID: d.loginUserID, dbDir: d.dbDir, tableChecker: d.tableChecker}
+		for id, rows := range updates {
+			if err := applyMessageReadWatermarks(tx, id, d.loginUserID, rows); err != nil {
+				return err
+			}
+			if err := applyMessageRevocations(tx, id, rows); err != nil {
+				return err
+			}
+			for _, row := range rows {
+				// A delete can commit while an overlapping history request is in
+				// flight. Re-check under this transaction, not only before it.
+				var current model_struct.LocalChatLog
+				if err := tx.Table(utils.GetTableName(id)).Where("client_msg_id = ?", row.ClientMsgID).Take(&current).Error; err != nil {
+					return err
+				}
+				if current.Status >= constant.MsgStatusHasDeleted && row.Status < constant.MsgStatusHasDeleted {
+					continue
+				}
+				ack := &model_struct.LocalChatLog{ClientMsgID: row.ClientMsgID, Seq: row.Seq, Status: row.Status, RecvID: row.RecvID, SessionType: row.SessionType, ServerMsgID: row.ServerMsgID, SendTime: row.SendTime}
+				if row.ContentType == constant.RevokeNotification {
+					ack.ContentType = row.ContentType
+					ack.Content = row.Content
+				}
+				if current.ContentType == constant.RevokeNotification && row.ContentType != constant.RevokeNotification {
+					ack.ContentType = current.ContentType
+					ack.Content = current.Content
+				}
+				if row.IsRead {
+					ack.IsRead = true
+					ack.AttachedInfo = row.AttachedInfo
+				}
+				if err := batch.UpdateMessage(ctx, id, ack); err != nil {
+					return err
+				}
+			}
+		}
+		if err := batch.BatchInsertMessageMap(ctx, inserts); err != nil {
+			return err
+		}
+		if err := batch.BatchUpdateConversationList(ctx, changed); err != nil {
+			return err
+		}
+		return batch.BatchInsertConversationList(ctx, added)
+	})
+}
diff --git a/pkg/db/message_sync_batch_test.go b/pkg/db/message_sync_batch_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/db/message_sync_batch_test.go
@@ -0,0 +1,44 @@
+//go:build cgo && !js
+
+package db
+
+import (
+	"context"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+)
+
+func TestMessageSyncBatchRollsBackRowsWhenConversationWriteFails(t *testing.T) {
+	ctx := context.Background()
+	d, err := NewDataBase(ctx, "atomic-test", t.TempDir(), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = d.Close(ctx) })
+	if err = d.BatchInsertConversationList(ctx, []*model_struct.LocalConversation{{ConversationID: "chat", UnreadCount: 3, LatestMsg: "before", LatestMsgSendTime: 3}}); err != nil {
+		t.Fatal(err)
+	}
+	rows := map[string][]*model_struct.LocalChatLog{"chat": {{ClientMsgID: "m4", Seq: 4}}}
+	// Updating an absent conversation fails after the message insert executed.
+	err = d.CommitMessageSyncBatch(ctx, nil, rows, []*model_struct.LocalConversation{{ConversationID: "missing", UnreadCount: 4}}, nil)
+	if err == nil {
+		t.Fatal("injected conversation failure accepted")
+	}
+	if _, err = d.GetMessageBySeq(ctx, "chat", 4); err == nil {
+		t.Fatal("message survived failed transaction")
+	}
+	if err = d.CommitMessageSyncBatch(ctx, nil, rows, []*model_struct.LocalConversation{{ConversationID: "chat", UnreadCount: 4, LatestMsg: "after", LatestMsgSendTime: 4}}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = d.GetMessageBySeq(ctx, "chat", 4); err != nil {
+		t.Fatal(err)
+	}
+	c, err := d.GetConversation(ctx, "chat")
+	if err != nil || c.UnreadCount != 4 || c.LatestMsg != "after" {
+		t.Fatalf("partial commit: %+v %v", c, err)
+	}
+	if err = d.CommitMessageSyncBatch(ctx, nil, rows, nil, nil); err != nil {
+		t.Fatal("replay not idempotent", err)
+	}
+}
diff --git a/pkg/db/message_window.go b/pkg/db/message_window.go
new file mode 100644
--- /dev/null
+++ b/pkg/db/message_window.go
@@ -0,0 +1,37 @@
+//go:build !js
+
+package db
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+	"gorm.io/gorm"
+)
+
+// ReadMessageWindow reads permissions, rows and durable revocations together.
+// A crash cannot leave a published coverage proof ahead of its messages: the
+// proof is reconstructed from committed rows on every native snapshot read.
+func (d *DataBase) ReadMessageWindow(ctx context.Context, id string, count int, target int64) (*model_struct.MessageWindowRead, error) {
+	d.mRWMutex.RLock()
+	defer d.mRWMutex.RUnlock()
+	result := &model_struct.MessageWindowRead{Conversation: &model_struct.LocalConversation{}}
+	err := d.conn.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("conversation_id = ?", id).Take(result.Conversation).Error; err != nil {
+			return err
+		}
+		table := utils.GetTableName(id)
+		if !tx.Migrator().HasTable(table) {
+			return nil
+		}
+		q := tx.Table(table).Where("seq > 0")
+		if target > 0 {
+			q = q.Where("seq <= ?", target)
+		}
+		if err := q.Order("seq DESC").Limit(min(max(count, 1), 300)).Find(&result.Rows).Error; err != nil {
+			return err
+		}
+		return applyMessageRevocations(tx, id, result.Rows)
+	})
+	return result, err
+}
diff --git a/pkg/db/message_window_crash_test.go b/pkg/db/message_window_crash_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/db/message_window_crash_test.go
@@ -0,0 +1,126 @@
+//go:build cgo && !js
+
+package db
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+	"gorm.io/gorm"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// This helper is a separate OS process. The parent kills it after SQLite has
+// written a transaction page, or after commit but before an SDK/UI receipt.
+func TestWindowCrashChild(t *testing.T) {
+	dir := os.Getenv("CHAT_WINDOW_CRASH_DIR")
+	if dir == "" {
+		t.Skip("subprocess only")
+	}
+	ctx := context.Background()
+	d, err := NewDataBase(ctx, "window-crash", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	phase := os.Getenv("CHAT_WINDOW_CRASH_PHASE")
+	pause := func() {
+		if err := os.WriteFile(filepath.Join(dir, "ready"), []byte(phase), 0600); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			time.Sleep(time.Second)
+		}
+	}
+	if phase == "during" {
+		if err = d.conn.Callback().Create().After("gorm:create").Register("window_crash", func(tx *gorm.DB) {
+			if tx.Statement.Table == utils.GetTableName("chat") {
+				pause()
+			}
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	err = d.CommitMessageSyncBatch(ctx, nil, map[string][]*model_struct.LocalChatLog{"chat": {{ClientMsgID: "m2", Seq: 2}}}, []*model_struct.LocalConversation{{ConversationID: "chat", MaxSeq: 2, UnreadCount: 2}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pause()
+}
+
+func TestWindowCrashRecovery(t *testing.T) {
+	for _, phase := range []string{"during", "after"} {
+		t.Run(phase, func(t *testing.T) {
+			dir := t.TempDir()
+			ctx := context.Background()
+			d, err := NewDataBase(ctx, "window-crash", dir, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = d.BatchInsertConversationList(ctx, []*model_struct.LocalConversation{{ConversationID: "chat", MaxSeq: 1, UnreadCount: 1}}); err != nil {
+				t.Fatal(err)
+			}
+			if err = d.BatchInsertMessageList(ctx, "chat", []*model_struct.LocalChatLog{{ClientMsgID: "m1", Seq: 1}}); err != nil {
+				t.Fatal(err)
+			}
+			if err = d.Close(ctx); err != nil {
+				t.Fatal(err)
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestWindowCrashChild$", "-test.timeout=30s")
+			cmd.Env = append(os.Environ(), "CHAT_WINDOW_CRASH_DIR="+dir, "CHAT_WINDOW_CRASH_PHASE="+phase)
+			output, err := os.Create(filepath.Join(dir, "child.log"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer output.Close()
+			cmd.Stdout = output
+			cmd.Stderr = output
+			if err = cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = cmd.Process.Kill() }()
+			deadline := time.Now().Add(20 * time.Second)
+			for {
+				if _, err = os.Stat(filepath.Join(dir, "ready")); err == nil {
+					break
+				}
+				if time.Now().After(deadline) {
+					b, _ := os.ReadFile(filepath.Join(dir, "child.log"))
+					t.Fatalf("child never reached failpoint: %s", b)
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			if err = cmd.Process.Kill(); err != nil {
+				t.Fatal(err)
+			}
+			_ = cmd.Wait()
+			d, err = NewDataBase(ctx, "window-crash", dir, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer d.Close(ctx)
+			w, err := d.ReadMessageWindow(ctx, "chat", 40, 2)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := 1
+			if phase == "after" {
+				want = 2
+			}
+			if len(w.Rows) != want || w.Conversation.MaxSeq != int64(want) || w.Conversation.UnreadCount != int32(want) {
+				t.Fatalf("partial commit after kill: %+v rows=%d", w.Conversation, len(w.Rows))
+			}
+			// Replay after a lost receipt must not duplicate a committed message.
+			if err = d.CommitMessageSyncBatch(ctx, nil, map[string][]*model_struct.LocalChatLog{"chat": {{ClientMsgID: "m2", Seq: 2}}}, []*model_struct.LocalConversation{{ConversationID: "chat", MaxSeq: 2, UnreadCount: 2}}, nil); err != nil {
+				t.Fatal(err)
+			}
+			w, err = d.ReadMessageWindow(ctx, "chat", 40, 2)
+			if err != nil || len(w.Rows) != 2 {
+				t.Fatalf("replay: %+v %v", w, err)
+			}
+		})
+	}
+}
diff --git a/pkg/db/message_window_mutation_test.go b/pkg/db/message_window_mutation_test.go
