+func (c *Conversation) judgeMultipleSubString(keywordList []string, main string, keywordListMatchType int) bool {
+	if len(keywordList) == 0 {
+		return true
+	}
+	if keywordListMatchType == constant.KeywordMatchOr {
+		for _, v := range keywordList {
+			if utils.KMP(main, v) {
+				return true
+			}
+		}
+		return false
+	} else {
+		for _, v := range keywordList {
+			if !utils.KMP(main, v) {
+				return false
+			}
+		}
+	}
+	return true
+}
