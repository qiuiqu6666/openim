@@ -0,0 +1,30 @@
+package group
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestCancelledGroupRecoveryDoesNotWaitForAPILock(t *testing.T) {
+	var gate groupSyncGate
+	gate.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- gate.LockContext(ctx) }()
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancelled waiter blocked")
+	}
+	gate.Unlock()
+	if err := gate.LockContext(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	gate.Unlock()
+}
diff --git a/internal/group/sync_member_departure.go b/internal/group/sync_member_departure.go
new file mode 100644
index 00000000..56ece1ac
--- /dev/null
+++ b/internal/group/sync_member_departure.go
@@ -0,0 +1,65 @@
+package group
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/group"
+)
+
+// A permission error alone is not proof of departure. Reconcile against a
+// complete authoritative membership snapshot before retiring any obligation.
+// Do not touch messages or conversation history.
+func (g *Group) retireDepartedMemberRequests(ctx context.Context, scope string, requests []*group.GetIncrementalGroupMemberReq) ([]*group.GetIncrementalGroupMemberReq, error) {
+	joined, err := g.getFullJoinGroupIDs(ctx, &group.GetFullJoinGroupIDsReq{UserID: g.loginUserID})
+	if err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	active := make(map[string]bool, len(joined.GroupIDs))
+	for _, id := range joined.GroupIDs {
+		active[id] = true
+	}
+	pending := make([]*group.GetIncrementalGroupMemberReq, 0, len(requests))
+	departed := make(map[string]bool)
+	for _, req := range requests {
+		if active[req.GroupID] {
+			pending = append(pending, req)
+		} else {
+			departed[req.GroupID] = true
+		}
+	}
+	if len(departed) == 0 {
+		return pending, nil
+	}
+	local, err := g.db.GetJoinedGroupListDB(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var removed []*model_struct.LocalGroup
+	for _, row := range local {
+		if row != nil && departed[row.GroupID] {
+			removed = append(removed, row)
+		}
+	}
+	// Invalidate the joined-list cursor first: its UIDList must not keep
+	// resurrecting retired jobs. A failed cleanup remains retryable.
+	if err := g.db.DeleteVersionSync(ctx, g.groupTableName(), g.loginUserID); err != nil {
+		return nil, err
+	}
+	// Reuse normal departure cleanup and listener ownership. Only the confirmed
+	// departed rows participate; unrelated local groups are preserved.
+	if err := g.groupSyncer.Sync(ctx, nil, removed, nil); err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	for id := range departed {
+		common.CompleteMetadataItem(ctx, scope, id)
+	}
+	return pending, nil
+}
diff --git a/internal/group/sync_member_departure_test.go b/internal/group/sync_member_departure_test.go
new file mode 100644
index 00000000..7e7385f8
--- /dev/null
+++ b/internal/group/sync_member_departure_test.go
@@ -0,0 +1,130 @@
+package group
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/open_im_sdk_callback"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	protocol "github.com/openimsdk/protocol/group"
+)
+
+type departureDB struct {
+	groupProfileDB
+	rows                 []*model_struct.LocalGroup
+	deleted, invalidated int
+	fail                 bool
+}
+
+func (d *departureDB) GetJoinedGroupListDB(context.Context) ([]*model_struct.LocalGroup, error) {
+	return d.rows, nil
+}
+func (d *departureDB) DeleteGroupAllMembers(context.Context, string) error {
+	if d.fail {
+		return errors.New("storage unavailable")
+	}
+	return nil
+}
+func (d *departureDB) DeleteVersionSync(context.Context, string, string) error {
+	d.invalidated++
+	return nil
+}
+func (d *departureDB) DeleteGroup(_ context.Context, id string) error {
+	for i, row := range d.rows {
+		if row.GroupID == id {
+			d.rows = append(d.rows[:i], d.rows[i+1:]...)
+			d.deleted++
+			break
+		}
+	}
+	return nil
+}
+
+type departureListener struct {
+	groupProfileListener
+	removed int
+}
+
+func (l *departureListener) OnJoinedGroupDeleted(string) { l.removed++ }
+
+func TestDepartedMemberPermissionRecovery(t *testing.T) {
+	for _, mode := range []string{"departed", "still_joined", "membership_failure", "transient", "storage_failure", "cancelled", "rejoined"} {
+		t.Run(mode, func(t *testing.T) {
+			batches, checks := 0, 0
+			var cancel context.CancelFunc
+			ctx := groupProfileServer(t, func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/group/get_full_join_group_ids" {
+					checks++
+					if mode == "membership_failure" {
+						_ = json.NewEncoder(w).Encode(map[string]any{"errCode": 500, "errMsg": "unavailable"})
+						return
+					}
+					if mode == "cancelled" {
+						cancel()
+						return
+					}
+					ids := []string{"valid"}
+					if mode == "still_joined" || mode == "rejoined" {
+						ids = append(ids, "old")
+					}
+					profileResponse(w, map[string]any{"groupIDs": ids})
+					return
+				}
+				var req protocol.BatchGetIncrementalGroupMemberReq
+				if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+					t.Error(err)
+					return
+				}
+				batches++
+				for _, item := range req.ReqList {
+					if item.GroupID == "old" {
+						code := 1002
+						if mode == "transient" {
+							code = 500
+						}
+						_ = json.NewEncoder(w).Encode(map[string]any{"errCode": code, "errMsg": "denied"})
+						return
+					}
+				}
+				profileResponse(w, map[string]any{"respList": map[string]any{"valid": map[string]any{}}})
+			})
+			ctx = common.WithMetadataProgress(ctx, &common.MetadataProgress{})
+			ctx, cancel = context.WithCancel(ctx)
+			defer cancel()
+			d := &departureDB{rows: []*model_struct.LocalGroup{{GroupID: "old"}, {GroupID: "valid"}}, fail: mode == "storage_failure"}
+			g := NewGroup("self", d, make(chan common.Cmd2Value, 4))
+			l := &departureListener{}
+			g.SetGroupListener(func() open_im_sdk_callback.OnGroupListener { return l })
+			err := g.IncrSyncGroupAndMember(ctx, "old", "valid")
+			if mode == "departed" {
+				if err != nil || batches != 2 || checks != 1 || d.deleted != 1 || l.removed != 1 || len(d.rows) != 1 || d.rows[0].GroupID != "valid" || d.invalidated != 2 {
+					t.Fatalf("err=%v batches=%d checks=%d db=%+v listener=%+v", err, batches, checks, d, l)
+				}
+				// A subsequent local-list sweep must not recreate the retired job.
+				if err := g.IncrSyncJoinGroupMember(ctx); err != nil || checks != 1 {
+					t.Fatalf("retired job repeated: %v checks=%d", err, checks)
+				}
+			} else {
+				if err == nil || d.deleted != 0 || l.removed != 0 || batches != 1 {
+					t.Fatalf("unsafe retirement: err=%v batches=%d db=%+v", err, batches, d)
+				}
+				if mode == "transient" && checks != 0 {
+					t.Fatal("transient error caused membership cleanup")
+				}
+				if mode != "cancelled" && len(common.PendingMetadataItems(ctx, "group-members", []string{"old", "valid"})) != 2 {
+					t.Fatal("failed recovery acknowledged pending work")
+				}
+				if mode == "storage_failure" {
+					d.fail = false
+					if err := g.IncrSyncGroupAndMember(ctx, "old", "valid"); err != nil || d.deleted != 1 || l.removed != 1 {
+						t.Fatalf("storage retry failed: %v", err)
+					}
+				}
+			}
+		})
+	}
+}
diff --git a/internal/group/sync_member_requests.go b/internal/group/sync_member_requests.go
new file mode 100644
index 00000000..a92bdb0d
--- /dev/null
+++ b/internal/group/sync_member_requests.go
@@ -0,0 +1,73 @@
+package group
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/protocol/group"
+	"github.com/openimsdk/tools/errs"
+)
+
+// The server stops after its changed-member response budget. A group omitted
+// from a nonempty response may not have been inspected; it is not a checkpoint.
+func (g *Group) syncMemberRequests(ctx context.Context, scope string, requests []*group.GetIncrementalGroupMemberReq) error {
+	for len(requests) > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		responses, err := g.getIncrementalGroupMemberBatch(ctx, requests)
+		if err != nil {
+			if errs.ErrNoPermission.Is(err) {
+				pending, recoveryErr := g.retireDepartedMemberRequests(ctx, scope, requests)
+				if recoveryErr != nil {
+					return recoveryErr
+				}
+				if len(pending) < len(requests) {
+					requests = pending
+					continue
+				}
+			}
+			return err
+		}
+		// The existing server skips dismissed groups. An entirely empty success
+		// cannot have reached the response budget, so all remaining were checked.
+		if len(responses) == 0 {
+			for _, req := range requests {
+				common.CompleteMetadataItem(ctx, scope, req.GroupID)
+			}
+			return ctx.Err()
+		}
+		pending := make([]*group.GetIncrementalGroupMemberReq, 0, len(requests))
+		tasks := make([]func() error, 0, len(requests))
+		for _, req := range requests {
+			id := req.GroupID
+			resp, present := responses[id]
+			if !present {
+				pending = append(pending, req)
+				continue
+			}
+			if unchangedMemberVersion(req, resp) {
+				common.CompleteMetadataItem(ctx, scope, id)
+				continue
+			}
+			tasks = append(tasks, func() error {
+				if resp == nil {
+					return errs.New("nil incremental group response", "groupID", id)
+				}
+				if err := g.syncGroupAndMember(ctx, id, resp); err != nil {
+					return err
+				}
+				common.CompleteMetadataItem(ctx, scope, id)
+				return nil
+			})
+		}
+		if len(pending) == len(requests) {
+			return errs.New("group batch response made no progress")
+		}
+		if err := runGroupSyncBatch(ctx, tasks); err != nil {
+			return err
+		}
+		requests = pending
+	}
+	return ctx.Err()
+}
diff --git a/internal/group/sync_probe.go b/internal/group/sync_probe.go
new file mode 100644
index 00000000..55201d4e
--- /dev/null
+++ b/internal/group/sync_probe.go
@@ -0,0 +1,54 @@
+package group
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/group"
+	"github.com/openimsdk/tools/errs"
+)
+
+// Optional capability keeps the existing database contract and WASM fallback.
+type versionHeaderReader interface {
+	GetVersionSyncHeaders(context.Context, string, []string) (map[string]*model_struct.LocalVersionSync, error)
+}
+
+func (g *Group) memberVersionRequests(ctx context.Context, ids []string) ([]*group.GetIncrementalGroupMemberReq, error) {
+	versions := make(map[string]*model_struct.LocalVersionSync, len(ids))
+	if reader, ok := g.db.(versionHeaderReader); ok {
+		var err error
+		versions, err = reader.GetVersionSyncHeaders(ctx, g.groupAndMemberVersionTableName(), ids)
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		for _, id := range ids {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			version, err := g.db.GetVersionSync(ctx, g.groupAndMemberVersionTableName(), id)
+			if err != nil && !errs.ErrRecordNotFound.Is(err) {
+				return nil, err
+			}
+			if err == nil {
+				versions[id] = version
+			}
+		}
+	}
+	requests := make([]*group.GetIncrementalGroupMemberReq, 0, len(ids))
+	for _, id := range ids {
+		request := &group.GetIncrementalGroupMemberReq{GroupID: id}
+		if version := versions[id]; version != nil {
+			request.VersionID, request.Version = version.VersionID, version.Version
+		}
+		requests = append(requests, request)
+	}
+	return requests, ctx.Err()
+}
+
+func unchangedMemberVersion(req *group.GetIncrementalGroupMemberReq, resp *group.GetIncrementalGroupMemberResp) bool {
+	return resp != nil && req.VersionID != "" && req.Version > 0 &&
+		req.VersionID == resp.VersionID && req.Version == resp.Version &&
+		!resp.Full && resp.Group == nil && resp.SortVersion == 0 &&
+		len(resp.Insert) == 0 && len(resp.Update) == 0 && len(resp.Delete) == 0
+}
