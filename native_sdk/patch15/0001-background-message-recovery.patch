@@ -0,0 +1,92 @@
+//go:build cgo && !js
+
+package db
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+)
+
+func TestGroupProfilePagesAreCompleteAndRollbackOnFailure(t *testing.T) {
+	ctx := ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "profile-pages"})
+	d, err := NewDataBase(ctx, "profile-pages", t.TempDir(), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close(ctx)
+	groups := make([]*model_struct.LocalGroup, 257)
+	rows := make([]*model_struct.LocalConversation, 257)
+	for i := range groups {
+		id := fmt.Sprintf("g%04d", i)
+		face := "new"
+		if i%7 == 0 {
+			face = ""
+		}
+		groups[i] = &model_struct.LocalGroup{GroupID: id, GroupName: "New", FaceURL: face}
+		rows[i] = &model_struct.LocalConversation{ConversationID: id, GroupID: id, ConversationType: constant.ReadGroupChatType, ShowName: "Old", FaceURL: "old", LatestMsgSendTime: 1, DraftText: "draft", UnreadCount: 7, IsPinned: true}
+	}
+	for start := 0; start < len(groups); start += 100 {
+		end := start + 100
+		if end > len(groups) {
+			end = len(groups)
+		}
+		if err := d.BatchInsertGroup(ctx, groups[start:end]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := d.BatchInsertConversationList(ctx, rows); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.conn.Exec("CREATE TRIGGER fail_profile BEFORE UPDATE ON local_conversations WHEN OLD.conversation_id = 'g0002' BEGIN SELECT RAISE(ABORT, 'injected profile failure'); END").Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := d.ReconcileGroupConversationProfilePage(ctx, "", 128); err == nil {
+		t.Fatal("write failure was swallowed")
+	}
+	first, err := d.GetConversation(ctx, "g0000")
+	if err != nil || first.ShowName != "Old" {
+		t.Fatal("failed page did not roll back")
+	}
+	if err := d.conn.Exec("DROP TRIGGER fail_profile").Error; err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	after := ""
+	for {
+		page, err := d.ReconcileGroupConversationProfilePage(ctx, after, 128)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(page) == 0 {
+			break
+		}
+		if len(page) > 128 {
+			t.Fatal("unbounded callback page")
+		}
+		for _, row := range page {
+			if seen[row.ConversationID] || row.ShowName != "New" || row.UnreadCount != 7 || row.DraftText != "draft" || !row.IsPinned {
+				t.Fatalf("incorrect page row %+v", row)
+			}
+			seen[row.ConversationID] = true
+		}
+		after = page[len(page)-1].ConversationID
+	}
+	if len(seen) != len(groups) {
+		t.Fatalf("lost group profiles: %d/%d", len(seen), len(groups))
+	}
+	for _, group := range groups {
+		row, err := d.GetConversation(ctx, group.GroupID)
+		if err != nil || row.FaceURL != group.FaceURL {
+			t.Fatalf("avatar missed: %s", group.GroupID)
+		}
+	}
+	page, err := d.ReconcileGroupConversationProfilePage(ctx, "", 128)
+	if err != nil || len(page) != 0 {
+		t.Fatal("unchanged data was republished")
+	}
+}
diff --git a/pkg/db/message_cache.go b/pkg/db/message_cache.go
new file mode 100644
index 00000000..2a3ede08
--- /dev/null
+++ b/pkg/db/message_cache.go
@@ -0,0 +1,269 @@
+//go:build !js
+
+package db
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Limits apply to replaceable, acknowledged server messages. Unsent/failed
+// messages, local deletion markers and durable state overlays are not cache.
+const MessageCacheConversationLimit = 1000
+const MessageCacheAccountLimit = 20000
+const MessageCacheByteLimit int64 = 64 << 20
+
+// Adopt existing conversation tables once on upgrade. This only compacts local
+// replaceable bodies; it never downloads history or rewrites unread/checkpoints.
+func (d *DataBase) initializeMessageCache(ctx context.Context, tables []string) error {
+	var known []messageCacheConversation
+	if err := d.conn.WithContext(ctx).Find(&known).Error; err != nil {
+		return err
+	}
+	adopted := make(map[string]bool, len(known))
+	for _, row := range known {
+		adopted[row.ConversationID] = true
+	}
+	for _, table := range tables {
+		if !strings.HasPrefix(table, "chat_logs_") {
+			continue
+		}
+		id := strings.TrimPrefix(table, "chat_logs_")
+		if !adopted[id] {
+			if err := d.MaintainMessageCache(ctx, id, nil); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+type messageCacheEntry struct {
+	ConversationID string `gorm:"primaryKey;index:cache_lru_conversation,priority:1"`
+	ClientMsgID    string `gorm:"primaryKey"`
+	Seq            int64
+	SendTime       int64
+	Touched        int64 `gorm:"index:cache_lru;index:cache_lru_conversation,priority:2"`
+	Bytes          int64
+}
+
+func (messageCacheEntry) TableName() string { return "sdk_message_cache_v1" }
+
+type messageCacheConversation struct {
+	ConversationID string `gorm:"primaryKey"`
+}
+
+func (messageCacheConversation) TableName() string { return "sdk_message_cache_conversations_v1" }
+
+// A small cursor survives eviction, so an open page can still request the next
+// older page by clientMsgID even under sustained live traffic.
+type messageCacheAnchor struct {
+	ConversationID string `gorm:"primaryKey"`
+	ClientMsgID    string `gorm:"primaryKey"`
+	Seq            int64
+	SendTime       int64
+	Touched        int64 `gorm:"index"`
+}
+
+func (messageCacheAnchor) TableName() string { return "sdk_message_cache_anchors_v1" }
+
+// Two paging cursors per conversation/view survive arbitrary live traffic.
+// They contain no message body and are replaced when that view changes pages.
+type messageCacheCursor struct {
+	ConversationID string `gorm:"primaryKey"`
+	ViewType       int    `gorm:"primaryKey"`
+	Reverse        bool   `gorm:"primaryKey"`
+	ClientMsgID    string
+	Seq            int64
+	SendTime       int64
+}
+
+func (messageCacheCursor) TableName() string { return "sdk_message_cache_cursors_v1" }
+
+func (d *DataBase) SaveMessageCacheCursors(ctx context.Context, id string, view int, reverse, reset bool, rows []*model_struct.LocalChatLog) error {
+	var first, last *model_struct.LocalChatLog
+	for _, row := range rows {
+		if row.Seq <= 0 {
+			continue
+		}
+		if first == nil || row.Seq < first.Seq {
+			first = row
+		}
+		if last == nil || row.Seq > last.Seq {
+			last = row
+		}
+	}
+	if first == nil {
+		return nil
+	}
+	var cursors []messageCacheCursor
+	if !reverse || reset {
+		cursors = append(cursors, messageCacheCursor{id, view, false, first.ClientMsgID, first.Seq, first.SendTime})
+	}
+	if reverse || reset {
+		cursors = append(cursors, messageCacheCursor{id, view, true, last.ClientMsgID, last.Seq, last.SendTime})
+	}
+	d.mRWMutex.Lock()
+	defer d.mRWMutex.Unlock()
+	return d.conn.WithContext(ctx).Clauses(clause.OnConflict{UpdateAll: true}).Create(&cursors).Error
+}
+
+func (d *DataBase) GetMessageCacheAnchor(ctx context.Context, id, msgID string) (*model_struct.LocalChatLog, error) {
+	d.mRWMutex.RLock()
+	defer d.mRWMutex.RUnlock()
+	var a messageCacheAnchor
+	if err := d.conn.WithContext(ctx).Where("conversation_id = ? AND client_msg_id = ?", id, msgID).Take(&a).Error; err != nil {
+		if err != gorm.ErrRecordNotFound {
+			return nil, err
+		}
+		var cursor messageCacheCursor
+		if err := d.conn.WithContext(ctx).Where("conversation_id = ? AND client_msg_id = ?", id, msgID).Take(&cursor).Error; err != nil {
+			return nil, err
+		}
+		return &model_struct.LocalChatLog{ClientMsgID: cursor.ClientMsgID, Seq: cursor.Seq, SendTime: cursor.SendTime}, nil
+	}
+	return &model_struct.LocalChatLog{ClientMsgID: a.ClientMsgID, Seq: a.Seq, SendTime: a.SendTime}, nil
+}
+
+// MaintainMessageCache is called after durable delivery, and after a history
+// result is built. Eviction never changes unread, summaries or sync coverage.
+func (d *DataBase) MaintainMessageCache(ctx context.Context, id string, touchedIDs []string) error {
+	if err := d.initChatLog(ctx, id); err != nil {
+		return err
+	}
+	d.mRWMutex.Lock()
+	defer d.mRWMutex.Unlock()
+	return d.conn.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		table := utils.GetConversationTableName(id)
+		now := time.Now().UnixNano()
+		// Import at most a cache window from an older SDK. Already-indexed rows
+		// retain their access age; freshly fetched history is explicitly touched.
+		var rows []*model_struct.LocalChatLog
+		var initialized int64
+		if err := tx.Model(&messageCacheConversation{}).Where("conversation_id = ?", id).Count(&initialized).Error; err != nil {
+			return err
+		}
+		if initialized == 0 {
+			if err := tx.Table(table).Where("seq > 0 AND status = ? AND coalesce(content_type,0) != ?", constant.MsgStatusSendSuccess, constant.RevokeNotification).Order("seq DESC").Limit(MessageCacheConversationLimit).Find(&rows).Error; err != nil {
+				return err
+			}
+		}
+		if len(touchedIDs) > 0 {
+			var touched []*model_struct.LocalChatLog
+			if err := tx.Table(table).Where("client_msg_id IN ? AND seq > 0 AND status = ? AND coalesce(content_type,0) != ?", touchedIDs, constant.MsgStatusSendSuccess, constant.RevokeNotification).Find(&touched).Error; err != nil {
+				return err
+			}
+			rows = append(rows, touched...)
+		}
+		touched := make(map[string]bool, len(touchedIDs))
+		for _, msgID := range touchedIDs {
+			touched[msgID] = true
+		}
+		entries := make(map[string]messageCacheEntry)
+		for _, row := range rows {
+			age := row.SendTime * int64(time.Millisecond)
+			if touched[row.ClientMsgID] {
+				age = now
+			}
+			entries[row.ClientMsgID] = messageCacheEntry{ConversationID: id, ClientMsgID: row.ClientMsgID, Seq: row.Seq, SendTime: row.SendTime, Touched: age,
+				Bytes: int64(len(row.Content) + len(row.AttachedInfo) + len(row.Ex) + len(row.LocalEx) + len(row.ClientMsgID) + len(row.ServerMsgID) + len(row.SenderNickname) + len(row.SenderFaceURL) + 256)}
+		}
+		batch := make([]messageCacheEntry, 0, len(entries))
+		for _, entry := range entries {
+			batch = append(batch, entry)
+		}
+		if len(batch) > 0 {
+			if err := tx.Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "conversation_id"}, {Name: "client_msg_id"}}, DoUpdates: clause.AssignmentColumns([]string{"bytes", "seq", "send_time"})}).CreateInBatches(batch, 100).Error; err != nil {
+				return err
+			}
+			if len(touchedIDs) > 0 {
+				if err := tx.Model(&messageCacheEntry{}).Where("conversation_id = ? AND client_msg_id IN ?", id, touchedIDs).Update("touched", now).Error; err != nil {
+					return err
+				}
+			}
+		}
+		// Compact legacy cache without touching pending sends or local deletes.
+		if initialized == 0 {
+			// Legacy recall rows are themselves durable tombstones. Keep them
+			// even if this SDK has not yet observed their notification journal.
+			if err := tx.Exec(fmt.Sprintf("DELETE FROM `%s` WHERE seq > 0 AND status = ? AND coalesce(content_type,0) != ? AND client_msg_id NOT IN (SELECT client_msg_id FROM sdk_message_cache_v1 WHERE conversation_id = ?)", table), constant.MsgStatusSendSuccess, constant.RevokeNotification, id).Error; err != nil {
+				return err
+			}
+			if err := tx.Create(&messageCacheConversation{ConversationID: id}).Error; err != nil {
+				return err
+			}
+		}
+		deleted := tx.Table(table).Where("status >= ?", constant.MsgStatusHasDeleted)
+		if initialized != 0 {
+			deleted = deleted.Where("client_msg_id IN ?", touchedIDs)
+		}
+		if err := deleted.Update("content", "").Error; err != nil {
+			return err
+		}
+		var victims []messageCacheEntry
+		if err := tx.Where("conversation_id = ?", id).Order("touched DESC, seq DESC").Offset(MessageCacheConversationLimit).Find(&victims).Error; err != nil {
+			return err
+		}
+		if err := evictMessageCache(tx, victims); err != nil {
+			return err
+		}
+		var totals struct {
+			Count int64
+			Bytes int64
+		}
+		if err := tx.Model(&messageCacheEntry{}).Select("count(*) AS count, coalesce(sum(bytes),0) AS bytes").Scan(&totals).Error; err != nil {
+			return err
+		}
+		for totals.Count > MessageCacheAccountLimit || totals.Bytes > MessageCacheByteLimit {
+			var oldest []messageCacheEntry
+			if err := tx.Order("touched ASC, seq ASC").Limit(100).Find(&oldest).Error; err != nil {
+				return err
+			}
+			if len(oldest) == 0 {
+				break
+			}
+			if err := evictMessageCache(tx, oldest); err != nil {
+				return err
+			}
+			for _, v := range oldest {
+				totals.Count--
+				totals.Bytes -= v.Bytes
+			}
+		}
+		return tx.Exec("DELETE FROM sdk_message_cache_anchors_v1 WHERE rowid IN (SELECT rowid FROM sdk_message_cache_anchors_v1 ORDER BY touched DESC LIMIT -1 OFFSET ?)", MessageCacheAccountLimit).Error
+	})
+}
+
+func evictMessageCache(tx *gorm.DB, victims []messageCacheEntry) error {
+	groups := make(map[string][]string)
+	anchors := make([]messageCacheAnchor, 0, len(victims))
+	for _, v := range victims {
+		groups[v.ConversationID] = append(groups[v.ConversationID], v.ClientMsgID)
+		anchors = append(anchors, messageCacheAnchor{v.ConversationID, v.ClientMsgID, v.Seq, v.SendTime, time.Now().UnixNano()})
+	}
+	if len(anchors) > 0 {
+		if err := tx.Clauses(clause.OnConflict{UpdateAll: true}).CreateInBatches(anchors, 100).Error; err != nil {
+			return err
+		}
+	}
+	for id, ids := range groups {
+		for begin := 0; begin < len(ids); begin += 100 {
+			page := ids[begin:min(begin+100, len(ids))]
+			if err := tx.Table(utils.GetConversationTableName(id)).Where("client_msg_id IN ? AND seq > 0 AND status = ? AND coalesce(content_type,0) != ?", page, constant.MsgStatusSendSuccess, constant.RevokeNotification).Delete(&model_struct.LocalChatLog{}).Error; err != nil {
+				return err
+			}
+			if err := tx.Where("conversation_id = ? AND client_msg_id IN ?", id, page).Delete(&messageCacheEntry{}).Error; err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
diff --git a/pkg/db/message_cache_test.go b/pkg/db/message_cache_test.go
new file mode 100644
index 00000000..32d7292f
--- /dev/null
+++ b/pkg/db/message_cache_test.go
@@ -0,0 +1,261 @@
+//go:build cgo && !js
+
+package db
+
+import (
+	"context"
+	"fmt"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+	"github.com/openimsdk/protocol/sdkws"
+	"strings"
+	"testing"
+)
+
+func cacheTestDB(t *testing.T) (*DataBase, context.Context) {
+	t.Helper()
+	ctx := context.Background()
+	d, err := NewDataBase(ctx, "cache-test", t.TempDir(), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = d.Close(ctx) })
+	return d, ctx
+}
+
+func cacheTestRows(first, last int) []*model_struct.LocalChatLog {
+	var rows []*model_struct.LocalChatLog
+	for seq := first; seq <= last; seq++ {
+		rows = append(rows, &model_struct.LocalChatLog{ClientMsgID: fmt.Sprint(seq), Seq: int64(seq), SendTime: int64(seq), Status: constant.MsgStatusSendSuccess, Content: `{"content":"message"}`})
+	}
+	return rows
+}
+
+func TestCacheEvictionRetainsUnreadPendingAndPagingAnchor(t *testing.T) {
+	d, ctx := cacheTestDB(t)
+	if err := d.BatchInsertConversationList(ctx, []*model_struct.LocalConversation{{ConversationID: "chat", UnreadCount: 99000, LatestMsg: `{"seq":1200}`}}); err != nil {
+		t.Fatal(err)
+	}
+	rows := append(cacheTestRows(1, 1000), &model_struct.LocalChatLog{ClientMsgID: "pending", Status: constant.MsgStatusSending}, &model_struct.LocalChatLog{ClientMsgID: "failed", Status: constant.MsgStatusSendFailed}, &model_struct.LocalChatLog{ClientMsgID: "deleted", Seq: 99999, Status: constant.MsgStatusHasDeleted})
+	if err := d.BatchInsertMessageList(ctx, "chat", rows); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.MaintainMessageCache(ctx, "chat", nil); err != nil {
+		t.Fatal(err)
+	}
+	newRows := cacheTestRows(1001, 1200)
+	if err := d.SaveMessageCacheCursors(ctx, "chat", 0, false, true, cacheTestRows(1, 40)); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.BatchInsertMessageMap(ctx, map[string][]*model_struct.LocalChatLog{"chat": newRows}); err != nil {
+		t.Fatal(err)
+	}
+	var ids []string
+	for _, row := range newRows {
+		ids = append(ids, row.ClientMsgID)
+	}
+	if err := d.MaintainMessageCache(ctx, "chat", ids); err != nil {
+		t.Fatal(err)
+	}
+	var count int64
+	d.conn.Table(utils.GetTableName("chat")).Count(&count)
+	if count != 1003 {
+		t.Fatalf("cache count %d, want 1000 + 3 protected rows", count)
+	}
+	anchor, err := d.GetMessageCacheAnchor(ctx, "chat", "100")
+	if err != nil || anchor.Seq != 100 {
+		t.Fatalf("evicted cursor: %+v %v", anchor, err)
+	}
+	// Even after the ordinary eviction-anchor budget has rolled over, the
+	// currently installed forward and reverse paging positions remain usable.
+	if err := d.conn.Where("conversation_id = ?", "chat").Delete(&messageCacheAnchor{}).Error; err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []string{"1", "40"} {
+		if _, err := d.GetMessageCacheAnchor(ctx, "chat", id); err != nil {
+			t.Fatal("active cursor lost", id, err)
+		}
+	}
+	conv, err := d.GetConversation(ctx, "chat")
+	if err != nil || conv.UnreadCount != 99000 || conv.LatestMsg != `{"seq":1200}` {
+		t.Fatalf("cache changed conversation: %+v %v", conv, err)
+	}
+	// Scrolling back is allowed to replace cold cached rows with older content.
+	if err := d.BatchInsertMessageMap(ctx, map[string][]*model_struct.LocalChatLog{"chat": cacheTestRows(1, 40)}); err != nil {
+		t.Fatal(err)
+	}
+	ids = nil
+	for seq := 1; seq <= 40; seq++ {
+		ids = append(ids, fmt.Sprint(seq))
+	}
+	if err := d.MaintainMessageCache(ctx, "chat", ids); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := d.GetMessage(ctx, "chat", "1"); err != nil {
+		t.Fatal("requested historical page was evicted", err)
+	}
+	for _, id := range []string{"pending", "failed", "deleted"} {
+		if _, err := d.GetMessage(ctx, "chat", id); err != nil {
+			t.Fatal(id, err)
+		}
+	}
+}
+
+func TestCacheAccountAndByteBudgets(t *testing.T) {
+	d, ctx := cacheTestDB(t)
+	for group := 0; group < 21; group++ {
+		id := fmt.Sprintf("group_%d", group)
+		if err := d.BatchInsertMessageList(ctx, id, cacheTestRows(1, 1000)); err != nil {
+			t.Fatal(err)
+		}
+		if err := d.MaintainMessageCache(ctx, id, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var count int64
+	d.conn.Model(&messageCacheEntry{}).Count(&count)
+	if count != MessageCacheAccountLimit {
+		t.Fatalf("account cache %d", count)
+	}
+	large := cacheTestRows(1, 70)
+	for _, row := range large {
+		row.Content = strings.Repeat("x", 1<<20)
+	}
+	if err := d.BatchInsertMessageList(ctx, "large", large); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.MaintainMessageCache(ctx, "large", nil); err != nil {
+		t.Fatal(err)
+	}
+	var bytes int64
+	d.conn.Model(&messageCacheEntry{}).Select("coalesce(sum(bytes),0)").Scan(&bytes)
+	if bytes > MessageCacheByteLimit {
+		t.Fatalf("byte budget exceeded: %d", bytes)
+	}
+}
+
+func TestRecallSurvivesUncachedOriginalRestartAndRefetch(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	d, err := NewDataBase(ctx, "recall", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.SaveMessageRevocation(ctx, &sdkws.RevokeMsgTips{ConversationID: "chat", Seq: 7, RevokerUserID: "sender", RevokeTime: 12}); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+	d, err = NewDataBase(ctx, "recall", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close(ctx)
+	if err := d.BatchInsertMessageMap(ctx, map[string][]*model_struct.LocalChatLog{"chat": cacheTestRows(7, 7)}); err != nil {
+		t.Fatal(err)
+	}
+	row, err := d.GetMessageBySeq(ctx, "chat", 7)
+	if err != nil || row.ContentType != constant.RevokeNotification {
+		t.Fatalf("recall resurrected: %+v %v", row, err)
+	}
+}
+
+func TestReadWatermarkSurvivesRestartAndHistoryCacheMiss(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	d, err := NewDataBase(ctx, "self", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.SaveMessageReadWatermarks(ctx, map[string]int64{"chat": 1000}, true, 5); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.SaveMessageReadWatermarks(ctx, map[string]int64{"chat": 500}, true, 3); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.SaveMessageReadWatermarks(ctx, map[string]int64{"chat": 800}, false, 4); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+	d, err = NewDataBase(ctx, "self", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close(ctx)
+	rows := []*model_struct.LocalChatLog{
+		{ClientMsgID: "peer900", SendID: "peer", Seq: 900, Status: constant.MsgStatusSendSuccess},
+		{ClientMsgID: "peer1001", SendID: "peer", Seq: 1001, Status: constant.MsgStatusSendSuccess},
+		{ClientMsgID: "self700", SendID: "self", Seq: 700, Status: constant.MsgStatusSendSuccess},
+		{ClientMsgID: "self900", SendID: "self", Seq: 900, Status: constant.MsgStatusSendSuccess},
+	}
+	if err := d.BatchInsertMessageMap(ctx, map[string][]*model_struct.LocalChatLog{"chat": rows}); err != nil {
+		t.Fatal(err)
+	}
+	for index, want := range []bool{true, false, true, false} {
+		row, err := d.GetMessage(ctx, "chat", rows[index].ClientMsgID)
+		if err != nil || row.IsRead != want {
+			t.Fatalf("read watermark for %s: %+v %v", rows[index].ClientMsgID, row, err)
+		}
+	}
+}
+
+func TestCacheEvictionFailureRollsBackLedgerAndMessages(t *testing.T) {
+	d, ctx := cacheTestDB(t)
+	if err := d.BatchInsertMessageList(ctx, "chat", cacheTestRows(1, 1000)); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.MaintainMessageCache(ctx, "chat", nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.BatchInsertMessageList(ctx, "chat", cacheTestRows(1001, 1001)); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.conn.Exec("CREATE TRIGGER fail_cache_delete BEFORE DELETE ON chat_logs_chat BEGIN SELECT RAISE(ABORT, 'injected cache error'); END").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := d.MaintainMessageCache(ctx, "chat", []string{"1001"}); err == nil {
+		t.Fatal("expected injected failure")
+	}
+	var count int64
+	d.conn.Model(&messageCacheEntry{}).Count(&count)
+	if count != 1000 {
+		t.Fatal("ledger did not roll back", count)
+	}
+	if _, err := d.GetMessage(ctx, "chat", "1"); err != nil {
+		t.Fatal("message lost during failed eviction", err)
+	}
+	d.conn.Exec("DROP TRIGGER fail_cache_delete")
+	if err := d.MaintainMessageCache(ctx, "chat", []string{"1001"}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestLegacyCacheMigrationKeepsRecallAndDeleteMarkers(t *testing.T) {
+	d, ctx := cacheTestDB(t)
+	rows := append(cacheTestRows(1, 1100),
+		&model_struct.LocalChatLog{ClientMsgID: "legacy-recall", Seq: 1, Status: constant.MsgStatusSendSuccess, ContentType: constant.RevokeNotification, Content: `{"detail":"{}"}`},
+		&model_struct.LocalChatLog{ClientMsgID: "legacy-delete", Seq: 2, Status: constant.MsgStatusHasDeleted, Content: "discard deleted body"})
+	if err := d.BatchInsertMessageList(ctx, "legacy", rows); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.initializeMessageCache(ctx, []string{"chat_logs_legacy"}); err != nil {
+		t.Fatal(err)
+	}
+	row, err := d.GetMessage(ctx, "legacy", "legacy-recall")
+	if err != nil || row.ContentType != constant.RevokeNotification {
+		t.Fatal("legacy recall was evicted", err)
+	}
+	row, err = d.GetMessage(ctx, "legacy", "legacy-delete")
+	if err != nil || row.Status != constant.MsgStatusHasDeleted || row.Content != "" {
+		t.Fatalf("invalid delete marker: %+v %v", row, err)
+	}
+	var count int64
+	d.conn.Model(&messageCacheEntry{}).Count(&count)
+	if count != 1000 {
+		t.Fatal("legacy cache budget", count)
+	}
+}
diff --git a/pkg/db/message_read_state.go b/pkg/db/message_read_state.go
new file mode 100644
index 00000000..7111b419
--- /dev/null
+++ b/pkg/db/message_read_state.go
@@ -0,0 +1,75 @@
+//go:build !js
+
+package db
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type messageReadState struct {
+	ConversationID string `gorm:"primaryKey"`
+	Self           bool   `gorm:"primaryKey"`
+	Seq            int64
+	ReadTime       int64
+}
+
+func (messageReadState) TableName() string { return "sdk_message_read_state_v1" }
+
+func (d *DataBase) SaveMessageReadWatermarks(ctx context.Context, seqs map[string]int64, self bool, readTime int64) error {
+	rows := make([]messageReadState, 0, len(seqs))
+	for id, seq := range seqs {
+		if seq > 0 {
+			rows = append(rows, messageReadState{ConversationID: id, Self: self, Seq: seq, ReadTime: readTime})
+		}
+	}
+	if len(rows) == 0 {
+		return nil
+	}
+	d.mRWMutex.Lock()
+	defer d.mRWMutex.Unlock()
+	return d.conn.WithContext(ctx).Clauses(clause.OnConflict{
+		Columns:   []clause.Column{{Name: "conversation_id"}, {Name: "self"}},
+		DoUpdates: clause.AssignmentColumns([]string{"seq", "read_time"}),
+		Where:     clause.Where{Exprs: []clause.Expression{clause.Expr{SQL: "excluded.seq > sdk_message_read_state_v1.seq"}}},
+	}).CreateInBatches(rows, 100).Error
+}
+
+func (d *DataBase) ApplyMessageReadWatermarks(ctx context.Context, id string, rows []*model_struct.LocalChatLog) error {
+	d.mRWMutex.RLock()
+	defer d.mRWMutex.RUnlock()
+	return applyMessageReadWatermarks(d.conn.WithContext(ctx), id, d.loginUserID, rows)
+}
+
+func applyMessageReadWatermarks(tx *gorm.DB, id, loginID string, rows []*model_struct.LocalChatLog) error {
+	if len(rows) == 0 {
+		return nil
+	}
+	var states []messageReadState
+	if err := tx.Where("conversation_id = ?", id).Find(&states).Error; err != nil {
+		return err
+	}
+	for _, state := range states {
+		for _, row := range rows {
+			if row.Seq <= 0 || row.Seq > state.Seq || (row.SendID == loginID) == state.Self {
+				continue
+			}
+			row.IsRead = true
+			if state.ReadTime > 0 {
+				var attached sdk_struct.AttachedInfoElem
+				_ = json.Unmarshal([]byte(row.AttachedInfo), &attached)
+				attached.HasReadTime = max(attached.HasReadTime, state.ReadTime)
+				payload, err := json.Marshal(attached)
+				if err != nil {
+					return err
+				}
+				row.AttachedInfo = string(payload)
+			}
+		}
+	}
+	return nil
+}
