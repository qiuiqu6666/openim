+		"chat": {Msgs: []*sdkws.MsgData{{ClientMsgID: "m6", SendID: "other", RecvID: "self", Seq: 6, SendTime: 6, SessionType: constant.SingleChatType, ContentType: constant.Text, Content: []byte(`{"content":"hello"}`)}}},
