@@ -0,0 +1,344 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/ccontext"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+	"google.golang.org/protobuf/proto"
+)
+
+func recoveryContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(ccontext.WithInfo(context.Background(), &ccontext.GlobalConfig{UserID: "self"}), 5*time.Second)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+func recoveryMsgs(id string, seqs ...int64) map[string]*sdkws.PullMsgs {
+	p := &sdkws.PullMsgs{}
+	for _, seq := range seqs {
+		p.Msgs = append(p.Msgs, &sdkws.MsgData{Seq: seq})
+	}
+	return map[string]*sdkws.PullMsgs{id: p}
+}
+
+func receiptWorker(t *testing.T, ch <-chan common.Cmd2Value, handle func(common.Cmd2Value) error) {
+	t.Helper()
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case cmd := <-ch:
+				err := handle(cmd)
+				if cmd.Receipt != nil {
+					cmd.Receipt <- err
+				}
+			case <-stop:
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { close(stop); <-done })
+}
+
+func requestWorker(t *testing.T, c *LongConnMgr, handle func(Message) *GeneralWsResp) {
+	t.Helper()
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case req := <-c.send:
+				req.Resp <- handle(req)
+			case <-stop:
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { close(stop); <-done })
+}
+
+func wireResponse(p proto.Message) *GeneralWsResp {
+	data, err := proto.Marshal(p)
+	if err != nil {
+		panic(err)
+	}
+	return &GeneralWsResp{Data: data}
+}
+
+func TestPullCommitWaitsForStorageAndRetriesFailure(t *testing.T) {
+	ctx := recoveryContext(t)
+	m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5}}
+	resp := &sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 6)}
+	ranges := map[string][2]int64{"chat": {6, 6}}
+	done := make(chan error, 1)
+	go func() { done <- m.commitPulledMessages(ctx, resp, ranges, 0) }()
+	cmd := <-m.conversationCh
+	if m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("advanced before storage acknowledgement")
+	}
+	want := errors.New("disk full")
+	cmd.Receipt <- want
+	if err := <-done; !errors.Is(err, want) {
+		t.Fatalf("lost storage error: %v", err)
+	}
+	if m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("advanced after failed storage")
+	}
+	go func() { done <- m.commitPulledMessages(ctx, resp, ranges, 0) }()
+	cmd = <-m.conversationCh
+	cmd.Receipt <- nil
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if m.syncedMaxSeqs["chat"] != 6 {
+		t.Fatal("retry did not commit")
+	}
+}
+
+func TestNotificationFailureDoesNotCommitItsSequence(t *testing.T) {
+	m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5, "n_chat": 2}}
+	want := errors.New("notification write failed")
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if cmd.Cmd == constant.CmdNotification {
+			return want
+		}
+		return nil
+	})
+	err := m.commitPulledMessages(recoveryContext(t), &sdkws.PullMessageBySeqsResp{
+		Msgs: recoveryMsgs("chat", 6), NotificationMsgs: recoveryMsgs("n_chat", 3),
+	}, map[string][2]int64{"chat": {6, 6}, "n_chat": {3, 3}}, 0)
+	if !errors.Is(err, want) || m.syncedMaxSeqs["chat"] != 6 || m.syncedMaxSeqs["n_chat"] != 2 {
+		t.Fatalf("err=%v positions=%v", err, m.syncedMaxSeqs)
+	}
+}
+
+func TestWakeupPullFailureThenReconnectRecovers(t *testing.T) {
+	ctx := recoveryContext(t)
+	c := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, loginUserID: "self", longConnMgr: c, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5}}
+	flags := make(chan int, 8)
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if cmd.Cmd == constant.CmdSyncFlag {
+			flags <- cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).SyncFlag
+		}
+		return nil
+	})
+	pulls := 0
+	requestWorker(t, c, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.GetNewestSeq {
+			return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"chat": 6}})
+		}
+		pulls++
+		if pulls == 1 {
+			return &GeneralWsResp{ErrCode: 10001, ErrMsg: "offline"}
+		}
+		return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 6)})
+	})
+	m.startSync()
+	m.doWakeupDataSync(ctx)
+	if m.isSyncing || m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("failure left syncing stuck or advanced sequence")
+	}
+	if got := []int{<-flags, <-flags}; !reflect.DeepEqual(got, []int{constant.MsgSyncBegin, constant.MsgSyncFailed}) {
+		t.Fatalf("failure flags: %v", got)
+	}
+	if !m.startSync() {
+		t.Fatal("reconnect could not retry")
+	}
+	m.doConnected(ctx)
+	if m.isSyncing || m.syncedMaxSeqs["chat"] != 6 {
+		t.Fatal("reconnect failed to recover")
+	}
+	if got := []int{<-flags, <-flags}; !reflect.DeepEqual(got, []int{constant.MsgSyncBegin, constant.MsgSyncEnd}) {
+		t.Fatalf("success flags: %v", got)
+	}
+}
+
+type recoveryVersionDB struct {
+	db_interface.DataBase
+	installed       bool
+	writeErr        error
+	notificationErr error
+	versionWrites   int
+	journal         map[string]*model_struct.LocalVersionSync
+}
+
+func (d *recoveryVersionDB) GetAllConversationListDB(context.Context) ([]*model_struct.LocalConversation, error) {
+	return nil, nil
+}
+
+func (d *recoveryVersionDB) GetAllConversationIDList(context.Context) ([]string, error) {
+	return []string{"chat"}, nil
+}
+func (d *recoveryVersionDB) GetAppSDKVersion(context.Context) (*model_struct.LocalAppSDKVersion, error) {
+	return &model_struct.LocalAppSDKVersion{Installed: d.installed}, nil
+}
+func (d *recoveryVersionDB) SetAppSDKVersion(_ context.Context, v *model_struct.LocalAppSDKVersion) error {
+	d.versionWrites++
+	if d.writeErr != nil {
+		return d.writeErr
+	}
+	d.installed = v.Installed
+	return nil
+}
+func (d *recoveryVersionDB) CheckConversationNormalMsgSeq(context.Context, string) (int64, error) {
+	return 0, nil
+}
+func (d *recoveryVersionDB) GetVersionSync(_ context.Context, table, id string) (*model_struct.LocalVersionSync, error) {
+	if row := d.journal[table+id]; row != nil {
+		return row, nil
+	}
+	return nil, errs.ErrRecordNotFound
+}
+func (d *recoveryVersionDB) SetVersionSync(_ context.Context, row *model_struct.LocalVersionSync) error {
+	if d.journal == nil {
+		d.journal = make(map[string]*model_struct.LocalVersionSync)
+	}
+	copy := *row
+	copy.UIDList = append([]string(nil), row.UIDList...)
+	d.journal[row.Table+row.EntityID] = &copy
+	return nil
+}
+func (d *recoveryVersionDB) GetConversation(context.Context, string) (*model_struct.LocalConversation, error) {
+	return &model_struct.LocalConversation{}, nil
+}
+func (d *recoveryVersionDB) GetNotificationAllSeqs(context.Context) ([]*model_struct.NotificationSeqs, error) {
+	return nil, nil
+}
+func (d *recoveryVersionDB) BatchInsertNotificationSeq(context.Context, []*model_struct.NotificationSeqs) error {
+	return d.notificationErr
+}
+
+func TestIncompleteInstallSurvivesRestartAndCommitFailure(t *testing.T) {
+	ctx := recoveryContext(t)
+	d := &recoveryVersionDB{writeErr: errors.New("disk full")}
+	m, err := NewMsgSyncer(ctx, make(chan common.Cmd2Value), nil, "self", nil, d, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !m.reinstalled {
+		t.Fatal("partial install with existing conversations was marked complete")
+	}
+	if err := m.compareSeqsAndBatchSync(ctx, nil, 1); err == nil || !m.reinstalled || d.installed {
+		t.Fatal("failed Installed write was treated as success")
+	}
+	d.writeErr = nil
+	if err := m.compareSeqsAndBatchSync(ctx, nil, 1); err != nil || m.reinstalled || !d.installed {
+		t.Fatalf("install retry failed: %v", err)
+	}
+}
+
+func TestInstallNotificationStorageFailureStopsCompletion(t *testing.T) {
+	d := &recoveryVersionDB{notificationErr: errors.New("disk full")}
+	m := &MsgSyncer{db: d, reinstalled: true, syncedMaxSeqs: map[string]int64{}}
+	if err := m.compareSeqsAndBatchSync(recoveryContext(t), map[string]int64{"n_self": 20}, 1); err == nil {
+		t.Fatal("ignored notification storage error")
+	}
+	if d.versionWrites != 0 || !m.reinstalled || m.syncedMaxSeqs["n_self"] != 0 {
+		t.Fatal("committed incomplete initial sync")
+	}
+}
+
+func TestPushStorageFailureKeepsGapRecoverable(t *testing.T) {
+	m := &MsgSyncer{conversationCh: make(chan common.Cmd2Value, 2), syncedMaxSeqs: map[string]int64{"chat": 5}}
+	m.pushTriggerAndSync(recoveryContext(t), recoveryMsgs("chat", 6), func(context.Context, map[string]*sdkws.PullMsgs) error { return errors.New("disk full") })
+	if m.syncedMaxSeqs["chat"] != 5 {
+		t.Fatal("failed push skipped its sequence")
+	}
+	cmd := <-m.conversationCh
+	if cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).SyncFlag != constant.MsgSyncFailed {
+		t.Fatal("missing recovery failure event")
+	}
+}
+
+func TestDuplicateOrOutOfOrderPushPullsOnlyUncoveredGap(t *testing.T) {
+	for _, seqs := range [][]int64{{7, 7}, {7, 6}} {
+		t.Run(fmt.Sprint(seqs), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			c := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{longConnMgr: c, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5}}
+			pulled := make(chan [2]int64, 1)
+			requestWorker(t, c, func(req Message) *GeneralWsResp {
+				p := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+					panic(err)
+				}
+				pulled <- [2]int64{p.SeqRanges[0].Begin, p.SeqRanges[0].End}
+				return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", 6)})
+			})
+			receiptWorker(t, m.conversationCh, func(common.Cmd2Value) error { return nil })
+			fastPath := false
+			m.pushTriggerAndSync(ctx, recoveryMsgs("chat", seqs...), func(context.Context, map[string]*sdkws.PullMsgs) error { fastPath = true; return nil })
+			if !fastPath {
+				t.Fatal("latest push waited for gap recovery")
+			}
+			select {
+			case got := <-pulled:
+				if got != [2]int64{6, 6} || seqs[1] == 6 {
+					t.Fatalf("wrong gap: %v", got)
+				}
+			default:
+				if seqs[1] != 6 {
+					t.Fatal("no gap pull")
+				}
+			}
+			if m.syncedMaxSeqs["chat"] != 7 {
+				t.Fatal("gap recovery did not commit")
+			}
+		})
+	}
+}
+
+func TestCancelledRequestDoesNotEnterTransportQueue(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	cancel()
+	c := &LongConnMgr{send: make(chan Message, 100)}
+	for i := 0; i < 100; i++ {
+		if err := c.SendReqWaitResp(ctx, &sdkws.GetMaxSeqReq{}, constant.GetNewestSeq, &sdkws.GetMaxSeqResp{}); err == nil {
+			t.Fatal("cancelled request succeeded")
+		}
+	}
+	if len(c.send) != 0 {
+		t.Fatalf("queued %d cancelled requests", len(c.send))
+	}
+}
+
+func TestFullTransportQueueHonorsDeadline(t *testing.T) {
+	ctx, cancel := context.WithTimeout(recoveryContext(t), 20*time.Millisecond)
+	defer cancel()
+	c := &LongConnMgr{send: make(chan Message, 1)}
+	c.send <- Message{}
+	if err := c.SendReqWaitResp(ctx, &sdkws.GetMaxSeqReq{}, constant.GetNewestSeq, &sdkws.GetMaxSeqResp{}); err == nil {
+		t.Fatal("blocked queue succeeded")
+	}
+	if len(c.send) != 1 {
+		t.Fatal("expired request entered full queue")
+	}
+}
+
+func TestExpiredRequestIsNotWritten(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	cancel()
+	c := &LongConnMgr{Syncer: NewWsRespAsyn()}
+	// No connection is configured: accessing it would panic if cancellation is ignored.
+	if _, err := c.sendAndWaitResp(ctx, &GeneralWsReq{ReqIdentifier: constant.PullMsgByRange}); err == nil {
+		t.Fatal("expired request was sent")
+	}
+	if len(c.Syncer.wsNotification) != 0 {
+		t.Fatal("expired request leaked response registration")
+	}
+}
diff --git a/internal/interaction/msg_sync_retry.go b/internal/interaction/msg_sync_retry.go
new file mode 100644
index 00000000..2caf32ec
--- /dev/null
+++ b/internal/interaction/msg_sync_retry.go
@@ -0,0 +1,41 @@
+package interaction
+
+import (
+	"context"
+	"time"
+)
+
+const messageSyncRetryMin = time.Second
+const messageSyncRetryMax = 30 * time.Second
+
+// Owned by the scheduler. Incoming pushes never wait on this clock and never
+// reset it; only a completed recovery attempt can demonstrate progress.
+type messageSyncRetry struct {
+	delay time.Duration
+	next  time.Time
+}
+
+func (r *messageSyncRetry) failed(now time.Time, progressed bool) {
+	if progressed {
+		r.delay = 0
+	}
+	if r.delay == 0 {
+		r.delay = messageSyncRetryMin
+	} else {
+		r.delay = min(messageSyncRetryMax, r.delay*2)
+	}
+	r.next = now.Add(r.delay)
+}
+
+func (r *messageSyncRetry) remaining(now time.Time) time.Duration {
+	return max(time.Duration(0), r.next.Sub(now))
+}
+
+func recordMessageSyncFailure(ctx context.Context, err error) {
+	if err == nil || ctx.Err() != nil {
+		return // Scheduler preemption and logout are not failed recovery attempts.
+	}
+	if owner, ok := ctx.Value(messagePageContextKey{}).(*messagePageCoordinator); ok {
+		owner.failed.Store(true)
+	}
+}
diff --git a/internal/interaction/msg_sync_retry_test.go b/internal/interaction/msg_sync_retry_test.go
new file mode 100644
index 00000000..307b3c22
--- /dev/null
+++ b/internal/interaction/msg_sync_retry_test.go
@@ -0,0 +1,158 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+func TestNoProgressRetryBackoffCapsAndResetsOnProgress(t *testing.T) {
+	var r messageSyncRetry
+	now := time.Unix(100, 0)
+	for _, seconds := range []int{1, 2, 4, 8, 16, 30, 30, 30} {
+		r.failed(now, false)
+		if got := r.remaining(now); got != time.Duration(seconds)*time.Second {
+			t.Fatalf("delay=%v want=%ds", got, seconds)
+		}
+		now = r.next
+	}
+	r.failed(now, true)
+	if r.remaining(now) != time.Second {
+		t.Fatal("committed progress did not reset backoff")
+	}
+}
+
+func TestNoProgressRetryCoalescesSignalsAndDeliversLivePush(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 100)
+	attempts := make(chan struct{}, 10)
+	live := make(chan struct{}, 100)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				live <- struct{}{}
+				return
+			}
+			recordMessageSyncFailure(cmd.Ctx, errors.New("unchanged missing range"))
+			attempts <- struct{}{}
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	select {
+	case <-attempts:
+	case <-time.After(time.Second):
+		t.Fatal("initial sync not started")
+	}
+	for n := 0; n < 30; n++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	}
+	for n := 0; n < 30; n++ {
+		select {
+		case <-live:
+		case <-time.After(250 * time.Millisecond):
+			t.Fatal("retry backoff blocked live delivery")
+		}
+	}
+	select {
+	case <-attempts:
+		t.Fatal("incoming signals bypassed backoff")
+	case <-time.After(150 * time.Millisecond):
+	}
+	select {
+	case <-attempts:
+	case <-time.After(2 * time.Second):
+		t.Fatal("retry was lost without another message")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(250 * time.Millisecond):
+		t.Fatal("logout waited for retry timer")
+	}
+}
+
+func TestCancelledAttemptDoesNotBecomeFailedRecovery(t *testing.T) {
+	owner := &messagePageCoordinator{}
+	ctx, cancel := context.WithCancel(context.WithValue(context.Background(), messagePageContextKey{}, owner))
+	cancel()
+	recordMessageSyncFailure(ctx, context.Canceled)
+	if owner.failed.Load() {
+		t.Fatal("preemption increased backoff")
+	}
+}
+
+func TestLivePreemptionCannotBypassRecordedFailure(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 4)
+	started, live, done := make(chan struct{}, 4), make(chan struct{}, 1), make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				live <- struct{}{}
+				return
+			}
+			recordMessageSyncFailure(cmd.Ctx, errors.New("range already failed"))
+			started <- struct{}{}
+			<-cmd.Ctx.Done()
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-started
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	select {
+	case <-live:
+	case <-time.After(time.Second):
+		t.Fatal("live push blocked")
+	}
+	select {
+	case <-started:
+		t.Fatal("preemption bypassed no-progress cooldown")
+	case <-time.After(150 * time.Millisecond):
+	}
+	cancel()
+	<-done
+}
+
+func TestRetryCooldownDrainsMoreThanOneBurstOfQueuedLiveMessages(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	input := make(chan common.Cmd2Value, 100)
+	started, live, done := make(chan struct{}), make(chan struct{}, 70), make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				live <- struct{}{}
+				return
+			}
+			owner := cmd.Ctx.Value(messagePageContextKey{}).(*messagePageCoordinator)
+			owner.bounded.Store(true)
+			recordMessageSyncFailure(cmd.Ctx, errors.New("failed bounded page"))
+			close(started)
+			<-cmd.Ctx.Done()
+		})
+	}()
+	defer func() { cancel(); <-done }()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-started
+	for n := 0; n < 70; n++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	}
+	deadline := time.After(500 * time.Millisecond)
+	for n := 0; n < 70; n++ {
+		select {
+		case <-live:
+		case <-deadline:
+			t.Fatalf("only %d queued live messages delivered during cooldown", n)
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_scheduler.go b/internal/interaction/msg_sync_scheduler.go
new file mode 100644
index 00000000..a4cb62a7
--- /dev/null
+++ b/internal/interaction/msg_sync_scheduler.go
@@ -0,0 +1,293 @@
+package interaction
+
+import (
+	"context"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+func isBackgroundSyncCommand(cmd common.Cmd2Value) bool {
+	return cmd.Cmd == constant.CmdConnSuccesss ||
+		cmd.Cmd == constant.CmdWakeUpDataSync || cmd.Cmd == constant.CmdIMMessageSync ||
+		cmd.Cmd == cmdReconcileMessageSeq || cmd.Cmd == cmdSyncAuxiliaryMetadata
+}
+
+func coalesceMessageSync(pending *common.Cmd2Value, incoming common.Cmd2Value) *common.Cmd2Value {
+	// Reconnect/foreground jobs also initialize metadata and publish the
+	// normal sync lifecycle. Lightweight checks must not replace that work.
+	if pending != nil && messageSyncPriority(incoming.Cmd) < messageSyncPriority(pending.Cmd) {
+		return pending
+	}
+	return &incoming
+}
+
+func messageSyncPriority(cmd string) int {
+	switch cmd {
+	case constant.CmdConnSuccesss:
+		return 4
+	case constant.CmdWakeUpDataSync:
+		return 3
+	case constant.CmdIMMessageSync:
+		return 2
+	case cmdSyncAuxiliaryMetadata:
+		return 0
+	default:
+		return 1
+	}
+}
+
+// Yield slow sync I/O to live pushes, without concurrent sequence mutation or
+// storage commits. A cancelled sync never advances uncommitted ranges; one
+// coalesced sync command resumes after queued live messages have been handled.
+func runMessageSyncLoop(ctx context.Context, input <-chan common.Cmd2Value, handle func(common.Cmd2Value), protectInitialSync ...func() bool) {
+	var pending *common.Cmd2Value
+	var pendingAuxiliary *common.Cmd2Value
+	var auxiliaryRetry messageSyncRetry
+	// Keep metadata obligations and their cooldown separate from message recovery.
+	enqueue := func(cmd common.Cmd2Value) {
+		if cmd.Cmd == cmdSyncAuxiliaryMetadata {
+			pendingAuxiliary = coalesceMessageSync(pendingAuxiliary, cmd)
+			return
+		}
+		if pending != nil && pending.Cmd == cmdSyncAuxiliaryMetadata {
+			pendingAuxiliary = coalesceMessageSync(pendingAuxiliary, *pending)
+			pending = nil
+		}
+		pending = coalesceMessageSync(pending, cmd)
+	}
+
+	var active *common.Cmd2Value
+	var done chan struct{}
+	var cancel context.CancelFunc
+	var activeCtx context.Context
+	var queued []common.Cmd2Value
+	protected := false
+	const liveBurst = 32
+	liveHandled := 0
+	var pageOwner *messagePageCoordinator
+	var pageTurns <-chan chan struct{}
+	var preemption *time.Timer
+	var preempt <-chan time.Time
+	reserveProgress := false
+	var retry messageSyncRetry
+	retryRemaining := func() time.Duration {
+		if pending != nil && pending.Cmd == cmdSyncAuxiliaryMetadata {
+			return auxiliaryRetry.remaining(time.Now())
+		}
+		return retry.remaining(time.Now())
+	}
+
+	var retryTimer *time.Timer
+	var retryWake <-chan time.Time
+	clearRetryTimer := func() {
+		if retryTimer != nil {
+			retryTimer.Stop()
+		}
+		retryTimer, retryWake = nil, nil
+	}
+	defer clearRetryTimer()
+	clearPreemption := func() {
+		if preemption != nil {
+			preemption.Stop()
+		}
+		preemption, preempt = nil, nil
+	}
+	stop := func(interrupted ...bool) {
+		clearPreemption()
+		if cancel != nil {
+			cancel()
+			<-done // The sole state owner must exit before another command runs.
+			// A live push can win the select just as a failed worker exits.
+			// Preserve its failure here too, so traffic cannot bypass the cooldown.
+			if pageOwner.failed.Load() || (active.Cmd == cmdSyncAuxiliaryMetadata && len(interrupted) > 0 && interrupted[0]) {
+				if active.Cmd == cmdSyncAuxiliaryMetadata {
+					auxiliaryRetry.failed(time.Now(), pageOwner.committed.Load() > 0)
+				} else {
+					retry.failed(time.Now(), pageOwner.committed.Load() > 0)
+				}
+				enqueue(*active)
+			}
+			cancel, done, active = nil, nil, nil
+			pageOwner, pageTurns = nil, nil
+		}
+	}
+	defer stop()
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		if active == nil && pending == nil && pendingAuxiliary != nil {
+			pending, pendingAuxiliary = pendingAuxiliary, nil
+		}
+		if active == nil && len(queued) > 0 && (pending == nil || liveHandled < liveBurst || retryRemaining() > 0) {
+			cmd := queued[0]
+			queued[0] = common.Cmd2Value{}
+			queued = queued[1:]
+			handle(cmd)
+			liveHandled++
+			continue
+		}
+		// Drain already queued work before restarting an interrupted sync.
+		if active == nil && pending != nil && retryRemaining() == 0 {
+			clearRetryTimer()
+			protected = len(protectInitialSync) > 0 && protectInitialSync[0]()
+			if !protected && liveHandled < liveBurst {
+				select {
+				case cmd, ok := <-input:
+					if !ok {
+						return
+					}
+					if isBackgroundSyncCommand(cmd) {
+						enqueue(cmd)
+					} else {
+						handle(cmd)
+						liveHandled++
+					}
+					continue
+				default:
+				}
+			}
+			original := *pending
+			pending = nil
+			if original.Ctx == nil {
+				original.Ctx = ctx
+			}
+			if original.Ctx.Err() != nil {
+				continue
+			}
+			active = &original
+			// Read bootstrap state only while no job owns it. Once started,
+			// first-login initialization cannot be starved by incoming traffic.
+			attempt := original
+			attemptCtx, attemptCancel := context.WithCancel(original.Ctx)
+			pageOwner = &messagePageCoordinator{turns: make(chan chan struct{})}
+			pageTurns = pageOwner.turns
+			attempt.Ctx, cancel = context.WithValue(attemptCtx, messagePageContextKey{}, pageOwner), attemptCancel
+			if original.Cmd == cmdSyncAuxiliaryMetadata {
+				attempt.Ctx = common.WithMetadataTurn(attempt.Ctx)
+			}
+			activeCtx = attempt.Ctx
+			liveHandled = 0
+			done = make(chan struct{})
+			go func(finished chan struct{}) {
+				defer close(finished)
+				defer attemptCancel()
+				handle(attempt)
+			}(done)
+		}
+		if active == nil && pending != nil && retryTimer == nil {
+			retryTimer = time.NewTimer(retryRemaining())
+			retryWake = retryTimer.C
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-retryWake:
+			clearRetryTimer()
+		case <-done:
+			if !pageOwner.failed.Load() {
+				if active.Cmd == cmdSyncAuxiliaryMetadata {
+					auxiliaryRetry = messageSyncRetry{}
+				} else {
+					retry = messageSyncRetry{}
+				}
+			}
+			reserveProgress = false
+			stop()
+		case <-preempt:
+			if delay := common.MetadataPreemptionDelay(activeCtx); delay > 0 {
+				preemption.Reset(delay)
+				continue
+			}
+			// A stalled first attempt may yield once. Its retry owns a bounded
+			// page until completion, so busy chats cannot cancel it forever.
+			if active != nil {
+				resume := *active
+				enqueue(resume)
+				reserveProgress = active.Cmd != cmdSyncAuxiliaryMetadata
+				stop(true)
+			}
+		case resume := <-pageTurns:
+			clearPreemption()
+			if pageOwner.committed.Load() > 0 {
+				reserveProgress = false
+			}
+			// The worker is paused and no message transaction is in flight.
+			// Bound the ingress turn so continuous traffic cannot starve pages.
+			for n := 0; n < liveBurst; n++ {
+				var cmd common.Cmd2Value
+				if len(queued) > 0 {
+					cmd, queued = queued[0], queued[1:]
+				} else {
+					select {
+					case incoming, ok := <-input:
+						if !ok {
+							close(resume)
+							return
+						}
+						cmd = incoming
+					default:
+						n = liveBurst
+						continue
+					}
+				}
+				if isBackgroundSyncCommand(cmd) {
+					enqueue(cmd)
+				} else {
+					handle(cmd)
+				}
+			}
+			close(resume)
+		case cmd, ok := <-input:
+			if !ok {
+				return
+			}
+			if isBackgroundSyncCommand(cmd) {
+				if pending != nil && pending.Cmd == cmdSyncAuxiliaryMetadata && cmd.Cmd != cmdSyncAuxiliaryMetadata {
+					clearRetryTimer()
+				}
+				if cmd.Cmd == constant.CmdConnSuccesss {
+					// A fresh transport may recover a network failure immediately.
+					retry = messageSyncRetry{}
+					clearRetryTimer()
+				}
+				// Repeated foreground/reconnect signals describe the same desired
+				// catch-up. Do not accumulate full sync jobs behind live traffic.
+				if active == nil || cmd.Cmd == constant.CmdConnSuccesss || cmd.Cmd == cmdSyncAuxiliaryMetadata ||
+					(active.Cmd == cmdReconcileMessageSeq && messageSyncPriority(cmd.Cmd) > 1) || active.Cmd == cmdSyncAuxiliaryMetadata {
+					enqueue(cmd)
+				}
+				if active != nil && active.Cmd == cmdSyncAuxiliaryMetadata && cmd.Cmd != cmdSyncAuxiliaryMetadata {
+					enqueue(*active)
+					reserveProgress = false
+					stop(true)
+				}
+				if active != nil && active.Cmd == cmdReconcileMessageSeq && messageSyncPriority(cmd.Cmd) > 1 {
+					stop()
+				}
+				continue
+			}
+			if active != nil {
+				if protected || reserveProgress || (pageOwner != nil && pageOwner.bounded.Load()) {
+					queued = append(queued, cmd)
+					if !protected && !reserveProgress && preemption == nil {
+						preemption = time.NewTimer(100 * time.Millisecond)
+						preempt = preemption.C
+					}
+					continue
+				}
+				// Let a short in-flight operation finish before cancelling it.
+				// Slow work still yields within the existing 100 ms budget.
+				queued = append(queued, cmd)
+				if preemption == nil {
+					preemption = time.NewTimer(100 * time.Millisecond)
+					preempt = preemption.C
+				}
+				continue
+			}
+			handle(cmd)
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_scheduler_test.go b/internal/interaction/msg_sync_scheduler_test.go
new file mode 100644
index 00000000..01048d31
--- /dev/null
+++ b/internal/interaction/msg_sync_scheduler_test.go
@@ -0,0 +1,188 @@
+package interaction
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func TestLivePushPreemptsSyncWithoutConcurrentStateOwners(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 8)
+	started, live, resumed, done := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var owners, attempts atomic.Int32
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if owners.Add(1) != 1 {
+				t.Error("concurrent sequence owners")
+			}
+			defer owners.Add(-1)
+			if cmd.Cmd == constant.CmdPushMsg {
+				close(live)
+				return
+			}
+			if attempts.Add(1) == 1 {
+				close(started)
+			} else {
+				close(resumed)
+			}
+			<-cmd.Ctx.Done()
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	<-started
+	for i := 0; i < 5; i++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	}
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	select {
+	case <-live:
+	case <-time.After(time.Second):
+		t.Fatal("sync blocked live push")
+	}
+	select {
+	case <-resumed:
+	case <-time.After(time.Second):
+		t.Fatal("interrupted sync was lost")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("logout did not stop sync")
+	}
+	if attempts.Load() != 2 {
+		t.Fatalf("duplicate sync signals queued %d jobs", attempts.Load())
+	}
+}
+
+func TestLivePushArrivesWhileNativeSyncNetworkIsStalled(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	c := &LongConnMgr{send: make(chan Message, 4)}
+	m := &MsgSyncer{ctx: ctx, loginUserID: "self", longConnMgr: c,
+		recvCh: make(chan common.Cmd2Value, 4), conversationCh: make(chan common.Cmd2Value, 4),
+		syncedMaxSeqs: map[string]int64{"chat": 5}}
+	delivered := make(chan int64, 4)
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if cmd.Cmd == constant.CmdNewMsgCome {
+			for _, msg := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs["chat"].Msgs {
+				delivered <- msg.Seq
+			}
+		}
+		return nil
+	})
+	done := make(chan struct{})
+	go func() { defer close(done); m.DoListener(ctx) }()
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	// Leave the sequence request unanswered. A live push must not wait for its
+	// network timeout, and the catch-up request must resume after delivery.
+	select {
+	case <-c.send:
+	case <-ctx.Done():
+		t.Fatal("sync never started")
+	}
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg,
+		Value: &sdkws.PushMessages{Msgs: recoveryMsgs("chat", 6)}}
+	select {
+	case seq := <-delivered:
+		if seq != 6 {
+			t.Fatalf("unexpected sequence %d", seq)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("live message waited behind sync network request")
+	}
+	select {
+	case <-c.send:
+	case <-time.After(time.Second):
+		t.Fatal("sync was not resumed")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("listener failed to exit")
+	}
+	if m.syncedMaxSeqs["chat"] != 6 {
+		t.Fatal("live storage acknowledgement not committed")
+	}
+}
+
+func TestReconnectDuringSyncIsRetained(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value)
+	started, release, reconnected, done := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdWakeUpDataSync {
+				close(started)
+				select {
+				case <-release:
+				case <-cmd.Ctx.Done():
+				}
+			} else {
+				close(reconnected)
+			}
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	<-started
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdConnSuccesss}
+	close(release)
+	select {
+	case <-reconnected:
+	case <-time.After(time.Second):
+		t.Fatal("new connection event was discarded")
+	}
+	cancel()
+	<-done
+}
+
+func TestShortSyncCompletesWithoutLivePushCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	input := make(chan common.Cmd2Value, 4)
+	started, release, live, done := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var attempts atomic.Int32
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == constant.CmdPushMsg {
+				close(live)
+				return
+			}
+			attempts.Add(1)
+			close(started)
+			select {
+			case <-release:
+			case <-cmd.Ctx.Done():
+				t.Error("short sync was cancelled")
+			}
+		})
+	}()
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdWakeUpDataSync}
+	<-started
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	time.Sleep(10 * time.Millisecond)
+	close(release)
+	select {
+	case <-live:
+	case <-time.After(time.Second):
+		t.Fatal("live push blocked")
+	}
+	cancel()
+	<-done
+	if attempts.Load() != 1 {
+		t.Fatal(attempts.Load())
+	}
+}
