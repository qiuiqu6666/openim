+func TestContiguousSQLiteLegacyGapAndInterruptedCheckpoint(t *testing.T) {
+	ctx := recoveryContext(t)
+	dir := t.TempDir()
+	d, err := db.NewDataBase(ctx, "self", dir, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = d.Close(ctx) })
