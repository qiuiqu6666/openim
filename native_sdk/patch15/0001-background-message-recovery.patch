@@ -0,0 +1,59 @@
+package interaction
+
+import (
+	"fmt"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+func TestRecoveryTransportBatchesEightFullPagesWithoutLosingCoverage(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+	var ids []string
+	pending := map[string][][2]int64{}
+	for i := 0; i < 8; i++ {
+		id := fmt.Sprintf("chat%d", i)
+		ids = append(ids, id)
+		pending[id] = [][2]int64{{1, 100}}
+	}
+	stored := map[string]int{}
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		for id, packet := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+			stored[id] += len(packet.Msgs)
+		}
+		return nil
+	})
+	requests := 0
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		requests++
+		p := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+			panic(err)
+		}
+		if len(p.SeqRanges) != 8 {
+			t.Errorf("expected eight independent pages, got %d", len(p.SeqRanges))
+		}
+		for _, r := range p.SeqRanges {
+			if r.Num != 100 || r.Begin != 1 || r.End != 100 {
+				t.Errorf("changed conversation page: %v", r)
+			}
+		}
+		return requestedRecoveryResponse(t, req)
+	})
+	failures := m.pullMissingRecoveryBatch(ctx, m.nextRecoveryBatch(ids, pending), 0)
+	if len(failures) != 0 {
+		t.Fatal(failures)
+	}
+	if requests != 1 {
+		t.Fatalf("requests=%d", requests)
+	}
+	for _, id := range ids {
+		if stored[id] != 100 || m.syncedMaxSeqs[id] != 100 {
+			t.Fatalf("lost coverage %s: rows=%d seq=%d", id, stored[id], m.syncedMaxSeqs[id])
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_visibility_batch.go b/internal/interaction/msg_sync_visibility_batch.go
new file mode 100644
index 00000000..1429679c
--- /dev/null
+++ b/internal/interaction/msg_sync_visibility_batch.go
@@ -0,0 +1,162 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"sort"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+)
+
+// Only explicit authenticated directional boundaries can shrink a range. Batch
+// the same protocol across chats; a missing packet is an error for that chat.
+func (m *MsgSyncer) visibleMessageRanges(ctx context.Context, ranges map[string][2]int64) (map[string][2]int64, map[string]error, []string) {
+	visible, conflicts := make(map[string][2]int64), make(map[string][2]int64)
+	failed := make(map[string]error)
+	ids := make([]string, 0, len(ranges))
+	for id := range ranges {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	var cached map[string]*model_struct.LocalConversation
+	if reader, ok := m.db.(db_interface.MessageRecoveryBoundsReader); ok {
+		rows, err := reader.GetMessageRecoveryBounds(ctx)
+		if err != nil {
+			for _, id := range ids {
+				failed[id] = err
+			}
+			return visible, failed, ids
+		}
+		cached = make(map[string]*model_struct.LocalConversation, len(rows))
+		for _, row := range rows {
+			if row != nil {
+				cached[row.ConversationID] = row
+			}
+		}
+		// Recent/pinned chats reach the first batch before dormant history.
+		sort.SliceStable(ids, func(i, j int) bool {
+			a, b := cached[ids[i]], cached[ids[j]]
+			if a == nil {
+				return false
+			}
+			if b == nil {
+				return true
+			}
+			if a.IsPinned != b.IsPinned {
+				return a.IsPinned
+			}
+			return a.LatestMsgSendTime > b.LatestMsgSendTime
+		})
+	}
+	for _, id := range ids {
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			failed[id] = err
+			continue
+		}
+		r := ranges[id]
+		r[0] = max(1, r[0])
+		if m.db != nil && !IsNotification(id) {
+			var row *model_struct.LocalConversation
+			var err error
+			if cached != nil {
+				row = cached[id]
+			} else {
+				row, err = m.db.GetConversation(ctx, id)
+			}
+			if err != nil && !errors.Is(err, errs.ErrRecordNotFound) {
+				failed[id] = err
+				continue
+			}
+			if row != nil {
+				r[0] = max(r[0], row.MinSeq)
+				if row.MaxSeq > 0 && r[1] > row.MaxSeq {
+					conflicts[id] = r
+				}
+			}
+		}
+		visible[id] = r
+	}
+	m.prioritizeConversations(ids, nil)
+	if len(conflicts) == 0 {
+		return visible, failed, ids
+	}
+	var conflictingIDs []string
+	for _, id := range ids {
+		if _, ok := conflicts[id]; ok {
+			conflictingIDs = append(conflictingIDs, id)
+		}
+	}
+	for begin := 0; begin < len(conflictingIDs); begin += latestMessageBatchSize {
+		batch := make(map[string][2]int64)
+		for _, id := range conflictingIDs[begin:min(begin+latestMessageBatchSize, len(conflictingIDs))] {
+			batch[id] = conflicts[id]
+		}
+		m.resolveVisibilityBatch(ctx, batch, failed)
+		for id, r := range batch {
+			if failed[id] == nil {
+				visible[id] = r
+			}
+		}
+	}
+	return visible, failed, ids
+}
+
+func (m *MsgSyncer) resolveVisibilityBatch(ctx context.Context, ranges map[string][2]int64, failed map[string]error) {
+	for _, ascending := range []bool{false, true} {
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			for id := range ranges {
+				failed[id] = err
+			}
+			return
+		}
+		order := sdkws.PullOrder_PullOrderDesc
+		if ascending {
+			order = sdkws.PullOrder_PullOrderAsc
+		}
+		req := &msg.GetSeqMessageReq{UserID: m.loginUserID, Order: order}
+		for id, r := range ranges {
+			if failed[id] != nil || r[0] > r[1] {
+				continue
+			}
+			seq := r[0]
+			if ascending {
+				seq = r[1]
+			}
+			req.Conversations = append(req.Conversations, &msg.ConversationSeqs{ConversationID: id, Seqs: []int64{seq}})
+		}
+		if len(req.Conversations) == 0 {
+			return
+		}
+		var resp msg.GetSeqMessageResp
+		if err := m.longConnMgr.SendReqWaitResp(ctx, req, constant.PullMsgBySeqList, &resp); err != nil {
+			for _, row := range req.Conversations {
+				failed[row.ConversationID] = err
+			}
+			return
+		}
+		for _, row := range req.Conversations {
+			id := row.ConversationID
+			packet := resp.Msgs[id]
+			if packet == nil || packet.EndSeq < 0 {
+				failed[id] = fmt.Errorf("invalid visibility response for %q", id)
+				continue
+			}
+			if !packet.IsEnd {
+				continue
+			}
+			r := ranges[id]
+			if ascending {
+				r[1] = min(r[1], packet.EndSeq)
+			} else {
+				r[0] = max(r[0], packet.EndSeq)
+			}
+			ranges[id] = r
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_visible_empty.go b/internal/interaction/msg_sync_visible_empty.go
new file mode 100644
index 00000000..477137c3
--- /dev/null
+++ b/internal/interaction/msg_sync_visible_empty.go
@@ -0,0 +1,101 @@
+package interaction
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/log"
+)
+
+// An empty preview alone is not coverage. Revalidate its full pending window
+// through the authenticated directional history API. This preserves cleared or
+// membership-restricted history without waiving genuine holes or transport errors.
+func (m *MsgSyncer) resolveEmptySyncPreviews(ctx context.Context, batch, visible map[string][2]int64, resp *sdkws.PullMessageBySeqsResp) error {
+	if resp == nil {
+		return nil
+	}
+	pending := make(map[string][2]int64)
+	for id := range batch {
+		if packet := resp.Msgs[id]; packet != nil && len(packet.Msgs) == 0 {
+			pending[id] = visible[id]
+		}
+	}
+	if len(pending) == 0 {
+		return nil
+	}
+	closed := 0
+	for _, ascending := range []bool{false, true} {
+		req := &msg.GetSeqMessageReq{UserID: m.loginUserID, Order: sdkws.PullOrder_PullOrderDesc}
+		if ascending {
+			req.Order = sdkws.PullOrder_PullOrderAsc
+		}
+		for id, r := range pending {
+			if r[0] > r[1] {
+				continue
+			}
+			seq := r[0]
+			if ascending {
+				seq = r[1]
+			}
+			req.Conversations = append(req.Conversations, &msg.ConversationSeqs{ConversationID: id, Seqs: []int64{seq}})
+		}
+		if len(req.Conversations) == 0 {
+			break
+		}
+		var boundary msg.GetSeqMessageResp
+		if err := m.longConnMgr.SendReqWaitResp(ctx, req, constant.PullMsgBySeqList, &boundary); err != nil {
+			return err
+		}
+		for _, conv := range req.Conversations {
+			packet := boundary.Msgs[conv.ConversationID]
+			if packet == nil || packet.EndSeq < 0 {
+				return fmt.Errorf("invalid empty-preview visibility response for %q", conv.ConversationID)
+			}
+			if !packet.IsEnd {
+				continue
+			}
+			r := pending[conv.ConversationID]
+			if ascending {
+				r[1] = min(r[1], packet.EndSeq)
+			} else {
+				r[0] = max(r[0], packet.EndSeq)
+			}
+			pending[conv.ConversationID] = r
+		}
+	}
+	for id, r := range pending {
+		original := visible[id]
+		tail := batch[id][1]
+		if r[0] <= tail && tail <= r[1] {
+			continue // The missing preview is still readable, so proof is incomplete.
+		}
+		var invisible [][2]int64
+		if r[0] > original[0] {
+			invisible = append(invisible, [2]int64{original[0], min(original[1], r[0]-1)})
+		}
+		if r[1] < original[1] {
+			invisible = append(invisible, [2]int64{max(original[0], r[1]+1), original[1]})
+		}
+		if len(invisible) > 0 {
+			// Directional history proves these sequences are outside visibility.
+			// Record only those ranges: a suffix must never acknowledge older holes.
+			if err := m.commitMessageCoverage(ctx, id, invisible); err != nil {
+				return err
+			}
+			messageSyncPageCommitted(ctx)
+		}
+		// Tightening the upper bound must not expand the automatic recent window
+		// backwards into history which was deliberately left for on-demand reads.
+		r[0] = max(r[0], original[1]-recentMessageWindow+1)
+		visible[id] = r
+		if m.syncedMaxSeqs[id] >= tail || m.messageAlreadyCovered(id, tail) {
+			delete(batch, id)
+			closed++
+		}
+	}
+	log.ZInfo(ctx, "sync_diag empty_previews_revalidated", "candidates", len(pending), "confirmedInvisible", closed, "stillIncomplete", len(pending)-closed)
+	return nil
+}
diff --git a/internal/interaction/msg_sync_visible_empty_lifecycle_test.go b/internal/interaction/msg_sync_visible_empty_lifecycle_test.go
new file mode 100644
index 00000000..0a524eeb
--- /dev/null
+++ b/internal/interaction/msg_sync_visible_empty_lifecycle_test.go
@@ -0,0 +1,112 @@
+package interaction
+
+import (
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+// Exercise the scheduler and delivery receipts, rather than only the boundary helper.
+func TestInvisiblePrefixLifecycleDoesNotSkipNewMessages(t *testing.T) {
+	for _, scenario := range []string{"clear_then_new", "rejoin_stale_upper", "reconnect_persisted_checkpoint"} {
+		t.Run(scenario, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			store := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}}
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, db: store, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+			lower, upper := int64(5), int64(4)
+			offline := false
+			delivered := map[int64]int{}
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				for _, batch := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+					for _, row := range batch.Msgs {
+						delivered[row.Seq]++
+					}
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if offline {
+					return &GeneralWsResp{ErrCode: 10001, ErrMsg: "connection lost"}
+				}
+				if req.Message.ReqIdentifier == constant.PullMsgBySeqList {
+					q := &msg.GetSeqMessageReq{}
+					if err := proto.Unmarshal(req.Message.Data, q); err != nil {
+						panic(err)
+					}
+					p := &sdkws.PullMsgs{}
+					seq := q.Conversations[0].Seqs[0]
+					if q.Order == sdkws.PullOrder_PullOrderDesc && seq <= lower {
+						p.IsEnd, p.EndSeq = true, lower
+					}
+					if q.Order == sdkws.PullOrder_PullOrderAsc && seq >= upper {
+						p.IsEnd, p.EndSeq = true, upper
+					}
+					return wireResponse(&msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{"chat": p}})
+				}
+				q := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, q); err != nil {
+					panic(err)
+				}
+				r := q.SeqRanges[0]
+				var seqs []int64
+				for s := r.Begin; s <= r.End; s++ {
+					if s >= lower && s <= upper {
+						seqs = append(seqs, s)
+					}
+				}
+				return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seqs...)})
+			})
+			if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": 4}, 1); err != nil {
+				t.Fatal(err)
+			}
+			if m.syncedMaxSeqs["chat"] != 4 || len(delivered) != 0 {
+				t.Fatal("old invisible prefix was not closed safely")
+			}
+			if scenario == "rejoin_stale_upper" {
+				// Membership reopens at seq 5, while the local cache still says max 4.
+				store.boundary = model_struct.LocalConversation{MinSeq: 5, MaxSeq: 4}
+			}
+			if scenario == "reconnect_persisted_checkpoint" {
+				m = &MsgSyncer{ctx: ctx, db: store, longConnMgr: conn, conversationCh: m.conversationCh, syncedMaxSeqs: map[string]int64{}}
+				if err := m.loadMessageCheckpoints(ctx, []string{"chat"}); err != nil {
+					t.Fatal(err)
+				}
+				offline = true
+				if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": 7}, 1); err == nil {
+					t.Fatal("outage accepted as completion")
+				}
+				if m.syncedMaxSeqs["chat"] != 4 {
+					t.Fatal("outage advanced checkpoint")
+				}
+				offline = false
+			}
+			upper = 7
+			if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": upper}, 1); err != nil {
+				t.Fatal(err)
+			}
+			for seq := int64(5); seq <= upper; seq++ {
+				if delivered[seq] != 1 {
+					t.Fatalf("normal seq %d delivered %d times", seq, delivered[seq])
+				}
+			}
+			if m.syncedMaxSeqs["chat"] != upper {
+				t.Fatalf("checkpoint=%d", m.syncedMaxSeqs["chat"])
+			}
+			if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": upper}, 1); err != nil {
+				t.Fatal(err)
+			}
+			for seq, count := range delivered {
+				if count != 1 {
+					t.Fatalf("seq %d repeated after completion", seq)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/interaction/msg_sync_visible_empty_test.go b/internal/interaction/msg_sync_visible_empty_test.go
new file mode 100644
index 00000000..de2554e0
--- /dev/null
+++ b/internal/interaction/msg_sync_visible_empty_test.go
@@ -0,0 +1,133 @@
+package interaction
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestEmptyPreviewFailureDoesNotAdvanceCheckpoint(t *testing.T) {
+	for _, disk := range []bool{false, true} {
+		t.Run(fmt.Sprint("disk=", disk), func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			db := &recoveryVersionDB{}
+			if disk {
+				db.writeErr = errors.New("disk unavailable")
+			}
+			// checkpointFaultDB fails only the durable completion write.
+			store := &checkpointFaultDB{recoveryVersionDB: db}
+			if disk {
+				store.failCompleted = 4
+			}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, syncedMaxSeqs: map[string]int64{}, db: store}
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if !disk {
+					return &GeneralWsResp{ErrCode: 10001, ErrMsg: "boundary unavailable"}
+				}
+				return wireResponse(&msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{"sg_test": {IsEnd: true, EndSeq: 5}}})
+			})
+			batch := map[string][2]int64{"sg_test": {4, 4}}
+			err := m.resolveEmptySyncPreviews(ctx, batch, map[string][2]int64{"sg_test": {1, 4}}, &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{"sg_test": {}}})
+			if err == nil || m.syncedMaxSeqs["sg_test"] != 0 || len(batch) != 1 {
+				t.Fatal("failed proof/write discarded pending work", err)
+			}
+		})
+	}
+}
+
+func TestEmptyPreviewRequiresAuthoritativeInvisiblePrefix(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		lower             int64
+		terminal, missing bool
+		wantClosed        bool
+	}{
+		{"cleared_history", 5, true, false, true},
+		{"inclusive_boundary_still_readable", 4, true, false, false},
+		{"empty_without_boundary", 5, false, false, false},
+		{"missing_boundary_packet", 5, true, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, longConnMgr: conn, syncedMaxSeqs: map[string]int64{}, db: &recoveryVersionDB{}}
+			batch := map[string][2]int64{"sg_test": {4, 4}}
+			visible := map[string][2]int64{"sg_test": {1, 4}}
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier != constant.PullMsgBySeqList {
+					t.Error("unexpected request")
+				}
+				q := &msg.GetSeqMessageReq{}
+				_ = proto.Unmarshal(req.Message.Data, q)
+				p := &sdkws.PullMsgs{IsEnd: tc.terminal, EndSeq: tc.lower}
+				if q.Order == sdkws.PullOrder_PullOrderAsc {
+					p.EndSeq = 4
+				}
+				r := &msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{}}
+				if !tc.missing {
+					r.Msgs["sg_test"] = p
+				}
+				return wireResponse(r)
+			})
+			err := m.resolveEmptySyncPreviews(ctx, batch, visible, &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{"sg_test": {IsEnd: true, EndSeq: 4}}})
+			if tc.missing && err == nil {
+				t.Fatal("missing proof accepted")
+			}
+			if !tc.missing && err != nil {
+				t.Fatal(err)
+			}
+			if tc.wantClosed {
+				if len(batch) != 0 || m.syncedMaxSeqs["sg_test"] != 4 || visible["sg_test"][0] != 5 {
+					t.Fatal("closed prefix not committed")
+				}
+			} else if len(batch) != 1 || m.syncedMaxSeqs["sg_test"] != 0 {
+				t.Fatal("unproven gap acknowledged")
+			}
+		})
+	}
+}
+
+func TestEmptyPreviewsRevalidateInOneBatchAndDoNotRepeat(t *testing.T) {
+	ctx := recoveryContext(t)
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, syncedMaxSeqs: map[string]int64{}, db: &recoveryVersionDB{}}
+	targets := map[string]int64{}
+	requests := 0
+	for n := 0; n < 100; n++ {
+		targets[fmt.Sprintf("sg_%03d", n)] = 4
+	}
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		requests++
+		if req.Message.ReqIdentifier == constant.PullMsgByRange {
+			r := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}}
+			for id := range targets {
+				r.Msgs[id] = &sdkws.PullMsgs{IsEnd: true, EndSeq: 4}
+			}
+			return wireResponse(r)
+		}
+		q := &msg.GetSeqMessageReq{}
+		_ = proto.Unmarshal(req.Message.Data, q)
+		if len(q.Conversations) != 100 || q.Order != sdkws.PullOrder_PullOrderDesc {
+			t.Error("not batched")
+		}
+		r := &msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{}}
+		for id := range targets {
+			r.Msgs[id] = &sdkws.PullMsgs{IsEnd: true, EndSeq: 5}
+		}
+		return wireResponse(r)
+	})
+	for n := 0; n < 2; n++ {
+		if err := m.compareSeqsAndBatchSync(ctx, targets, 1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if requests != 2 {
+		t.Fatalf("expected one preview and one boundary batch, got %d", requests)
+	}
+}
diff --git a/internal/interaction/msg_visible_range.go b/internal/interaction/msg_visible_range.go
new file mode 100644
index 00000000..58f169c9
--- /dev/null
+++ b/internal/interaction/msg_visible_range.go
@@ -0,0 +1,51 @@
+package interaction
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+// Resolve only from an explicit directional boundary on the existing history
+// protocol. An empty range pull alone never proves deletion or visibility.
+func (m *MsgSyncer) refreshVisibleMessageRange(ctx context.Context, id string, r [2]int64) ([2]int64, error) {
+	return m.longConnMgr.ResolveVisibleMessageRange(ctx, m.loginUserID, id, r)
+}
+
+// ResolveVisibleMessageRange revalidates a conflicting cached bound using the
+// existing directional history protocol. It does not change local checkpoints.
+func (c *LongConnMgr) ResolveVisibleMessageRange(ctx context.Context, userID, id string, r [2]int64) ([2]int64, error) {
+	for _, ascending := range []bool{false, true} {
+		seq, order := r[0], sdkws.PullOrder_PullOrderDesc
+		if ascending {
+			seq, order = r[1], sdkws.PullOrder_PullOrderAsc
+		}
+		var resp msg.GetSeqMessageResp
+		req := &msg.GetSeqMessageReq{UserID: userID, Order: order, Conversations: []*msg.ConversationSeqs{{ConversationID: id, Seqs: []int64{seq}}}}
+		if err := c.SendReqWaitResp(ctx, req, constant.PullMsgBySeqList, &resp); err != nil {
+			return r, err
+		}
+		rows := resp.Msgs[id]
+		if rows == nil {
+			return r, fmt.Errorf("visibility response missing %q", id)
+		}
+		if rows.IsEnd {
+			if rows.EndSeq < 0 {
+				return r, fmt.Errorf("invalid visibility boundary for %q", id)
+			}
+			if ascending && rows.EndSeq < r[1] {
+				r[1] = rows.EndSeq
+			}
+			if !ascending && rows.EndSeq > r[0] {
+				r[0] = rows.EndSeq
+			}
+		}
+		if r[0] > r[1] {
+			break
+		}
+	}
+	return r, nil
+}
diff --git a/internal/interaction/msg_visible_range_test.go b/internal/interaction/msg_visible_range_test.go
new file mode 100644
index 00000000..4122712f
--- /dev/null
+++ b/internal/interaction/msg_visible_range_test.go
@@ -0,0 +1,108 @@
+package interaction
+
+import (
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+func TestVisibilityRecoveryUsesFreshBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name                                                       string
+		completed, cachedMax, target, visibleMin, visibleMax, want int64
+		ambiguous                                                  bool
+	}{
+		{name: "stale upper bound", completed: 10, cachedMax: 10, target: 20, visibleMin: 1, visibleMax: 20, want: 20},
+		{name: "expired prefix within latest window", target: 650, visibleMin: 601, visibleMax: 650, want: 650},
+		{name: "permission upper bound", completed: 10, cachedMax: 10, target: 20, visibleMin: 1, visibleMax: 15, want: 15},
+		{name: "ambiguous empty prefix", target: 650, visibleMin: 601, visibleMax: 650, want: 0, ambiguous: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			d := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, boundary: model_struct.LocalConversation{MaxSeq: tc.cachedMax}}
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			m := &MsgSyncer{ctx: ctx, db: d, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": tc.completed}}
+			delivered, pulls, probes := 0, 0, 0
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				for _, batch := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+					for _, row := range batch.Msgs {
+						if row.Seq < tc.visibleMin || row.Seq > tc.visibleMax {
+							t.Errorf("delivered invisible seq %d", row.Seq)
+						}
+						delivered++
+					}
+				}
+				return nil
+			})
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier == constant.PullMsgBySeqList {
+					probes++
+					p := &msg.GetSeqMessageReq{}
+					if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+						panic(err)
+					}
+					bound := &sdkws.PullMsgs{}
+					seq := p.Conversations[0].Seqs[0]
+					if !tc.ambiguous {
+						if p.Order == sdkws.PullOrder_PullOrderDesc && seq < tc.visibleMin {
+							bound.IsEnd = true
+							bound.EndSeq = tc.visibleMin
+						}
+						if p.Order == sdkws.PullOrder_PullOrderAsc && seq > tc.visibleMax {
+							bound.IsEnd = true
+							bound.EndSeq = tc.visibleMax
+						}
+					}
+					return wireResponse(&msg.GetSeqMessageResp{Msgs: map[string]*sdkws.PullMsgs{"chat": bound}})
+				}
+				pulls++
+				p := &sdkws.PullMessageBySeqsReq{}
+				if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+					panic(err)
+				}
+				r := p.SeqRanges[0]
+				var seqs []int64
+				for s := r.Begin; s <= r.End; s++ {
+					if s >= tc.visibleMin && s <= tc.visibleMax {
+						seqs = append(seqs, s)
+					}
+				}
+				return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seqs...)})
+			})
+			err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": tc.target}, 1)
+			if (err != nil) != tc.ambiguous {
+				t.Fatalf("unexpected sync result: %v", err)
+			}
+			if m.syncedMaxSeqs["chat"] != tc.want || m.checkpoints["chat"].Target != tc.target {
+				t.Fatalf("lost coverage/target: %+v", m.checkpoints["chat"])
+			}
+			wantRows := int(tc.want - max(tc.completed, tc.visibleMin-1))
+			if wantRows < 0 {
+				wantRows = 0
+			}
+			if tc.ambiguous {
+				wantRows = 1
+			} // The valid tail is visible; the unknown older gap remains pending.
+			if delivered != wantRows {
+				t.Fatalf("delivered=%d want=%d", delivered, wantRows)
+			}
+			if probes != 2 {
+				t.Fatalf("boundary resolution must be bounded: %d", probes)
+			}
+			if !tc.ambiguous && tc.want == tc.target {
+				previous := pulls
+				if err := m.compareSeqsAndBatchSync(ctx, map[string]int64{"chat": tc.target}, 1); err != nil {
+					t.Fatal(err)
+				}
+				if pulls != previous {
+					t.Fatal("complete interval was fetched again")
+				}
+			}
+		})
+	}
+}
