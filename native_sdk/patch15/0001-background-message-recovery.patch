@@ -0,0 +1,30 @@
+package group
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestCancelledGroupRecoveryDoesNotWaitForAPILock(t *testing.T) {
+	var gate groupSyncGate
+	gate.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- gate.LockContext(ctx) }()
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancelled waiter blocked")
+	}
+	gate.Unlock()
+	if err := gate.LockContext(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	gate.Unlock()
+}
diff --git a/internal/group/sync_member_requests.go b/internal/group/sync_member_requests.go
new file mode 100644
index 00000000..16c9dea7
--- /dev/null
+++ b/internal/group/sync_member_requests.go
@@ -0,0 +1,63 @@
+package group
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/protocol/group"
+	"github.com/openimsdk/tools/errs"
+)
+
+// The server stops after its changed-member response budget. A group omitted
+// from a nonempty response may not have been inspected; it is not a checkpoint.
+func (g *Group) syncMemberRequests(ctx context.Context, scope string, requests []*group.GetIncrementalGroupMemberReq) error {
+	for len(requests) > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		responses, err := g.getIncrementalGroupMemberBatch(ctx, requests)
+		if err != nil {
+			return err
+		}
+		// The existing server skips dismissed groups. An entirely empty success
+		// cannot have reached the response budget, so all remaining were checked.
+		if len(responses) == 0 {
+			for _, req := range requests {
+				common.CompleteMetadataItem(ctx, scope, req.GroupID)
+			}
+			return ctx.Err()
+		}
+		pending := make([]*group.GetIncrementalGroupMemberReq, 0, len(requests))
+		tasks := make([]func() error, 0, len(requests))
+		for _, req := range requests {
+			id := req.GroupID
+			resp, present := responses[id]
+			if !present {
+				pending = append(pending, req)
+				continue
+			}
+			if unchangedMemberVersion(req, resp) {
+				common.CompleteMetadataItem(ctx, scope, id)
+				continue
+			}
+			tasks = append(tasks, func() error {
+				if resp == nil {
+					return errs.New("nil incremental group response", "groupID", id)
+				}
+				if err := g.syncGroupAndMember(ctx, id, resp); err != nil {
+					return err
+				}
+				common.CompleteMetadataItem(ctx, scope, id)
+				return nil
+			})
+		}
+		if len(pending) == len(requests) {
+			return errs.New("group batch response made no progress")
+		}
+		if err := runGroupSyncBatch(ctx, tasks); err != nil {
+			return err
+		}
+		requests = pending
+	}
+	return ctx.Err()
+}
diff --git a/internal/group/sync_probe.go b/internal/group/sync_probe.go
new file mode 100644
index 00000000..55201d4e
--- /dev/null
+++ b/internal/group/sync_probe.go
@@ -0,0 +1,54 @@
+package group
+
+import (
+	"context"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/group"
+	"github.com/openimsdk/tools/errs"
+)
+
+// Optional capability keeps the existing database contract and WASM fallback.
+type versionHeaderReader interface {
+	GetVersionSyncHeaders(context.Context, string, []string) (map[string]*model_struct.LocalVersionSync, error)
+}
+
+func (g *Group) memberVersionRequests(ctx context.Context, ids []string) ([]*group.GetIncrementalGroupMemberReq, error) {
+	versions := make(map[string]*model_struct.LocalVersionSync, len(ids))
+	if reader, ok := g.db.(versionHeaderReader); ok {
+		var err error
+		versions, err = reader.GetVersionSyncHeaders(ctx, g.groupAndMemberVersionTableName(), ids)
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		for _, id := range ids {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			version, err := g.db.GetVersionSync(ctx, g.groupAndMemberVersionTableName(), id)
+			if err != nil && !errs.ErrRecordNotFound.Is(err) {
+				return nil, err
+			}
+			if err == nil {
+				versions[id] = version
+			}
+		}
+	}
+	requests := make([]*group.GetIncrementalGroupMemberReq, 0, len(ids))
+	for _, id := range ids {
+		request := &group.GetIncrementalGroupMemberReq{GroupID: id}
+		if version := versions[id]; version != nil {
+			request.VersionID, request.Version = version.VersionID, version.Version
+		}
+		requests = append(requests, request)
+	}
+	return requests, ctx.Err()
+}
+
+func unchangedMemberVersion(req *group.GetIncrementalGroupMemberReq, resp *group.GetIncrementalGroupMemberResp) bool {
+	return resp != nil && req.VersionID != "" && req.Version > 0 &&
+		req.VersionID == resp.VersionID && req.Version == resp.Version &&
+		!resp.Full && resp.Group == nil && resp.SortVersion == 0 &&
+		len(resp.Insert) == 0 && len(resp.Update) == 0 && len(resp.Delete) == 0
+}
