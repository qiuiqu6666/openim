+func TestPriorityHistoryReusesSQLiteRowsIncludingTombstones(t *testing.T) {
+	_, _, _, cmd := recoveryConversation(t)
+	d, err := db.NewDataBase(cmd.Ctx, "self", t.TempDir(), 0)
+	if err != nil {
+		t.Fatal(err)
