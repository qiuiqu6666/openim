+		t.Fatalf("lost profile notification: row=%+v events=%d commands=%d versions=%d", d.row, l.changed, len(ch), d.saved)
+	}
+	if cached, ok := g.groupInfoCache.Load("g"); !ok || cached.GroupName != "Offline name" {
+		t.Fatal("cache was not refreshed")
+	}
+}
+
+func TestGroupSyncFailurePropagatesAndCanRetry(t *testing.T) {
+	ctx := groupProfileServer(t, func(w http.ResponseWriter, r *http.Request) {
+		profileResponse(w, map[string]any{"respList": map[string]any{"g": map[string]any{"versionID": "members", "version": 1, "group": map[string]any{"groupID": "g", "groupName": "New"}}}})
+	})
+	d := &groupProfileDB{row: &model_struct.LocalGroup{GroupID: "g"}, failMember: true}
+	g := NewGroup("self", d, make(chan common.Cmd2Value, 4))
+	g.SetGroupListener(func() open_im_sdk_callback.OnGroupListener { return &groupProfileListener{} })
+	if err := g.IncrSyncGroupAndMember(ctx, "g"); err == nil || d.saved != 0 {
+		t.Fatal("member error was swallowed")
+	}
+	d.failMember = false
+	if err := g.IncrSyncGroupAndMember(ctx, "g"); err != nil || d.saved != 1 {
+		t.Fatalf("retry failed: %v", err)
+	}
+}
diff --git a/internal/interaction/connection_recovery.go b/internal/interaction/connection_recovery.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/connection_recovery.go
@@ -0,0 +1,62 @@
+package interaction
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// Optional interface preserves the existing JS and external transport contract.
+func dialSession(ctx context.Context, conn LongConn, url string) (*http.Response, error) {
+	if dialer, ok := conn.(interface {
+		DialContext(context.Context, string, http.Header) (*http.Response, error)
+	}); ok {
+		return dialer.DialContext(ctx, url, nil)
+	}
+	return conn.Dial(url, nil)
+}
+
+func (c *LongConnMgr) recoverySignal() chan struct{} {
+	c.recoveryMu.Lock()
+	defer c.recoveryMu.Unlock()
+	if c.recoveryWake == nil {
+		c.recoveryWake = make(chan struct{}, 1)
+	}
+	return c.recoveryWake
+}
+
+func (c *LongConnMgr) wakeReconnect() {
+	select {
+	case c.recoverySignal() <- struct{}{}:
+	default:
+	}
+}
+
+func (c *LongConnMgr) waitReconnect(ctx context.Context, delay time.Duration) bool {
+	// Until push coverage is deployed, retain a low-frequency background
+	// fallback instead of cutting background reception off completely.
+	if c.GetBackground() && delay < time.Minute {
+		delay = time.Minute
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-c.recoverySignal():
+		return ctx.Err() == nil
+	case <-timer.C:
+		return ctx.Err() == nil
+	}
+}
+
+func (c *LongConnMgr) setCloseError(err error) {
+	c.recoveryMu.Lock()
+	defer c.recoveryMu.Unlock()
+	c.closedErr = err
+}
+func (c *LongConnMgr) closeError() error {
+	c.recoveryMu.Lock()
+	defer c.recoveryMu.Unlock()
+	return c.closedErr
+}
diff --git a/internal/interaction/connection_recovery_test.go b/internal/interaction/connection_recovery_test.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/connection_recovery_test.go
@@ -0,0 +1,67 @@
+//go:build !js
+
+package interaction
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestReconnectBackoffDoesNotWrapAndResetIsExplicit(t *testing.T) {
+	r := NewExponentialRetry()
+	for i := 0; i < 100; i++ {
+		d := r.GetSleepInterval()
+		if i >= 5 && (d < 15*time.Second || d > 30*time.Second) {
+			t.Fatalf("sustained failure returned to fast retry: attempt=%d delay=%v", i, d)
+		}
+	}
+	r.Reset()
+	if d := r.GetSleepInterval(); d < 500*time.Millisecond || d > time.Second {
+		t.Fatal(d)
+	}
+}
+
+func TestRecoveryWaitCancelledAndWakeCoalesced(t *testing.T) {
+	c := &LongConnMgr{}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if c.waitReconnect(ctx, time.Hour) {
+		t.Fatal("cancelled session retried")
+	}
+	for i := 0; i < 1000; i++ {
+		c.wakeReconnect()
+	}
+	if len(c.recoverySignal()) != 1 {
+		t.Fatal("wake events not coalesced")
+	}
+	if !c.waitReconnect(context.Background(), time.Hour) {
+		t.Fatal("wake ignored")
+	}
+	if len(c.recoverySignal()) != 0 {
+		t.Fatal("wake not consumed")
+	}
+}
+
+func TestForegroundInterruptsBackgroundBackoff(t *testing.T) {
+	c := &LongConnMgr{}
+	c.SetBackground(true)
+	done := make(chan bool, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	go func() { done <- c.waitReconnect(ctx, time.Minute) }()
+	c.SetBackground(false)
+	if !<-done {
+		t.Fatal("foreground did not wake reconnect")
+	}
+}
+
+func TestNativeDialHonorsSessionCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	d := NewWebSocket(0)
+	_, err := dialSession(ctx, d, "ws://127.0.0.1:1")
+	if err == nil || !d.IsNil() {
+		t.Fatal("cancelled dial opened a socket")
+	}
+}
