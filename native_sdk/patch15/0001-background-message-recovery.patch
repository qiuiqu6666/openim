+	if err := d.BatchInsertConversationList(cmd.Ctx, []*model_struct.LocalConversation{{ConversationID: "chat", UnreadCount: 3, LatestMsg: `{"seq":1000}`}}); err != nil {
+		t.Fatal(err)
