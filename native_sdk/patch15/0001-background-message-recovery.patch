+type transactionalRecoveryDB struct{ *recoveryDB }
+
+func (d *transactionalRecoveryDB) BatchInsertMessageMap(ctx context.Context, msgs map[string][]*model_struct.LocalChatLog) error {
+	for id, ms := range msgs {
