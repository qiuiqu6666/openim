new file mode 100644
index 0000000..6c42ba1
--- /dev/null
+++ b/internal/interaction/connection_recovery.go
@@ -0,0 +1,62 @@
+package interaction
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// Optional interface preserves the existing JS and external transport contract.
+func dialSession(ctx context.Context, conn LongConn, url string) (*http.Response, error) {
+	if dialer, ok := conn.(interface {
+		DialContext(context.Context, string, http.Header) (*http.Response, error)
+	}); ok {
+		return dialer.DialContext(ctx, url, nil)
+	}
+	return conn.Dial(url, nil)
+}
+
+func (c *LongConnMgr) recoverySignal() chan struct{} {
+	c.recoveryMu.Lock()
+	defer c.recoveryMu.Unlock()
+	if c.recoveryWake == nil {
+		c.recoveryWake = make(chan struct{}, 1)
+	}
+	return c.recoveryWake
+}
+
+func (c *LongConnMgr) wakeReconnect() {
+	select {
+	case c.recoverySignal() <- struct{}{}:
+	default:
+	}
+}
+
+func (c *LongConnMgr) waitReconnect(ctx context.Context, delay time.Duration) bool {
+	// Until push coverage is deployed, retain a low-frequency background
+	// fallback instead of cutting background reception off completely.
+	if c.GetBackground() && delay < time.Minute {
+		delay = time.Minute
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-c.recoverySignal():
+		return ctx.Err() == nil
+	case <-timer.C:
+		return ctx.Err() == nil
+	}
+}
+
+func (c *LongConnMgr) setCloseError(err error) {
+	c.recoveryMu.Lock()
+	defer c.recoveryMu.Unlock()
+	c.closedErr = err
+}
+func (c *LongConnMgr) closeError() error {
+	c.recoveryMu.Lock()
+	defer c.recoveryMu.Unlock()
+	return c.closedErr
+}
diff --git a/internal/interaction/connection_recovery_test.go b/internal/interaction/connection_recovery_test.go
new file mode 100644
index 0000000..73f60ce
--- /dev/null
+++ b/internal/interaction/connection_recovery_test.go
@@ -0,0 +1,67 @@
+//go:build !js
+
+package interaction
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestReconnectBackoffDoesNotWrapAndResetIsExplicit(t *testing.T) {
+	r := NewExponentialRetry()
+	for i := 0; i < 100; i++ {
+		d := r.GetSleepInterval()
+		if i >= 5 && (d < 15*time.Second || d > 30*time.Second) {
+			t.Fatalf("sustained failure returned to fast retry: attempt=%d delay=%v", i, d)
+		}
+	}
+	r.Reset()
+	if d := r.GetSleepInterval(); d < 500*time.Millisecond || d > time.Second {
+		t.Fatal(d)
+	}
+}
+
+func TestRecoveryWaitCancelledAndWakeCoalesced(t *testing.T) {
+	c := &LongConnMgr{}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if c.waitReconnect(ctx, time.Hour) {
+		t.Fatal("cancelled session retried")
+	}
+	for i := 0; i < 1000; i++ {
+		c.wakeReconnect()
+	}
+	if len(c.recoverySignal()) != 1 {
+		t.Fatal("wake events not coalesced")
+	}
+	if !c.waitReconnect(context.Background(), time.Hour) {
+		t.Fatal("wake ignored")
+	}
+	if len(c.recoverySignal()) != 0 {
+		t.Fatal("wake not consumed")
+	}
+}
+
+func TestForegroundInterruptsBackgroundBackoff(t *testing.T) {
+	c := &LongConnMgr{}
+	c.SetBackground(true)
+	done := make(chan bool, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	go func() { done <- c.waitReconnect(ctx, time.Minute) }()
+	c.SetBackground(false)
+	if !<-done {
+		t.Fatal("foreground did not wake reconnect")
+	}
+}
+
+func TestNativeDialHonorsSessionCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	d := NewWebSocket(0)
+	_, err := dialSession(ctx, d, "ws://127.0.0.1:1")
+	if err == nil || !d.IsNil() {
+		t.Fatal("cancelled dial opened a socket")
+	}
+}
diff --git a/internal/interaction/connection_telemetry.go b/internal/interaction/connection_telemetry.go
new file mode 100644
index 0000000..c85657d
--- /dev/null
+++ b/internal/interaction/connection_telemetry.go
@@ -0,0 +1,58 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"github.com/openimsdk/tools/log"
+	"net"
+	"sync/atomic"
+	"time"
+)
+
+type connectionTelemetry struct {
+	attempts       atomic.Int64
+	connectedAt    atomic.Int64
+	lastPing       atomic.Int64
+	lastPong       atomic.Int64
+	lastMessage    atomic.Int64
+	lastDisconnect atomic.Int64
+}
+
+func observedConnectionError(err error) string {
+	var dns *net.DNSError
+	if errors.As(err, &dns) {
+		return "dns_error"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "session_cancelled"
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return "transport_timeout"
+	}
+	return "transport_error"
+}
+
+func (m *connectionTelemetry) connected(ctx context.Context, background bool) {
+	now := time.Now().UnixMilli()
+	m.connectedAt.Store(now)
+	m.lastPing.Store(0)
+	m.lastPong.Store(0)
+	m.lastMessage.Store(0)
+	var recoveryMS int64
+	if disconnected := m.lastDisconnect.Load(); disconnected > 0 {
+		recoveryMS = now - disconnected
+	}
+	log.ZInfo(ctx, "connection_recovered", "connectedAtMs", now, "attempts", m.attempts.Swap(0), "recoveryMs", recoveryMS, "background", background)
+}
+
+func (m *connectionTelemetry) disconnected(ctx context.Context, err error, background bool) {
+	now := time.Now().UnixMilli()
+	m.lastDisconnect.Store(now)
+	code, received := transportCloseCode(err)
+	log.ZWarn(ctx, "connection_disconnected", err,
+		"disconnectedAtMs", now, "connectedAtMs", m.connectedAt.Load(),
+		"observedError", observedConnectionError(err), "confirmedReason", "unknown",
+		"closeCode", code, "closeFrameReceived", received, "background", background,
+		"lastPingAtMs", m.lastPing.Load(), "lastPongAtMs", m.lastPong.Load(), "lastMessageAtMs", m.lastMessage.Load())
+}
diff --git a/internal/interaction/initial_sync_traffic_test.go b/internal/interaction/initial_sync_traffic_test.go
new file mode 100644
index 0000000..616ba55
--- /dev/null
+++ b/internal/interaction/initial_sync_traffic_test.go
@@ -0,0 +1,114 @@
+package interaction
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestFirstLoginCompletesAndCommitsMessagesUnderLiveTraffic(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	conn := &LongConnMgr{send: make(chan Message, 4)}
+	db := &recoveryVersionDB{}
+	m := &MsgSyncer{ctx: ctx, db: db, reinstalled: true, loginUserID: "self", longConnMgr: conn,
+		recvCh: make(chan common.Cmd2Value, 32), conversationCh: make(chan common.Cmd2Value, 32), syncedMaxSeqs: map[string]int64{}}
+	started, release := make(chan struct{}), make(chan struct{})
+	stored := make(chan int64, 32)
+	starts := 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if initial, ok := cmd.Value.(sdk_struct.CmdMsgSyncInReinstall); ok {
+			for _, messages := range initial.Msgs {
+				for _, msg := range messages.Msgs {
+					stored <- msg.Seq
+				}
+			}
+			return nil
+		}
+		v, ok := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation)
+		if !ok {
+			return nil
+		}
+		if cmd.Cmd == constant.CmdSyncFlag && v.SyncFlag == constant.AppDataSyncStart {
+			starts++
+			if starts == 1 {
+				close(started)
+			}
+			select {
+			case <-release:
+				return cmd.Ctx.Err()
+			case <-cmd.Ctx.Done():
+				return cmd.Ctx.Err()
+			}
+		}
+		for _, messages := range v.Msgs {
+			for _, msg := range messages.Msgs {
+				stored <- msg.Seq
+			}
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.GetNewestSeq {
+			return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"chat": 6}})
+		}
+		pull := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+			panic(err)
+		}
+		// Model the server: omitted/ascending order returns the oldest row.
+		seq := int64(1)
+		if pull.Order == sdkws.PullOrder_PullOrderDesc {
+			seq = 6
+		}
+		return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seq)})
+	})
+	done := make(chan struct{})
+	allHandled := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, m.recvCh, func(cmd common.Cmd2Value) {
+			m.handlePushMsgAndEventSafely(cmd)
+			if cmd.Cmd == constant.CmdPushMsg && cmd.Value.(*sdkws.PushMessages).Msgs["chat"].Msgs[0].Seq == 26 {
+				close(allHandled)
+			}
+		}, func() bool { return m.reinstalled })
+	}()
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdConnSuccesss}
+	<-started
+	for seq := int64(7); seq <= 26; seq++ {
+		m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg, Value: &sdkws.PushMessages{Msgs: recoveryMsgs("chat", seq)}}
+	}
+	select {
+	case <-stored:
+		t.Fatal("messages handled before first-login metadata was ready")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	for want := int64(6); want <= 26; want++ {
+		select {
+		case got := <-stored:
+			if got != want {
+				t.Fatalf("stored sequence %d, want %d", got, want)
+			}
+		case <-ctx.Done():
+			t.Fatal("initial sync or queued live messages did not finish")
+		}
+	}
+	select {
+	case <-allHandled:
+	case <-ctx.Done():
+		t.Fatal("live message commit never acknowledged")
+	}
+	cancel()
+	<-done
+	if !db.installed || m.reinstalled || m.syncedMaxSeqs["chat"] != 26 || starts != 1 {
+		t.Fatalf("bootstrap not committed: installed=%v reinstall=%v seq=%d starts=%d", db.installed, m.reinstalled, m.syncedMaxSeqs["chat"], starts)
+	}
+}
