+			if err != nil {
+				return nil, err
+			}
+		}
+	} else { // If the user is no longer in the group, return nil immediately
+		return nil, nil
+	}
+	dataFetcher := datafetcher.NewDataFetcher(
+		g.db,
+		g.groupAndMemberVersionTableName(),
+		groupID,
