+++ b/internal/interaction/msg_sync_metadata_test.go
@@ -0,0 +1,82 @@
+package interaction
+
+import (
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func TestOfflineLatestPrecedesFailingMetadataWithoutPush(t *testing.T) {
+	for _, wake := range []bool{false, true} {
+		for _, tail := range []int64{6, 100000000} {
+			t.Run(fmt.Sprintf("wake=%v/tail=%d", wake, tail), func(t *testing.T) {
+				ctx := recoveryContext(t)
+				conn := &LongConnMgr{send: make(chan Message, 1)}
+				m := &MsgSyncer{ctx: ctx, longConnMgr: conn, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"si_peer": 5}}
+				var visible, metadataCalls, terminal atomic.Int64
+				visible.Store(5)
+				failMetadata := true
+				receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+					if cmd.Cmd == constant.CmdSyncData {
+						metadataCalls.Add(1)
+						if visible.Load() != tail {
+							t.Error("metadata ran before latest message became visible")
+						}
+						if failMetadata {
+							return errors.New("profile service unavailable")
+						}
+					}
+					if cmd.Cmd == constant.CmdSyncFlag {
+						terminal.Store(int64(cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).SyncFlag))
+					}
+					if cmd.Cmd == constant.CmdNewMsgCome {
+						for _, packet := range cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).Msgs {
+							for _, row := range packet.Msgs {
+								if row.Seq > visible.Load() {
+									visible.Store(row.Seq)
+								}
+							}
+						}
+					}
+					return nil
+				})
+				requestWorker(t, conn, func(req Message) *GeneralWsResp {
+					if req.Message.ReqIdentifier == constant.GetNewestSeq {
+						return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"si_peer": tail}})
+					}
+					return requestedRecoveryResponse(t, req)
+				})
+				run := func() {
+					m.startSync()
+					if wake {
+						m.doWakeupDataSync(ctx)
+					} else {
+						m.doConnected(ctx)
+					}
+				}
+				run()
+				// Flush the terminal command through the same serialized worker.
+				if err := common.SendCmdWithReceipt(ctx, common.Cmd2Value{Cmd: "barrier"}, m.conversationCh); err != nil {
+					t.Fatal(err)
+				}
+				if visible.Load() != tail || metadataCalls.Load() != 1 || terminal.Load() != constant.MsgSyncFailed {
+					t.Fatalf("tail=%d metadata=%d status=%d", visible.Load(), metadataCalls.Load(), terminal.Load())
+				}
+				failMetadata = false
+				run()
+				if err := common.SendCmdWithReceipt(ctx, common.Cmd2Value{Cmd: "barrier"}, m.conversationCh); err != nil {
+					t.Fatal(err)
+				}
+				if metadataCalls.Load() != 2 || terminal.Load() != constant.MsgSyncEnd {
+					t.Fatal("metadata obligation was not retried")
+				}
+			})
+		}
+	}
+}
diff --git a/internal/interaction/msg_sync_page.go b/internal/interaction/msg_sync_page.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_page.go
@@ -0,0 +1,50 @@
+package interaction
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+type messagePageContextKey struct{}
+
+// Only the scheduler handles ingress. A range worker lends it ownership at a
+// committed page boundary and remains paused until that turn is acknowledged.
+type messagePageCoordinator struct {
+	bounded   atomic.Bool
+	committed atomic.Int64
+	failed    atomic.Bool
+	turns     chan chan struct{}
+}
+
+func messageSyncPageCommitted(ctx context.Context) {
+	if owner, ok := ctx.Value(messagePageContextKey{}).(*messagePageCoordinator); ok {
+		owner.committed.Add(1)
+	}
+}
+
+func protectMessagePages(ctx context.Context) func() {
+	if owner, ok := ctx.Value(messagePageContextKey{}).(*messagePageCoordinator); ok {
+		owner.bounded.Store(true)
+		return func() { owner.bounded.Store(false) }
+	}
+	return func() {}
+}
+
+func yieldMessageSyncPage(ctx context.Context) error {
+	owner, ok := ctx.Value(messagePageContextKey{}).(*messagePageCoordinator)
+	if !ok {
+		return ctx.Err()
+	}
+	resume := make(chan struct{})
+	select {
+	case owner.turns <- resume:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	select {
+	case <-resume:
+		return ctx.Err()
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
diff --git a/internal/interaction/msg_sync_recent.go b/internal/interaction/msg_sync_recent.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_recent.go
@@ -0,0 +1,77 @@
+package interaction
+
+import (
+	"context"
+	"sort"
+)
+
+// Automatic recovery is bounded independently of a group's lifetime history.
+const recentMessageWindow = 100
+
+func (m *MsgSyncer) messageAlreadyCovered(id string, seq int64) bool {
+	for _, r := range m.checkpoints[id].Covered {
+		if seq >= r[0] && seq <= r[1] {
+			return true
+		}
+	}
+	return false
+}
+
+// commitMessageCoverage never mistakes the newest observed message for a
+// complete prefix. Old ranges may be forgotten conservatively: their content
+// remains queryable on demand and is never scheduled for background download.
+func (m *MsgSyncer) commitMessageCoverage(ctx context.Context, id string, ranges [][2]int64) error {
+	state := m.checkpoints[id]
+	state.Completed = max(state.Completed, m.syncedMaxSeqs[id])
+	all := append(append([][2]int64(nil), state.Covered...), ranges...)
+	sort.Slice(all, func(i, j int) bool { return all[i][0] < all[j][0] })
+	merged := make([][2]int64, 0, len(all))
+	for _, r := range all {
+		state.Target = max(state.Target, r[1])
+		if r[1] <= state.Completed {
+			continue
+		}
+		if r[0] <= state.Completed+1 {
+			state.Completed = r[1]
+			continue
+		}
+		if len(merged) > 0 && r[0] <= merged[len(merged)-1][1]+1 {
+			merged[len(merged)-1][1] = max(merged[len(merged)-1][1], r[1])
+		} else {
+			merged = append(merged, r)
+		}
+	}
+	// A bounded journal, rather than one item per missing sequence.
+	if len(merged) > recentMessageWindow {
+		merged = merged[len(merged)-recentMessageWindow:]
+	}
+	state.Covered = merged
+	if err := m.saveMessageCheckpoint(ctx, id, state); err != nil {
+		return err
+	}
+	m.syncedMaxSeqs[id] = state.Completed
+	return nil
+}
+
+func (m *MsgSyncer) recentMissingRanges(id string, r [2]int64) [][2]int64 {
+	r[0] = max(max(1, r[0]), r[1]-recentMessageWindow+1)
+	state := m.checkpoints[id]
+	r[0] = max(r[0], m.syncedMaxSeqs[id]+1)
+	var missing [][2]int64
+	for _, covered := range state.Covered {
+		if covered[1] < r[0] {
+			continue
+		}
+		if covered[0] > r[1] {
+			break
+		}
+		if covered[0] > r[0] {
+			missing = append(missing, [2]int64{r[0], covered[0] - 1})
+		}
+		r[0] = max(r[0], covered[1]+1)
+	}
+	if r[0] <= r[1] {
+		missing = append(missing, r)
+	}
+	return missing
+}
diff --git a/internal/interaction/msg_sync_recent_batch.go b/internal/interaction/msg_sync_recent_batch.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_recent_batch.go
@@ -0,0 +1,198 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/sdkerrs"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+// Retain the existing 100-message response budget. Small gaps share a request;
+// large gaps remain bounded, and notification state is always replayed alone.
+func (m *MsgSyncer) nextRecoveryBatch(ids []string, pending map[string][][2]int64) map[string][2]int64 {
+	batch := make(map[string][2]int64)
+	remaining := int64(SplitPullMsgNum)
+	for _, id := range ids {
+		pages := pending[id]
+		if len(pages) == 0 {
+			continue
+		}
+		r := pages[len(pages)-1]
+		r[0] = max(r[0], m.syncedMaxSeqs[id]+1)
+		if r[0] > r[1] {
+			pending[id] = pages[:len(pages)-1]
+			if len(pending[id]) == 0 {
+				delete(pending, id)
+			}
+			continue
+		}
+		if IsNotification(id) && len(batch) > 0 {
+			continue
+		}
+		r[1] = min(r[1], r[0]+remaining-1)
+		batch[id] = r
+		remaining -= r[1] - r[0] + 1
+		if IsNotification(id) || remaining == 0 || len(batch) == 8 {
+			break
+		}
+	}
+	return batch
+}
+
+func (m *MsgSyncer) pullMissingRecoveryBatch(ctx context.Context, batch map[string][2]int64, total int) map[string]error {
+	failed := make(map[string]error)
+	resp, err := m.pullMsgBySeqRange(ctx, batch, SplitPullMsgNum)
+	if err != nil {
+		// A connection timeout applies to the whole transport. Never multiply a
+		// 30-second outage into one timeout per conversation in this batch.
+		if len(batch) > 1 && ctx.Err() == nil && !errors.Is(err, sdkerrs.ErrCtxDeadline) {
+			for id, r := range batch {
+				for key, failure := range m.pullMissingRecoveryBatch(ctx, map[string][2]int64{id: r}, total) {
+					failed[key] = failure
+				}
+			}
+		} else {
+			for id := range batch {
+				failed[id] = err
+			}
+		}
+		return failed
+	}
+	for id, r := range batch {
+		if err := ctx.Err(); err != nil {
+			failed[id] = err
+			continue
+		}
+		var one *sdkws.PullMessageBySeqsResp
+		if resp != nil {
+			one = &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{}, NotificationMsgs: map[string]*sdkws.PullMsgs{}}
+			if packet := resp.Msgs[id]; packet != nil {
+				one.Msgs[id] = packet
+			}
+			if packet := resp.NotificationMsgs[id]; packet != nil {
+				one.NotificationMsgs[id] = packet
+			}
+		}
+		if err := m.commitPulledMessages(ctx, one, map[string][2]int64{id: r}, total); err != nil {
+			failed[id] = err
+		} else {
+			messageSyncPageCommitted(ctx)
+		}
+	}
+	return failed
+}
+
+func (m *MsgSyncer) recoverRecentMessagePages(ctx context.Context, ids []string, pending map[string][][2]int64, reinstall bool, totalPages int) []error {
+	refreshed := make(map[string]bool)
+	var failures []error
+	priorities := m.conversationPriorities(ctx)
+	ctx = context.WithValue(ctx, recoveryPriorityKey{}, priorities)
+	for len(pending) > 0 {
+		if err := yieldMessageSyncPage(ctx); err != nil {
+			return append(failures, err)
+		}
+		m.prioritizeConversations(ids, priorities)
+		batch := m.nextRecoveryBatch(ids, pending)
+		if len(batch) == 0 {
+			continue
+		}
+		total := 0
+		if reinstall {
+			total = totalPages
+		}
+		failed := m.pullRecoveryBatch(ctx, batch, total)
+		if err := ctx.Err(); err != nil {
+			return append(failures, err)
+		}
+		for id, r := range batch {
+			if err := failed[id]; err != nil {
+				var incomplete *incompleteMessageRange
+				if errors.As(err, &incomplete) && !IsNotification(id) && !refreshed[id] {
+					refreshed[id] = true
+					pages := pending[id]
+					remaining := [2]int64{r[0], pages[len(pages)-1][1]}
+					visible, boundaryErr := m.refreshVisibleMessageRange(ctx, id, remaining)
+					if boundaryErr == nil && visible != remaining {
+						if visible[0] > r[0] {
+							if commitErr := m.commitMessageCheckpoint(ctx, id, min(r[1], visible[0]-1)); commitErr != nil {
+								return append(failures, commitErr)
+							}
+						}
+						pending[id] = m.recentMissingRanges(id, visible)
+						if len(pending[id]) == 0 {
+							delete(pending, id)
+						}
+						continue
+					}
+					if boundaryErr != nil {
+						err = errors.Join(err, boundaryErr)
+					}
+				}
+				failures = append(failures, fmt.Errorf("message range %s [%d,%d]: %w", id, r[0], r[1], err))
+				delete(pending, id)
+				continue
+			}
+			pages := pending[id]
+			page := pages[len(pages)-1]
+			if r[1] == page[1] {
+				pending[id] = pages[:len(pages)-1]
+			} else {
+				pages[len(pages)-1] = [2]int64{r[1] + 1, page[1]}
+			}
+			if len(pending[id]) == 0 {
+				delete(pending, id)
+			}
+		}
+	}
+	return failures
+}
+
+// Share foreground history lanes and adopt only rows revalidated in SQLite.
+// Locks are ordered by ID, and there is no concurrent coverage mutation.
+func (m *MsgSyncer) pullRecoveryBatch(ctx context.Context, batch map[string][2]int64, total int) map[string]error {
+	failed := make(map[string]error)
+	release, err := m.lockPreviewHistory(ctx, batch)
+	if err != nil {
+		for id := range batch {
+			failed[id] = err
+		}
+		return failed
+	}
+	defer release()
+	missing := make(map[string][][2]int64)
+	for id, r := range batch {
+		if err := m.acceptStoredHistory(ctx, id, r, total); err != nil {
+			failed[id] = err
+			continue
+		}
+		if IsNotification(id) {
+			missing[id] = [][2]int64{r}
+		} else {
+			missing[id] = m.recentMissingRanges(id, r)
+		}
+		if len(missing[id]) == 0 {
+			delete(missing, id)
+		}
+	}
+	for len(missing) > 0 {
+		request := make(map[string][2]int64)
+		for id, spans := range missing {
+			request[id] = spans[0]
+		}
+		results := m.pullMissingRecoveryBatch(ctx, request, total)
+		for id := range request {
+			if err := results[id]; err != nil {
+				failed[id] = err
+				delete(missing, id)
+			} else {
+				missing[id] = missing[id][1:]
+				if len(missing[id]) == 0 {
+					delete(missing, id)
+				}
+			}
+		}
+	}
+	return failed
+}
