--- /dev/null
+++ b/internal/interaction/connection_recovery_test.go
@@ -0,0 +1,67 @@
+//go:build !js
+
+package interaction
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestReconnectBackoffDoesNotWrapAndResetIsExplicit(t *testing.T) {
+	r := NewExponentialRetry()
+	for i := 0; i < 100; i++ {
+		d := r.GetSleepInterval()
+		if i >= 5 && (d < 15*time.Second || d > 30*time.Second) {
+			t.Fatalf("sustained failure returned to fast retry: attempt=%d delay=%v", i, d)
+		}
+	}
+	r.Reset()
+	if d := r.GetSleepInterval(); d < 500*time.Millisecond || d > time.Second {
+		t.Fatal(d)
+	}
+}
+
+func TestRecoveryWaitCancelledAndWakeCoalesced(t *testing.T) {
+	c := &LongConnMgr{}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if c.waitReconnect(ctx, time.Hour) {
+		t.Fatal("cancelled session retried")
+	}
+	for i := 0; i < 1000; i++ {
+		c.wakeReconnect()
+	}
+	if len(c.recoverySignal()) != 1 {
+		t.Fatal("wake events not coalesced")
+	}
+	if !c.waitReconnect(context.Background(), time.Hour) {
+		t.Fatal("wake ignored")
+	}
+	if len(c.recoverySignal()) != 0 {
+		t.Fatal("wake not consumed")
+	}
+}
+
+func TestForegroundInterruptsBackgroundBackoff(t *testing.T) {
+	c := &LongConnMgr{}
+	c.SetBackground(true)
+	done := make(chan bool, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	go func() { done <- c.waitReconnect(ctx, time.Minute) }()
+	c.SetBackground(false)
+	if !<-done {
+		t.Fatal("foreground did not wake reconnect")
+	}
+}
+
+func TestNativeDialHonorsSessionCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	d := NewWebSocket(0)
+	_, err := dialSession(ctx, d, "ws://127.0.0.1:1")
+	if err == nil || !d.IsNil() {
+		t.Fatal("cancelled dial opened a socket")
+	}
+}
diff --git a/internal/interaction/connection_request_lifetime.go b/internal/interaction/connection_request_lifetime.go
new file mode 100644
index 00000000..fe766708
--- /dev/null
+++ b/internal/interaction/connection_request_lifetime.go
@@ -0,0 +1,28 @@
+package interaction
+
+// requestConnectionDone binds a response wait to the socket used for its write.
+// The caller holds connWrite, so a redial cannot replace the socket in between.
+func (c *LongConnMgr) requestConnectionDone() <-chan struct{} {
+	c.w.Lock()
+	defer c.w.Unlock()
+	if c.connectionDone == nil {
+		c.connectionDone = make(chan struct{})
+		if c.connStatus != Connected {
+			close(c.connectionDone)
+		}
+	}
+	return c.connectionDone
+}
+
+// endConnectionRequestsLocked does not retry sent messages: the caller still
+// receives the normal network error and owns any idempotent recovery policy.
+func (c *LongConnMgr) endConnectionRequestsLocked() {
+	if c.connectionDone == nil {
+		return
+	}
+	select {
+	case <-c.connectionDone:
+	default:
+		close(c.connectionDone)
+	}
+}
diff --git a/internal/interaction/connection_request_lifetime_test.go b/internal/interaction/connection_request_lifetime_test.go
new file mode 100644
index 00000000..d488e52d
--- /dev/null
+++ b/internal/interaction/connection_request_lifetime_test.go
@@ -0,0 +1,164 @@
+package interaction
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+// Only the transport boundary is faked; requests use the real response router.
+type lifetimeTransport struct {
+	LongConn
+	written chan struct{}
+	onWrite func()
+}
+
+func (c *lifetimeTransport) WriteMessage(int, []byte) error {
+	c.written <- struct{}{}
+	if c.onWrite != nil {
+		c.onWrite()
+	}
+	return nil
+}
+func (c *lifetimeTransport) SetWriteDeadline(time.Duration) error { return nil }
+func (c *lifetimeTransport) Close() error                         { return nil }
+
+func lifetimeManager(t *testing.T) (*LongConnMgr, *lifetimeTransport) {
+	t.Helper()
+	transport := &lifetimeTransport{written: make(chan struct{}, 8)}
+	c := &LongConnMgr{ctx: recoveryContext(t), conn: transport, connWrite: new(sync.Mutex),
+		Syncer: NewWsRespAsyn(), encoder: NewGobEncoder()}
+	c.SetConnectionStatus(Connected)
+	return c, transport
+}
+
+func TestAcknowledgedRequestSurvivesImmediateDisconnect(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	request := &GeneralWsReq{ReqIdentifier: constant.SendMsg}
+	transport.onWrite = func() {
+		if err := c.Syncer.NotifyResp(c.ctx, GeneralWsResp{MsgIncr: request.MsgIncr, Data: []byte("ack")}); err != nil {
+			t.Fatal(err)
+		}
+		_ = c.close()
+	}
+	response, err := c.sendAndWaitResp(c.ctx, request)
+	if err != nil || response == nil || string(response.Data) != "ack" {
+		t.Fatalf("lost acknowledged send on closure: response=%v error=%v", response, err)
+	}
+}
+
+func TestForegroundConfirmationRunsAfterDisconnectedQueuedRequest(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	ctx, cancel := context.WithCancel(c.ctx)
+	defer cancel()
+	old := Message{Ctx: ctx, Message: GeneralWsReq{ReqIdentifier: constant.PullMsgByRange}, Resp: make(chan *GeneralWsResp, 1)}
+	foreground := Message{Ctx: ctx, Message: GeneralWsReq{ReqIdentifier: constant.SetBackgroundStatus}, Resp: make(chan *GeneralWsResp, 1)}
+	resume := make(chan struct{})
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		c.dispatchMessage(old)
+		<-resume
+		c.dispatchMessage(foreground)
+	}()
+	<-transport.written
+	_ = c.close()
+	c.SetConnectionStatus(Connected)
+	close(resume)
+	select {
+	case <-transport.written:
+	case <-time.After(300 * time.Millisecond):
+		cancel()
+		<-finished
+		t.Fatal("foreground confirmation stayed behind a disconnected history request")
+	}
+	c.Syncer.wsMutex.RLock()
+	var id string
+	for key := range c.Syncer.wsNotification {
+		id = key
+	}
+	c.Syncer.wsMutex.RUnlock()
+	if id == "" {
+		t.Fatal("foreground request missing")
+	}
+	if err := c.Syncer.NotifyResp(ctx, GeneralWsResp{MsgIncr: id}); err != nil {
+		t.Fatal(err)
+	}
+	<-finished
+	if response := <-old.Resp; response.ErrCode == 0 {
+		t.Fatal("disconnected request reported success")
+	}
+	if response := <-foreground.Resp; response.ErrCode != 0 {
+		t.Fatalf("foreground confirmation failed: %v", response)
+	}
+}
+
+func TestDisconnectedRequestReleasesForegroundQueue(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	ctx, cancel := context.WithCancel(c.ctx)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := c.sendAndWaitResp(ctx, &GeneralWsReq{ReqIdentifier: constant.SetBackgroundStatus})
+		done <- err
+	}()
+	<-transport.written
+	if err := c.close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("disconnected request reported success")
+		}
+	case <-time.After(300 * time.Millisecond):
+		cancel()
+		<-done
+		t.Fatal("old socket request still blocks foreground recovery after disconnect")
+	}
+	if len(c.Syncer.wsNotification) != 0 {
+		t.Fatal("response registration leaked")
+	}
+}
+
+func TestRecoveredConnectionDoesNotInheritOldRequestWait(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	ctx, cancel := context.WithCancel(c.ctx)
+	defer cancel()
+	oldDone := make(chan error, 1)
+	go func() {
+		_, err := c.sendAndWaitResp(ctx, &GeneralWsReq{ReqIdentifier: constant.SetBackgroundStatus})
+		oldDone <- err
+	}()
+	<-transport.written
+	_ = c.close()
+	c.SetConnectionStatus(Connected)
+	select {
+	case err := <-oldDone:
+		if err == nil {
+			t.Fatal("old request succeeded on replacement connection")
+		}
+	case <-time.After(300 * time.Millisecond):
+		cancel()
+		<-oldDone
+		t.Fatal("replacement connection hid the old socket closure")
+	}
+	request := &GeneralWsReq{ReqIdentifier: constant.GetNewestSeq}
+	newDone := make(chan error, 1)
+	go func() { _, err := c.sendAndWaitResp(ctx, request); newDone <- err }()
+	<-transport.written
+	select {
+	case err := <-newDone:
+		t.Fatalf("new request inherited old cancellation: %v", err)
+	default:
+	}
+	if err := c.Syncer.NotifyResp(ctx, GeneralWsResp{MsgIncr: request.MsgIncr}); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-newDone; err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/interaction/connection_telemetry.go b/internal/interaction/connection_telemetry.go
new file mode 100644
index 00000000..c85657d2
--- /dev/null
+++ b/internal/interaction/connection_telemetry.go
@@ -0,0 +1,58 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"github.com/openimsdk/tools/log"
+	"net"
+	"sync/atomic"
+	"time"
+)
+
+type connectionTelemetry struct {
+	attempts       atomic.Int64
+	connectedAt    atomic.Int64
+	lastPing       atomic.Int64
+	lastPong       atomic.Int64
+	lastMessage    atomic.Int64
+	lastDisconnect atomic.Int64
+}
+
+func observedConnectionError(err error) string {
+	var dns *net.DNSError
+	if errors.As(err, &dns) {
+		return "dns_error"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "session_cancelled"
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return "transport_timeout"
+	}
+	return "transport_error"
+}
+
+func (m *connectionTelemetry) connected(ctx context.Context, background bool) {
+	now := time.Now().UnixMilli()
+	m.connectedAt.Store(now)
+	m.lastPing.Store(0)
+	m.lastPong.Store(0)
+	m.lastMessage.Store(0)
+	var recoveryMS int64
+	if disconnected := m.lastDisconnect.Load(); disconnected > 0 {
+		recoveryMS = now - disconnected
+	}
+	log.ZInfo(ctx, "connection_recovered", "connectedAtMs", now, "attempts", m.attempts.Swap(0), "recoveryMs", recoveryMS, "background", background)
+}
+
+func (m *connectionTelemetry) disconnected(ctx context.Context, err error, background bool) {
+	now := time.Now().UnixMilli()
+	m.lastDisconnect.Store(now)
+	code, received := transportCloseCode(err)
+	log.ZWarn(ctx, "connection_disconnected", err,
+		"disconnectedAtMs", now, "connectedAtMs", m.connectedAt.Load(),
+		"observedError", observedConnectionError(err), "confirmedReason", "unknown",
+		"closeCode", code, "closeFrameReceived", received, "background", background,
+		"lastPingAtMs", m.lastPing.Load(), "lastPongAtMs", m.lastPong.Load(), "lastMessageAtMs", m.lastMessage.Load())
+}
diff --git a/internal/interaction/foreground_probe.go b/internal/interaction/foreground_probe.go
new file mode 100644
index 00000000..bec1ee08
--- /dev/null
+++ b/internal/interaction/foreground_probe.go
@@ -0,0 +1,149 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/utils"
+	"github.com/openimsdk/tools/log"
+)
+
+const foregroundProbeTimeout = 3 * time.Second
+
+// Optional: browser/custom transports retain their existing heartbeat policy.
+type foregroundPingTransport interface {
+	ForegroundPingWriter() func(string, time.Time) error
+}
+
+type foregroundProbe struct {
+	token      string
+	connection <-chan struct{}
+	ack        chan struct{}
+	cancel     chan struct{}
+	started    time.Time
+}
+
+func (c *LongConnMgr) cancelForegroundProbeLocked() {
+	if p := c.foregroundProbe; p != nil {
+		close(p.cancel)
+		c.foregroundProbe = nil
+	}
+}
+
+func (c *LongConnMgr) acknowledgeForegroundProbe(token string) {
+	c.mutex.Lock()
+	defer c.mutex.Unlock()
+	if p := c.foregroundProbe; p != nil && p.token == token {
+		select {
+		case p.ack <- struct{}{}:
+		default:
+		}
+	}
+}
+
+func (c *LongConnMgr) probeForegroundConnection(timeout time.Duration) {
+	transport, supported := c.conn.(foregroundPingTransport)
+	if !supported {
+		return
+	}
+	// Same lock order as close(): connection state, then visibility. A dial
+	// changes state to Connecting before replacing the underlying socket.
+	c.w.Lock()
+	if c.connStatus != Connected {
+		c.w.Unlock()
+		return
+	}
+	c.mutex.Lock()
+	if c.IsBackground {
+		c.mutex.Unlock()
+		c.w.Unlock()
+		return
+	}
+	if c.connectionDone == nil {
+		c.connectionDone = make(chan struct{})
+	}
+	if p := c.foregroundProbe; p != nil && p.connection == c.connectionDone {
+		c.mutex.Unlock()
+		c.w.Unlock()
+		return
+	}
+	c.cancelForegroundProbeLocked()
+	writePing := transport.ForegroundPingWriter() // captures this socket, never a later one
+	p := &foregroundProbe{token: "foreground-" + utils.OperationIDGenerator(), connection: c.connectionDone,
+		ack: make(chan struct{}, 1), cancel: make(chan struct{}), started: time.Now()}
+	c.foregroundProbe = p
+	ctx := c.probeContext
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	c.mutex.Unlock()
+	c.w.Unlock()
+	log.ZInfo(ctx, "foreground_probe_started", "timeoutMs", timeout.Milliseconds())
+	go c.runForegroundProbe(ctx, p, writePing, timeout)
+}
+
+func (c *LongConnMgr) runForegroundProbe(ctx context.Context, p *foregroundProbe, writePing func(string, time.Time) error, timeout time.Duration) {
+	defer func() {
+		c.mutex.Lock()
+		if c.foregroundProbe == p {
+			c.foregroundProbe = nil
+		}
+		c.mutex.Unlock()
+	}()
+	select {
+	case <-ctx.Done():
+		return
+	case <-p.cancel:
+		return
+	case <-p.connection:
+		return
+	default:
+	}
+	deadline := p.started.Add(timeout)
+	err := writePing(p.token, deadline)
+	if err == nil {
+		timer := time.NewTimer(time.Until(deadline))
+		defer timer.Stop()
+		select {
+		case <-ctx.Done():
+			return
+		case <-p.cancel:
+			return
+		case <-p.connection:
+			return
+		case <-p.ack:
+			log.ZInfo(ctx, "foreground_probe_confirmed", "elapsedMs", time.Since(p.started).Milliseconds())
+			return
+		case <-timer.C:
+			err = errors.New("foreground pong deadline exceeded")
+		}
+	}
+	if c.retireForegroundConnection(ctx, p, err) {
+		log.ZInfo(ctx, "foreground_probe_reconnect", "elapsedMs", time.Since(p.started).Milliseconds())
+		c.wakeReconnect()
+	}
+}
+
+func (c *LongConnMgr) retireForegroundConnection(ctx context.Context, p *foregroundProbe, reason error) bool {
+	c.w.Lock()
+	defer c.w.Unlock()
+	c.mutex.Lock()
+	defer c.mutex.Unlock()
+	if ctx.Err() != nil || c.IsBackground || c.foregroundProbe != p || c.connStatus != Connected || c.connectionDone != p.connection {
+		return false
+	}
+	// A pong arriving as the timer fires wins over timeout.
+	select {
+	case <-p.ack:
+		return false
+	default:
+	}
+	c.foregroundProbe = nil
+	c.connStatus = Closed
+	c.endConnectionRequestsLocked()
+	c.setCloseError(reason)
+	c.metrics.disconnected(ctx, reason, false)
+	_ = c.conn.Close()
+	return true
+}
diff --git a/internal/interaction/foreground_probe_default.go b/internal/interaction/foreground_probe_default.go
new file mode 100644
index 00000000..7ab34274
--- /dev/null
+++ b/internal/interaction/foreground_probe_default.go
@@ -0,0 +1,18 @@
+//go:build !js
+
+package interaction
+
+import (
+	"github.com/gorilla/websocket"
+	"time"
+)
+
+// Called while the manager guards a Connected socket. WriteControl is safe
+// alongside normal writes and has its own deadline; it never alters the data
+// writer's deadline or waits behind the serialized request/ACK queue.
+func (d *Default) ForegroundPingWriter() func(string, time.Time) error {
+	socket := d.conn
+	return func(token string, deadline time.Time) error {
+		return socket.WriteControl(websocket.PingMessage, []byte(token), deadline)
+	}
+}
diff --git a/internal/interaction/foreground_probe_test.go b/internal/interaction/foreground_probe_test.go
new file mode 100644
index 00000000..40df5865
--- /dev/null
+++ b/internal/interaction/foreground_probe_test.go
@@ -0,0 +1,123 @@
+package interaction
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func probeFixture(t *testing.T) (*LongConnMgr, *probeTransport) {
+	c, transport := lifetimeManager(t)
+	p := &probeTransport{lifetimeTransport: transport, pings: make(chan string, 8)}
+	c.conn = p
+	ctx, cancel := context.WithCancel(context.Background())
+	c.probeContext = ctx
+	t.Cleanup(cancel)
+	return c, p
+}
+
+func TestForegroundProbeHalfOpenDeadline(t *testing.T) {
+	c, p := probeFixture(t)
+	c.probeForegroundConnection(40 * time.Millisecond)
+	<-p.pings
+	deadline := time.After(time.Second)
+	for c.IsConnected() {
+		select {
+		case <-deadline:
+			t.Fatal("half-open connection not retired")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if p.closes.Load() != 1 {
+		t.Fatal("probe did not close exactly its old socket")
+	}
+}
+
+func TestForegroundProbeIgnoresUnrelatedPong(t *testing.T) {
+	c, p := probeFixture(t)
+	c.probeForegroundConnection(40 * time.Millisecond)
+	<-p.pings
+	c.acknowledgeForegroundProbe("regular-heartbeat")
+	time.Sleep(80 * time.Millisecond)
+	if c.IsConnected() {
+		t.Fatal("unrelated pong satisfied foreground probe")
+	}
+}
+
+func TestForegroundProbeCancellationAndReplacement(t *testing.T) {
+	for _, action := range []string{"background", "logout", "replacement", "pong"} {
+		t.Run(action, func(t *testing.T) {
+			c, p := probeFixture(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			c.probeContext = ctx
+			c.probeForegroundConnection(40 * time.Millisecond)
+			token := <-p.pings
+			for i := 0; i < 20; i++ {
+				c.probeForegroundConnection(40 * time.Millisecond)
+			}
+			if len(p.pings) != 0 {
+				t.Fatal("duplicate foreground probes")
+			}
+			switch action {
+			case "background":
+				c.SetBackground(true)
+			case "logout":
+				cancel()
+			case "replacement":
+				c.SetConnectionStatus(Closed)
+				c.SetConnectionStatus(Connected)
+			case "pong":
+				c.acknowledgeForegroundProbe(token)
+			}
+			time.Sleep(80 * time.Millisecond)
+			if p.closes.Load() != 0 || !c.IsConnected() {
+				t.Fatal("obsolete probe closed connection")
+			}
+		})
+	}
+}
+
+type probeTransport struct {
+	*lifetimeTransport
+	pings  chan string
+	closes atomic.Int32
+}
+
+func (p *probeTransport) ForegroundPingWriter() func(string, time.Time) error {
+	return func(token string, deadline time.Time) error { p.pings <- token; return nil }
+}
+func (p *probeTransport) SetReadDeadline(time.Duration) error { return nil }
+func (p *probeTransport) Close() error                        { p.closes.Add(1); return nil }
+
+func TestForegroundTransitionProbesConnectedSocketImmediately(t *testing.T) {
+	c, transport := lifetimeManager(t)
+	p := &probeTransport{lifetimeTransport: transport, pings: make(chan string, 8)}
+	c.conn = p
+	c.SetBackground(true)
+	c.SetBackground(false)
+	select {
+	case token := <-p.pings:
+		if err := c.pongHandler(token); err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(300 * time.Millisecond):
+		t.Fatal("foreground did not probe the supposedly connected socket; still waiting for heartbeat")
+	}
+	if !c.IsConnected() || p.closes.Load() != 0 {
+		t.Fatal("healthy socket was closed")
+	}
+}
+
+func TestForegroundReportProbesEvenWhenAlreadyMarkedForeground(t *testing.T) {
+	c, p := probeFixture(t)
+	c.SetBackground(false)
+	select {
+	case token := <-p.pings:
+		c.acknowledgeForegroundProbe(token)
+	case <-time.After(300 * time.Millisecond):
+		t.Fatal("foreground report skipped probe because local visibility was already foreground")
+	}
+}
diff --git a/internal/interaction/history_priority.go b/internal/interaction/history_priority.go
new file mode 100644
index 00000000..c6c04ac5
--- /dev/null
+++ b/internal/interaction/history_priority.go
@@ -0,0 +1,297 @@
+package interaction
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/converter"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/db_interface"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"sort"
+	"sync"
+)
+
+// Session-owned coordination: history reads and recovery share one lane per
+// conversation. Only durably stored foreground rows are advertised as covered.
+// No process-global account state or second message store is introduced.
+type historyPriority struct {
+	mu      sync.Mutex
+	lanes   map[string]*historyLane
+	covered map[string][]int64
+	order   []string
+}
+type historyLane struct {
+	token            chan struct{}
+	refs, foreground int
+}
+
+func (l *LongConnMgr) LockMessageHistory(ctx context.Context, id string, foreground bool) (func(), error) {
+	if l == nil {
+		return func() {}, ctx.Err()
+	}
+	p := &l.historyPriority
+	p.mu.Lock()
+	if p.lanes == nil {
+		p.lanes = make(map[string]*historyLane)
+	}
+	lane := p.lanes[id]
+	if lane == nil {
+		lane = &historyLane{token: make(chan struct{}, 1)}
+		lane.token <- struct{}{}
+		p.lanes[id] = lane
+	}
+	lane.refs++
+	if foreground {
+		lane.foreground++
+	}
+	p.mu.Unlock()
+	drop := func() {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		lane.refs--
+		if foreground {
+			lane.foreground--
+		}
+		if lane.refs == 0 {
+			delete(p.lanes, id)
+		}
+	}
+	select {
+	case <-ctx.Done():
+		drop()
+		return nil, ctx.Err()
+	case <-lane.token:
+	}
+	if err := ctx.Err(); err != nil {
+		lane.token <- struct{}{}
+		drop()
+		return nil, err
+	}
+	var once sync.Once
+	return func() { once.Do(func() { lane.token <- struct{}{}; drop() }) }, nil
+}
+
+func (l *LongConnMgr) RememberHistoryRows(id string, seqs []int64) {
+	if l == nil || len(seqs) == 0 {
+		return
+	}
+	p := &l.historyPriority
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.covered == nil {
+		p.covered = make(map[string][]int64)
+	}
+	if _, ok := p.covered[id]; !ok {
+		if len(p.order) >= 128 {
+			delete(p.covered, p.order[0])
+			p.order = p.order[1:]
+		}
+		p.order = append(p.order, id)
+	}
+	seen := make(map[int64]bool)
+	for _, s := range append(append([]int64(nil), p.covered[id]...), seqs...) {
+		if s > 0 {
+			seen[s] = true
+		}
+	}
+	rows := make([]int64, 0, len(seen))
+	for s := range seen {
+		rows = append(rows, s)
+	}
+	sort.Slice(rows, func(i, j int) bool { return rows[i] < rows[j] })
+	if len(rows) > recentMessageWindow {
+		rows = rows[len(rows)-recentMessageWindow:]
+	}
+	p.covered[id] = rows
+}
+
+func (l *LongConnMgr) storedHistoryRanges(id string, r [2]int64) [][2]int64 {
+	if l == nil {
+		return nil
+	}
+	p := &l.historyPriority
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	var ranges [][2]int64
+	for _, s := range p.covered[id] {
+		if s < r[0] || s > r[1] {
+			continue
+		}
+		if len(ranges) > 0 && ranges[len(ranges)-1][1]+1 == s {
+			ranges[len(ranges)-1][1] = s
+		} else {
+			ranges = append(ranges, [2]int64{s, s})
+		}
+	}
+	return ranges
+}
+
+type syncConversationPriority struct {
+	pinned   bool
+	activity int64
+}
+
+type recoveryPriorityKey struct{}
+
+func recoveryPriorities(ctx context.Context) map[string]syncConversationPriority {
+	priorities, _ := ctx.Value(recoveryPriorityKey{}).(map[string]syncConversationPriority)
+	return priorities
+}
+
+func (m *MsgSyncer) conversationPriorities(ctx context.Context) map[string]syncConversationPriority {
+	result := make(map[string]syncConversationPriority)
+	if m.db == nil {
+		return result
+	}
+	var rows []*model_struct.LocalConversation
+	var err error
+	if reader, ok := m.db.(db_interface.MessageRecoveryBoundsReader); ok {
+		rows, err = reader.GetMessageRecoveryBounds(ctx)
+	} else {
+		rows, err = m.db.GetAllConversationListDB(ctx)
+	}
+	if err != nil {
+		return result
+	} // Ordering is optional; synchronization still runs.
+	for _, row := range rows {
+		if row != nil {
+			result[row.ConversationID] = syncConversationPriority{row.IsPinned, row.LatestMsgSendTime}
+		}
+	}
+	return result
+}
+
+func (m *MsgSyncer) prioritizeConversations(ids []string, priorities map[string]syncConversationPriority) {
+	active := make(map[string]bool)
+	if m.longConnMgr != nil {
+		p := &m.longConnMgr.historyPriority
+		p.mu.Lock()
+		for id, lane := range p.lanes {
+			active[id] = lane.foreground > 0
+		}
+		p.mu.Unlock()
+	}
+	sort.SliceStable(ids, func(i, j int) bool {
+		a, b := ids[i], ids[j]
+		if active[a] != active[b] {
+			return active[a]
+		}
+		x, y := priorities[a], priorities[b]
+		if x.pinned != y.pinned {
+			return x.pinned
+		}
+		return x.activity > y.activity
+	})
+}
+
+// Called while holding the same lane as foreground storage. A sparse newest
+// window remains sparse coverage; it must never advance across an older gap.
+func (m *MsgSyncer) acceptStoredHistory(ctx context.Context, id string, r [2]int64, total int) error {
+	if IsNotification(id) {
+		return nil
+	}
+	ranges := m.longConnMgr.storedHistoryRanges(id, r)
+	if len(ranges) == 0 {
+		return nil
+	}
+	if m.db == nil {
+		return nil
+	}
+	var seqs []int64
+	for _, span := range ranges {
+		for s := span[0]; s <= span[1]; s++ {
+			if !m.messageAlreadyCovered(id, s) {
+				seqs = append(seqs, s)
+			}
+		}
+	}
+	if len(seqs) == 0 {
+		return nil
+	}
+	rows, err := m.db.GetMessagesBySeqs(ctx, id, seqs)
+	if err != nil {
+		return err
+	}
+	// Replay through the normal receipt path so adopting history preserves
+	// conversation previews, unread reconciliation and durable acknowledgements.
+	// Revalidate SQLite: clear-history may have removed a remembered row.
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i] == nil {
+			return false
+		}
+		if rows[j] == nil {
+			return true
+		}
+		return rows[i].Seq < rows[j].Seq
+	})
+	var groups [][]*sdkws.MsgData
+	for _, row := range rows {
+		if row == nil || row.Seq < r[0] || row.Seq > r[1] {
+			continue
+		}
+		data := converter.MsgStructToMsgData(converter.LocalChatLogToMsgStruct(row), nil)
+		if len(groups) > 0 && groups[len(groups)-1][len(groups[len(groups)-1])-1].Seq+1 == row.Seq {
+			groups[len(groups)-1] = append(groups[len(groups)-1], data)
+		} else {
+			groups = append(groups, []*sdkws.MsgData{data})
+		}
+	}
+	for _, group := range groups {
+		resp := &sdkws.PullMessageBySeqsResp{Msgs: map[string]*sdkws.PullMsgs{id: {Msgs: group}}}
+		if err = m.commitPulledMessages(ctx, resp, map[string][2]int64{id: {group[0].Seq, group[len(group)-1].Seq}}, total, true); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (m *MsgSyncer) syncPrioritizedPage(ctx context.Context, id string, r [2]int64, total int) error {
+	release, err := m.longConnMgr.LockMessageHistory(ctx, id, false)
+	if err != nil {
+		return err
+	}
+	defer release()
+	if err = m.acceptStoredHistory(ctx, id, r, total); err != nil {
+		return err
+	}
+	pages := [][2]int64{r}
+	if !IsNotification(id) {
+		pages = m.recentMissingRanges(id, r)
+	}
+	for _, page := range pages {
+		batch := map[string][2]int64{id: page}
+		resp, err := m.pullMsgBySeqRange(ctx, batch, page[1]-page[0]+1)
+		if err != nil {
+			return err
+		}
+		if err = m.commitPulledMessages(ctx, resp, batch, total); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (m *MsgSyncer) lockPreviewHistory(ctx context.Context, batch map[string][2]int64) (func(), error) {
+	ids := make([]string, 0, len(batch))
+	for id := range batch {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	var releases []func()
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			for i := len(releases) - 1; i >= 0; i-- {
+				releases[i]()
+			}
+		})
+	}
+	for _, id := range ids {
+		unlock, err := m.longConnMgr.LockMessageHistory(ctx, id, false)
+		if err != nil {
+			release()
+			return nil, err
+		}
+		releases = append(releases, unlock)
+	}
+	return release, nil
+}
diff --git a/internal/interaction/history_priority_test.go b/internal/interaction/history_priority_test.go
new file mode 100644
index 00000000..8c370154
--- /dev/null
+++ b/internal/interaction/history_priority_test.go
@@ -0,0 +1,231 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+type priorityDB struct {
+	*recoveryVersionDB
+	conversations []*model_struct.LocalConversation
+	rows          map[int64]*model_struct.LocalChatLog
+	readErr       error
+}
+
+func (d *priorityDB) GetAllConversationListDB(context.Context) ([]*model_struct.LocalConversation, error) {
+	return d.conversations, d.readErr
+}
+func (d *priorityDB) GetMessagesBySeqs(_ context.Context, _ string, seqs []int64) ([]*model_struct.LocalChatLog, error) {
+	var rows []*model_struct.LocalChatLog
+	for _, s := range seqs {
+		if row := d.rows[s]; row != nil {
+			rows = append(rows, row)
+		}
+	}
+	return rows, d.readErr
+}
