+	m := &MsgSyncer{ctx: ctx, loginUserID: "self", longConnMgr: c, conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"chat": 5}}
+	flags := make(chan int, 8)
