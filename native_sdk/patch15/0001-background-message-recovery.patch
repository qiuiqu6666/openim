index 00000000..633bd9c4
--- /dev/null
+++ b/third_party/tools/log/async_test.go
@@ -0,0 +1,49 @@
+package log
+
+import (
+	"context"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestName(t *testing.T) {
+	DisableAsync = true
+	sdkType := "TestSDK"
+	platformName := runtime.GOOS
+	err := InitLoggerFromConfig(
+		"testLogger", // loggerPrefixName
+		"testModule", // moduleName
+		sdkType,      // sdkType
+		platformName, // platformName
+		5,            // logLevel (Debug)
+		false,        // isStdout
+		false,        // isJson
+		".",          // logLocation
+		5,            // rotateCount
+		24,           // rotationTime
+		"1.0.0",      // moduleVersion
+		false,        // isSimplify
+	)
+	assert.NoError(t, err)
+
+	ctx := context.Background()
+
+	const count = 1000000
+	start := time.Now()
+	for i := 0; i < count; i++ {
+		ZDebug(ctx, "test debug message", "key", "value", "log_index", i)
+	}
+	Flush()
+	end := time.Now()
+	duration := end.Sub(start)
+
+	t.Log("cost:", duration)
+	t.Log("avg:", duration/time.Duration(count))
+
+	// 7.015554167s 7.015µs
+	// 3.207912375s 3.207µs
+
+}
diff --git a/third_party/tools/log/branding_test.go b/third_party/tools/log/branding_test.go
new file mode 100644
index 00000000..f6a96c13
--- /dev/null
+++ b/third_party/tools/log/branding_test.go
@@ -0,0 +1,39 @@
+package log
+
+import (
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"strings"
+	"testing"
+)
+
+func TestDiagnosticBranding(t *testing.T) {
+	for _, jsonFormat := range []bool{false, true} {
+		config := zap.NewProductionEncoderConfig()
+		var encoder zapcore.Encoder = zapcore.NewConsoleEncoder(config)
+		if jsonFormat {
+			encoder = zapcore.NewJSONEncoder(config)
+		}
+		encoder = (&alignEncoder{Encoder: encoder}).Clone()
+		encoder.AddString("source", "open-im-sdk-core")
+		out, err := encoder.EncodeEntry(zapcore.Entry{Level: zapcore.ErrorLevel, Message: "OpenIM failed", Caller: zapcore.EntryCaller{Defined: true, File: "open_im_sdk/caller.go", Line: 123}}, []zapcore.Field{
+			zap.String("error", "github.com/openimsdk/tools/errs failed: code=1001"),
+			zap.String("operationID", "op-123"), zap.Int("elapsed_ms", 1500),
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		value := out.String()
+		out.Free()
+		for _, unwanted := range []string{"openim", "open-im", "open_im"} {
+			if strings.Contains(strings.ToLower(value), unwanted) {
+				t.Fatalf("leaked branding: %s", value)
+			}
+		}
+		for _, required := range []string{"op-123", "1500", "1001", "caller.go:123", "Chat failed"} {
+			if !strings.Contains(value, required) {
+				t.Fatalf("lost diagnostic %s: %s", required, value)
+			}
+		}
+	}
+}
diff --git a/third_party/tools/log/color.go b/third_party/tools/log/color.go
new file mode 100644
index 00000000..2cb4fe07
--- /dev/null
+++ b/third_party/tools/log/color.go
@@ -0,0 +1,50 @@
+package log
+
+import (
+	"fmt"
+
+	"go.uber.org/zap/zapcore"
+)
+
+// Foreground colors.
+const (
+	Black Color = iota + 30
+	Red
+	Green
+	Yellow
+	Blue
+	Magenta
+	Cyan
+	White
+)
+
+var (
+	_levelToColor = map[zapcore.Level]Color{
+		zapcore.DebugLevel:  White,
+		zapcore.InfoLevel:   Blue,
+		zapcore.WarnLevel:   Yellow,
+		zapcore.ErrorLevel:  Red,
+		zapcore.DPanicLevel: Red,
+		zapcore.PanicLevel:  Red,
+		zapcore.FatalLevel:  Red,
+	}
+	_unknownLevelColor = make(map[zapcore.Level]string, len(_levelToColor))
+
+	_levelToLowercaseColorString = make(map[zapcore.Level]string, len(_levelToColor))
+	_levelToCapitalColorString   = make(map[zapcore.Level]string, len(_levelToColor))
+)
+
+func init() {
+	for level, color := range _levelToColor {
+		_levelToLowercaseColorString[level] = color.Add(level.String())
+		_levelToCapitalColorString[level] = color.Add(level.CapitalString())
+	}
+}
+
+// Color represents a text color.
+type Color uint8
+
+// Add adds the coloring to the given string.
+func (c Color) Add(s string) string {
+	return fmt.Sprintf("\x1b[%dm%s\x1b[0m", uint8(c), s)
+}
