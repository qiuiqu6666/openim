+		elem := sdk_struct.SoundElem{}
+		err = utils.JsonStringToStruct(msg.Content, &elem)
+		msg.SoundElem = &elem
+	case constant.Video:
+		elem := sdk_struct.VideoElem{}
+		err = utils.JsonStringToStruct(msg.Content, &elem)
+		msg.VideoElem = &elem
+	case constant.File:
