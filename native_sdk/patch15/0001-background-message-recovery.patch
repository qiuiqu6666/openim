new file mode 100644
index 00000000..f78c5b32
--- /dev/null
+++ b/internal/group/sync_batch.go
@@ -0,0 +1,76 @@
+package group
+
+import (
+	"context"
+	"github.com/openimsdk/tools/log"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// Bound database/profile work independently of the server's batch size.
+// Cancellation stops dispatch and joins in-flight work before returning.
+func runGroupSyncBatch(ctx context.Context, tasks []func() error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if len(tasks) == 0 {
+		return nil
+	}
+	const concurrency = 4
+	var started, active, peak atomic.Int64
+	var cancelledAt atomic.Int64
+	stopNotice := context.AfterFunc(ctx, func() { cancelledAt.CompareAndSwap(0, time.Now().UnixNano()) })
+	defer stopNotice()
+	defer func() {
+		join := time.Duration(0)
+		if at := cancelledAt.Load(); at != 0 {
+			join = time.Since(time.Unix(0, at))
+		}
+		log.ZDebug(ctx, "group_sync_batch_summary", "scheduled", len(tasks), "started", started.Load(), "peakActive", peak.Load(), "activeAtExit", active.Load(), "cancelled", ctx.Err() != nil, "cancelJoinElapsed", join)
+	}()
+	jobs := make(chan func() error)
+	var wg sync.WaitGroup
+	var firstErr error
+	var once sync.Once
+	for i := 0; i < concurrency; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for task := range jobs {
+				if ctx.Err() != nil {
+					return
+				}
+				started.Add(1)
+				n := active.Add(1)
+				for old := peak.Load(); n > old; old = peak.Load() {
+					if peak.CompareAndSwap(old, n) {
+						break
+					}
+				}
+				err := task()
+				active.Add(-1)
+				if err != nil {
+					once.Do(func() { firstErr = err })
+				}
+			}
+		}()
+	}
+dispatch:
+	for _, task := range tasks {
+		if ctx.Err() != nil {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			break dispatch
+		case jobs <- task:
+		}
+	}
+	close(jobs)
+	wg.Wait()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return firstErr
+}
diff --git a/internal/group/sync_batch_test.go b/internal/group/sync_batch_test.go
new file mode 100644
index 00000000..bc736f8e
--- /dev/null
+++ b/internal/group/sync_batch_test.go
@@ -0,0 +1,60 @@
+package group
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+)
+
+func TestGroupBatchCancellationStopsQueuedWork(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan struct{}, 4)
+	var calls atomic.Int32
+	tasks := make([]func() error, 500)
+	for i := range tasks {
+		tasks[i] = func() error {
+			calls.Add(1)
+			started <- struct{}{}
+			<-ctx.Done()
+			return ctx.Err()
+		}
+	}
+	done := make(chan error, 1)
+	go func() { done <- runGroupSyncBatch(ctx, tasks) }()
+	for i := 0; i < 4; i++ {
+		<-started
+	}
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if calls.Load() != 4 {
+		t.Fatalf("started %d tasks after cancellation", calls.Load())
+	}
+}
+
+func TestGroupBatchPreservesErrorAndProcessesRemainingGroups(t *testing.T) {
+	failure := errors.New("profile failure")
+	var calls atomic.Int32
+	tasks := make([]func() error, 20)
+	for i := range tasks {
+		tasks[i] = func() error { calls.Add(1); return failure }
+	}
+	if err := runGroupSyncBatch(context.Background(), tasks); !errors.Is(err, failure) {
+		t.Fatal(err)
+	}
+	if calls.Load() != 20 {
+		t.Fatal(calls.Load())
+	}
+}
+
+func TestGroupBatchAlreadyCancelledDoesNoWork(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err := runGroupSyncBatch(ctx, []func() error{func() error { t.Error("cancelled task ran"); return nil }})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
