@@ -0,0 +1,120 @@
+//go:build cgo && !js
+
+package interaction
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func TestInitialSQLiteSyncRetriesAfterMessageFailure(t *testing.T) {
+	for _, stage := range []string{"pull", "storage", "restart"} {
+		t.Run(stage, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			dir := t.TempDir()
+			d, err := db.NewDataBase(ctx, "self", dir, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = d.Close(ctx) })
+			if err := d.BatchInsertConversationList(ctx, []*model_struct.LocalConversation{{ConversationID: "chat", ConversationType: constant.SingleChatType}}); err != nil {
+				t.Fatal(err)
+			}
+			conn := &LongConnMgr{send: make(chan Message, 1)}
+			conn.SetConnectionStatus(Connected)
+			conversationCh := make(chan common.Cmd2Value)
+			m, err := NewMsgSyncer(ctx, conversationCh, nil, "self", conn, d, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			// The app has its metadata, but has not committed its first messages.
+			m.reinstalled = true
+			flags := make(chan int, 8)
+			storageAttempts := 0
+			receiptWorker(t, conversationCh, func(cmd common.Cmd2Value) error {
+				if cmd.Cmd == constant.CmdSyncFlag {
+					flags <- cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).SyncFlag
+				}
+				if cmd.Cmd == constant.CmdMsgSyncInReinstall {
+					storageAttempts++
+					if stage == "storage" && storageAttempts == 1 {
+						return errors.New("simulated disk write failure")
+					}
+					batch := cmd.Value.(sdk_struct.CmdMsgSyncInReinstall)
+					inserts := map[string][]*model_struct.LocalChatLog{}
+					for id, rows := range batch.Msgs {
+						for _, row := range rows.Msgs {
+							inserts[id] = append(inserts[id], &model_struct.LocalChatLog{ClientMsgID: fmt.Sprint(row.Seq), Seq: row.Seq})
+						}
+					}
+					return d.CommitMessageSyncBatch(ctx, nil, inserts, nil, nil)
+				}
+				return nil
+			})
+			pulls := 0
+			observations := 0
+			requestWorker(t, conn, func(req Message) *GeneralWsResp {
+				if req.Message.ReqIdentifier == constant.GetNewestSeq {
+					observations++
+					notificationSeq := int64(7)
+					if observations > 1 {
+						notificationSeq = 5
+					} // A stale retry response.
+					return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"n_chat": notificationSeq, "chat": 3}})
+				}
+				pulls++
+				if stage != "storage" && pulls == 1 {
+					return &GeneralWsResp{ErrCode: 10001, ErrMsg: "simulated connection loss"}
+				}
+				return requestedRecoveryResponse(t, req)
+			})
+			m.startSync()
+			m.doConnected(ctx)
+			if <-flags != constant.AppDataSyncStart || <-flags != constant.MsgSyncFailed {
+				t.Fatal("failure did not terminate initial sync")
+			}
+			version, err := d.GetAppSDKVersion(ctx)
+			if err != nil || version.Installed || !m.reinstalled || m.syncedMaxSeqs["chat"] != 0 {
+				t.Fatalf("failure committed initialization: %+v %v", version, err)
+			}
+			if stage == "restart" {
+				if err := d.Close(ctx); err != nil {
+					t.Fatal(err)
+				}
+				d, err = db.NewDataBase(ctx, "self", dir, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				m, err = NewMsgSyncer(ctx, conversationCh, nil, "self", conn, d, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			// No new push or user action is needed for a foreground retry.
+			m.doMessageSeqReconciliation(ctx)
+			if <-flags != constant.AppDataSyncStart || <-flags != constant.AppDataSyncFinish {
+				t.Fatal("retry did not finish initial sync")
+			}
+			version, err = d.GetAppSDKVersion(ctx)
+			if err != nil || !version.Installed || m.reinstalled || m.syncedMaxSeqs["chat"] != 3 {
+				t.Fatalf("retry failed: %+v %v", version, err)
+			}
+			if m.syncedMaxSeqs["n_chat"] != 7 {
+				t.Fatalf("stale retry rewound in-memory notification baseline to %d", m.syncedMaxSeqs["n_chat"])
+			}
+			for seq := int64(1); seq <= 3; seq++ {
+				if _, err := d.GetMessageBySeq(ctx, "chat", seq); err != nil {
+					t.Fatalf("missing committed message %d: %v", seq, err)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/interaction/initial_sync_traffic_test.go b/internal/interaction/initial_sync_traffic_test.go
new file mode 100644
index 00000000..0eecddad
--- /dev/null
+++ b/internal/interaction/initial_sync_traffic_test.go
@@ -0,0 +1,128 @@
+package interaction
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestFirstLoginCompletesAndCommitsMessagesUnderLiveTraffic(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	conn := &LongConnMgr{send: make(chan Message, 4)}
+	db := &recoveryVersionDB{}
+	m := &MsgSyncer{ctx: ctx, db: db, reinstalled: true, loginUserID: "self", longConnMgr: conn,
+		recvCh: make(chan common.Cmd2Value, 32), conversationCh: make(chan common.Cmd2Value, 32), syncedMaxSeqs: map[string]int64{}}
+	started, release := make(chan struct{}), make(chan struct{})
+	stored := make(chan int64, 32)
+	starts := 0
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if initial, ok := cmd.Value.(sdk_struct.CmdMsgSyncInReinstall); ok {
+			for _, messages := range initial.Msgs {
+				for _, msg := range messages.Msgs {
+					stored <- msg.Seq
+				}
+			}
+			return nil
+		}
+		v, ok := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation)
+		if !ok {
+			return nil
+		}
+		if cmd.Cmd == constant.CmdSyncFlag && v.SyncFlag == constant.AppDataSyncStart {
+			starts++
+			if starts == 1 {
+				close(started)
+			}
+			select {
+			case <-release:
+				return cmd.Ctx.Err()
+			case <-cmd.Ctx.Done():
+				return cmd.Ctx.Err()
+			}
+		}
+		for _, messages := range v.Msgs {
+			for _, msg := range messages.Msgs {
+				stored <- msg.Seq
+			}
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.GetNewestSeq {
+			return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"chat": 6}})
+		}
+		pull := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, pull); err != nil {
+			panic(err)
+		}
+		var seqs []int64
+		for seq := pull.SeqRanges[0].Begin; seq <= pull.SeqRanges[0].End; seq++ {
+			seqs = append(seqs, seq)
+		}
+		return wireResponse(&sdkws.PullMessageBySeqsResp{Msgs: recoveryMsgs("chat", seqs...)})
+	})
+	done := make(chan struct{})
+	allHandled := make(chan struct{})
+	commitsFinished := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, m.recvCh, func(cmd common.Cmd2Value) {
+			if cmd.Cmd == "testCommitBarrier" {
+				close(commitsFinished)
+				return
+			}
+			m.handlePushMsgAndEventSafely(cmd)
+			if cmd.Cmd == constant.CmdPushMsg && cmd.Value.(*sdkws.PushMessages).Msgs["chat"].Msgs[0].Seq == 26 {
+				close(allHandled)
+			}
+		}, func() bool { return m.reinstalled })
+	}()
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdConnSuccesss}
+	<-started
+	for seq := int64(7); seq <= 26; seq++ {
+		m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg, Value: &sdkws.PushMessages{Msgs: recoveryMsgs("chat", seq)}}
+	}
+	select {
+	case <-stored:
+		t.Fatal("messages handled before first-login metadata was ready")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	seen := make(map[int64]bool)
+	for n := 0; n < 26; n++ {
+		select {
+		case got := <-stored:
+			if got < 1 || got > 26 || seen[got] {
+				t.Fatalf("unexpected/duplicate sequence %d", got)
+			}
+			seen[got] = true
+		case <-ctx.Done():
+			t.Fatal("initial sync or queued live messages did not finish")
+		}
+	}
+	select {
+	case <-allHandled:
+	case <-ctx.Done():
+		t.Fatal("live message commit never acknowledged")
+	}
+	// Pushes can now be handled at the first page boundary and journal gaps.
+	// Receipt observation alone precedes the worker's durable checkpoint write.
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: "testCommitBarrier"}
+	select {
+	case <-commitsFinished:
+	case <-ctx.Done():
+		t.Fatal("range checkpoint never committed")
+	}
+	cancel()
+	<-done
+	if !db.installed || m.reinstalled || m.syncedMaxSeqs["chat"] != 26 || starts != 1 {
+		t.Fatalf("bootstrap not committed: installed=%v reinstall=%v seq=%d starts=%d", db.installed, m.reinstalled, m.syncedMaxSeqs["chat"], starts)
+	}
+}
