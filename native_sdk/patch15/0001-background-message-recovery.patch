+package interaction
+
+import (
+	"sync/atomic"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+)
+
+func TestContiguousPushDoesNotRestartReadReconciliation(t *testing.T) {
+	for _, id := range []string{"chat", "n_receipts"} {
+		t.Run(id, func(t *testing.T) {
+			ctx := recoveryContext(t)
+			m := &MsgSyncer{ctx: ctx, conversationCh: make(chan common.Cmd2Value),
+				syncedMaxSeqs: map[string]int64{id: 5}, recoveryReadSeqReady: true,
+				pendingReadReconcile: true}
+			var reconciliations atomic.Int32
+			receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+				if cmd.Value.(sdk_struct.CmdNewMsgComeToConversation).ReconcileReadSeq {
+					reconciliations.Add(1)
+				}
+				return nil
+			})
+			trigger := m.triggerConversation
+			if IsNotification(id) {
+				trigger = m.triggerNotification
+			}
+			for seq := int64(6); seq <= 15; seq++ {
+				m.pushTriggerAndSync(ctx, recoveryMsgs(id, seq), trigger)
+			}
+			if reconciliations.Load() != 0 || !m.recoveryReadSeqReady || !m.pendingReadReconcile {
+				t.Fatalf("contiguous pushes disturbed background recovery: scans=%d ready=%v pending=%v", reconciliations.Load(), m.recoveryReadSeqReady, m.pendingReadReconcile)
+			}
+			if m.syncedMaxSeqs[id] != 15 {
+				t.Fatalf("push delivery did not advance: %d", m.syncedMaxSeqs[id])
+			}
+			// The background owner must still reconcile the obligation left by
+			// a genuine earlier gap, even if live rows already closed that gap.
+			if err := m.syncCompleteMessageRanges(ctx, nil, false); err != nil {
+				t.Fatal(err)
+			}
+			if reconciliations.Load() != 1 || m.pendingReadReconcile {
+				t.Fatalf("background reconciliation lost: scans=%d pending=%v", reconciliations.Load(), m.pendingReadReconcile)
+			}
+		})
+	}
+}
diff --git a/internal/interaction/msg_sync_failure.go b/internal/interaction/msg_sync_failure.go
new file mode 100644
index 00000000..df4c2e09
--- /dev/null
+++ b/internal/interaction/msg_sync_failure.go
@@ -0,0 +1,20 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+)
+
+// A deliberately yielded worker still owes its durable targets, but does not
+// describe a broken connection. Preserve the scheduler retry without feeding
+// cancellation back into the application's network recovery loop.
+func (m *MsgSyncer) reportMessageSyncFailure(ctx context.Context, err error) {
+	recordMessageSyncFailure(ctx, err)
+	if err == nil || ctx.Err() != nil || errors.Is(err, context.Canceled) {
+		return
+	}
+	common.TriggerCmdSyncFlag(m.ctx, constant.MsgSyncFailed, m.conversationCh)
+}
diff --git a/internal/interaction/msg_sync_failure_test.go b/internal/interaction/msg_sync_failure_test.go
new file mode 100644
index 00000000..f086e6f5
--- /dev/null
+++ b/internal/interaction/msg_sync_failure_test.go
@@ -0,0 +1,42 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+)
+
+func TestCancelledSyncDoesNotPublishFailureAndRetainsRetry(t *testing.T) {
+	for _, cancelledParent := range []bool{false, true} {
+		t.Run(map[bool]string{false: "yielded-metadata", true: "cancelled-attempt"}[cancelledParent], func(t *testing.T) {
+			session := recoveryContext(t)
+			owner := &messagePageCoordinator{}
+			ctx, cancel := context.WithCancel(context.WithValue(session, messagePageContextKey{}, owner))
+			defer cancel()
+			if cancelledParent {
+				cancel()
+			}
+			m := &MsgSyncer{ctx: session, conversationCh: make(chan common.Cmd2Value, 1)}
+			m.reportMessageSyncFailure(ctx, context.Canceled)
+			if len(m.conversationCh) != 0 {
+				t.Fatal("scheduler cancellation was reported as a connection failure")
+			}
+			if owner.failed.Load() == cancelledParent {
+				t.Fatal("active yielded metadata must retain its retry; cancelled owner must not create another")
+			}
+		})
+	}
+}
+
+func TestRealSyncFailureRemainsVisibleAndRetryable(t *testing.T) {
+	ctx := recoveryContext(t)
+	owner := &messagePageCoordinator{}
+	ctx = context.WithValue(ctx, messagePageContextKey{}, owner)
+	m := &MsgSyncer{ctx: ctx, conversationCh: make(chan common.Cmd2Value, 1)}
+	m.reportMessageSyncFailure(ctx, errors.New("storage failed"))
+	if len(m.conversationCh) != 1 || !owner.failed.Load() {
+		t.Fatal("real failure disappeared")
+	}
+}
