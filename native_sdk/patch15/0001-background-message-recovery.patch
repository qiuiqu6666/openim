--- /dev/null
+++ b/internal/interaction/msg_sync_fairness_test.go
@@ -0,0 +1,294 @@
+package interaction
+
+import (
+	"context"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/db/model_struct"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/msg"
+	"github.com/openimsdk/protocol/sdkws"
+	"google.golang.org/protobuf/proto"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestVisibilityPreflightYieldsBetweenConversations(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	d := &checkpointFaultDB{recoveryVersionDB: &recoveryVersionDB{installed: true}, boundary: model_struct.LocalConversation{MaxSeq: 10}}
+	m := &MsgSyncer{ctx: ctx, db: d, longConnMgr: conn, recvCh: make(chan common.Cmd2Value), conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"a": 10, "b": 10}}
+	boundaryStarted, release := make(chan struct{}), make(chan struct{})
+	var probes int
+	var live atomic.Bool
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if p, ok := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation); ok && p.Msgs["live"] != nil {
+			live.Store(true)
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.PullMsgBySeqList {
+			probes++
+			if probes == 1 {
+				close(boundaryStarted)
+				select {
+				case <-release:
+				case <-req.Ctx.Done():
+					return &GeneralWsResp{ErrCode: 10001}
+				}
+			}
+			if probes == 2 && !live.Load() {
+				t.Error("live message waited behind every visibility probe")
+			}
+			p := &msg.GetSeqMessageReq{}
+			if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+				panic(err)
+			}
+			packets := make(map[string]*sdkws.PullMsgs)
+			for _, row := range p.Conversations {
+				packets[row.ConversationID] = &sdkws.PullMsgs{}
+			}
+			return wireResponse(&msg.GetSeqMessageResp{Msgs: packets})
+		}
+		return requestedRecoveryResponse(t, req)
+	})
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, m.recvCh, func(cmd common.Cmd2Value) {
+			if isBackgroundSyncCommand(cmd) {
+				finished <- m.syncCompleteMessageRanges(cmd.Ctx, map[string][2]int64{"a": {11, 20}, "b": {11, 20}}, false)
+			} else {
+				m.handlePushMsgAndEventSafely(cmd)
+			}
+		}, func() bool { return true })
+	}()
+	t.Cleanup(func() { cancel(); <-done })
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-boundaryStarted
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg, Value: &sdkws.PushMessages{Msgs: recoveryMsgs("live", 1)}}
+	close(release)
+	select {
+	case err := <-finished:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("boundary recovery did not finish")
+	}
+	if probes != 2 || !live.Load() {
+		t.Fatalf("unexpected progress probes=%d live=%v", probes, live.Load())
+	}
+}
+
+func TestLivePushCannotStarveMaxSequenceDiscovery(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	input := make(chan common.Cmd2Value)
+	started := make(chan context.Context, 3)
+	release := make(chan struct{})
+	live := make(chan struct{}, 40)
+	finished := make(chan struct{}, 1)
+	var attempts atomic.Int32
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, input, func(cmd common.Cmd2Value) {
+			if !isBackgroundSyncCommand(cmd) {
+				live <- struct{}{}
+				return
+			}
+			n := attempts.Add(1)
+			started <- cmd.Ctx
+			if n == 1 {
+				<-cmd.Ctx.Done()
+				return
+			}
+			select {
+			case <-release:
+				finished <- struct{}{}
+			case <-cmd.Ctx.Done():
+			}
+		})
+	}()
+	t.Cleanup(func() { cancel(); <-done })
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-started
+	input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	<-live
+	retry := <-started
+	for n := 0; n < 35; n++ {
+		input <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg}
+	}
+	select {
+	case <-retry.Done():
+		t.Fatal("max-sequence retry was starved by live traffic")
+	case <-time.After(150 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-finished:
+	case <-ctx.Done():
+		t.Fatal("metadata never completed")
+	}
+	for n := 0; n < 35; n++ {
+		select {
+		case <-live:
+		case <-ctx.Done():
+			t.Fatal("live events not drained")
+		}
+	}
+	if attempts.Load() != 2 {
+		t.Fatal(attempts.Load())
+	}
+}
+
+func TestInitialHistoryYieldsLivePushBetweenPages(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, db: &recoveryVersionDB{}, reinstalled: true, longConnMgr: conn, recvCh: make(chan common.Cmd2Value), conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{}}
+	pageStarted := make(chan int64, 3)
+	releasePage := make(chan struct{})
+	liveStored := make(chan struct{}, 1)
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if p, ok := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation); ok && p.Msgs["live"] != nil {
+			liveStored <- struct{}{}
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.GetNewestSeq {
+			return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"history": 300, "history_b": 300}})
+		}
+		p := &sdkws.PullMessageBySeqsReq{}
+		if err := proto.Unmarshal(req.Message.Data, p); err != nil {
+			panic(err)
+		}
+		r := p.SeqRanges[0]
+		pageStarted <- r.Begin
+		select {
+		case <-releasePage:
+		case <-req.Ctx.Done():
+			return &GeneralWsResp{ErrCode: 10001}
+		}
+		return requestedRecoveryResponse(t, req)
+	})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runMessageSyncLoop(ctx, m.recvCh, m.handlePushMsgAndEventSafely, func() bool { return m.reinstalled })
+	}()
+	t.Cleanup(func() { cancel(); <-done })
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdConnSuccesss}
+	if got := <-pageStarted; got != 300 {
+		t.Fatal(got)
+	}
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg, Value: &sdkws.PushMessages{Msgs: recoveryMsgs("live", 1)}}
+	releasePage <- struct{}{}
+	if got := <-pageStarted; got != 201 {
+		t.Fatal(got)
+	}
+	select {
+	case <-liveStored:
+	default:
+		t.Fatal("live push waited for all history pages")
+	}
+	releasePage <- struct{}{}
+}
+
+func TestContinuousLivePushCannotCancelEveryRecoveryPage(t *testing.T) {
+	ctx, cancel := context.WithCancel(recoveryContext(t))
+	defer cancel()
+	conn := &LongConnMgr{send: make(chan Message, 1)}
+	m := &MsgSyncer{ctx: ctx, longConnMgr: conn, recvCh: make(chan common.Cmd2Value), conversationCh: make(chan common.Cmd2Value), syncedMaxSeqs: map[string]int64{"gap": 3}}
+	pulls := make(chan Message, 3)
+	release := make(chan struct{})
+	storedGap := make(chan struct{}, 1)
+	liveStored := make(chan int64, 64)
+	var attempts atomic.Int32
+	receiptWorker(t, m.conversationCh, func(cmd common.Cmd2Value) error {
+		if p, ok := cmd.Value.(sdk_struct.CmdNewMsgComeToConversation); ok {
+			if p.Msgs["gap"] != nil {
+				storedGap <- struct{}{}
+			}
+			if p.Msgs["live"] != nil {
+				liveStored <- p.Msgs["live"].Msgs[0].Seq
+			}
+		}
+		return nil
+	})
+	requestWorker(t, conn, func(req Message) *GeneralWsResp {
+		if req.Message.ReqIdentifier == constant.GetNewestSeq {
+			return wireResponse(&sdkws.GetMaxSeqResp{MaxSeqs: map[string]int64{"gap": 13}})
+		}
+		n := attempts.Add(1)
+		pulls <- req
+		if n == 1 {
+			<-req.Ctx.Done()
+			return &GeneralWsResp{ErrCode: 10001}
+		}
+		select {
+		case <-release:
+		case <-req.Ctx.Done():
+			return &GeneralWsResp{ErrCode: 10001}
+		}
+		return requestedRecoveryResponse(t, req)
+	})
+	done := make(chan struct{})
+	go func() { defer close(done); runMessageSyncLoop(ctx, m.recvCh, m.handlePushMsgAndEventSafely) }()
+	t.Cleanup(func() { cancel(); <-done })
+	push := func(seq int64) {
+		m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdPushMsg, Value: &sdkws.PushMessages{Msgs: recoveryMsgs("live", seq)}}
+	}
+	m.recvCh <- common.Cmd2Value{Ctx: ctx, Cmd: constant.CmdIMMessageSync}
+	<-pulls
+	push(1)
+	select {
+	case <-liveStored:
+	case <-ctx.Done():
+		t.Fatal("stalled first attempt blocked live push")
+	}
+	var retry Message
+	select {
+	case retry = <-pulls:
+	case <-ctx.Done():
+		t.Fatal("recovery was not retried")
+	}
+	for seq := int64(2); seq <= 40; seq++ {
+		push(seq)
+	}
+	select {
+	case <-retry.Ctx.Done():
+		t.Fatal("continuous live ingress cancelled reserved progress")
+	case <-time.After(150 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-storedGap:
+	case <-ctx.Done():
+		t.Fatal("gap made no progress")
+	}
+	for seq := int64(2); seq <= 40; seq++ {
+		select {
+		case got := <-liveStored:
+			if got != seq {
+				t.Fatalf("live ordering: %d != %d", got, seq)
+			}
+		case <-ctx.Done():
+			t.Fatal("live queue stranded after gap")
+		}
+	}
+	select {
+	case <-storedGap:
+	case <-ctx.Done():
+		t.Fatal("history made no progress after the latest preview")
+	}
+	if attempts.Load() != 3 {
+		t.Fatalf("expected one bounded preemption, attempts=%d", attempts.Load())
+	}
+}
diff --git a/internal/interaction/msg_sync_latest.go b/internal/interaction/msg_sync_latest.go
new file mode 100644
--- /dev/null
+++ b/internal/interaction/msg_sync_latest.go
@@ -0,0 +1,208 @@
+package interaction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/common"
+	"github.com/openimsdk/openim-sdk-core/v3/pkg/constant"
+	"github.com/openimsdk/openim-sdk-core/v3/sdk_struct"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+)
+
+const latestMessageBatchSize = 100
+
+// Publish one latest message for every conversation before pulling any recent
+// history. Batch conversations, rather than making one network trip per chat.
+func (m *MsgSyncer) syncLatestMessagePreviews(ctx context.Context, ids []string, visible map[string][2]int64, total int) (map[string]error, error) {
+	var singles, others []string
+	for _, id := range ids {
+		if IsNotification(id) || m.messageAlreadyCovered(id, visible[id][1]) {
+			continue
+		}
+		if strings.HasPrefix(id, "si_") {
+			singles = append(singles, id)
+		} else {
+			others = append(others, id)
+		}
+	}
+	ordered := make([]string, 0, len(singles)+len(others))
+	for i := 0; i < max(len(singles), len(others)); i++ {
+		if i < len(singles) {
+			ordered = append(ordered, singles[i])
+		}
+		if i < len(others) {
+			ordered = append(ordered, others[i])
+		}
+	}
+	failed := make(map[string]error)
+	priorities := m.conversationPriorities(ctx)
+	ctx = context.WithValue(ctx, recoveryPriorityKey{}, priorities)
+	for begin := 0; begin < len(ordered); begin += latestMessageBatchSize {
+		m.prioritizeConversations(ordered[begin:], priorities)
+		batch := make(map[string][2]int64)
+		for _, id := range ordered[begin:min(begin+latestMessageBatchSize, len(ordered))] {
+			end := visible[id][1]
+			batch[id] = [2]int64{end, end}
+		}
+		if err := m.syncLatestMessageBatch(ctx, batch, visible, total, failed); err != nil {
+			return failed, err
+		}
+	}
+	return failed, nil
+}
+
+func (m *MsgSyncer) syncLatestMessageBatch(ctx context.Context, batch, visible map[string][2]int64, total int, failed map[string]error) error {
+	if err := yieldMessageSyncPage(ctx); err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	release, err := m.lockPreviewHistory(ctx, batch)
+	if err != nil {
+		return err
+	}
+	defer release()
+	for id, r := range batch {
+		if err := m.acceptStoredHistory(ctx, id, r, total); err != nil {
+			return err
+		}
+	}
+	// A live push handled at the page boundary may already have stored the tail.
+	for id, r := range batch {
+		if m.messageAlreadyCovered(id, r[1]) || m.syncedMaxSeqs[id] >= r[1] {
+			delete(batch, id)
+		}
+	}
+	if len(batch) == 0 {
+		return nil
+	}
+	resp, err := m.pullMsgBySeqRange(ctx, batch, 1)
+	if err != nil {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		// Isolate a bad conversation without discarding other previews in its batch.
+		if len(batch) > 1 {
+			release()
+			for id, r := range batch {
+				if err := m.syncLatestMessageBatch(ctx, map[string][2]int64{id: r}, visible, total, failed); err != nil {
+					return err
+				}
+			}
+		} else {
+			for id, r := range batch {
+				failed[id] = fmt.Errorf("latest message %s [%d]: %w", id, r[1], err)
+			}
+		}
+		return nil
+	}
+	if err := m.resolveEmptySyncPreviews(ctx, batch, visible, resp); err != nil {
+		return err
+	}
+	accepted := &sdkws.PullMessageBySeqsResp{Msgs: make(map[string]*sdkws.PullMsgs)}
+	var deleted []string
+	for id, r := range batch {
+		if resp == nil {
+			err = fmt.Errorf("empty latest-message response")
+		} else {
+			err = validatePulledConversationCoverage(resp.Msgs, map[string][2]int64{id: r}, false)
+		}
+		if err != nil {
+			failed[id] = fmt.Errorf("latest message %s: %w", id, err)
+			delete(batch, id)
+			continue
+		}
+		accepted.Msgs[id] = resp.Msgs[id]
+		if resp.Msgs[id].Msgs[0].Status == constant.MsgStatusHasDeleted {
+			deleted = append(deleted, id)
+		}
+	}
+	// The maximum sequence can be a deletion placeholder. Recover the last
+	// visible message too, including one older than the automatic 100-row window.
+	if len(deleted) > 0 {
+		last, fetchErr := m.fetchLatestValidMessages(ctx, deleted)
+		fallback := make(map[string]*sdkws.PullMsgs)
+		for _, id := range deleted {
+			if fetchErr != nil || last == nil {
+				failed[id] = fmt.Errorf("latest valid message %s: %v", id, fetchErr)
+				delete(batch, id)
+				delete(accepted.Msgs, id)
+				continue
+			}
+			row := last.Msgs[id]
+			if row == nil {
+				continue // No remaining visible message.
+			}
+			minimum := int64(1)
+			if m.db != nil {
+				conversation, readErr := m.db.GetConversation(ctx, id)
+				if readErr != nil && !errors.Is(readErr, errs.ErrRecordNotFound) {
+					failed[id] = fmt.Errorf("latest valid message %s boundary: %w", id, readErr)
+					delete(batch, id)
+					delete(accepted.Msgs, id)
+					continue
+				}
+				if conversation != nil {
+					minimum = max(minimum, conversation.MinSeq)
+				}
+			}
+			if row.Seq < minimum || row.Seq > visible[id][1] || row.Status >= constant.MsgStatusHasDeleted {
+				failed[id] = fmt.Errorf("invalid latest valid message for %s", id)
+				delete(batch, id)
+				delete(accepted.Msgs, id)
+				continue
+			}
+			fallback[id] = &sdkws.PullMsgs{Msgs: []*sdkws.MsgData{row}}
+		}
+		if len(fallback) > 0 {
+			if total > 0 {
+				err = m.triggerReinstallConversation(ctx, fallback, total, true)
+			} else {
+				err = common.SendCmdWithReceipt(ctx, common.Cmd2Value{Cmd: constant.CmdNewMsgCome,
+					Value: sdk_struct.CmdNewMsgComeToConversation{Msgs: fallback, Recovery: true, ReconcileReadSeq: !m.recoveryReadSeqReady}}, m.conversationCh)
+				if err == nil {
+					m.recoveryReadSeqReady = true
+				}
+			}
+			for id, packet := range fallback {
+				commitErr := err
+				if commitErr == nil {
+					seq := packet.Msgs[0].Seq
+					commitErr = m.commitMessageCoverage(ctx, id, [][2]int64{{seq, seq}})
+				}
+				if commitErr != nil {
+					failed[id] = fmt.Errorf("latest valid message %s: %w", id, commitErr)
+					delete(batch, id)
+					delete(accepted.Msgs, id)
+				}
+			}
+		}
+	}
+	if len(batch) > 0 {
+		if err := m.commitPulledMessages(ctx, accepted, batch, total, true); err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			if len(batch) > 1 {
+				release()
+				for id, r := range batch {
+					if err := m.syncLatestMessageBatch(ctx, map[string][2]int64{id: r}, visible, total, failed); err != nil {
+						return err
+					}
+				}
+			} else {
+				for id := range batch {
+					failed[id] = fmt.Errorf("latest message %s commit: %w", id, err)
+				}
+			}
+		} else {
+			messageSyncPageCommitted(ctx)
+		}
+	}
+	return ctx.Err()
+}
