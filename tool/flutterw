#!/usr/bin/env bash
set -euo pipefail

# Use the project's supported SDK without changing the global Flutter installation.
project_flutter_sdk="${OPENIM_FLUTTER_SDK:-$HOME/development/sdk/flutter-3.32.8}"
if [[ ! -x "$project_flutter_sdk/bin/flutter" ]]; then
  echo "Flutter 3.32.8 not found at $project_flutter_sdk. Set OPENIM_FLUTTER_SDK to its SDK directory." >&2
  exit 1
fi
sdk_version="$("$project_flutter_sdk/bin/flutter" --version --machine)"
if [[ "$sdk_version" != *'"frameworkVersion": "3.32.8"'* ]]; then
  echo "This project requires Flutter 3.32.8. Check OPENIM_FLUTTER_SDK." >&2
  exit 1
fi
export PATH="$project_flutter_sdk/bin:$PATH"
exec "$project_flutter_sdk/bin/flutter" "$@"
